# Keep secrets, local state and host-built modules OUT of the image.
# Without this file `COPY . .` baked the operator's .env (SESSION_SECRET, APP_KEY,
# DB password), TLS private keys, backups/uploads and .git into every image layer,
# and replaced the Alpine-built node_modules with the host's (audit SA-10).
#
# CIS Docker Benchmark 4.10 (no secrets in images) and a minimal build context:
# only what the server needs at run time goes in - server.js, src/, views/,
# public/, private/, locales/, db/, scripts/ (migrate-preflight is required at
# run time), package*.json, LICENSE, NOTICE, README.md.

# Secrets and TLS material
.env
.env.*
!.env.example
certs/
*.pem
*.key
*.pfx
*.p12

# Dependencies are installed in the build stage (npm ci --omit=dev)
node_modules/
npm-debug.log*

# Runtime data: uploads, quarantine, temp imports, logs, backups
# (the image creates these empty under /app/data, see the Dockerfile)
data/
uploads/
tmp/
logs/
backups/
AI_Engine_Docs/
*.log
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
sbom*.json
*.sarif

# Source control, CI, editor and test artefacts
.git/
.gitattributes
.github/
.husky/
.claude/
.gitleaks.toml
coverage/
.nyc_output/
playwright-report/
test-results/
tests/
playwright.config.js
jest.config.js
commitlint.config.js
.eslintrc.json
.prettierrc
.prettierignore
.editorconfig
.vscode/
.idea/
.DS_Store
Thumbs.db
/_*.js
/_*.json

# Documentation and non-container distributions
docs/
mobile/
installer/
*.bat
*.md
!README.md

# Container definitions themselves
Dockerfile
docker-compose*.yml
.dockerignore
