# IDevelop Community Edition — environment configuration
# Copy this file to .env and set at least SESSION_SECRET, APP_KEY and DATABASE_URL.
# In production the app REFUSES to start with a missing or weak secret.

# ======================
# Application Settings
# ======================
NODE_ENV=production
PORT=3000

# Session Secret (REQUIRED - Generate a strong random string)
# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARACTERS

# At-rest encryption key for stored secrets (MFA seeds, SSO / LMS / SMTP
# credentials). Strongly recommended: without it SESSION_SECRET is used, so
# rotating the session secret would orphan every stored secret.
# Generate with: openssl rand -hex 32. NEVER change it by hand once data is
# encrypted — rotate with: NEW_APP_KEY=<new> node scripts/rotate-app-key.js --commit
APP_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_KEY

# Docker Compose only: password of the bundled PostgreSQL container.
# DB_PASSWORD=choose-a-strong-password

# ======================
# Database Configuration (PostgreSQL — required)
# ======================

# PostgreSQL connection string (REQUIRED).
# Example: postgres://idevelop:secret@localhost:5432/idevelop
DATABASE_URL=postgres://idevelop:CHANGE_ME@localhost:5432/idevelop

# PG pool size (optional)
# PG_POOL_MAX=10

# ======================
# Background jobs (Phase 4+)
# ======================
# Redis powers asynchronous background jobs: dispute-escalation timers,
# notification dispatch, and lifecycle processing. It is OPTIONAL — without it
# the app runs and these handlers execute INLINE (synchronously) instead.
# RECOMMENDED FOR PRODUCTION so long-running/scheduled work doesn't block requests.
# Install Redis (Linux) or Memurai (Windows), then set:
# REDIS_URL=redis://localhost:6379

# ======================
# Security - Rate Limiting
# ======================

# Login rate limiting
LOGIN_RATE_LIMIT=5          # Max login attempts per window
LOGIN_RATE_WINDOW=15        # Window duration in minutes
LOGIN_LOCKOUT_DURATION=30   # Account lockout duration in minutes

# API rate limiting
API_RATE_LIMIT=100          # Max API requests per window
API_RATE_WINDOW=15          # Window duration in minutes

# ======================
# Optional Settings
# ======================

# Session timeout (in milliseconds)
# Default: 24 hours = 86400000
# SESSION_TIMEOUT=86400000

# Log level (error, warn, info, debug)
# LOG_LEVEL=info

# Maximum file upload size (in bytes)
# Default: 5MB = 5242880
# MAX_UPLOAD_SIZE=5242880

# ======================
# Production Deployment
# ======================

# Trust proxy (set to 1 if behind nginx/apache)
# TRUST_PROXY=1

# ======================
# V2 feature flag & packaging
# ======================
# V2_FEATURES gates the "V2" modules mounted under /v2/* (UAM/MFA management,
# self-assessment cycles, IDP, confidential talent/bias, coaching, PIP,
# lifecycle) and activates i18n (FR primary, EN fallback). The CORE product
# (skills matrix, readiness, reviews, 9-box, coaching, reports, dashboards, RBAC,
# SSO, onboarding) runs WITHOUT this flag.
#
# Decision/packaging guidance:
#   • Single-tenant on-prem install that wants the full talent suite → set V2_FEATURES=1.
#   • Minimal/core deployment → leave it unset (V2 routes are not mounted; their
#     sidebar links are hidden automatically).
# The flag is read at boot, so change it then restart the service.
# V2_FEATURES=1

# ======================
# Email / SMTP (outgoing notifications)
# ======================
# Email-on-action notifications are configured primarily from the in-app
# Settings page (Settings → Email (SMTP) + Email Triggers), which is the
# recommended approach. These environment variables act as a FALLBACK: a
# setting saved in the UI always wins; if a setting is blank, the matching
# SMTP_* value below is used. This lets you ship credentials via the
# environment without storing them in the database.
#
# Email sending is gated by the "enableEmailNotifications" master switch in
# the Settings UI. Leave SMTP_HOST unset to keep email fully disabled.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=IDevelop <noreply@example.com>

# Public URL of this instance as USERS reach it — embedded in outgoing emails
# (e.g. the onboarding-credentials mail links to APP_BASE_URL/login). Set to
# the DNS name users actually browse to.
#
# SECURITY — set this on any instance that sends password-reset mail. Links in
# email are NEVER built from the request's Host header (an attacker can set it
# and have the platform mail a victim a reset link pointing at attacker-
# controlled infrastructure). When this is unset the link falls back to the
# machine hostname, which is safe but may not be how users reach the server.
# BASE_URL is accepted as an alias for backward compatibility.
# APP_BASE_URL=http://hr-server.company.local:3000

# Extra host[:port] values that may legitimately appear in the Host header and
# are safe to use when building email links — for installs reachable under
# several names, or behind a reverse proxy. Comma-separated, matched EXACTLY.
# Only consulted when APP_BASE_URL is unset.
# TRUSTED_HOSTS=hr.company.local,hr.company.local:3000

# ======================
# Single Sign-On (multi-provider)
# ======================
# SSO links an external identity to an EXISTING local account (admin or
# employee). There is NO just-in-time provisioning: a user can only sign in if
# their email matches an active account, or their external id was previously
# linked. Each provider below is independent — configure as many as you need;
# the login page shows a button per active provider.
#
# MASTER SWITCH — must be on for ANY provider to load:
# SSO_ENABLED=1
#
# A provider only activates when ALL of its required variables are present.
#
# --- 1) Microsoft Entra ID / Azure AD (openid-client: OIDC + PKCE) ----------
# Azure → App registrations → New registration. Platform: Web. Enable ID tokens.
# Create a client secret. Graph delegated scopes: openid, profile, email, User.Read.
# Redirect URI must equal SSO_ENTRA_REDIRECT_URL and end in /auth/sso/entra/callback.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=your-client-secret-value
# SSO_ENTRA_REDIRECT_URL=https://app.example.com/auth/sso/entra/callback
# SSO_ENTRA_LABEL=Sign in with Microsoft
# SSO_LOG_LEVEL=warn
#
# --- 1b) Microsoft Entra ID — API bearer tokens (jose: JWT verification)
# OPTIONAL, non-interactive auth measure. When set (and SSO_ENABLED=1), the API
# (/api/v1/* and /api/powerbi/*) ALSO accepts an Entra-issued JWT access token as
# `Authorization: Bearer <token>`, in addition to X-API-Key. The token is validated
# (signature via tenant JWKS, issuer, audience, expiry) and mapped to a LOCAL
# account — the caller must be PRE-LINKED by their Entra object id: set the target
# admin/employee's auth_provider='entra' and external_id=<oid>. Leave AZURE_API_CLIENT_ID
# unset to keep API auth as API-key-only (no behaviour change). Setting up interactive
# Entra login alone does NOT enable this — it is a separate, explicit opt-in.
#   AZURE_API_CLIENT_ID  — REQUIRED to enable. The API app registration's client id
#                          (use the same value as AZURE_CLIENT_ID for a single-app setup).
#   AZURE_API_AUDIENCE   — expected token 'aud' (defaults to the client id; api://<id> also accepted)
#   AZURE_API_ISSUER     — override the expected issuer (defaults to the v2.0 tenant issuer)
# AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
#
# --- 2) Generic OpenID Connect (Okta, Auth0, Keycloak, OneLogin, Ping, …) ---
# Copy the endpoint URLs from the IdP's .well-known/openid-configuration.
# Callback URL registered at the IdP must end in /auth/sso/oidc/callback.
# OIDC_ISSUER=https://your-tenant.okta.com/oauth2/default
# OIDC_AUTH_URL=https://your-tenant.okta.com/oauth2/default/v1/authorize
# OIDC_TOKEN_URL=https://your-tenant.okta.com/oauth2/default/v1/token
# OIDC_USERINFO_URL=https://your-tenant.okta.com/oauth2/default/v1/userinfo
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URL=https://app.example.com/auth/sso/oidc/callback
# OIDC_SCOPE=openid profile email
# OIDC_LABEL=Sign in with SSO
#
# --- 3) SAML 2.0 (ADFS, Shibboleth, Okta/OneLogin/Ping SAML, …) -------------
# SAML_ENTRY_POINT = the IdP's SSO (redirect) URL.
# SAML_ISSUER      = this app's SP entity id (any stable URI you register at IdP).
# SAML_CALLBACK_URL= the SP Assertion Consumer Service; ends in /auth/sso/saml/callback.
# Provide the IdP signing certificate either inline (SAML_IDP_CERT, PEM body,
# no headers) or as a file path (SAML_IDP_CERT_FILE).
# SAML_ENTRY_POINT=https://idp.example.com/sso/saml
# SAML_ISSUER=https://app.example.com/saml/metadata
# SAML_CALLBACK_URL=https://app.example.com/auth/sso/saml/callback
# SAML_IDP_CERT=MIID...base64...==
# SAML_IDP_CERT_FILE=/etc/idevelop/idp-cert.pem
# SAML_LABEL=Sign in with SAML
#
# --- 4) Google Workspace (passport-google-oauth20) --------------------------
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI must end in /auth/sso/google/callback.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URL=https://app.example.com/auth/sso/google/callback
# GOOGLE_HD=example.com          # optional: restrict to this Workspace domain
# GOOGLE_LABEL=Sign in with Google
