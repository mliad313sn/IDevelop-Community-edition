# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
*.pfx.bak
*.p12
certs/

# Build / temp
tmp/
dist/
build/
coverage/
.nyc_output/
playwright-report/
test-results/

# Logs
logs/
*.log

# Databases and dumps: never commit data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/old/
# Backup keyring (SA-39): wrapped keys, never versioned
data/keys/
data.zip

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo

# Snapshots created by SnapshotService (kept off git, archived externally)
data/backups/*.zip
!data/backups/.gitkeep

# Local DB backup dumps (installer/manage restore points live in ProgramData;
# these are dev-side dumps — never version them)
backups/

# Generated screenshot sets for the user guide (capture on invented data only)
tests/uat/

# Local scratch: underscore-prefixed probe files at the repository root
/_*.js
/_*.json
accounts-before.json

# Operator-supplied packaging denylist (never committed: it names what it protects)
installer/denylist.txt

# Supply-chain scan outputs (npm run security:*, CI); published as build artifacts
sbom*.json
*.sarif
*.sql.gz
data/*.sql

# Generated at package time (scripts/build-third-party-notices.js)
THIRD-PARTY-NOTICES.txt
