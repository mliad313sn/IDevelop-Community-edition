<!-- Global command palette (Ctrl/Cmd+K, or the header search button) — jump to any page, person,
     skill or role without hunting through menus. Results are RBAC-scoped by
     /api/quick-search; employees never see other people's records. -->
<div class="cmdk" id="cmdk" hidden role="dialog" aria-modal="true" aria-label="<%= __('chrome:cmdk_aria') %>">
    <div class="cmdk-backdrop" data-cmdk-close></div>
    <div class="cmdk-panel">
        <div class="cmdk-input-row">
            <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
            <input type="text" id="cmdkInput" class="cmdk-input" autocomplete="off"
                   placeholder="<%= __('chrome:cmdk_placeholder') %>" aria-label="<%= __('chrome:cmdk_placeholder') %>">
            <kbd class="cmdk-esc">Esc</kbd>
        </div>
        <div class="cmdk-results" id="cmdkResults" role="listbox" aria-label="<%= __('chrome:cmdk_results_aria') %>"></div>
        <div class="cmdk-foot">
            <span><kbd>↑</kbd><kbd>↓</kbd> <%= __('chrome:cmdk_navigate') %></span>
            <span><kbd>↵</kbd> <%= __('chrome:cmdk_open') %></span>
        </div>
    </div>
</div>

<style>
.cmdk{position:fixed;inset:0;z-index:9998}
.cmdk[hidden]{display:none}
.cmdk-backdrop{position:absolute;inset:0;background:rgba(2,6,23,.45)}
.cmdk-panel{position:relative;max-width:620px;margin:9vh auto 0;background:var(--bg-primary,#fff);
    border:1px solid var(--border,#e2e8f0);border-radius:14px;box-shadow:0 24px 60px rgba(2,32,71,.28);overflow:hidden}
.cmdk-input-row{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--border,#e2e8f0);color:var(--text-secondary,#64748b)}
.cmdk-input{flex:1;border:none;outline:none;background:transparent;font-size:1.02rem;color:var(--text-primary,#0f172a)}
.cmdk-esc{font-size:.7rem;border:1px solid var(--border,#cbd5e1);border-radius:5px;padding:1px 6px;color:var(--text-secondary,#64748b)}
.cmdk-results{max-height:52vh;overflow-y:auto;padding:6px}
.cmdk-group{font-size:.7rem;letter-spacing:.05em;color:var(--text-secondary,#64748b);padding:8px 12px 4px}
.cmdk-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:8px;cursor:pointer;color:inherit;text-decoration:none}
.cmdk-item:hover,.cmdk-item.is-active{background:var(--bg-subtle,#f1f5f9)}
.cmdk-item i{width:18px;text-align:center;color:var(--text-secondary,#64748b)}
.cmdk-item-sub{margin-left:auto;font-size:.76rem;color:var(--text-secondary,#64748b)}
.cmdk-empty{padding:22px;text-align:center;color:var(--text-secondary,#64748b);font-size:.9rem}
.cmdk-foot{display:flex;gap:16px;padding:8px 16px;border-top:1px solid var(--border,#e2e8f0);
    font-size:.74rem;color:var(--text-secondary,#64748b)}
.cmdk-foot kbd{border:1px solid var(--border,#cbd5e1);border-radius:4px;padding:0 4px;margin-right:2px}
@media (max-width:640px){ .cmdk-panel{margin:0;max-width:none;height:100%;border-radius:0} .cmdk-results{max-height:calc(100vh - 130px)} }
</style>

<script nonce="<%= cspNonce %>">
(function () {
    'use strict';
    const T = <%- include('./json-script', { v: {
        pages: __('chrome:cmdk_pages'), people: __('chrome:cmdk_people'),
        skills: __('chrome:cmdk_skills'), roles: __('chrome:cmdk_roles'),
        empty: __('chrome:cmdk_empty'), hint: __('chrome:cmdk_hint'),
    } }) %>;
    // Static destinations come from the navigation config (navConfig.paletteIndex):
    // every rail page this person may see — sub-pages and folded sections
    // included — then the account menu, with the same names and the same
    // visibility predicates as the rail. The palette never offers a page this
    // person cannot open.
    <% const _pN = (typeof navConfig !== 'undefined' && navConfig) ? navConfig : null;
       const _pT = (k) => __(String(k).indexOf(':') === -1 ? 'chrome:' + k : k);
       const _pIdx = _pN ? _pN.paletteIndex(locals).map(function (p) {
           return { label: _pT(p.labelKey), group: _pT(p.groupKey), href: p.href, icon: p.icon };
       }) : []; %>
    const PAGES = <%- include('./json-script', { v: _pIdx }) %>;

    const el = document.getElementById('cmdk');
    const input = document.getElementById('cmdkInput');
    const list = document.getElementById('cmdkResults');
    let items = [], active = 0, reqSeq = 0, opener = null;

    function open() {
        // Remember who opened the palette (the header search button, or whatever
        // had the focus on Ctrl+K) so closing gives the focus back.
        const a = document.activeElement;
        opener = a && a !== document.body && !el.contains(a) ? a : null;
        el.hidden = false;
        input.value = '';
        render(defaultItems());
        setTimeout(() => input.focus(), 10);
    }
    function close() {
        el.hidden = true;
        const back = opener || document.getElementById('hdrSearch');
        opener = null;
        if (back && typeof back.focus === 'function' && document.contains(back)) back.focus();
    }
    function defaultItems() {
        return PAGES.slice(0, 8).map((p) => ({ ...p, group: p.group || T.pages }));
    }
    function render(next) {
        items = next; active = 0;
        if (!items.length) { list.innerHTML = '<div class="cmdk-empty">' + esc(T.empty) + '</div>'; return; }
        let html = '', lastGroup = null;
        items.forEach((it, i) => {
            if (it.group !== lastGroup) { html += '<div class="cmdk-group" role="presentation"></div>'; lastGroup = it.group; }
            html += '<a class="cmdk-item' + (i === 0 ? ' is-active' : '') + '" data-i="' + i + '" role="option">' +
                '<i class="' + esc(it.icon) + '" aria-hidden="true"></i><span></span>' +
                (it.sub ? '<span class="cmdk-item-sub"></span>' : '') + '</a>';
        });
        list.innerHTML = html;
        // Text and links set as properties (never innerHTML) so a person's name
        // or a skill title can't inject markup into the palette.
        const groups = [];
        let prev = null;
        items.forEach((it) => { if (it.group !== prev) { groups.push(it.group); prev = it.group; } });
        list.querySelectorAll('.cmdk-group').forEach((node, i) => { node.textContent = groups[i] || ''; });
        list.querySelectorAll('.cmdk-item').forEach((node, i) => {
            node.setAttribute('href', items[i].href);
            node.querySelector('span').textContent = items[i].label;
            const sub = node.querySelector('.cmdk-item-sub');
            if (sub) sub.textContent = items[i].sub;
        });
    }
    function setActive(i) {
        const nodes = list.querySelectorAll('.cmdk-item');
        if (!nodes.length) return;
        active = (i + nodes.length) % nodes.length;
        nodes.forEach((n, j) => n.classList.toggle('is-active', j === active));
        nodes[active].scrollIntoView({ block: 'nearest' });
    }

    function esc(v) {
        return String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    }

    let debounce = null;
    input.addEventListener('input', () => {
        const q = input.value.trim();
        clearTimeout(debounce);
        if (!q) { render(defaultItems()); return; }
        const ql = q.toLowerCase();
        const local = PAGES.filter((p) => p.label.toLowerCase().includes(ql) || String(p.group || '').toLowerCase().includes(ql))
            .map((p) => ({ ...p, group: p.group || T.pages }));
        render(local);
        if (q.length < 2) return;
        const seq = ++reqSeq;
        debounce = setTimeout(async () => {
            try {
                const r = await fetch('/api/quick-search?q=' + encodeURIComponent(q), { headers: { Accept: 'application/json' } });
                if (!r.ok || seq !== reqSeq) return;           // ignore stale responses
                const d = await r.json();
                const remote = []
                    .concat((d.employees || []).map((e) => ({ group: T.people, label: e.name, sub: e.role, href: '/employees/' + e.id, icon: 'fas fa-user' })))
                    .concat((d.roles || []).map((x) => ({ group: T.roles, label: x.name, href: '/roles/' + x.id, icon: 'fas fa-user-tie' })))
                    .concat((d.skills || []).map((s) => ({ group: T.skills, label: s.name, href: '/domains-skills', icon: 'fas fa-layer-group' })));
                if (seq === reqSeq) render(local.concat(remote));
            } catch (_) { /* offline — local page matches still work */ }
        }, 180);
    });

    document.addEventListener('keydown', (e) => {
        // Ctrl/Cmd+K only: a bare « / » swallowed the key in every non-input
        // widget; the header carries a visible search button instead.
        if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) { e.preventDefault(); el.hidden ? open() : close(); return; }
        if (el.hidden) return;
        if (e.key === 'Escape') { e.preventDefault(); close(); }
        else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
        else if (e.key === 'Enter') {
            const node = list.querySelectorAll('.cmdk-item')[active];
            if (node) { e.preventDefault(); window.location.href = node.getAttribute('href'); }
        }
    });
    el.querySelector('[data-cmdk-close]').addEventListener('click', close);
    document.querySelectorAll('[data-cmdk-open]').forEach((b) => b.addEventListener('click', open));
})();
</script>
