<%#
  One chart drawn by public/js/viz.js.

    include('../partials/viz/chart', { vizChart: {
        id:         string, unique on the page (required)
        title:      the question the chart answers, with its scope
        subtitle:   the population and its coverage
        config:     the viz config (see the header of public/js/viz.js):
                    { kind, unit, decimals, labels, series:[{key,label,data,n,status}],
                      colorBy, bands, polarity, threshold:{value,label,kind}, min, max… }
                    — a null stays null (a gap, "Not measured"), never 0
        summary:    optional accessible summary (generated by viz.js when absent)
        table:      { head:[…], rows:[[…]] } optional pre-formatted data table,
                    rendered here so it works without JS; a null cell prints
                    "Not measured". Built by viz.js from `config` when absent.
        mobileList: [{label, value, display, n, status}] | false (keep the canvas on phones)
        footer:     { source, asOf, glossaryHref }
        height:     canvas height in px (default 280)
    } })

  The page loads /js/fmt.js, /js/chart-theme.js and /js/viz.js (and
  /vendor/chart.umd.min.js for the canvas: without it viz.js shows the sorted
  list) — views/partials/viz/scripts.ejs. The config travels in a JSON
  data block (script type application/json) escaped by partials/json-script
  (CSP-safe: no inline code). Locals read: `__`, `lang`, `fmtDate`.
-%><%
  var _c = (typeof vizChart !== 'undefined' && vizChart) ? vizChart : {};
  var _lang = (typeof lang !== 'undefined' && lang) ? lang : 'fr';
  var _id = String(_c.id || 'viz-chart');
  var _foot = _c.footer || {};
  var _i18n = {
      unmeasured: __('viz:unmeasured'),
      small_n: __('viz:small_n'),
      toggle_show: __('viz:chart.toggle_show'),
      toggle_hide: __('viz:chart.toggle_hide'),
      table_caption: __('viz:chart.table_caption', { title: '{{title}}' }),
      col_label: __('viz:chart.col_label'),
      col_n: __('viz:chart.col_n'),
      col_status: __('viz:chart.col_status'),
      list_label: __('viz:chart.list_label'),
      summary_items: __('viz:chart.summary_items', { count: '{{count}}' }),
      summary_lowest: __('viz:chart.summary_lowest', { label: '{{label}}', value: '{{value}}' }),
      summary_highest: __('viz:chart.summary_highest', { label: '{{label}}', value: '{{value}}' }),
      summary_unmeasured: __('viz:chart.summary_unmeasured', { count: '{{count}}' }),
      keyboard_hint: __('viz:chart.keyboard_hint'),
      threshold: __('viz:chart.threshold', { value: '{{value}}' }),
      target: __('viz:chart.target', { value: '{{value}}' }),
      status: {
          ready: __('viz:status.ready'), partial: __('viz:status.partial'), not_ready: __('viz:status.not_ready'),
          unassessed: __('viz:status.unassessed'), good: __('viz:status.good'), warn: __('viz:status.warn'),
          risk: __('viz:status.risk'), unmeasured: __('viz:status.unmeasured')
      }
  };
  var _payload = {
      config: _c.config || null,
      opts: {
          title: _c.title || '', subtitle: _c.subtitle || '', summary: _c.summary || null,
          height: _c.height || null, lang: _lang, i18n: _i18n
      }
  };
  if (_c.table) _payload.opts.table = _c.table;
  if (_c.mobileList !== undefined && _c.mobileList !== null) _payload.opts.mobileList = _c.mobileList;
  var _rows = (_c.table && Array.isArray(_c.table.rows)) ? _c.table.rows.length : ((_c.config && Array.isArray(_c.config.labels)) ? _c.config.labels.length : 0);
  var _asOf = (_foot.asOf && typeof fmtDate === 'function') ? fmtDate(_foot.asOf) : null;
-%>
<figure class="viz-chart" id="<%= _id %>" data-viz-chart<% if (_c.title) { %> aria-labelledby="<%= _id %>-title"<% } %>>
    <% if (_c.title || _c.subtitle) { -%>
    <figcaption class="viz-head">
        <div>
            <% if (_c.title) { %><h3 class="viz-title" id="<%= _id %>-title"><%= _c.title %></h3><% } %>
            <% if (_c.subtitle) { %><p class="viz-subtitle"><%= _c.subtitle %></p><% } %>
        </div>
    </figcaption>
    <% } -%>
    <div class="viz-canvas-wrap">
        <p class="viz-live viz-kbd-hint" id="<%= _id %>-hint"><%= _i18n.keyboard_hint %></p>
        <p class="viz-live" aria-live="polite"></p>
    </div>
    <ul class="viz-list" aria-label="<%= (_c.title ? _c.title + ' — ' : '') + _i18n.list_label %>"></ul>
    <details class="viz-data">
        <summary class="viz-data-toggle btn btn-sm btn-secondary"><span class="viz-data-label"><%= _i18n.toggle_show %></span><% if (_rows) { %><span class="viz-count" aria-hidden="true"><%= _rows %></span><% } %></summary>
        <div class="viz-table-wrap">
        <% if (_c.table && Array.isArray(_c.table.head) && Array.isArray(_c.table.rows)) { -%>
            <table class="viz-table">
                <% if (_c.title) { %><caption class="viz-live"><%= __('viz:chart.table_caption', { title: _c.title }) %></caption><% } %>
                <thead><tr><% _c.table.head.forEach(function (h, i) { %><th scope="col"<% if (i) { %> class="viz-num"<% } %>><%= h %></th><% }); %></tr></thead>
                <tbody>
                <% _c.table.rows.forEach(function (r) { -%>
                    <tr><% r.forEach(function (cell, i) { var un = cell === null || cell === undefined; if (i === 0) { %><th scope="row"><%= un ? '' : cell %></th><% } else { %><td class="viz-num<%= un ? ' viz-unmeasured-cell' : '' %>"><%= un ? _i18n.unmeasured : cell %></td><% } }); %></tr>
                <% }); -%>
                </tbody>
            </table>
        <% } -%>
        </div>
    </details>
    <script type="application/json" class="viz-config"><%- include('../json-script', { v: _payload }) %></script>
    <% if (_foot.source || _asOf || _foot.glossaryHref) { -%>
    <footer class="viz-footer">
        <% if (_foot.source) { %><span><%= __('viz:chart.source', { source: _foot.source }) %></span><% } %>
        <% if (_asOf) { %><span><%= __('viz:chart.as_of', { date: _asOf }) %></span><% } %>
        <% if (_foot.glossaryHref) { %><a href="<%= _foot.glossaryHref %>"><%= __('viz:chart.glossary') %></a><% } %>
    </footer>
    <% } -%>
</figure>
