<aside class="sidebar" id="appSidebar">
    <style>
    /* Long navigation labels must never be sliced mid-word. `.sidebar-link` is a
       flex row with `overflow:hidden`, but the label span was a rigid flex item
       with no min-width, so FR labels longer than the rail (e.g. "Plans de
       développement (PDI)", or a long white-label brand name) were cut off with
       no visual sign that text was missing. Letting the span shrink and clip with
       an ellipsis makes the truncation legible; every link already carries a
       `title=`, so the full label stays available on hover and to assistive tech. */
    .sidebar-link-text { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sidebar-logo-text { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    </style>
    <div class="sidebar-header">
        <a href="<%= user.userType === 'employee' ? '/employee/dashboard' : '/dashboard' %>" class="sidebar-logo">
            <% if (typeof branding !== 'undefined' && branding && branding.logoUrl) { %>
                <img src="<%= branding.logoUrl %>" alt="" class="sidebar-logo-img" style="height:28px;max-width:40px;object-fit:contain;border-radius:6px;">
            <% } else { %>
                <img src="/brand/idevelop-mark.svg" alt="" class="sidebar-logo-img sidebar-logo-mark" width="28" height="28">
            <% } %>
            <% const _brandName = (typeof branding !== 'undefined' && branding && branding.appName) ? branding.appName : 'IDevelop'; %>
            <span class="sidebar-logo-text" title="<%= _brandName %>"><%= _brandName %></span>
        </a>
        <button class="sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()" title="<%= __('chrome:sidebar_toggle_title') %>"
            aria-label="<%= __('chrome:sidebar_toggle_aria') %>">
            <i class="fas fa-bars" aria-hidden="true"></i>
        </button>
    </div>

    <%#
        3.23.18 (UX-03 / UX-17 / UX-05) — the rail is cut BY TASK, one entry per notion.

        An employee used to meet twelve links under "Mon espace" (four of them
        near-synonyms: statut / progression / évolution / développement), a manager
        about forty-five in seven groups, a SuperAdmin fifty-six. The rail now shows
        a handful of TASK entries; each entry either opens its main page and carries
        its related pages in a sub-list, or is a HUB (a disclosure button) whose
        sub-list holds the pages of one notion — e.g. the five "review" pages now
        live under ONE « Revues & contestations » entry.

        Gating is unchanged, link by link: every flag below is the EXACT condition
        the link carried before this cut (section gate AND link gate), read through
        `can()` for admins (src/config/permissions.js `implies`), never a
        hand-written role list. A hub is rendered only when at least one of its
        pages is. Nothing a person could not open before becomes visible; nothing
        they could open disappears (tests/unit/c317-u-navigation-sidebar.test.js).
    %>
    <% const _ut = user.userType;
       const _isEmp = _ut === 'employee', _isMgr = _ut === 'manager', _isAdm = _ut === 'admin';
       const _sa = user.role === 'superadmin';
       const _can = (s) => (typeof can === 'function') && can(s);
       const _ws = (k) => typeof wsVisible !== 'function' || wsVisible(k);
       const _v2 = typeof v2Features !== 'undefined' && !!v2Features;
       const _lc = typeof featureLocalContent !== 'undefined' && !!featureLocalContent;
       const _cp = (typeof currentPath !== 'undefined' && currentPath) ? String(currentPath) : '';
       const _at = (p) => _cp.startsWith(p);
       const _on = (b) => (b ? 'active' : '');

       // Section gates, exactly as the old sections declared them.
       const gMain = !_isEmp && _ws('nav:main');
       const gMainDash = gMain && (['admin', 'manager', 'superadmin'].includes(_ut) || user.role === 'superadmin' || user.role === 'localadmin');
       const gPeople = gMain && (_isMgr || (_isAdm && _can('view_employees')));
       const gMine = _isEmp || _isMgr;
       const gTeam = (_isMgr || _isAdm) && _ws('nav:team');
       const gTalent = (_isMgr || _isAdm) && _ws('nav:talent');
       const gTools = (_isAdm || _isMgr) && _ws('nav:tools');
       const canCont = _isMgr || _can('view_continuity') || _can('manage_succession') || _can('view_retention_risk') || _can('manage_handover');
       const canLms = _isMgr || _can('configure_lms');
       // Route → capability, exactly as src/routes/index.js declares it.
       const navComptes   = _can('view_employees') || _can('manage_invitations') || _can('manage_admins') || _sa;
       const navCampagnes = _can('manage_cycles') || _sa;
       const navDonnees   = _can('export_data') || _can('import_data') || _can('view_system_logs') || _sa;
       const navReglages  = _can('manage_organization') || _can('view_domains_skills') || _can('view_roles') || _can('view_app_settings') || _sa;
       const gAdmComptes = _isAdm && navComptes && _ws('nav:administration');
       const gAdmCamp    = _isAdm && navCampagnes && _ws('nav:administration');
       const gAdmData    = _isAdm && navDonnees && _ws('nav:administration');
       const gAdmSet     = _isAdm && navReglages && _ws('nav:configuration');

       // One flag per destination.
       const S = {
           dashboard: gMainDash, benchmark: gMainDash, siteExposure: gMainDash, boardPack: gMainDash,
           employees: gPeople, skillMatrix: gPeople,
           mine: gMine,
           acrMine: _isEmp,                      // an employee reads it under « Mes évaluations »
           acrHub: _isMgr || gAdmCamp,           // a manager / admin decides it under « Revues & contestations »
           account: _isEmp,
           saReviews: gTeam, supDash: gTeam && _isMgr, gap: gTeam, coaching: gTeam,
           idpManage: gTeam && _v2, pip: gTeam && _v2, disputes: gTeam && _v2,
           nineBox: gTalent, talentActions: gTalent, careerPath: gTalent, orgChart: gTalent,
           lifecycle: gTalent && _v2,
           continuity: gTalent && _v2 && canCont, keyPerson: gTalent && _v2 && canCont,
           lms: gTalent && _v2 && canLms && _can('configure_lms'),
           cap: gTalent && _v2 && canLms,
           accounts: gAdmComptes && _can('manage_invitations'),
           onboarding: gAdmComptes && _can('manage_onboarding'),
           admins: gAdmComptes && _can('manage_admins'), delegation: gAdmComptes && _can('manage_admins'),
           accessReview: gAdmComptes && _sa, ssoMigration: gAdmComptes && _sa, sessions: gAdmComptes && _sa,
           makerChecker: gAdmCamp && _v2 && _sa,
           cycles: gAdmCamp && _can('manage_cycles'),
           cancellations: gAdmCamp || (gTools && _isMgr),
           postApproval: gAdmCamp || (gTools && _isMgr),
           dataMgmt: gAdmData && (_can('export_data') || _can('import_data')),
           sqlConsole: gAdmData && _sa,
           sysLogs: gAdmData && _can('view_system_logs'),
           adminNotif: gAdmData && _sa,
           organization: gAdmSet && _can('manage_organization'),
           domainsSkills: gAdmSet && _can('view_domains_skills'),
           roles: gAdmSet && _can('view_roles'),
           appSettings: gAdmSet && _can('view_app_settings'),
           sso: gAdmSet && _sa, apiKeys: gAdmSet && _sa, health: gAdmSet && _sa,
           license: gAdmSet && _sa, maintenance: gAdmSet && _sa, setup: gAdmSet && _sa,
           reports: gTools, deptAnalytics: gTools, localContent: gTools && _lc,
           compliance: gTools && (_isMgr || _can('view_compliance')),
           qualified: gTools, movements: gTools,
           // 3.23.18: safety clearances — admins holding a compliance grant, and SuperAdmins.
           safetyGate: gTools && _isAdm && (_can('view_compliance') || _can('manage_compliance') || _sa),
           notifStandalone: !gMine,              // employees/managers reach it under « À faire »
       };
       // Active-page tests (same expressions as before).
       const A = {
           dashboard: _at('/dashboard'), benchmark: _at('/benchmark'),
           siteExposure: _at('/exec/site-exposure'), boardPack: _at('/exec/board-pack'),
           employees: _at('/employees'), skillMatrix: _at('/skill-matrix'),
           home: _at('/employee/dashboard'), sa: _at('/employee/self-assessment'),
           status: _at('/employee/assessment-status'),
           myReviews: _at('/employee/supervisor-reviews') || _at('/employee/reviews'),
           acr: _at('/assessment-changes'), progress: _at('/employee/my-progress'),
           okr: _at('/employee/okr'), myCoaching: _at('/employee/my-coaching'),
           certs: _at('/employee/my-certifications'), growth: _at('/employee/opportunities'),
           learning: _at('/employee/my-learning'),
           myDev: _at('/employee/my-development') || (_at('/v2/idp') && !_at('/v2/idp/manage') && !_at('/v2/idp/new')),
           account: _cp === '/account',
           saReviews: _at('/supervisor/self-assessment-reviews'),
           supDash: _at('/supervisor/dashboard') || _at('/supervisor/reviews'),
           gap: _at('/supervisor/gap-analysis'), coaching: _at('/coaching'),
           idpManage: _at('/v2/idp/manage') || _at('/v2/idp/new'), pip: _at('/v2/pip'),
           disputes: _at('/v2/slf/disputes'),
           nineBox: _at('/talent/nine-box'), talentActions: _at('/talent/actions'),
           careerPath: _at('/talent/career-path'), orgChart: _at('/org-chart'),
           lifecycle: _at('/v2/lifecycle'), continuity: _at('/v2/continuity'),
           keyPerson: _at('/exec/key-person'), lms: _at('/v2/lms'), cap: _at('/v2/cap'),
           accounts: _at('/admin/accounts') || _at('/admin/invitations'),
           onboarding: _at('/onboarding'), admins: _at('/admins'), delegation: _at('/admin/delegation'),
           accessReview: _at('/admin/access-review'), ssoMigration: _at('/admin/sso-migration'),
           sessions: _at('/admin/sessions'), makerChecker: _at('/v2/uam/maker-checker'),
           cycles: _cp === '/cycles' || /^\/cycles\/\d+/.test(_cp),
           cancellations: _at('/cancellations'), postApproval: _at('/reviews/post-approval'),
           dataMgmt: _cp === '/data-management', sqlConsole: _at('/data-management/sql-console'),
           sysLogs: _at('/system-logs'), adminNotif: _at('/admin/notifications'),
           organization: _at('/organization'),
           domainsSkills: _at('/domains') || _at('/skills') || _at('/domains-skills'),
           roles: _at('/roles'), appSettings: _cp === '/app-settings', sso: _at('/app-settings/sso'),
           apiKeys: _at('/admin/api-keys'), health: _at('/admin/health'), license: _at('/admin/license'),
           maintenance: _at('/admin/maintenance'), setup: _at('/setup'),
           reports: _at('/reports') && !_at('/reports/local-content') && !_at('/reports/dept-analytics'),
           deptAnalytics: _at('/reports/dept-analytics'), localContent: _at('/reports/local-content'),
           compliance: _at('/compliance'), qualified: _at('/qualified'), movements: _at('/movements'),
           safetyGate: _at('/safety-gate'),
           guide: _at('/guide'), notifications: _at('/notifications'), about: _at('/about'),
       };
       const _any = (...ks) => ks.some((k) => S[k]);
       const _open = (pairs) => pairs.some(([s, a]) => S[s] && A[a]);
       const _tg = (name) => __('chrome:nav_sub_toggle_aria', { name: name }); %>

    <nav class="sidebar-nav" role="navigation" aria-label="<%= __('chrome:nav_main_aria') %>">

        <%# ── Premiers pas (SuperAdmin, until the required steps are done) ──── %>
        <% if (typeof setupProgress !== 'undefined' && setupProgress && S.setup) { %>
        <a href="/setup" class="sidebar-link hz-setup-link <%= _on(A.setup) %>" title="<%= __('chrome:nav_setup_title') %>">
            <i class="fas fa-flag-checkered" aria-hidden="true"></i>
            <span class="sidebar-link-text"><%= __('chrome:nav_setup') %></span>
            <span class="hz-pill" aria-label="<%= __('chrome:nav_setup_progress_aria', { done: setupProgress.done, total: setupProgress.total }) %>"><%= setupProgress.done %>/<%= setupProgress.total %></span>
        </a>
        <% } %>

        <%# ── Mon équipe ─────────────────────────────────────────────────────── %>
        <% if (_any('employees', 'skillMatrix', 'supDash', 'gap', 'orgChart')) { %>
        <div class="sidebar-section" data-section-key="section_my_team">
            <button type="button" class="sidebar-section-label" aria-expanded="true"><%= __('chrome:section_my_team') %><i class="fas fa-chevron-down sidebar-section-chevron" aria-hidden="true"></i></button>
            <% if (S.supDash) { %>
            <a href="/supervisor/dashboard" class="sidebar-link <%= _on(A.supDash) %>" title="<%= __('chrome:nav_my_team') %>">
                <i class="fas fa-users" aria-hidden="true"></i>
                <span class="sidebar-link-text"><%= __('chrome:nav_my_team') %></span>
            </a>
            <% } %>
            <% if (S.employees) { const _o = A.skillMatrix; %>
            <div class="sidebar-entry<%= _o ? ' is-open' : '' %>" data-entry-key="people">
                <div class="sidebar-entry-row">
                    <%# an ADMIN only sees these when they hold `view_employees`;
                        a manager reaches both through their span. %>
                    <a href="/employees" class="sidebar-link <%= _on(A.employees) %>" title="<%= __('chrome:nav_employees_title') %>">
                        <i class="fas fa-address-book" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_employees') %></span>
                    </a>
                    <button type="button" class="sidebar-entry-toggle" aria-expanded="<%= _o ? 'true' : 'false' %>" aria-controls="sbsub-people" aria-label="<%= _tg(__('chrome:nav_employees')) %>"><i class="fas fa-chevron-down" aria-hidden="true"></i></button>
                </div>
                <div class="sidebar-sub" id="sbsub-people" role="group" aria-label="<%= __('chrome:nav_employees') %>">
                    <a href="/skill-matrix" class="sidebar-link sidebar-sublink <%= _on(A.skillMatrix) %>" title="<%= __('chrome:nav_skill_matrix') %>">
                        <i class="fas fa-border-all" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_skill_matrix') %></span>
                    </a>
                </div>
            </div>
            <% } %>
            <% if (S.gap) { %>
            <a href="/supervisor/gap-analysis" class="sidebar-link <%= _on(A.gap) %>" title="<%= __('chrome:nav_gap_analysis_title') %>">
                <i class="fas fa-chart-bar" aria-hidden="true"></i>
                <span class="sidebar-link-text"><%= __('chrome:nav_gap_analysis') %></span>
            </a>
            <% } %>
            <% if (S.orgChart) { %>
            <a href="/org-chart" class="sidebar-link <%= _on(A.orgChart) %>" title="<%= __('chrome:nav_org_chart_title') %>">
                <i class="fas fa-sitemap" aria-hidden="true"></i>
                <span class="sidebar-link-text"><%= __('chrome:nav_org_chart') %></span>
            </a>
            <% } %>
        </div>
        <% } %>

        <%# ── Campagnes & revues ─────────────────────────────────────────────── %>
        <% if (_any('cycles', 'saReviews', 'acrHub', 'postApproval', 'disputes', 'compliance', 'safetyGate', 'qualified', 'movements')) { %>
        <div class="sidebar-section" data-section-key="section_campaigns_reviews">
            <button type="button" class="sidebar-section-label" aria-expanded="true"><%= __('chrome:section_campaigns_reviews') %><i class="fas fa-chevron-down sidebar-section-chevron" aria-hidden="true"></i></button>
            <% if (S.cycles) { %>
            <%# Campaign console: the live completion funnel per cycle. %>
            <a href="/cycles" class="sidebar-link <%= _on(A.cycles) %>" title="<%= __('admin:cyc_nav_console') %>">
                <i class="fas fa-calendar-check" aria-hidden="true"></i>
                <span class="sidebar-link-text"><%= __('chrome:section_campaigns') %></span>
            </a>
            <% } %>
            <% if (_any('saReviews', 'acrHub', 'postApproval', 'disputes')) {
                const _o = _open([['saReviews', 'saReviews'], ['acrHub', 'acr'], ['postApproval', 'postApproval'], ['disputes', 'disputes']]); %>
            <%# ONE entry for the review notions a decider works with: the review
                queue, change requests, post-approval revisions and disputes. The
                person's OWN reviews stay under « Mes évaluations ». %>
            <div class="sidebar-entry sidebar-hub<%= _o ? ' is-open' : '' %>" data-entry-key="reviews">
                <button type="button" class="sidebar-link sidebar-hub-toggle" aria-expanded="<%= _o ? 'true' : 'false' %>" aria-controls="sbsub-reviews" title="<%= __('chrome:nav_reviews_hub_title') %>">
                    <i class="fas fa-scale-balanced" aria-hidden="true"></i>
                    <span class="sidebar-link-text"><%= __('chrome:nav_reviews_hub') %></span>
                    <i class="fas fa-chevron-down sidebar-hub-chevron" aria-hidden="true"></i>
                </button>
                <div class="sidebar-sub" id="sbsub-reviews" role="group" aria-label="<%= __('chrome:nav_reviews_hub') %>">
                    <% if (S.saReviews) { %>
                    <a href="/supervisor/self-assessment-reviews" class="sidebar-link sidebar-sublink <%= _on(A.saReviews) %>" title="<%= __('chrome:nav_sa_reviews_title') %>">
                        <i class="fas fa-inbox" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_sa_reviews') %></span>
                    </a>
                    <% } %>
                    <% if (S.acrHub) { %>
                    <%# The change request: ONE page serves the requester and the
                        decider, so ONE entry. %>
                    <a href="/assessment-changes" class="sidebar-link sidebar-sublink <%= _on(A.acr) %>" title="<%= __('chrome:nav_acr_title') %>">
                        <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_acr') %></span>
                    </a>
                    <% } %>
                    <% if (S.postApproval) { %>
                    <a href="/reviews/post-approval" class="sidebar-link sidebar-sublink <%= _on(A.postApproval) %>" title="<%= __('chrome:nav_post_reviews_title') %>">
                        <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_post_reviews') %></span>
                    </a>
                    <% } %>
                    <% if (S.disputes) { %>
                    <a href="/v2/slf/disputes" class="sidebar-link sidebar-sublink <%= _on(A.disputes) %>" title="<%= __('chrome:nav_disputes_title') %>">
                        <i class="fas fa-gavel" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_disputes') %></span>
                    </a>
                    <% } %>
                </div>
            </div>
            <% } %>
            <% if (_any('compliance', 'safetyGate', 'qualified', 'movements')) {
                const _o = _open([['compliance', 'compliance'], ['safetyGate', 'safetyGate'], ['qualified', 'qualified'], ['movements', 'movements']]); %>
            <%# Operational assurance: the day-to-day checks and the audit trail. %>
            <div class="sidebar-entry sidebar-hub<%= _o ? ' is-open' : '' %>" data-entry-key="assurance">
                <button type="button" class="sidebar-link sidebar-hub-toggle" aria-expanded="<%= _o ? 'true' : 'false' %>" aria-controls="sbsub-assurance" title="<%= __('chrome:section_assurance') %>">
                    <i class="fas fa-list-ul" aria-hidden="true"></i>
                    <span class="sidebar-link-text"><%= __('chrome:section_assurance') %></span>
                    <i class="fas fa-chevron-down sidebar-hub-chevron" aria-hidden="true"></i>
                </button>
                <div class="sidebar-sub" id="sbsub-assurance" role="group" aria-label="<%= __('chrome:section_assurance') %>">
                    <% if (S.compliance) { %>
                    <a href="/compliance" class="sidebar-link sidebar-sublink <%= _on(A.compliance) %>" title="<%= __('chrome:nav_compliance_title') %>">
                        <i class="fas fa-file-shield" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_compliance') %></span>
                    </a>
                    <% } %>
                    <% if (S.safetyGate) { %>
                    <a href="/safety-gate" class="sidebar-link sidebar-sublink <%= _on(A.safetyGate) %>" title="<%= __('chrome:nav_safety_gate_title') %>">
                        <i class="fas fa-helmet-safety" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_safety_gate') %></span>
                    </a>
                    <% } %>
                    <% if (S.qualified) { %>
                    <a href="/qualified" class="sidebar-link sidebar-sublink <%= _on(A.qualified) %>" title="<%= __('chrome:nav_qualified_title') %>">
                        <i class="fas fa-user-check" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_qualified') %></span>
                    </a>
                    <% } %>
                    <% if (S.movements) { %>
                    <a href="/movements" class="sidebar-link sidebar-sublink <%= _on(A.movements) %>" title="<%= __('chrome:nav_movements_title') %>">
                        <i class="fas fa-right-left" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_movements') %></span>
                    </a>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>
        <% } %>

        <%# ── Talents (folded by default) ────────────────────────────────────── %>
        <% if (_any('nineBox', 'talentActions', 'careerPath', 'coaching', 'idpManage', 'pip', 'cancellations', 'continuity', 'keyPerson', 'lifecycle', 'cap', 'lms')) { %>
        <div class="sidebar-section" data-section-key="section_talent">
            <button type="button" class="sidebar-section-label" aria-expanded="true"><%= __('chrome:section_talent') %><i class="fas fa-chevron-down sidebar-section-chevron" aria-hidden="true"></i></button>
            <% if (S.nineBox) { const _o = A.talentActions || A.careerPath; %>
            <div class="sidebar-entry<%= _o ? ' is-open' : '' %>" data-entry-key="ninebox">
                <div class="sidebar-entry-row">
                    <a href="/talent/nine-box" class="sidebar-link <%= _on(A.nineBox) %>" title="<%= __('chrome:nav_nine_box_title') %>">
                        <i class="fas fa-table-cells-large" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_nine_box') %></span>
                    </a>
                    <button type="button" class="sidebar-entry-toggle" aria-expanded="<%= _o ? 'true' : 'false' %>" aria-controls="sbsub-ninebox" aria-label="<%= _tg(__('chrome:nav_nine_box')) %>"><i class="fas fa-chevron-down" aria-hidden="true"></i></button>
                </div>
                <div class="sidebar-sub" id="sbsub-ninebox" role="group" aria-label="<%= __('chrome:nav_nine_box') %>">
                    <a href="/talent/actions" class="sidebar-link sidebar-sublink <%= _on(A.talentActions) %>" title="<%= __('chrome:nav_talent_actions_title') %>">
                        <i class="fas fa-clipboard-list" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_talent_actions') %></span>
                    </a>
                    <a href="/talent/career-path" class="sidebar-link sidebar-sublink <%= _on(A.careerPath) %>" title="<%= __('chrome:nav_career_path_title') %>">
                        <i class="fas fa-route" aria-hidden="true"></i>
                        <span class="sidebar-link-text"><%= __('chrome:nav_career_path') %></span>
                    </a>
                </div>
            </div>
            <% } %>
            <% if (_any('coaching', 'idpManage', 'pip', 'cancellations')) {
                const _o = _open([['coaching', 'coaching'], ['idpManage', 'idpManage'], ['pip', 'pip'], ['cancellations', 'cancellations']]); %>
            <div class="sidebar-entry sidebar-hub<%= _o ? ' is-open' : '' %>" data-entry-key="plans">
                <button type="button" class="sidebar-link sidebar-hub-toggle" aria-expanded="<%= _o ? 'true' : 'false' %>" aria-controls="sbsub-plans" title="<%= __('chrome:nav_plans_hub_title') %>">
                    <i class="fas fa-hand-holding-heart" aria-hidden="true"></i>
                    <span class="sidebar-link-text"><%= __('chrome:nav_plans_hub') %></span>
                    <i class="fas fa-chevron-down sidebar-hub-chevron" aria-hidden="true"></i>
                </button>
                <div class="sidebar-sub" id="sbsub-plans" role="group" aria-label="<%= __('chrome:nav_plans_hub') %>">
                    <% if (S.coaching) { %>
