<%#
    The rail is RENDERED from src/config/navigation.js (app.locals.navConfig), the
    one navigation config that also feeds the breadcrumbs, the quick-search palette,
    the account menu and the help titles. This template holds no gate and no label
    of its own: every destination, its name, its icon and its visibility predicate
    (permission, workspace component, optional module) live in the config.
    « Tableau de bord » is always the first entry and leads to the person's home.

    The rail is a <div role="complementary">: on a phone the drawer becomes a modal
    dialog (public/js/nav-rail.js swaps the role), and role="dialog" is not allowed
    on an <aside>.
%>
<% const _N = (typeof navConfig !== 'undefined' && navConfig) ? navConfig : null;
   const _nav = _N ? _N.buildNav(locals) : { tree: [], storageKey: 'sidebarNav.v3', legacyStorageKeys: [] };
   const _home = _N ? _N.homeUrl(user) : (user.userType === 'employee' ? '/employee/dashboard' : '/dashboard');
   const _t = (k) => __(String(k).indexOf(':') === -1 ? 'chrome:' + k : k);
   const _tg = (name) => __('chrome:nav_sub_toggle_aria', { name: name });
   const _gloss = {};
   if (_N) { _N.glossaryMap(locals).forEach(function (k, p) { _gloss[p] = _t(k); }); }
   const _setupShown = typeof setupProgress !== 'undefined' && setupProgress && _N && _N.gates(_N.buildContext(locals)).setup; %>
<div class="sidebar" id="appSidebar" role="complementary" aria-label="<%= __('chrome:nav_drawer_aria') %>">
    <div class="sidebar-header">
        <a href="<%= _home %>" class="sidebar-logo">
            <% if (typeof branding !== 'undefined' && branding && branding.logoUrl) { %>
                <img src="<%= branding.logoUrl %>" alt="" class="sidebar-logo-img" style="height:28px;max-width:40px;object-fit:contain;border-radius:6px;">
            <% } else { %>
                <img src="/brand/idevelop-mark.svg" alt="" class="sidebar-logo-img sidebar-logo-mark" width="28" height="28">
            <% } %>
            <% const _brandName = (typeof branding !== 'undefined' && branding && branding.appName) ? branding.appName : 'IDevelop'; %>
            <span class="sidebar-logo-text" title="<%= _brandName %>"><%= _brandName %></span>
        </a>
        <button type="button" class="sidebar-toggle" id="sidebarToggle" data-on-click="toggleSidebar" title="<%= __('chrome:sidebar_toggle_title') %>"
            aria-label="<%= __('chrome:sidebar_toggle_aria') %>">
            <i class="fas fa-bars" aria-hidden="true"></i>
        </button>
    </div>

    <% function _link(n, sub) { %>
        <a href="<%= n.href %>" class="sidebar-link<%= sub ? ' sidebar-sublink' : '' %><%= n.active ? ' active' : '' %>"<% if (n.active) { %> aria-current="<%= n.current %>"<% } %> title="<%= _t(n.titleKey) %>" data-nav-id="<%= n.id %>">
            <i class="fas <%= n.icon %>" aria-hidden="true"></i>
            <span class="sidebar-link-text"><%= _t(n.labelKey) %></span>
            <% if (n.id === 'tasks') { %><span class="sidebar-badge" data-nav-badge="tasks" hidden></span><% } %>
        </a>
    <% } %>
    <% function _entry(n, sub) {
        if (!n.children.length) { _link(n, sub); return; }
        const _o = !!n.open; %>
        <div class="sidebar-entry<%= n.hub ? ' sidebar-hub' : '' %><%= _o ? ' is-open' : '' %>" data-entry-key="<%= n.id %>">
            <% if (n.hub) { %>
            <button type="button" class="sidebar-link sidebar-hub-toggle" aria-expanded="<%= _o ? 'true' : 'false' %>" aria-controls="sbsub-<%= n.id %>" title="<%= _t(n.titleKey) %>">
                <i class="fas <%= n.icon %>" aria-hidden="true"></i>
                <span class="sidebar-link-text"><%= _t(n.labelKey) %></span>
                <i class="fas fa-chevron-down sidebar-hub-chevron" aria-hidden="true"></i>
            </button>
            <% } else { %>
            <div class="sidebar-entry-row">
                <% _link(n, sub); %>
                <button type="button" class="sidebar-entry-toggle" aria-expanded="<%= _o ? 'true' : 'false' %>" aria-controls="sbsub-<%= n.id %>" aria-label="<%= _tg(_t(n.labelKey)) %>"><i class="fas fa-chevron-down" aria-hidden="true"></i></button>
            </div>
            <% } %>
            <div class="sidebar-sub" id="sbsub-<%= n.id %>" role="group" aria-label="<%= _t(n.labelKey) %>">
                <% n.children.forEach(function (k) { _entry(k, true); }); %>
            </div>
        </div>
    <% } %>

    <nav class="sidebar-nav" aria-label="<%= __('chrome:nav_main_aria') %>"
         data-nav-storage="<%= _nav.storageKey %>" data-nav-legacy="<%= (_nav.legacyStorageKeys || []).join(',') %>"
         data-nav-owner="<%= _N ? _N.ownerTag(user) : '' %>">
        <% _nav.tree.forEach(function (top, _i) { %>
            <% if (_i === 1) { %>
            <%# « Premiers pas » (SuperAdmin, until the required steps are done), right after « Tableau de bord ». %>
            <% if (_setupShown) { %>
            <a href="/setup" class="sidebar-link hz-setup-link" title="<%= __('chrome:nav_setup_title') %>" data-nav-id="setup_pill">
                <i class="fas fa-flag-checkered" aria-hidden="true"></i>
                <span class="sidebar-link-text"><%= __('chrome:nav_setup') %></span>
                <span class="hz-pill" aria-label="<%= __('chrome:nav_setup_progress_aria', { done: setupProgress.done, total: setupProgress.total }) %>"><%= setupProgress.done %>/<%= setupProgress.total %></span>
            </a>
            <% } %>
            <% } %>
            <% if (top.type === 'section') { %>
            <div class="sidebar-section<%= top.hasCurrent ? ' has-current' : '' %>" data-section-key="<%= top.key %>" data-closed-default="<%= top.closedByDefault ? '1' : '0' %>">
                <button type="button" class="sidebar-section-label" id="sbsec-<%= top.key %>-label" aria-expanded="true" aria-controls="sbsec-<%= top.key %>"><%= _t(top.labelKey) %><i class="fas fa-chevron-down sidebar-section-chevron" aria-hidden="true"></i></button>
                <div class="sidebar-section-items" id="sbsec-<%= top.key %>" role="group" aria-labelledby="sbsec-<%= top.key %>-label">
                    <% top.items.forEach(function (n) { _entry(n, false); }); %>
                </div>
            </div>
            <% } else { _entry(top, false); } %>
        <% }); %>
    </nav>

    <%# Glossary map path → canonical name, in the session language: the help panel
        titles read it (public/js/help.js), so the rail, the page and its help agree. %>
    <script type="application/json" id="navGlossary"><%- include('./json-script', { v: _gloss }) %></script>

    <script nonce="<%= cspNonce %>">
    (function () {
        'use strict';
        // Collapsible groups and entry sub-lists. In order of authority:
        //   1. the group / entry holding the current page is ALWAYS open;
        //   2. otherwise the person's remembered choice;
        //   3. otherwise the default the server rendered (data-closed-default).
        // State is keyed on the STABLE data-section-key / data-entry-key, never on
        // the translated label, and it belongs to ONE signed-in person: another
        // person on the same (shared) computer starts from the defaults.
        var nav = document.querySelector('#appSidebar .sidebar-nav');
        if (!nav) return;
        nav.classList.add('js-nav');
        var KEY = nav.getAttribute('data-nav-storage') || 'sidebarNav.v3';
        var OWNER = nav.getAttribute('data-nav-owner') || '';
        var legacy = (nav.getAttribute('data-nav-legacy') || '').split(',');

        var saved = {};
        try {
            legacy.forEach(function (k) { if (k) localStorage.removeItem(k); });
            saved = JSON.parse(localStorage.getItem(KEY) || '{}') || {};
        } catch (e) { saved = {}; }
        if (saved.__o !== OWNER) saved = { __o: OWNER };
        function save() { try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) { /* private mode */ } }
        var has = function (k) { return Object.prototype.hasOwnProperty.call(saved, k); };

        Array.prototype.forEach.call(nav.querySelectorAll('.sidebar-section'), function (sec, i) {
            var btn = sec.querySelector('.sidebar-section-label');
            if (!btn) return;
            var key = sec.getAttribute('data-section-key') || ('idx' + i);
            var id = 's:' + key;
            var holdsCurrent = !!sec.querySelector('.sidebar-link.active');
            if (holdsCurrent) sec.classList.add('has-current');
            var open;
            if (holdsCurrent) open = true;
            else if (has(id)) open = !!saved[id];
            else open = sec.getAttribute('data-closed-default') !== '1';
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            btn.addEventListener('click', function () {
                var nowOpen = btn.getAttribute('aria-expanded') !== 'true';
                btn.setAttribute('aria-expanded', nowOpen ? 'true' : 'false');
                // Once the person takes control of a group, the has-current
                // override must not undo their choice.
                if (!nowOpen) sec.classList.remove('has-current');
                saved[id] = nowOpen;
                save();
            });
        });

        Array.prototype.forEach.call(nav.querySelectorAll('.sidebar-entry'), function (entry) {
            var toggle = entry.querySelector('.sidebar-entry-toggle, .sidebar-hub-toggle');
            if (!toggle) return;
            var id = 'e:' + (entry.getAttribute('data-entry-key') || '');
            var holdsCurrent = !!entry.querySelector('.sidebar-sub .sidebar-link.active');
            var open = holdsCurrent || (has(id) ? !!saved[id] : entry.classList.contains('is-open'));
            function paint(o) {
                entry.classList.toggle('is-open', o);
                toggle.setAttribute('aria-expanded', o ? 'true' : 'false');
            }
            paint(open);
            toggle.addEventListener('click', function () {
                var nowOpen = !entry.classList.contains('is-open');
                // On the folded icon rail a sub-list has no room: unfold the rail first.
                if (nowOpen && document.body.classList.contains('sidebar-collapsed') && typeof window.toggleSidebar === 'function') {
                    window.toggleSidebar();
                }
                paint(nowOpen);
                saved[id] = nowOpen;
                save();
            });
        });
    })();
    </script>
    <script src="/js/nav-rail.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" defer></script>

    <%# Sidebar footer: WHO is signed in. It opens the person's profile; the ONE
        account menu (password, sessions, 2FA, language, sign-out) lives in the
        top bar, with the same entries on every page. %>
    <div class="sidebar-footer">
        <a href="/account" class="sidebar-user" title="<%= __('chrome:menu_my_profile') %>" aria-label="<%= __('chrome:sidebar_user_profile_aria', { name: user.username || user.employeeNumber || '' }) %>">
            <span class="sidebar-user-avatar" aria-hidden="true">
                <%= (user.username || user.employeeNumber || 'U' ).charAt(0).toUpperCase() %>
            </span>
            <span class="sidebar-user-info">
                <span class="sidebar-user-name">
                    <%= user.username || user.employeeNumber || 'User' %>
                </span>
                <span class="sidebar-user-role">
                    <%= user.userType==='employee' ? __('chrome:role_employee') : (user.userType==='manager' ? __('chrome:role_manager') :
                        (user.role==='superadmin' ? __('chrome:role_superadmin') : (user.role==='localadmin' ? __('chrome:role_localadmin') : __('chrome:role_user')
                        ))) %>
                </span>
            </span>
            <i class="fas fa-angle-right sidebar-user-more" aria-hidden="true"></i>
        </a>
    </div>
</div>
<div class="nav-backdrop" id="navBackdrop" aria-hidden="true"></div>
