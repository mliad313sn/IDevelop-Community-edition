<script nonce="<%= cspNonce %>">
(function(){
  var EMP=<%= employee.id %>;
  var COLOR={skill:'#2563eb',ninebox:'#7c3aed',coaching:'#0ea5a4',idp:'#15803d',pip:'#e6921e'};
  var KLBL={skill:<%- JSON.stringify(__('admin:skill')) %>,ninebox:'9-Box',coaching:'Coaching',idp:'IDP',pip:'PIP'};
  var all=[]; var filter='all';
  function e(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
  function render(){
    var feed=document.getElementById('tl-feed');
    var rows=all.filter(function(x){return filter==='all'||x.kind===filter;});
    if(!rows.length){ feed.innerHTML='<div class="text-muted" style="padding:.5rem">'+<%- JSON.stringify(__('admin:no_events_filter')) %>+'</div>'; return; }
    feed.innerHTML=rows.map(function(x){
      var c=COLOR[x.kind]||'#64748b';
      return '<div class="tl-feed-item"><span class="tl-dot" style="background:'+c+'"></span>'+
        '<div style="flex:1"><div class="tl-txt"><span class="tl-k" style="color:'+c+'">'+(KLBL[x.kind]||x.kind)+'</span>'+e(x.text)+'</div>'+
        '<div class="tl-when">'+FMT.dateTime(x.at)+'</div></div></div>';
    }).join('');
  }
  document.querySelectorAll('#tl-filters .tl-chip').forEach(function(b){
    b.addEventListener('click',function(){ filter=b.dataset.k; document.querySelectorAll('#tl-filters .tl-chip').forEach(function(x){x.classList.toggle('on',x===b);}); render(); });
  });
  fetch('/employees/'+EMP+'/timeline',{headers:{Accept:'application/json'}})
    .then(function(r){ return r.ok?r.json():{timeline:[]}; })
    .then(function(j){ all=j.timeline||[]; render(); }).catch(function(){});
})();
</script>

