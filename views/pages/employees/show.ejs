<style>
.dev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.dev-card{border:1px solid var(--line,#e2e8f0);border-radius:12px;background:var(--card,#fff);overflow:hidden}
.dev-h{font-weight:700;padding:10px 14px;border-bottom:1px solid var(--line,#eef2f7);font-size:.92rem}
.dev-body{padding:6px 12px 10px;max-height:300px;overflow:auto}
.dev-item{padding:9px 2px;border-bottom:1px solid #f4f6fb;font-size:.84rem}
.dev-item:last-child{border-bottom:0}
.dev-item .dev-t{font-weight:600;color:var(--ink,#0f172a)}
.dev-sub{color:#94a3b8;font-size:.76rem;margin-top:2px}
.dev-badge{padding:1px 8px;border-radius:999px;color:#fff;font-size:.72rem;text-transform:capitalize}
.dev-badge[data-s="active"]{background:#15803d}.dev-badge[data-s="proposed"],.dev-badge[data-s="draft"]{background:#b45309}
.dev-badge[data-s="closed"],.dev-badge[data-s="completed"]{background:#475569}.dev-badge[data-s="cancelled"],.dev-badge[data-s="rejected"]{background:#b91c1c}
.dev-bar{height:7px;background:#e2e8f0;border-radius:999px;overflow:hidden;margin-top:5px}
.dev-fill{height:100%;background:linear-gradient(90deg,#2563eb,#0ea5e9)}
@media(max-width:900px){.dev-grid{grid-template-columns:1fr}}
</style>
<script nonce="<%= cspNonce %>">
(function(){
  var EMP = <%= employee.id %>;
  function e(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
  function d(x){ return x?String(x).slice(0,10):'—'; }
  function badge(s){ return '<span class="dev-badge" data-s="'+e(s)+'">'+e(s)+'</span>'; }
  function empty(m){ return '<div class="text-muted" style="padding:.5rem">'+m+'</div>'; }
  fetch('/employees/'+EMP+'/development',{headers:{Accept:'application/json'}})
    .then(function(r){ return r.ok?r.json():{coaching:[],idps:[],pips:[]}; })
    .then(function(j){
      document.getElementById('dev-coaching').innerHTML = (j.coaching&&j.coaching.length)? j.coaching.map(function(c){
        return '<div class="dev-item"><div class="dev-t">'+e(c.title||c.kind)+' '+badge(c.state)+'</div>'+
          '<div class="dev-sub">'+e(c.kind)+(c.contextType?(' · ctx: '+e(c.contextType)):'')+(c.targetDate?(' · due '+d(c.targetDate)):'')+'</div>'+
          '<div class="dev-bar"><div class="dev-fill" style="width:'+(Number(c.progress)||0)+'%"></div></div></div>';
      }).join('') : empty(<%- JSON.stringify(__('admin:no_coaching_plans')) %>);

      document.getElementById('dev-idp').innerHTML = (j.idps&&j.idps.length)? j.idps.map(function(i){
        var pct = i.actTotal? Math.round(i.actDone/i.actTotal*100):0;
        return '<div class="dev-item"><div class="dev-t">IDP #'+i.id+' '+badge(i.status)+'</div>'+
          '<div class="dev-sub">priority '+e(i.priority||'—')+' · '+i.objTotal+' objective(s) · '+i.actDone+'/'+i.actTotal+' actions done'+(i.startsOn?(' · '+d(i.startsOn)+'→'+d(i.endsOn)):'')+'</div>'+
          '<div class="dev-bar"><div class="dev-fill" style="width:'+pct+'%"></div></div></div>';
      }).join('') : empty(<%- JSON.stringify(__('admin:no_development_plans')) %>);

      document.getElementById('dev-pip').innerHTML = (j.pips&&j.pips.length)? j.pips.map(function(p){
        return '<div class="dev-item"><div class="dev-t">PIP #'+p.id+' '+badge(p.state)+'</div>'+
          '<div class="dev-sub">'+(p.startsOn?(d(p.startsOn)+'→'+d(p.endsOn)):'')+(p.outcome?(' · outcome: '+e(p.outcome)):'')+'</div>'+
          (p.summary?'<div class="dev-sub">'+e(String(p.summary).slice(0,120))+'</div>':'')+'</div>';
      }).join('') : empty(<%- JSON.stringify(__('admin:no_improvement_plans')) %>);
    }).catch(function(){});
})();
</script>

<!-- Goals & OKRs (Wave 3 — consumes /api/v1) -->
<section class="card" style="margin-top:1.25rem;padding:1rem;">
  <h2><i class="fas fa-bullseye" aria-hidden="true"></i> <%= __('admin:goals_okrs') %> <span class="text-muted" style="font-size:.8rem;font-weight:400"><%= __('admin:okr_subtitle') %></span></h2>
  <div style="display:flex;gap:.5rem;margin:.5rem 0 1rem;flex-wrap:wrap;">
    <input id="okr-new-title" type="text" placeholder="<%= __('admin:new_objective_placeholder') %>" style="flex:1;min-width:240px;padding:6px 8px;">
    <input id="okr-new-period" type="text" placeholder="<%= __('admin:period_placeholder') %>" style="width:170px;padding:6px 8px;">
    <button class="btn btn-primary" onclick="okrAddObjective()">＋ <%= __('admin:add_objective') %></button>
  </div>
  <div id="okr-list"><div class="text-muted"><%= __('admin:loading') %></div></div>
</section>
<script nonce="<%= cspNonce %>">
(function(){
  var EMP = <%= employee.id %>;
  var base = '/api/v1';
  function e(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
  // Goal statuses were printed as raw English enums (at_risk, done…).
  var GST = <%- include('../../partials/json-script', { v: { active: __('talentx:okr_st_active'), at_risk: __('talentx:okr_st_at_risk'), done: __('talentx:okr_st_done'), cancelled: __('talentx:okr_st_cancelled') } }) %>;
  var OKR_T = <%- include('../../partials/json-script', { v: { status: __('talentx:okr_status'), align: __('talentx:okr_align'), alignPh: __('talentx:okr_align_ph'), alignDone: __('talentx:okr_align_done') } }) %>;
  var OBJECTIVES = null; // org objectives for the align control (null = not offered to this viewer)
  // UX-12 (3.23.21): white text on these fills is >= 4.5:1 (the former fills were 2.4-4.0:1).
  function badge(s){ var m={active:'#1f5f99',at_risk:'#8a4b00',done:'#1e6b3a',cancelled:'#5f6368'}; return '<span style="display:inline-block;padding:1px 7px;border-radius:10px;font-size:11px;font-weight:700;color:#fff;background:'+(m[s]||'#4a5563')+'">'+e(GST[s]||s)+'</span>'; }
  function statusSelect(g){ return '<select id="gst-'+g.id+'" aria-label="'+e(OKR_T.status+' — '+(g.title||''))+'" style="padding:2px 4px;font-size:.8rem" onchange="okrSetStatus('+g.id+',this.value)">'
    + ['active','at_risk','done','cancelled'].map(function(s){ return '<option value="'+s+'"'+(s===g.status?' selected':'')+'>'+e(GST[s]||s)+'</option>'; }).join('') + '</select>'; }
  function alignSelect(o){ if(!OBJECTIVES||!OBJECTIVES.length) return '';
    return ' <select aria-label="'+e(OKR_T.align)+'" style="padding:2px 4px;font-size:.8rem" onchange="okrAlign('+o.id+',this)"><option value="">'+e(OKR_T.alignPh)+'</option>'
      + OBJECTIVES.map(function(x){ return '<option value="'+Number(x.id)+'">'+e(x.title)+(x.period?(' ('+e(x.period)+')'):'')+'</option>'; }).join('') + '</select>'; }
  function bar(pct){ pct=Math.max(0,Math.min(100,Math.round(pct||0))); return '<div style="height:10px;border-radius:5px;background:#e6edf3;overflow:hidden;margin-top:4px"><div style="height:100%;width:'+pct+'%;background:#2f80c4"></div></div>'; }
  function api(path, opts){ return fetch(base+path, Object.assign({headers:{'Content-Type':'application/json'}}, opts||{})).then(function(r){ return r.json().then(function(j){ return {ok:r.ok,status:r.status,body:j}; }); }); }

  window.okrLoad = function(){
    api('/employees/'+EMP+'/goals').then(function(res){
      var box = document.getElementById('okr-list');
      if(!res.ok){ box.innerHTML='<div class="text-muted">'+<%- JSON.stringify(__('admin:unable_load_goals')) %>+' ('+res.status+').</div>'; return; }
      var goals = res.body.data||[];
      var objectives = goals.filter(function(g){return g.kind==='objective';});
      var krsByParent = {}; goals.filter(function(g){return g.kind==='key_result';}).forEach(function(k){ (krsByParent[k.parentId]=krsByParent[k.parentId]||[]).push(k); });
      if(!objectives.length){ box.innerHTML='<div class="text-muted">'+<%- JSON.stringify(__('admin:no_goals_yet')) %>+'</div>'; return; }
      box.innerHTML = objectives.map(function(o){
        var krs = krsByParent[o.id]||[];
        var avg = krs.length ? krs.reduce(function(a,k){ return a + (k.targetValue? Math.min(100,(k.currentValue/k.targetValue)*100):0); },0)/krs.length : 0;
        var krHtml = krs.map(function(k){
          var pct = k.targetValue? Math.min(100,Math.round(k.currentValue/k.targetValue*100)):0;
          return '<div style="margin:.4rem 0 .4rem 1rem;">'
            + '<div style="font-size:.85rem">'+e(k.title)+' '+badge(k.status)+' '+statusSelect(k)+' <span class="text-muted">'+e(k.currentValue)+'/'+e(k.targetValue==null?'—':k.targetValue)+(k.metricUnit?(' '+e(k.metricUnit)):'')+'</span></div>'
            + bar(pct)
            + '<div style="margin-top:3px"><input type="number" id="kr-val-'+k.id+'" value="'+e(k.currentValue)+'" aria-label="'+e(k.title)+'" style="width:80px;padding:3px 6px"> '
            + '<button class="btn btn-secondary btn-sm" aria-label="'+e(<%- JSON.stringify(__('admin:update')) %>+' — '+k.title)+'" onclick="okrSaveProgress('+k.id+')">'+<%- JSON.stringify(__('admin:update')) %>+'</button></div></div>';
        }).join('');
        return '<div class="dev-item" style="border:1px solid #d6dee6;border-radius:6px;padding:.6rem;margin-bottom:.6rem">'
          + '<div class="dev-t" style="font-weight:600">'+e(o.title)+' '+badge(o.status)+' '+statusSelect(o)+(o.period?(' <span class="text-muted">'+e(o.period)+'</span>'):'')+alignSelect(o)+'</div>'
          + bar(avg)
          + krHtml
          + '<div style="margin-top:.4rem;margin-left:1rem;display:flex;gap:.4rem;flex-wrap:wrap">'
          + '<input type="text" id="kr-new-'+o.id+'" placeholder="'+<%- JSON.stringify(__('admin:new_key_result_placeholder')) %>+'" style="flex:1;min-width:180px;padding:4px 6px">'
          + '<input type="number" id="kr-tgt-'+o.id+'" placeholder="'+<%- JSON.stringify(__('admin:target_placeholder')) %>+'" style="width:90px;padding:4px 6px">'
          + '<button class="btn btn-secondary btn-sm" onclick="okrAddKR('+o.id+')">＋ '+<%- JSON.stringify(__('admin:key_result')) %>+'</button></div>'
          + '</div>';
      }).join('');
    }).catch(function(){ document.getElementById('okr-list').innerHTML='<div class="text-muted">'+<%- JSON.stringify(__('admin:error_loading_goals')) %>+'</div>'; });
  };
  window.okrAddObjective = function(){
    var t=document.getElementById('okr-new-title').value.trim(); if(!t) return;
    var period=document.getElementById('okr-new-period').value.trim()||null;
    api('/goals',{method:'POST',body:JSON.stringify({employeeId:EMP,kind:'objective',title:t,period:period})}).then(function(r){
      if(!r.ok){ alert(<%- JSON.stringify(__('admin:could_not_add_goal')) %>+': '+(r.body&&r.body.error||r.status)); return; }
      document.getElementById('okr-new-title').value=''; document.getElementById('okr-new-period').value=''; window.okrLoad();
    });
  };
  window.okrAddKR = function(objId){
    var t=document.getElementById('kr-new-'+objId).value.trim(); if(!t) return;
    var tgt=parseFloat(document.getElementById('kr-tgt-'+objId).value); if(isNaN(tgt)) tgt=null;
    api('/goals',{method:'POST',body:JSON.stringify({employeeId:EMP,parentId:objId,kind:'key_result',title:t,targetValue:tgt})}).then(function(r){
      if(!r.ok){ alert(<%- JSON.stringify(__('admin:could_not_add_key_result')) %>+': '+(r.body&&r.body.error||r.status)); return; } window.okrLoad();
    });
  };
  window.okrSaveProgress = function(krId){
    var v=parseFloat(document.getElementById('kr-val-'+krId).value); if(isNaN(v)) return;
    api('/goals/'+krId+'/progress',{method:'PATCH',body:JSON.stringify({currentValue:v})}).then(function(r){
      if(!r.ok){ alert(<%- JSON.stringify(__('admin:could_not_update')) %>+': '+(r.body&&r.body.error||r.status)); return; } window.okrLoad();
    });
  };
  // Status (active / at risk / done / cancelled) — the API accepted it, no screen set it.
  window.okrSetStatus = function(id, status){
    api('/goals/'+id+'/progress',{method:'PATCH',body:JSON.stringify({status:status})}).then(function(r){
      if(!r.ok){ alert(<%- JSON.stringify(__('admin:could_not_update')) %>+': '+(r.body&&r.body.error||r.status)); }
      window.okrLoad();
    });
  };
  // Align an objective onto an org objective (goal cascade). Offered only when
  // the viewer may read the org objectives; the server re-checks scope.
  window.okrAlign = function(goalId, sel){
    var objId = Number(sel.value); if(!objId) return;
    var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content || '';
    fetch('/v2/cap/objective/'+objId+'/align',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json','x-csrf-token':csrf},body:JSON.stringify({goalId:goalId})})
      .then(function(r){ return r.json().catch(function(){ return {}; }).then(function(j){ return {ok:r.ok&&j.ok!==false,body:j,status:r.status}; }); })
      .then(function(r){ alert(r.ok ? OKR_T.alignDone : (<%- JSON.stringify(__('admin:could_not_update')) %>+': '+(r.body&&r.body.error||r.status))); sel.value=''; });
  };
  fetch('/v2/cap/objectives',{headers:{'Accept':'application/json'}})
    .then(function(r){ return (r.ok && (r.headers.get('content-type')||'').indexOf('json')>-1) ? r.json() : null; })
    .then(function(j){ OBJECTIVES = (j && j.ok && j.objectives) || null; okrLoad(); })
    .catch(function(){ okrLoad(); });
})();
</script>

<!-- Check-ins / 1-on-1s (Wave 3 — consumes /api/v1) -->
<section class="card" style="margin-top:1.25rem;padding:1rem;">
  <h2><i class="fas fa-calendar-days" aria-hidden="true"></i> <%= __('admin:checkins_title') %> <span class="text-muted" style="font-size:.8rem;font-weight:400"><%= __('admin:checkins_subtitle') %></span></h2>
  <div style="display:flex;gap:.5rem;margin:.5rem 0 1rem;flex-wrap:wrap;align-items:center;">
    <select id="ci-new-kind" style="padding:6px 8px;"><option value="one_on_one"><%= __('admin:one_on_one') %></option><option value="feedback"><%= __('admin:feedback') %></option><option value="pulse"><%= __('admin:pulse') %></option></select>
    <input id="ci-new-title" type="text" placeholder="<%= __('admin:topic_placeholder') %>" style="flex:1;min-width:200px;padding:6px 8px;">
    <input id="ci-new-when" type="date" style="padding:6px 8px;">
    <select id="ci-new-sentiment" style="padding:6px 8px;"><option value=""><%= __('admin:mood_dash') %></option><option value="1"><span aria-hidden="true">😟</span> 1</option><option value="2"><span aria-hidden="true">🙁</span> 2</option><option value="3"><span aria-hidden="true">😐</span> 3</option><option value="4"><span aria-hidden="true">🙂</span> 4</option><option value="5"><span aria-hidden="true">😀</span> 5</option></select>
    <button class="btn btn-primary" onclick="ciAdd()">＋ <%= __('admin:add_checkin') %></button>
  </div>
  <div id="ci-list"><div class="text-muted"><%= __('admin:loading') %></div></div>
</section>
<script nonce="<%= cspNonce %>">
(function(){
  var EMP = <%= employee.id %>;
  var base = '/api/v1';
  var MOOD = {1:'😟',2:'🙁',3:'😐',4:'🙂',5:'😀'};
  function e(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
  function badge(s){ var m={scheduled:'#2f80c4',completed:'#2e9e57',cancelled:'#9e9e9e'}; return '<span style="display:inline-block;padding:1px 7px;border-radius:10px;font-size:9px;font-weight:700;color:#fff;background:'+(m[s]||'#5b6b7b')+'">'+e(s)+'</span>'; }
  function kindLabel(k){ return {one_on_one:<%- JSON.stringify(__('admin:one_on_one')) %>,feedback:<%- JSON.stringify(__('admin:feedback')) %>,pulse:<%- JSON.stringify(__('admin:pulse')) %>}[k]||k; }
  // jamais d'ISO dans une page française. dd/MM/aaaa,
  // forcé UTC comme fmtPeriodBound côté serveur, « — » si la date est illisible.
  function dt(s){ if(!s) return ''; try{ var x=new Date(s); if(isNaN(x.getTime())) return '—';
    var p=function(n){return String(n).padStart(2,'0');};
    return p(x.getUTCDate())+'/'+p(x.getUTCMonth()+1)+'/'+x.getUTCFullYear(); }catch(_){ return ''; } }
  function api(path, opts){ return fetch(base+path, Object.assign({headers:{'Content-Type':'application/json'}}, opts||{})).then(function(r){ return r.json().then(function(j){ return {ok:r.ok,status:r.status,body:j}; }); }); }

  function renderItems(ci){
    return api('/check-ins/'+ci.id+'/items').then(function(res){
      var items = (res.ok && res.body.data)||[];
      return items.map(function(it){
        return '<div style="margin:.2rem 0 .2rem 1rem;font-size:.85rem;display:flex;align-items:center;gap:.4rem">'
          + (it.isAction ? '<input type="checkbox" '+(it.done?'checked':'')+' onchange="ciToggle('+it.id+',this.checked)">' : '<span class="text-muted">•</span>')
          + '<span style="'+(it.done?'text-decoration:line-through;opacity:.6':'')+'">'+e(it.body)+(it.isAction?' <span class="text-muted" style="font-size:9px">'+<%- JSON.stringify(__('admin:action_tag')) %>+'</span>':'')+'</span></div>';
      }).join('');
    });
  }

  window.ciLoad = function(){
    api('/employees/'+EMP+'/check-ins').then(function(res){
      var box = document.getElementById('ci-list');
      if(!res.ok){ box.innerHTML='<div class="text-muted">'+<%- JSON.stringify(__('admin:unable_load_checkins')) %>+' ('+res.status+').</div>'; return; }
      var rows = res.body.data||[];
      if(!rows.length){ box.innerHTML='<div class="text-muted">'+<%- JSON.stringify(__('admin:no_checkins')) %>+'</div>'; return; }
      box.innerHTML = rows.map(function(c){
        var when = dt(c.occurredAt||c.scheduledAt);
        return '<div class="dev-item" id="ci-'+c.id+'" style="border:1px solid #d6dee6;border-radius:6px;padding:.6rem;margin-bottom:.6rem">'
          + '<div style="font-weight:600">'+e(kindLabel(c.kind))+(c.title?(' — '+e(c.title)):'')+' '+badge(c.status)
          + (c.sentiment?(' <span title="mood">'+(MOOD[c.sentiment]||'')+'</span>'):'')
          + (when?(' <span class="text-muted" style="font-size:.8rem">'+when+'</span>'):'')+'</div>'
          + (c.sharedNotes?('<div class="text-muted" style="font-size:.85rem;margin:.2rem 0">'+e(c.sharedNotes)+'</div>'):'')
          + '<div class="ci-items" data-for="'+c.id+'"></div>'
          + '<div style="margin-top:.4rem;margin-left:1rem;display:flex;gap:.4rem;flex-wrap:wrap">'
          + '<input type="text" id="ci-item-'+c.id+'" placeholder="'+<%- JSON.stringify(__('admin:talking_point_placeholder')) %>+'" style="flex:1;min-width:180px;padding:4px 6px">'
          + '<label style="font-size:.8rem;display:flex;align-items:center;gap:3px"><input type="checkbox" id="ci-itemact-'+c.id+'"> '+<%- JSON.stringify(__('admin:action_tag')) %>+'</label>'
          + '<button class="btn btn-secondary btn-sm" onclick="ciAddItem('+c.id+')">＋ '+<%- JSON.stringify(__('admin:item_label')) %>+'</button>'
          + (c.status!=='completed'?(' <button class="btn btn-secondary btn-sm" onclick="ciComplete('+c.id+')">'+<%- JSON.stringify(__('admin:mark_complete')) %>+'</button>'):'')
          + '</div></div>';
      }).join('');
      rows.forEach(function(c){ renderItems(c).then(function(html){ var el=document.querySelector('.ci-items[data-for="'+c.id+'"]'); if(el) el.innerHTML=html; }); });
    }).catch(function(){ document.getElementById('ci-list').innerHTML='<div class="text-muted">'+<%- JSON.stringify(__('admin:error_loading_checkins')) %>+'</div>'; });
  };
  window.ciAdd = function(){
    var kind=document.getElementById('ci-new-kind').value;
    var title=document.getElementById('ci-new-title').value.trim()||null;
    var when=document.getElementById('ci-new-when').value||null;
    var sv=document.getElementById('ci-new-sentiment').value; var sentiment=sv?parseInt(sv,10):null;
    var payload={employeeId:EMP,kind:kind,title:title,sentiment:sentiment};
    if(when) payload.scheduledAt=when+'T09:00:00Z';
    api('/check-ins',{method:'POST',body:JSON.stringify(payload)}).then(function(r){
      if(!r.ok){ alert(<%- JSON.stringify(__('admin:could_not_add_checkin')) %>+': '+(r.body&&r.body.error||r.status)); return; }
      document.getElementById('ci-new-title').value=''; document.getElementById('ci-new-when').value=''; document.getElementById('ci-new-sentiment').value=''; window.ciLoad();
    });
  };
  window.ciAddItem = function(id){
    var b=document.getElementById('ci-item-'+id).value.trim(); if(!b) return;
    var isAction=document.getElementById('ci-itemact-'+id).checked;
    api('/check-ins/'+id+'/items',{method:'POST',body:JSON.stringify({body:b,isAction:isAction})}).then(function(r){
      if(!r.ok){ alert(<%- JSON.stringify(__('admin:could_not_add_item')) %>+': '+(r.body&&r.body.error||r.status)); return; } window.ciLoad();
    });
  };
  window.ciToggle = function(itemId,done){
    api('/check-in-items/'+itemId,{method:'PATCH',body:JSON.stringify({done:done})}).then(function(r){
      if(!r.ok){ alert(<%- JSON.stringify(__('admin:could_not_update_item')) %>+': '+(r.body&&r.body.error||r.status)); window.ciLoad(); }
    });
  };
  window.ciComplete = function(id){
    api('/check-ins/'+id,{method:'PATCH',body:JSON.stringify({status:'completed',occurredAt:new Date().toISOString()})}).then(function(r){
      if(!r.ok){ alert(<%- JSON.stringify(__('admin:could_not_complete')) %>+': '+(r.body&&r.body.error||r.status)); return; } window.ciLoad();
    });
  };
  ciLoad();
})();
</script>

<!-- ══ SECTION operations — "Journal": every trace where this person acted or was the
     subject, from the append-only system log. Self-contained appended section;
     admin-only (the controller passes `journal` only then). ══ -->
<% if (typeof journal !== 'undefined' && journal) { %>
<div class="card" style="padding:1.1rem;margin-bottom:1rem" id="empJournal">
  <h2><i class="fas fa-book" aria-hidden="true"></i> <%= __('admin:ops_journal_title') %>
      <span class="chip"><%= journal.total != null ? journal.total : '—' %></span></h2>
  <p class="text-muted" style="font-size:.82rem;margin:.2rem 0 .8rem"><%= __('admin:ops_journal_hint') %></p>
  <% if (!journal.rows.length) { %>
    <p class="text-muted"><%= __('admin:ops_journal_none') %></p>
  <% } else { %>
  <div style="overflow-x:auto">
    <table class="table">
      <thead><tr>
        <th><%= __('admin:ops_journal_col_when') %></th>
        <th><%= __('admin:ops_journal_col_what') %></th>
        <th><%= __('admin:ops_journal_col_who') %></th>
        <th><%= __('admin:ops_journal_col_detail') %></th>
      </tr></thead>
      <tbody>
      <% journal.rows.forEach(function (r) {
           var actor = r.actorRef || (r.username ? 'admin:' + r.username : null);
           var isSelf = actor && /^(employee|manager|supervisor):/.test(String(actor))
                        && String(actor).split(':')[1] === String(employee.id); %>
        <tr>
          <td><%= fmtDateTime(r.createdAt) %></td>
          <td><span class="chip"><%= r.action %></span>
              <span class="text-muted" style="font-size:.72rem"><%= isSelf ? __('admin:ops_journal_role_actor') : __('admin:ops_journal_role_target') %></span></td>
          <td><%= r.username || r.actorRef || '—' %></td>
          <td style="white-space:normal;max-width:40rem"><%= typeof r.details === 'string' ? r.details : JSON.stringify(r.details || '') %></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>
  <p style="margin:.6rem 0 0">
    <a class="btn btn-sm btn-secondary" href="/system-logs?employeeId=<%= employee.id %>&amp;excludeHttp=1"><%= __('admin:ops_journal_more') %></a>
  </p>
  <% } %>
</div>
<% } %>
<!-- ══ end SECTION operations ══ -->
