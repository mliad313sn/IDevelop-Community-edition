<a href="/employees" class="btn-back"><%= __('admin:back_to_employees') %></a>

<div class="page-header">
    <h1><%= employee.firstName %> <%= employee.lastName %></h1>
    <div class="page-actions">
        <a href="/employees/<%= employee.id %>/assessments" class="btn btn-primary"><i class="fas fa-chart-column" aria-hidden="true"></i> <%= __('admin:view_assessments') %></a>
        <a href="/employees/<%= employee.id %>/progress" class="btn btn-secondary" title="Historique des campagnes et progression / Campaign history & progression"><i class="fas fa-arrow-trend-up" aria-hidden="true"></i> Progression</a>
        <a href="#skill-timeline" class="btn btn-secondary"><i class="fas fa-chart-line" aria-hidden="true"></i> <%= __('admin:skill_timeline') %></a>
        <a href="/employees/<%= employee.id %>/edit" class="btn btn-secondary"><i class="fas fa-pen" aria-hidden="true"></i> <%= __('admin:edit') %></a>
    </div>
</div>

<%# Record state, made explicit. Three states a reader must never confuse:
    a LEAVER (is_active=false, cancelled_at NULL) wears "Sorti"; a record
    VOIDED as created-in-error (MaintenanceService, cancelled_at + reason,
    reversible) says so with its reason; a GDPR-ERASED subject (erased_at,
    irreversible) carries its own marker. Until now the profile showed none
    of them, and the list showed a voided duplicate as a departure. %>
<%
    const recErased = Boolean(employee.erasedAt);
    const recVoided = !recErased && Boolean(employee.cancelledAt);
    const recInactive = !recErased && !recVoided && (employee.isActive === false || employee.isActive === 0);
    const recState = recErased ? 'erased' : (recVoided ? 'voided' : (recInactive ? 'inactive' : 'active'));
    const recDate = (d) => { try { return new Date(d).toLocaleDateString(typeof lang !== 'undefined' && lang === 'en' ? 'en-GB' : 'fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }); } catch (e) { return String(d).slice(0, 10); } };
%>
<style nonce="<%= cspNonce %>">
    .rec-badge { display:inline-block; padding:2px 9px; border:1px solid; border-radius:999px; font: 600 11px/1.6 var(--font-data, system-ui); letter-spacing:.04em; white-space:nowrap; }
    .rec-badge[data-s="inactive"] { border-color: var(--danger, #b91c1c); color: var(--danger, #b91c1c); }
    .rec-badge[data-s="voided"]   { border-color: var(--warning, #b45309); color: var(--warning, #b45309); }
    .rec-badge[data-s="erased"]   { border-color: var(--text-muted, #64748b); color: var(--text-muted, #64748b); }
    .rec-badge[data-s="active"]   { border-color: var(--success, #15803d); color: var(--success, #15803d); }
    .rec-note { display:block; margin-top:.35rem; color: var(--text-muted, #64748b); font-size:.9rem; }
</style>
<div class="employee-details">
    <div class="detail-section">
        <h2><%= __('admin:employee_information') %></h2>
        <table class="table">
            <tr data-record-state="<%= recState %>">
                <th><%= __('admin:emp_record_status') %></th>
                <td>
                    <% if (recErased) { %>
                        <span class="rec-badge" data-s="erased" title="<%= __('admin:emp_erased_title') %>"><%= __('admin:emp_erased_badge') %></span>
                        <span class="rec-note"><%= __('admin:emp_erased_title') %></span>
                    <% } else if (recVoided) { %>
                        <span class="rec-badge" data-s="voided" title="<%= __('admin:emp_voided_title') %>"><%= __('admin:emp_voided_badge') %></span>
                        <span class="rec-note"><%= __('admin:emp_voided_on', { date: recDate(employee.cancelledAt) }) %><% if (employee.cancelReason) { %> — <%= __('admin:emp_voided_reason', { reason: employee.cancelReason }) %><% } %></span>
                    <% } else if (recInactive) { %>
                        <span class="rec-badge" data-s="inactive" title="<%= __('admin:emp_inactive_title') %>"><%= __('admin:emp_inactive_badge') %></span>
                    <% } else { %>
                        <span class="rec-badge" data-s="active"><%= __('admin:emp_record_active') %></span>
                    <% } %>
                </td>
            </tr>
            <tr>
                <th><%= __('admin:employee_number') %></th>
                <td><%= employee.employeeNumber %></td>
            </tr>
            <tr>
                <th><%= __('admin:name') %></th>
                <td><%= employee.firstName %> <%= employee.lastName %></td>
            </tr>
            <tr>
                <th><%= __('admin:email') %></th>
                <td><%= employee.email || __('admin:not_available') %></td>
            </tr>
            <tr>
                <th><%= __('admin:phone') %></th>
                <td><%= employee.phone || __('admin:not_available') %></td>
            </tr>
            <tr>
                <th><%= __('admin:role') %></th>
                <td><%= employee.roleName %></td>
            </tr>
            <tr>
                <th><%= __('admin:site') %></th>
                <td><%= employee.siteName %></td>
            </tr>
            <tr>
                <th><%= __('admin:department') %></th>
                <td><%= employee.departmentName %></td>
            </tr>
            <tr>
                <th><%= __('admin:service') %></th>
                <td><%= employee.serviceName %></td>
            </tr>
        </table>
    </div>
</div>

<%# Account status: read-only for everyone who may open the
    record; a manager gets one-click REQUESTS (unlock / resend) that land in the
    admins' action centre instead of a 403 on the admin buttons. %>
<% if (typeof account !== 'undefined' && account) {
    const accCls = (s) => ({ active: 'badge-success', locked: 'badge-danger', expired: 'badge-danger', disabled: 'badge-danger', none: 'badge-danger', stale: 'badge-warning', pending: 'badge-warning', never_invited: 'badge-warning', sso: 'badge-info' })[s] || 'badge-secondary';
    const openKinds = new Set((typeof openRequests !== 'undefined' ? openRequests : []).map((r) => r.kind)); %>
<div class="detail-section" style="margin-top:1.25rem" id="account-status">
    <h2><i class="fas fa-user-lock" aria-hidden="true"></i> <%= __('admin:acc_block_title') %></h2>
    <div class="card" style="padding:14px 16px;">
        <table class="table" style="margin:0;">
            <tr><th><%= __('admin:acc_th_state') %></th><td>
                <span class="badge <%= accCls(account.state) %>" data-acc-state="<%= account.state %>" title="<%= __('admin:acc_state_' + account.state + '_title') %>"><%= __('admin:acc_state_' + account.state) %></span>
                <% if (account.state === 'locked' && account.lockedUntil) { %> <span class="help-text"><%= __('admin:acc_locked_until', { time: fmtDateTime(account.lockedUntil), n: account.failedAttempts }) %></span><% } %>
            </td></tr>
            <tr><th><%= __('admin:acc_th_username') %></th><td><code><%= account.username || '—' %></code> · <%= __('admin:acc_kind_' + account.kind) %></td></tr>
            <tr><th><%= __('admin:acc_th_last_login') %></th><td><%= account.lastLoginAt ? fmtDateTime(account.lastLoginAt) : __('admin:acc_never') %></td></tr>
            <tr><th><%= __('admin:inv_th_invitation') %></th><td><%= account.invitedAt ? fmtDate(account.invitedAt) : '—' %></td></tr>
        </table>
        <% if (typeof isManagerUser !== 'undefined' && isManagerUser) { %>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.8rem;align-items:center;">
            <button type="button" class="btn btn-secondary btn-sm acc-request" data-acc-request="unlock" data-emp="<%= employee.id %>" <%= openKinds.has('unlock') ? 'disabled' : '' %>><i class="fas fa-lock-open" aria-hidden="true"></i> <%= __('admin:acc_request_btn_unlock') %></button>
            <button type="button" class="btn btn-secondary btn-sm acc-request" data-acc-request="resend" data-emp="<%= employee.id %>" <%= openKinds.has('resend') ? 'disabled' : '' %>><i class="fas fa-paper-plane" aria-hidden="true"></i> <%= __('admin:acc_request_btn_resend') %></button>
            <span class="help-text" id="acc-request-msg"><%= openKinds.size ? __('admin:acc_request_pending_note') : __('admin:acc_request_hint') %></span>
        </div>
        <% } else if (typeof canActOnAccount !== 'undefined' && canActOnAccount) { %>
        <p class="help-text" style="margin:.6rem 0 0;"><a href="/admin/accounts?q=<%= encodeURIComponent(account.username || employee.employeeNumber || '') %>"><i class="fas fa-users-gear" aria-hidden="true"></i> <%= __('admin:ap_open_console') %></a>
            <% (typeof openRequests !== 'undefined' ? openRequests : []).forEach(function (r) { %> · <span style="color:#b45309;"><%= __('admin:acc_request_open_' + r.kind, { date: fmtDate(r.createdAt) }) %></span><% }); %></p>
        <% } %>
    </div>
</div>
<% if (typeof isManagerUser !== 'undefined' && isManagerUser) { %>
<script nonce="<%= cspNonce %>">
(function () {
    var msg = document.getElementById('acc-request-msg');
    Array.prototype.forEach.call(document.querySelectorAll('.acc-request'), function (btn) {
        btn.addEventListener('click', async function () {
            var note = await window.promptDialog(<%- JSON.stringify(__('admin:acc_request_note_prompt')) %>, '', { multiline: true });
            if (note === null) return;
            btn.disabled = true;
            try {
                var r = await fetch('/employees/' + btn.getAttribute('data-emp') + '/account-request', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ kind: btn.getAttribute('data-acc-request'), note: note }) });
                var j = await r.json().catch(function () { return {}; });
                msg.textContent = j.message || j.error || '';
                msg.style.color = r.ok ? '#15803d' : '#b91c1c';
                if (!r.ok) btn.disabled = false;
                if (window.toast) window.toast(j.message || j.error || '', r.ok ? 'success' : 'error');
            } catch (e) { btn.disabled = false; }
        });
    });
})();
</script>
<% } %>
<% } %>

<% if (typeof canManageAccess !== 'undefined' && canManageAccess) { %>
<%# Every sentence of this block is keyed; the confirms go through data-confirm. %>
<div class="detail-section" style="margin-top:1.25rem">
    <h2><i class="fas fa-id-badge" aria-hidden="true"></i> <%= __('admin:acc_id_title') %></h2>

    <!-- Authentication methods: local password + any number of SSO identities -->
    <div class="card" style="padding:14px 16px; margin-bottom:1rem;">
        <h3 style="margin-top:0;"><i class="fas fa-fingerprint" aria-hidden="true"></i> <%= __('admin:acc_id_methods') %></h3>

        <!-- Local password -->
        <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.5rem 0; border-bottom:1px solid var(--line,#e2e8f0);">
            <div>
                <i class="fas fa-key" aria-hidden="true"></i> <strong><%= __('admin:acc_id_local_password') %></strong>
                <% if (typeof passwordDisabled !== 'undefined' && passwordDisabled) { %>
                    <span class="pill" style="background:#f6e4e8;color:#9e3a52;font-size:11px;padding:2px 8px;border-radius:999px;"><%= __('admin:acc_id_pw_disabled') %></span>
                <% } else { %>
                    <span class="pill" style="background:#e3f0e9;color:#2f7d5b;font-size:11px;padding:2px 8px;border-radius:999px;"><%= __('admin:acc_id_pw_enabled') %></span>
                <% } %>
            </div>
            <form action="/employees/<%= employee.id %>/password-auth" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="disabled" value="<%= (typeof passwordDisabled !== 'undefined' && passwordDisabled) ? '0' : '1' %>">
                <button type="submit" class="btn btn-secondary btn-sm">
                    <%= (typeof passwordDisabled !== 'undefined' && passwordDisabled) ? __('admin:acc_id_pw_reenable') : __('admin:acc_id_pw_disable') %>
                </button>
            </form>
        </div>

        <!-- Linked SSO identities -->
        <% if (typeof identities !== 'undefined' && identities.length) { %>
            <% identities.forEach(function(idn){ %>
                <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.5rem 0; border-bottom:1px solid var(--line,#e2e8f0);">
                    <div>
                        <i class="fas fa-id-badge" aria-hidden="true"></i> <strong><%= idn.provider %></strong>
                        <code style="font-size:.85em;"><%= idn.uid %></code>
                        <% if (idn.email) { %><span class="help-text" style="font-size:.85em;">· <%= idn.email %></span><% } %>
                        <% if (idn.isPrimary) { %><span style="font-size:11px;color:var(--brand,#b8860b);">· <%= __('admin:acc_id_primary') %></span><% } %>
                    </div>
                    <form action="/employees/<%= employee.id %>/identity/remove" method="POST" data-confirm="<%= __('admin:acc_id_remove_confirm') %>" data-confirm-danger>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="identityId" value="<%= idn.id %>">
                        <button type="submit" class="btn btn-secondary btn-sm"><i class="fas fa-unlink" aria-hidden="true"></i> <%= __('admin:acc_id_remove') %></button>
                    </form>
                </div>
            <% }); %>
        <% } else { %>
            <p class="help-text" style="margin:.5rem 0 0;"><%= __('admin:acc_id_none') %></p>
        <% } %>

        <!-- Add another identity -->
        <form action="/employees/<%= employee.id %>/sso-link" method="POST" style="display:flex; flex-wrap:wrap; gap:.5rem; align-items:flex-end; margin-top:.75rem;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group" style="margin:0;">
                <label for="sso-provider"><%= __('admin:acc_id_provider') %></label>
                <select id="sso-provider" name="provider" class="form-control" style="max-width:140px;">
                    <option value="entra">entra</option>
                    <option value="oidc">oidc</option>
                    <option value="saml">saml</option>
                    <option value="google">google</option>
                </select>
            </div>
            <div class="form-group" style="margin:0; flex:1; min-width:240px;">
                <label for="sso-external-id"><%= __('admin:acc_id_external_id') %></label>
                <input type="text" id="sso-external-id" name="externalId" class="form-control" placeholder="<%= __('admin:acc_id_external_id_ph') %>" required>
            </div>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus" aria-hidden="true"></i> <%= __('admin:acc_id_add_method') %></button>
        </form>
    </div>

    <!-- Promote to admin (SuperAdmin only) -->
    <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
    <div class="card" style="padding:14px 16px;">
        <h3 style="margin-top:0;"><i class="fas fa-user-shield" aria-hidden="true"></i> <%= __('admin:acc_id_admin_title') %></h3>
        <% if (linkedAdmin) { %>
            <%# The sentence carries markup (strong, a, code), so it is printed raw -
                and every value placed INTO it is HTML-escaped first. i18next runs with
                escapeValue:false, so an admin username such as an img onerror payload
                used to reach the SuperAdmin's page as live markup (audit SA-02). %>
            <% var _ehAcc = function (v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }; %>
            <p class="help-text"><%- __('admin:acc_id_admin_has', { role: _ehAcc(enumLabel('admin_role', linkedAdmin.role)), username: _ehAcc(linkedAdmin.username), id: _ehAcc(linkedAdmin.id) }) %><%= linkedAdmin.isActive ? '' : ' (' + __('admin:acc_id_admin_deactivated') + ')' %></p>
            <div style="display:flex; gap:.5rem; flex-wrap:wrap;">
                <a href="/admins/<%= linkedAdmin.id %>" class="btn btn-secondary btn-sm"><i class="fas fa-sliders-h" aria-hidden="true"></i> <%= __('admin:acc_id_admin_manage') %></a>
                <%# the twin of the button on /admins/:id — same mandatory reason. %>
                <form action="/admins/<%= linkedAdmin.id %>/revoke-access" method="POST" data-confirm="<%= __('admin:acc_id_admin_revoke_confirm') %>" data-confirm-danger data-confirm-reason="reason">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-user-slash" aria-hidden="true"></i> <%= __('admin:acc_id_admin_revoke') %></button>
                </form>
            </div>
        <% } else { %>
            <p class="help-text"><%- __('admin:acc_id_admin_grant_intro') %></p>
            <form action="/employees/<%= employee.id %>/grant-admin" method="POST" style="display:flex; gap:.5rem; align-items:flex-end;" data-confirm="<%= __('admin:acc_id_admin_grant_confirm') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group" style="margin:0;">
                    <label for="grant-role"><%= __('admin:role') %></label>
                    <select id="grant-role" name="role" class="form-control" style="max-width:180px;">
                        <option value="localadmin"><%= enumLabel('admin_role', 'localadmin') %></option>
                        <option value="viewer"><%= enumLabel('admin_role', 'viewer') %></option>
                        <option value="superadmin"><%= enumLabel('admin_role', 'superadmin') %></option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-user-shield" aria-hidden="true"></i> <%= __('admin:acc_id_admin_grant') %></button>
            </form>
        <% } %>
    </div>
    <%# EXC (3.23.21, PO decision): the employee's SSO exception — SuperAdmin only,
        audited; password sign-in kept while SSO is enforced. Never an admin account. %>
    <div class="card" style="padding:14px 16px;" id="sso-exception">
        <h3 style="margin-top:0;"><i class="fas fa-key" aria-hidden="true"></i> <%= __('admin:sso_exc_title') %></h3>
        <p class="help-text" id="sso-exc-help"><%= __('admin:sso_exc_help') %></p>
        <% if (employee.ssoExceptionAt) { %>
            <p data-sso-exception-active><%= __('admin:sso_exc_active', { date: (typeof fmtDate === 'function') ? fmtDate(employee.ssoExceptionAt) : employee.ssoExceptionAt, by: employee.ssoExceptionBy ? ('#' + employee.ssoExceptionBy) : '—', reason: employee.ssoExceptionReason || '—' }) %></p>
            <form action="/employees/<%= employee.id %>/sso-exception" method="POST" data-confirm="<%= __('admin:sso_exc_remove_confirm') %>" data-confirm-danger>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="remove">
                <button type="submit" class="btn btn-secondary btn-sm"><%= __('admin:sso_exc_remove') %></button>
            </form>
        <% } else { %>
            <p><%= __('admin:sso_exc_none') %></p>
            <form action="/employees/<%= employee.id %>/sso-exception" method="POST" style="display:flex; gap:.5rem; align-items:flex-end; flex-wrap:wrap;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="grant">
                <div class="form-group" style="margin:0; flex:1; min-width:240px;">
                    <label for="sso-exc-reason"><%= __('admin:sso_exc_reason_label') %></label>
                    <input type="text" id="sso-exc-reason" name="reason" class="form-control" maxlength="300" required aria-describedby="sso-exc-help">
                </div>
                <button type="submit" class="btn btn-primary btn-sm"><%= __('admin:sso_exc_grant') %></button>
            </form>
        <% } %>
    </div>
    <% } %>
</div>
<% } %>

<!-- Skill evolution over time + assessment movement (employee ↔ reviewer) -->
<div id="skill-timeline" class="detail-section" style="margin-top:1.25rem">
  <h2><i class="fas fa-chart-line" aria-hidden="true"></i> <%= __('admin:skill_evolution_movement') %></h2>
  <div class="st-grid">
    <div class="st-card">
      <div class="st-head">
        <strong><%= __('admin:skill_level_over_time') %></strong>
        <select id="st-skill" class="form-control" style="max-width:280px"><option value=""><%= __('admin:loading') %></option></select>
      </div>
      <div id="st-empty" class="text-muted" style="display:none;padding:.75rem"><%= __('admin:no_skill_history') %></div>
      <div style="position:relative;height:300px"><canvas id="st-chart"></canvas></div>
      <div id="st-summary" class="text-muted" style="font-size:.85rem;margin-top:.4rem"></div>
    </div>
    <div class="st-card">
      <div class="st-head"><strong><%= __('admin:assessment_movement') %></strong> <span class="text-muted" style="font-size:.8rem"><%= __('admin:movement_subtitle') %></span></div>
      <div id="st-movement" class="st-timeline"><div class="text-muted" style="padding:.75rem"><%= __('admin:loading') %></div></div>
    </div>
  </div>
</div>

<style>
.st-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:16px}
.st-card{border:1px solid var(--line,#e2e8f0);border-radius:12px;padding:14px 16px;background:var(--card,#fff)}
.st-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap}
.st-timeline{max-height:340px;overflow:auto}
.st-ev{display:flex;gap:10px;padding:8px 4px;border-bottom:1px solid #f1f5f9;font-size:.86rem}
.st-dot{width:10px;height:10px;border-radius:50%;margin-top:5px;flex:0 0 10px}
.st-ev .st-when{color:#94a3b8;font-size:.76rem}
.st-act{font-weight:700;text-transform:capitalize}
@media(max-width:820px){.st-grid{grid-template-columns:1fr}}
</style>
<script src="/vendor/chart.umd.min.js?v=<%= assetVersion %>"></script>
<script src="/js/chart-theme.js?v=<%= assetVersion %>"></script>
<script nonce="<%= cspNonce %>">
// Shared by the several chart blocks on this page. Colours resolve from the
// theme, so they follow the running identity instead of being frozen to one
// edition's palette; the fallbacks keep the page rendering if the theme is
// ever absent.
var SEMC = (window.ChartTheme && window.ChartTheme.SEMANTIC) || { neutral: '#5B9DF5', mid: '#F5A623' };
var ROLEC = (window.ChartTheme && window.ChartTheme.ROLE) || { neutralFillSoft: 'rgba(91,157,245,0.14)' };
</script>
<script nonce="<%= cspNonce %>">
(function(){
  var EMP = <%= employee.id %>;
  var ACT_COLOR = { submit:'#1b56b8', open_review:'#c46a00', request_changes:'#c62828', approve:'#0f8a3c', reject:'#b00020', validate:'#0f8a3c', arbitrate:'#7a3cc4', comment:'#64748b' };
  var bySkill = {}, chart = null;
  function fmt(d){ try{ return FMT.date(d); }catch(e){ return String(d).slice(0,10); } }

  fetch('/employees/'+EMP+'/assessments/history',{headers:{Accept:'application/json'}})
    .then(function(r){ return r.ok?r.json():{history:[]}; })
    .then(function(j){
      var rows = (j.history||[]).slice().sort(function(a,b){ return new Date(a.assessedAt)-new Date(b.assessedAt); });
      rows.forEach(function(h){ (bySkill[h.skillId] = bySkill[h.skillId] || {name:h.skillName||('#'+h.skillId), pts:[]}).pts.push(h); });
      var sel = document.getElementById('st-skill');
      var ids = Object.keys(bySkill).sort(function(a,b){ return bySkill[b].pts.length - bySkill[a].pts.length || bySkill[a].name.localeCompare(bySkill[b].name); });
      if(!ids.length){ sel.style.display='none'; document.getElementById('st-empty').style.display='block'; document.getElementById('st-chart').style.display='none'; return; }
      sel.innerHTML = ids.map(function(id){ return '<option value="'+id+'">'+esc(bySkill[id].name)+' ('+bySkill[id].pts.length+')</option>'; }).join('');
      sel.onchange = function(){ draw(sel.value); };
      draw(ids[0]);
    });

  function draw(skillId){
    var s = bySkill[skillId]; if(!s) return;
    var labels = s.pts.map(function(p){ return fmt(p.assessedAt); });
    var data = s.pts.map(function(p){ return p.newLevel; });
    var ctx = document.getElementById('st-chart').getContext('2d');
    if(chart) chart.destroy();
    chart = new Chart(ctx, { type:'line', data:{ labels:labels, datasets:[{ label:s.name+' — level', data:data, stepped:true, borderColor:SEMC.neutral, backgroundColor:ROLEC.neutralFillSoft, fill:true, pointRadius:4, tension:0 }]},
      options:{ responsive:true, maintainAspectRatio:false, scales:{ y:{ min:0, max:4, ticks:{ stepSize:1 }, title:{display:true,text:<%- JSON.stringify(__('admin:level_axis')) %>} } }, plugins:{ legend:{display:false}, tooltip:{ callbacks:{ afterLabel:function(c){ var p=s.pts[c.dataIndex]; return (p.source?('source: '+p.source):'')+(p.actorType?(' · '+p.actorType):''); } } } } } });
    var first=s.pts[0], last=s.pts[s.pts.length-1];
    document.getElementById('st-summary').textContent = s.pts.length+' change(s) · '+first.newLevel+' → '+last.newLevel+' (from '+fmt(first.assessedAt)+' to '+fmt(last.assessedAt)+')';
  }

  fetch('/api/self-assessment/employee/'+EMP+'/movement',{headers:{Accept:'application/json'}})
    .then(function(r){ return r.ok?r.json():{events:[]}; })
    .then(function(j){
      var box = document.getElementById('st-movement'); var ev = j.events||[];
      if(!ev.length){ box.innerHTML='<div class="text-muted" style="padding:.75rem">'+<%- JSON.stringify(__('admin:no_movement')) %>+'</div>'; return; }
      box.innerHTML = ev.map(function(e){
        var c = ACT_COLOR[e.action]||'#64748b';
        var arrow = (e.fromState&&e.toState)?(' <span class="text-muted">'+esc(e.fromState)+'→'+esc(e.toState)+'</span>'):'';
        return '<div class="st-ev"><span class="st-dot" style="background:'+c+'"></span><div><span class="st-act" style="color:'+c+'">'+esc(e.action)+'</span> <span class="text-muted">by '+esc(e.actorType||'?')+'</span>'+arrow+(e.skillName?(' · '+esc(e.skillName)):'')+'<div class="st-when">'+FMT.dateTime(e.createdAt)+'</div></div></div>';
      }).join('');
    });
  function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
})();
</script>

<!-- 9-Box placement trend over time -->
<div class="detail-section" style="margin-top:1.25rem">
  <h2><i class="fas fa-puzzle-piece" aria-hidden="true"></i> <%= __('admin:ninebox_history') %></h2>
  <div class="card" style="padding:14px 16px">
    <div id="nbt-empty" class="text-muted" style="display:none;padding:.5rem"><%= __('admin:no_ninebox') %></div>
    <div id="nbt-wrap">
      <div id="nbt-summary" class="text-muted" style="font-size:.88rem;margin-bottom:8px"></div>
      <div style="position:relative;height:260px"><canvas id="nbt-chart"></canvas></div>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">
(function(){
  var EMP = <%= employee.id %>;
  function fmt(d){ try{ return FMT.date(d); }catch(e){ return String(d).slice(0,10); } }
  fetch('/api/ninebox/employee/'+EMP+'/trend',{headers:{Accept:'application/json'}})
    .then(function(r){ return r.ok?r.json():{trend:[]}; })
    .then(function(j){
      var t = j.trend||[];
      if(!t.length){ document.getElementById('nbt-empty').style.display='block'; document.getElementById('nbt-wrap').style.display='none'; return; }
      // Localized 9-box cell name. `boxLabel` is the hardcoded English string the
      // service stored at placement time, so rendering it put 'Gold Star' into a
      // French chart. Derive from potential-performance, the same key the service
      // uses; fall back to the stored value only if the pair is unrecognised.
      var NB_CELL = {
        'high-low':<%- JSON.stringify(__('talentx:nb_cell_diamond')) %>, 'high-medium':<%- JSON.stringify(__('talentx:nb_cell_shooting')) %>, 'high-high':<%- JSON.stringify(__('talentx:nb_cell_gold')) %>,
        'medium-low':<%- JSON.stringify(__('talentx:nb_cell_dilemma')) %>, 'medium-medium':<%- JSON.stringify(__('talentx:nb_cell_critical')) %>, 'medium-high':<%- JSON.stringify(__('talentx:nb_cell_emerging')) %>,
        'low-low':<%- JSON.stringify(__('talentx:nb_cell_concern')) %>, 'low-medium':<%- JSON.stringify(__('talentx:nb_cell_essential')) %>, 'low-high':<%- JSON.stringify(__('talentx:nb_cell_trusted')) %>
      };
      var NB_BOX_WORD = <%- JSON.stringify(__('talentx:nb_box_word')) %>;
      function nbCell(p){ return (p && NB_CELL[p.potential+'-'+p.performance]) || (p && p.boxLabel) || (NB_BOX_WORD+' '+(p&&p.box)); }
      var labels = t.map(function(p){ return fmt(p.at); });
      var ctx = document.getElementById('nbt-chart').getContext('2d');
      new Chart(ctx, { type:'line', data:{ labels:labels, datasets:[
          { label:<%- JSON.stringify(__('admin:performance')) %>, data:t.map(function(p){return p.perfScore;}), stepped:true, borderColor:SEMC.mid, backgroundColor:'transparent', pointRadius:4, tension:0 },
          { label:<%- JSON.stringify(__('admin:potential')) %>, data:t.map(function(p){return p.potScore;}), stepped:true, borderColor:SEMC.neutral, backgroundColor:'transparent', pointRadius:4, tension:0 }
        ]},
        options:{ responsive:true, maintainAspectRatio:false,
          scales:{ y:{ min:1, max:3, ticks:{ stepSize:1, callback:function(v){return {1:<%- JSON.stringify(__('admin:low')) %>,2:<%- JSON.stringify(__('admin:medium')) %>,3:<%- JSON.stringify(__('admin:high')) %>}[v]||v;} } } },
          plugins:{ legend:{position:'bottom'}, tooltip:{ callbacks:{ title:function(c){ return labels[c[0].dataIndex]; }, afterBody:function(c){ var p=t[c[0].dataIndex]; return NB_BOX_WORD+': '+nbCell(p); } } } } } });
      var first=t[0], last=t[t.length-1];
      document.getElementById('nbt-summary').innerHTML = t.length+' placement(s) · latest: <strong>'+esc9(nbCell(last))+'</strong> (perf '+last.performance+' / pot '+last.potential+') · from '+fmt(first.at)+' to '+fmt(last.at);
    }).catch(function(){});
  function esc9(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
})();
</script>

