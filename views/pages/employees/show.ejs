    <div class="dev-card"><div class="dev-h"><i class="fas fa-stopwatch" aria-hidden="true"></i> <%= __('admin:improvement_plans_pip') %></div><div id="dev-pip" class="dev-body"><div class="text-muted" style="padding:.5rem"><%= __('admin:loading') %></div></div></div>
