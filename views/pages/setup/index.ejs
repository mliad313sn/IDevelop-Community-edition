<%#
  /setup — « Getting started » and « Ready for go-live » (SetupController).
  A SuperAdmin reads the organisation's counts and may hide the banner. Any
  other administrator reads it READ-ONLY (readOnly): the people counts are
  those of their clearance, a step links only to a page their permissions
  open, the administrator-account lines show a state without a count, and
  there is no dismiss. « Not measured » (a source that could not be read) is
  never « done »; the decisions (SSO, shared computers, local content) are
  reported, never scored, never changed here. Server-rendered, no script.
  Locals: checks, complete, golive, readOnly.
-%><%
  var RO = (typeof readOnly !== 'undefined') && readOnly;
  var GL = (typeof golive !== 'undefined' && golive) ? golive : null;
  var _pick = function (map, k) { return Object.prototype.hasOwnProperty.call(map, k) ? map[k] : null; };
  var GL_LBL = {
      gl_safety: ['admin:setup_gl_safety', 'admin:setup_gl_safety_sub'],
      gl_critical_roles: ['admin:setup_gl_critical_roles', 'admin:setup_gl_critical_roles_sub'],
      gl_critical_skills: ['admin:setup_gl_critical_skills', 'admin:setup_gl_critical_skills_sub'],
      gl_measurable: ['admin:setup_gl_measurable', 'admin:setup_gl_measurable_sub'],
      gl_kpi_targets: ['admin:setup_gl_kpi_targets', 'admin:setup_gl_kpi_targets_sub'],
      gl_admin_mfa: ['admin:setup_gl_admin_mfa', 'admin:setup_gl_admin_mfa_sub'],
      gl_access_review: ['admin:setup_gl_access_review', 'admin:setup_gl_access_review_sub'],
      gl_privacy: ['admin:setup_gl_privacy', 'admin:setup_gl_privacy_sub'],
      gl_backup: ['admin:setup_gl_backup', 'admin:setup_gl_backup_sub'],
      gl_sso: ['admin:setup_gl_sso', 'admin:setup_gl_sso_sub'],
      gl_kiosk: ['admin:setup_gl_kiosk', 'admin:setup_gl_kiosk_sub'],
      gl_local_content: ['admin:setup_gl_local_content', 'admin:setup_gl_local_content_sub']
  };
  var GL_ST = { done: 'admin:setup_gl_st_done', todo: 'admin:setup_gl_st_todo', empty: 'admin:setup_gl_st_empty', unmeasured: 'admin:setup_gl_st_unmeasured', info: 'admin:setup_gl_st_info' };
  var GL_TONE = { done: 'good', todo: 'warn', empty: 'neutral', unmeasured: 'unmeasured', info: 'neutral' };
  var GL_ICON = { done: '✓', todo: '!', empty: '·', unmeasured: '—', info: 'i' };
-%>
<link rel="stylesheet" href="/css/admin-insight.css?v=<%= assetVersion %>">
<div class="page-header">
    <h1><i class="fas fa-list-check" aria-hidden="true"></i> <%= __('admin:setup_title') %></h1>
</div>

<div class="help-text gl-help"><%= __('admin:setup_help', { brand: (typeof brandName!=='undefined' && brandName) ? brandName : 'IDevelop' }) %></div>
<% if (RO) { %>
<p class="ai-note" data-setup-readonly><i class="fas fa-eye" aria-hidden="true"></i> <%= __('admin:setup_readonly_note') %></p>
<% } %>

<% if (complete) { %>
    <div class="card hz-callout gl-ready">
        <i class="fas fa-circle-check" aria-hidden="true"></i>
        <strong><%= __('admin:setup_complete') %></strong>
    </div>
<% } %>

<% const _ck = {}; checks.forEach(function (c) { _ck[c.key] = c; }); %>
<% if (!RO && ((_ck.skills && !_ck.skills.done) || (_ck.employees && !_ck.employees.done))) { %>
<div class="card hz-callout gl-ready">
    <h2 class="gl-title"><i class="fas fa-seedling" aria-hidden="true"></i> <%= __('admin:setup_sample_title') %></h2>
    <p class="gl-sub"><%= __('admin:setup_sample_body') %></p>
    <ul class="gl-sample">
        <% if (_ck.skills && !_ck.skills.done) { %><li><%= __('admin:setup_sample_starter') %> <code>npm run db:seed:starter -- --commit</code></li><% } %>
        <li><%= __('admin:setup_sample_demo') %> <code>npm run db:seed:demo-org -- --commit</code></li>
    </ul>
</div>
<% } %>

<ul class="card gl-list" data-setup="first-run">
    <% const LBL = {
        modules: [__('admin:setup_modules'), __('admin:setup_modules_sub')],
        org: [__('admin:setup_org'), __('admin:setup_org_sub')],
        skills: [__('admin:setup_skills'), __('admin:setup_skills_sub')],
        roles: [__('admin:setup_roles'), __('admin:setup_roles_sub')],
        employees: [__('admin:setup_employees'), __('admin:setup_employees_sub')],
        reviewers: [__('admin:setup_reviewers'), __('admin:setup_reviewers_sub')],
        contactable: [__('admin:setup_contactable'), __('admin:setup_contactable_sub')],
        cycle: [__('admin:setup_cycle'), __('admin:setup_cycle_sub')],
        assessments: [__('admin:setup_assessments'), __('admin:setup_assessments_sub')],
        email: [__('admin:setup_email'), __('admin:setup_email_sub')],
        hris: [__('admin:setup_hris'), __('admin:setup_hris_sub')],
    }; %>
    <% checks.forEach(function(c){ const l = LBL[c.key] || [c.key, '']; %>
        <li class="gl-row" data-step="<%= c.key %>">
            <span class="viz-chip viz-chip--<%= c.done ? 'good' : 'neutral' %>"><span class="viz-chip-icon" aria-hidden="true"><%= c.done ? '✓' : '·' %></span><span class="sr-only"><%= c.done ? __('admin:setup_gl_st_done') : __('admin:setup_gl_st_todo') %></span></span>
            <div class="gl-body">
                <strong><%= l[0] %></strong>
                <% if (c.optional) { %><span class="badge badge-secondary"><%= __('admin:setup_optional') %></span><% } %>
                <div class="gl-sub"><%= l[1] %></div>
            </div>
            <span class="gl-count"><%= c.count %></span>
            <% if (c.href) { %><a href="<%= c.href %>" class="btn btn-sm <%= c.done || RO ? 'btn-secondary' : 'btn-primary' %>"><%= c.done || RO ? __('admin:setup_review') : __('admin:setup_start') %></a><% } else { %><span class="gl-sub"><%= __('admin:setup_gl_no_link') %></span><% } %>
        </li>
    <% }); %>
</ul>

<% if (GL) { %>
<h2 class="gl-title" id="golive"><i class="fas fa-flag-checkered" aria-hidden="true"></i> <%= __('admin:setup_gl_title') %></h2>
<p class="ai-note"><%= __('admin:setup_gl_help') %></p>
<div class="card gl-ready" data-golive-ready="<%= GL.ready ? 'yes' : 'no' %>">
    <% if (GL.ready) { %>
    <span class="viz-chip viz-chip--good"><span class="viz-chip-icon" aria-hidden="true">✓</span><span><%= __('admin:setup_gl_ready') %></span></span>
    <% } else { %>
    <span class="viz-chip viz-chip--warn"><span class="viz-chip-icon" aria-hidden="true">!</span><span><%= __('admin:setup_gl_todo', { count: GL.todo, n: numFmt.num(GL.todo, 0) }) %></span></span>
    <% } %>
</div>
<ul class="card gl-list" data-setup="go-live">
    <% GL.lines.forEach(function (g) { var L = _pick(GL_LBL, g.key) || [g.key, g.key]; var cnt = g.count; if (cnt === 'on') cnt = __('admin:setup_gl_on'); else if (cnt === 'off') cnt = __('admin:setup_gl_off'); %>
        <li class="gl-row" data-gl="<%= g.key %>" data-gl-state="<%= g.state %>">
            <span class="viz-chip viz-chip--<%= _pick(GL_TONE, g.state) || 'neutral' %>"><span class="viz-chip-icon" aria-hidden="true"><%= _pick(GL_ICON, g.state) || '·' %></span><span><%= __(_pick(GL_ST, g.state) || 'admin:setup_gl_st_unmeasured') %></span></span>
            <div class="gl-body">
                <strong><%= __(L[0]) %></strong>
                <div class="gl-sub"><%= __(L[1]) %></div>
            </div>
            <span class="gl-count"><%= (cnt === null || cnt === undefined) ? '' : cnt %></span>
            <% if (g.href) { %><a href="<%= g.href %>" class="btn btn-sm <%= g.state === 'todo' && !RO ? 'btn-primary' : 'btn-secondary' %>"><%= g.state === 'todo' && !RO ? __('admin:setup_start') : __('admin:setup_review') %></a><% } else { %><span class="gl-sub"><%= __('admin:setup_gl_no_link') %></span><% } %>
        </li>
    <% }); %>
</ul>
<% } %>

<% if (!RO && typeof user !== 'undefined' && user && user.role === 'superadmin') { %>
<!-- Dismiss hides the banner org-wide, so it's superadmin-only (matches the route). -->
<form method="POST" action="/setup/dismiss" class="gl-dismiss">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn btn-secondary btn-sm"><%= __('admin:setup_dismiss') %></button>
</form>
<% } %>
