<%#
  « Decisions » of a board pack (migration 197, BoardDecisionController).
  The decisions taken on the pack of ONE scope: record what the meeting
  decided (the owner is a ROLE, never a person), follow it (state and notes,
  an append-only history), and the next pack prints them. A text that names
  a person is refused before it is written. Server-rendered; no script of its
  own, no inline handler: the confirmation goes through ui-feedback's
  declarative data-confirm. Required fields: the form legend and the CSS
  marker, never a typed « * ».
  Locals: ctx, decisions (null = not available), scopeLabel, hidden (scope
  fields), canWrite, ownerRoles, states, kpis, today.
-%><%
  var DL = (typeof decisions !== 'undefined') ? decisions : null;
  var HF = hidden || [];
  var tone = { open: 'info', in_progress: 'info', done: 'ok', dropped: 'neutral' };
  // full keys (the locale scan reads them); an unknown code falls back to the first
  var _pick = function (map, k) { return Object.prototype.hasOwnProperty.call(map, k) ? map[k] : map[Object.keys(map)[0]]; };
  var _role = { exec_committee: 'exec:bd_role_exec_committee', hr_director: 'exec:bd_role_hr_director', hse: 'exec:bd_role_hse', site: 'exec:bd_role_site', training: 'exec:bd_role_training', hr_local: 'exec:bd_role_hr_local', managers: 'exec:bd_role_managers', finance: 'exec:bd_role_finance' };
  var _state = { open: 'exec:bd_state_open', in_progress: 'exec:bd_state_in_progress', done: 'exec:bd_state_done', dropped: 'exec:bd_state_dropped' };
  var roleOpts = [{ value: '', label: __('exec:bd_pick_role') }].concat((ownerRoles || []).map(function (r) { return { value: r, label: __(_pick(_role, r)) }; }));
  var kpiOpts = [{ value: '', label: __('exec:bd_no_kpi') }].concat((kpis || []).map(function (k) { return { value: k, label: __('kpi:' + k.toLowerCase() + '_name') }; }));
  var stateOpts = (states || []).map(function (s) { return { value: s, label: __(_pick(_state, s)) }; });
  var _q = ctx.scopeQuery ? '?' + ctx.scopeQuery : '';
  var _d = function (s) { return s ? fmtDate(s) : '—'; };
-%>
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>">
<div class="page-header">
    <h1><i class="fas fa-gavel" aria-hidden="true"></i> <%= __('exec:bd_title') %></h1>
</div>
<p class="text-muted"><%= __('exec:bd_subtitle') %></p>
<p class="bd-scope"><i class="fas fa-user-lock" aria-hidden="true"></i> <%= __('exec:bd_scope', { scope: scopeLabel || '' }) %> <span class="text-muted"><%= __('exec:bd_scope_note') %></span></p>
<p class="bp-actions"><a class="btn btn-secondary" href="/exec/board-pack<%= _q %>"><i class="fas fa-briefcase" aria-hidden="true"></i> <%= __('exec:bd_back_pack') %></a></p>

<% if (ctx.scopeRefused) { %>
    <div class="card hz-callout" role="alert"><p><strong><%= __('dash:d3_scope_refused_title') %></strong> <%= __('dash:d3_scope_refused_text') %></p></div>
<% } else if (DL === null) { %>
    <p class="ds-note"><%= __('exec:bd_unavailable') %></p>
<% } else { %>

<% if (canWrite) { %>
<section class="card bd-card" aria-labelledby="bd-new-h">
    <h2 id="bd-new-h" class="h3"><%= __('exec:bd_new_title') %></h2>
    <%- include('../../partials/form-legend') %>
    <form method="POST" action="/exec/decisions" class="bd-grid" id="bd-new">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% HF.forEach(function (f) { %><input type="hidden" name="<%= f.name %>" value="<%= f.value %>"><% }); %>
        <div class="bd-wide">
            <%- include('../../partials/form-field', { id: 'bd-text', name: 'decisionText', type: 'textarea', label: __('exec:bd_field_text'), required: true, hint: __('exec:bd_field_text_hint'), attrs: { maxlength: 2000, rows: 3 } }) %>
        </div>
        <%- include('../../partials/form-field', { id: 'bd-role', name: 'ownerRole', type: 'select', label: __('exec:bd_field_owner'), required: true, options: roleOpts, hint: __('exec:bd_field_owner_hint') }) %>
        <%- include('../../partials/form-field', { id: 'bd-kpi', name: 'kpiId', type: 'select', label: __('exec:bd_field_kpi'), options: kpiOpts, hint: __('exec:bd_field_kpi_hint') }) %>
        <%- include('../../partials/form-field', { id: 'bd-decided', name: 'decidedAt', type: 'date', label: __('exec:bd_field_decided'), required: true, value: today || '', attrs: { max: today || false } }) %>
        <%- include('../../partials/form-field', { id: 'bd-pack', name: 'packDate', type: 'date', label: __('exec:bd_field_pack'), value: today || '', hint: __('exec:bd_field_pack_hint') }) %>
        <%- include('../../partials/form-field', { id: 'bd-due', name: 'dueDate', type: 'date', label: __('exec:bd_field_due'), hint: __('exec:bd_field_due_hint') }) %>
        <div class="bd-wide bp-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i> <%= __('exec:bd_submit') %></button>
        </div>
    </form>
</section>
<% } else { %>
    <p class="text-muted"><%= __('exec:bd_readonly') %></p>
<% } %>

<section class="card bd-card" aria-labelledby="bd-list-h">
    <h2 id="bd-list-h" class="h3"><%= __('exec:bd_list_title') %></h2>
    <% if (!DL.length) { %>
        <p class="ds-note" data-bd-empty><%= __('exec:bd_none') %></p>
    <% } else { %>
    <div class="ds-table-wrap"><table class="ds-table" id="bd-table">
        <caption class="sr-only"><%= __('exec:bd_list_title') %></caption>
        <thead><tr>
            <th scope="col"><%= __('exec:bd_col_decided') %></th>
            <th scope="col"><%= __('exec:bd_col_text') %></th>
            <th scope="col"><%= __('exec:bd_col_owner') %></th>
            <th scope="col"><%= __('exec:bd_col_due') %></th>
            <th scope="col"><%= __('exec:bd_col_kpi') %></th>
            <th scope="col"><%= __('exec:bd_col_state') %></th>
        </tr></thead>
        <tbody>
        <% DL.forEach(function (x) { %>
            <tr data-decision="<%= x.id %>" data-state="<%= x.state %>">
                <td><%= _d(x.decidedAt) %><br><span class="text-muted"><%= __('exec:bd_pack_of', { date: _d(x.packDate) }) %></span></td>
                <td><%= x.text %></td>
                <td><%= __(_pick(_role, x.ownerRole)) %></td>
                <td><%= x.dueDate ? _d(x.dueDate) : __('exec:bd_no_due') %></td>
                <td><%= x.kpiId ? __('kpi:' + x.kpiId.toLowerCase() + '_name') : '—' %></td>
                <td><%- include('../../partials/status-badge', { tone: x.late ? 'warn' : tone[x.state], label: x.late ? __('exec:bd_state_late') : __(_pick(_state, x.state)), text: true }) %></td>
            </tr>
            <tr class="bd-follow" data-follow="<%= x.id %>">
                <td colspan="6">
                    <details>
                        <summary><%= __('exec:bd_history', { count: x.events.length, n: x.events.length }) %></summary>
                        <ol class="bd-events">
                        <% x.events.forEach(function (e) { %>
                            <li><%= _d(e.on) %> — <%= e.kind === 'created' ? __('exec:bd_ev_created') : (e.kind === 'state' ? __('exec:bd_ev_state', { from: __(_pick(_state, e.fromState)), to: __(_pick(_state, e.toState)) }) : __('exec:bd_ev_note')) %><% if (e.mine) { %> <span class="text-muted">(<%= __('exec:bd_ev_mine') %>)</span><% } %><% if (e.note) { %><%= colon %> « <%= e.note %> »<% } %></li>
                        <% }); %>
                        </ol>
                        <% if (canWrite) { %>
                        <form method="POST" action="/exec/decisions/<%= x.id %>/state" class="bd-grid" data-confirm="<%= __('exec:bd_state_confirm') %>" data-confirm-title="<%= __('exec:bd_state_confirm_title') %>" data-confirm-yes="<%= __('exec:bd_state_submit') %>">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <% HF.forEach(function (f) { %><input type="hidden" name="<%= f.name %>" value="<%= f.value %>"><% }); %>
                            <%- include('../../partials/form-field', { id: 'bd-state-' + x.id, name: 'state', type: 'select', label: __('exec:bd_field_state'), required: true, value: x.state, options: stateOpts }) %>
                            <%- include('../../partials/form-field', { id: 'bd-state-note-' + x.id, name: 'note', type: 'textarea', label: __('exec:bd_field_state_note'), hint: __('exec:bd_field_state_note_hint'), attrs: { maxlength: 2000, rows: 2 } }) %>
                            <div class="bd-wide bp-actions"><button type="submit" class="btn btn-secondary"><%= __('exec:bd_state_submit') %></button></div>
                        </form>
                        <form method="POST" action="/exec/decisions/<%= x.id %>/note" class="bd-grid">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <% HF.forEach(function (f) { %><input type="hidden" name="<%= f.name %>" value="<%= f.value %>"><% }); %>
                            <div class="bd-wide">
                                <%- include('../../partials/form-field', { id: 'bd-note-' + x.id, name: 'note', type: 'textarea', label: __('exec:bd_field_note'), required: true, attrs: { maxlength: 2000, rows: 2 } }) %>
                            </div>
                            <div class="bd-wide bp-actions"><button type="submit" class="btn btn-secondary"><%= __('exec:bd_note_submit') %></button></div>
                        </form>
                        <% } %>
                    </details>
                </td>
            </tr>
        <% }); %>
        </tbody>
    </table></div>
    <% } %>
</section>
<% } %>
