<%#
  Board pack — ONE print-ready brief a director takes into the committee.
  The same figures as the dashboard, from the same service over the same
  scope (the scope bar's remembered choice for this page), so the pack can
  never be contradicted by the app it was printed from. COUNTS ONLY: no
  person is named in the pack. « Not measured » is printed in words, never 0;
  fewer than 5 people never get a percentage. The masthead reads the
  white-label branding.
  Locals: ctx, screen (firstScreen), overview (tabModel 'overview' | null),
  scopeLabel, generatedAt.
-%><%
  var _F = numFmt;
  var _num = function (v) { return v !== null && v !== undefined && v !== '' && isFinite(Number(v)); };
  var brand = (typeof branding !== 'undefined' && branding && branding.appName) ? branding.appName : '';
  var brandLogo = (typeof branding !== 'undefined' && branding && branding.logoUrl) ? branding.logoUrl : null;
  var S = screen || { tiles: [], more: [], brief: [], setup: [] };
  var tiles = (S.tiles || []).concat(S.more || []);
  var _icon = { good: '✓', warn: '!', risk: '▲' };
  var _value = function (k) {
      if (k.emptyState) return k.emptyState.message;
      var den = _num(k.denominator) ? Number(k.denominator) : null;
      if (!_num(k.value) || ((k.unit || 'pct') === 'pct' && den === 0)) return __('viz:unmeasured');
      if ((k.unit || 'pct') === 'pct' && den !== null && den < 5) return __('viz:tile.of', { a: _F.num(k.numerator, 0), b: _F.num(den, 0) });
      return (k.unit || 'pct') === 'pct' ? _F.pct(k.value, 1) : _F.num(k.value, 0);
  };
  var _delta = function (k) {
      if (!_num(k.delta)) return '—';
      var d = Number(k.delta);
      return (d > 0 ? '+' : (d < 0 ? '−' : '')) + ((k.unit || 'pct') === 'pct' ? _F.num(Math.abs(d), 1) + ' ' + __('viz:tile.pts') : _F.num(Math.abs(d), 0));
  };
  var O = overview || null;
  var rec = (O && O.recorded) || [];
  var _q = ctx.scopeQuery ? '?' + ctx.scopeQuery : '';
-%>
<link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>">
<article class="board-pack" id="board-pack">
  <header class="bp-head">
    <div class="bp-brand">
      <% if (brandLogo) { %><img src="<%= brandLogo %>" alt="" class="bp-logo"><% } %>
      <% if (brand) { %><span class="bp-brandname"><%= brand %></span><% } %>
    </div>
    <h1><%= __('exec:bp_title') %></h1>
    <p class="bp-sub"><%= __('exec:bp_subtitle') %></p>
    <p class="bp-meta"><%= __('exec:bp_generated').replace('{d}', fmtDate(generatedAt)) %> · <%= __('dash:d3_bp_scope', { scope: scopeLabel, n: _F.num(ctx.pop.ids.length, 0) }) %></p>
    <p class="bp-actions no-print">
      <button type="button" class="btn btn-primary" data-print><i class="fas fa-print" aria-hidden="true"></i> <%= __('dash:d3_bp_print') %></button>
      <a class="btn btn-secondary" href="/dashboard<%= _q %>"><%= __('exec:back_dashboard') %></a>
    </p>
  </header>

  <% if (ctx.scopeRefused) { %>
    <div class="card hz-callout" role="alert"><p><strong><%= __('dash:d3_scope_refused_title') %></strong> <%= __('dash:d3_scope_refused_text') %></p></div>
  <% } %>

  <% if (!ctx.caps.pop) { %>
    <p class="ds-note"><strong><%= __('dash:d3_no_scope_title') %></strong> <%= __('dash:d3_no_scope_text') %></p>
  <% } else { %>
  <section class="bp-section" id="bp-brief">
    <h2><%= __('dash:d3_bp_section_brief') %></h2>
    <ul class="bp-list">
      <% (S.brief || []).forEach(function (l) { %><li><%= l.text %></li><% }); %>
    </ul>
  </section>

  <section class="bp-section" id="bp-kpis">
    <h2><%= __('dash:d3_bp_section_kpi') %></h2>
    <div class="ds-table-wrap"><table class="ds-table">
      <thead><tr><th scope="col"><%= __('dash:d3_bp_indicator') %></th><th scope="col" class="num"><%= __('dash:d3_bp_value') %></th><th scope="col"><%= __('dash:d3_bp_status') %></th><th scope="col" class="num"><%= __('dash:d3_bp_movement') %><% if (S.since) { %> (<%= __('viz:tile.delta_since', { date: fmtDate(S.since) }) %>)<% } %></th></tr></thead>
      <tbody>
      <% tiles.forEach(function (k) { %>
        <tr data-kpi="<%= k.kpi %>">
          <th scope="row"><%= k.label %><% if (k.sub) { %><br><span class="ds-note"><%= k.sub %></span><% } %></th>
          <td class="num"><%= _value(k) %></td>
          <td><% if (k.status) { %><span class="viz-chip viz-chip--<%= k.status %>"><span class="viz-chip-icon" aria-hidden="true"><%= _icon[k.status] %></span><span><%= __('viz:status.' + k.status) %></span></span><% } else { %>—<% } %></td>
          <td class="num"><%= _delta(k) %></td>
        </tr>
      <% }); %>
      </tbody>
    </table></div>
  </section>

  <% if (O) { %>
  <section class="bp-section" id="bp-trend">
    <h2><%= __('dash:d3_bp_section_trend') %></h2>
    <% if (!rec.length) { %>
      <p class="ds-note"><%= __('exec:bp_no_trend') %></p>
    <% } else { %>
      <div class="ds-table-wrap"><table class="ds-table">
        <thead><tr><th scope="col"><%= __('dash:d3_bp_month') %></th><th scope="col" class="num"><%= __('kpi:k1_name') %></th><th scope="col" class="num"><%= __('kpi:k3_name') %></th></tr></thead>
        <tbody>
        <% rec.slice(-12).forEach(function (p) { %><tr><th scope="row"><%= typeof monthLabel === 'function' ? monthLabel(p.month) : p.month %></th><td class="num"><%= _num(p.K1) ? _F.pct(p.K1, 1) : __('viz:unmeasured') %></td><td class="num"><%= _num(p.K3) ? _F.pct(p.K3, 1) : __('viz:unmeasured') %></td></tr><% }); %>
        </tbody>
      </table></div>
    <% } %>
  </section>

  <% if (O.sites && O.sites.length) { %>
  <section class="bp-section" id="bp-sites">
    <h2><%= __('dash:d3_bp_section_sites') %></h2>
    <div class="ds-table-wrap"><table class="ds-table">
      <thead><tr><th scope="col"><%= __('dash:d3_col_site') %></th><th scope="col" class="num"><%= __('dash:d3_col_k1') %></th><% if (O.sites.some(function (r) { return r.k8; })) { %><th scope="col" class="num"><%= __('dash:d3_col_k8') %></th><% } %><% if (O.sites.some(function (r) { return r.k9; })) { %><th scope="col" class="num"><%= __('dash:d3_col_k9') %></th><% } %></tr></thead>
      <tbody>
      <% var _h8 = O.sites.some(function (r) { return r.k8; }), _h9 = O.sites.some(function (r) { return r.k9; }); %>
      <% O.sites.forEach(function (r) { %><tr><th scope="row"><%= r.noSite ? __('viz:no_site') : r.siteName %></th><td class="num"><%- include('../dashboard/_kpi-cell', { r: r.k1, unit: 'pct' }) %></td><% if (_h8) { %><td class="num"><%- include('../dashboard/_kpi-cell', { r: r.k8, unit: 'count' }) %></td><% } %><% if (_h9) { %><td class="num"><%- include('../dashboard/_kpi-cell', { r: r.k9, unit: 'pct' }) %></td><% } %></tr><% }); %>
      </tbody>
    </table></div>
  </section>
  <% } %>
  <% } %>

  <% if ((S.setup || []).length) { %>
  <section class="bp-section" id="bp-setup">
    <h2><%= __('dash:d3_bp_section_setup') %></h2>
    <ul class="bp-list">
      <% S.setup.forEach(function (it) { %><li><%= it.key === 'setup' ? __('dash:d3_setup_setup', { done: it.done, total: it.total }) : __('dash:d3_setup_' + it.key) %></li><% }); %>
    </ul>
  </section>
  <% } %>
  <% } %>

  <footer class="bp-foot">
    <p><%= __('dash:d3_bp_footnote') %></p>
  </footer>
</article>
<script src="/js/board-pack.js?v=<%= assetVersion %>"></script>
