<div class="page-header">
  <h1><i class="fas fa-clipboard-list" aria-hidden="true"></i> <%= __('talentx:ta_title') %></h1>
  <p class="text-muted"><%= __('talentx:ta_intro') %></p>
</div>

<!-- Summary cards -->
<div class="ta-cards">
  <div class="ta-card"><div class="ta-n"><%= summary.pipsActive %><span class="ta-of">/ <%= summary.pipsTotal %></span></div><div class="ta-l"><%= __('talentx:ta_pips_active') %></div></div>
  <div class="ta-card"><div class="ta-n"><%= summary.idpsActive %><span class="ta-of">/ <%= summary.idpsTotal %></span></div><div class="ta-l"><%= __('talentx:ta_idps_active') %></div></div>
  <div class="ta-card"><div class="ta-n"><%= summary.coachingActive %><span class="ta-of">/ <%= summary.coachingTotal %></span></div><div class="ta-l"><%= __('talentx:ta_coaching_active') %></div></div>
  <%# avgProgress is NULL when no coaching is active — render a dash, never "0 %". %>
  <% if (summary.avgProgress === null || summary.avgProgress === undefined) { %>
  <div class="ta-card" title="<%= __('talentx:ta_avg_progress_none') %>"><div class="ta-n"><span class="text-muted" aria-label="<%= __('dash:rd_not_measured') %>">—</span></div><div class="ta-l"><%= __('talentx:ta_avg_progress') %> <span class="text-muted" style="font-weight:400">· <%= __('dash:rd_not_measured') %></span></div></div>
  <% } else { %>
  <div class="ta-card"><div class="ta-n"><%= summary.avgProgress %>%</div><div class="ta-l"><%= __('talentx:ta_avg_progress') %></div></div>
  <% } %>
  <div class="ta-card <%= bias.length ? 'ta-warn' : '' %>"><div class="ta-n"><%= bias.length %></div><div class="ta-l"><%= __('talentx:ta_bias_alerts') %></div></div>
</div>

<!-- Needs attention -->
<% var needs = attention.pipsProposed + attention.idpsDraft + attention.coachingStalled + attention.biasOpen; %>
<div class="ta-attention <%= needs ? '' : 'ta-clear' %>">
  <% if (needs) { %>
    <strong><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> <%= __('talentx:ta_needs_attention') %></strong>
    <% if (attention.pipsProposed) { %><a href="/v2/pip" class="ta-chip"><%= attention.pipsProposed %> <%= __('talentx:ta_pips_awaiting') %></a><% } %>
    <% if (attention.idpsDraft) { %><a href="/v2/idp/manage" class="ta-chip"><%= attention.idpsDraft %> <%= __('talentx:ta_idps_draft') %></a><% } %>
    <% if (attention.coachingStalled) { %><a href="/coaching/plans" class="ta-chip"><%= attention.coachingStalled %> <%= __('talentx:ta_coaching_stalled') %></a><% } %>
    <% if (attention.biasOpen) { %><a href="/talent/nine-box" class="ta-chip"><%= attention.biasOpen %> <%= __('talentx:ta_bias_open') %></a><% } %>
  <% } else { %>
    <strong><i class="fas fa-circle-check" aria-hidden="true"></i> <%= __('talentx:ta_all_clear') %></strong> — <%= __('talentx:ta_no_items') %>
  <% } %>
</div>

<div class="ta-toolbar">
  <input id="ta-search" class="form-control" placeholder="<%= __('talentx:ta_filter_ph') %>" style="max-width:420px">
  <span style="display:flex;align-items:center;gap:14px">
    <span class="text-muted" style="font-size:.85rem"><%= __('talentx:ta_by_context') %> <%= summary.byContext.skill_gap %> · PIP <%= summary.byContext.pip %> · IDP <%= summary.byContext.idp %></span>
    <button id="ta-export" class="btn btn-secondary" type="button"><i class="fas fa-download" aria-hidden="true"></i> <%= __('talentx:ta_export_csv') %></button>
  </span>
</div>

<!-- PIPs -->
<div class="card ta-section">
  <h3><i class="fas fa-user-clock" aria-hidden="true"></i> <%= __('talentx:ta_pip_heading') %> <span class="ta-count"><%= pips.length %></span> <a class="ta-link" href="/v2/pip"><%= __('talentx:ta_manage') %></a></h3>
  <table class="table"><thead><tr><th><%= __('talentx:employee') %></th><th><%= __('talentx:state') %></th><th><%= __('talentx:ta_window') %></th><th><%= __('talentx:ta_summary') %></th></tr></thead><tbody>
    <% if (!pips.length) { %><tr><td colspan="4"><em><%= __('talentx:ta_no_pips') %></em></td></tr><% } else { pips.forEach(function(p){ %>
      <tr class="ta-row" data-emp="<%= ((p.firstName||'')+' '+(p.lastName||'')+' '+(p.employeeNumber||'')).toLowerCase() %>">
        <td><strong><%= (p.firstName||'')+' '+(p.lastName||'') %></strong><div class="ta-sub"><%= p.employeeNumber||'' %></div></td>
        <td><span class="ta-badge" data-s="<%= p.state %>"><%= enumLabel(p.state) %></span></td>
        <%# `starts_on`/`ends_on` are PG `date` columns and node-pg hands them
            back as Date objects, so String(...).slice(0,10) printed « Tue Sep 15 » —
            English, truncated and WITHOUT THE YEAR, on a French page. fmtDate is the
            helper written for exactly this defect and already renders « — » when absent. %>
        <td><%= fmtDate(p.startsOn) + ' → ' + fmtDate(p.endsOn) %></td>
        <td class="ta-sub"><%= (p.summary||'').slice(0,120) %></td>
      </tr>
    <% }); } %>
  </tbody></table>
</div>

<!-- IDPs -->
<div class="card ta-section">
  <h3><i class="fas fa-seedling" aria-hidden="true"></i> <%= __('talentx:ta_idp_heading') %> <span class="ta-count"><%= idps.length %></span> <a class="ta-link" href="/v2/idp/manage"><%= __('talentx:ta_manage') %></a></h3>
  <table class="table"><thead><tr><th><%= __('talentx:employee') %></th><th><%= __('talentx:status') %></th><th><%= __('talentx:ta_priority') %></th><th><%= __('talentx:ta_window') %></th></tr></thead><tbody>
    <% if (!idps.length) { %><tr><td colspan="4"><em><%= __('talentx:ta_no_idps') %></em></td></tr><% } else { idps.forEach(function(i){ %>
      <tr class="ta-row" data-emp="<%= ((i.firstName||'')+' '+(i.lastName||'')+' '+(i.employeeNumber||'')).toLowerCase() %>">
        <td><strong><%= (i.firstName||'')+' '+(i.lastName||'') %></strong><div class="ta-sub"><%= i.employeeNumber||'' %></div></td>
        <td><span class="ta-badge" data-s="<%= i.status %>"><%= enumLabel(i.status) %></span></td>
        <td><%= i.priority||'—' %></td>
        <%# , second site (the IDP window was missed by the first report). %>
        <td><%= fmtDate(i.startsOn) + ' → ' + fmtDate(i.endsOn) %></td>
      </tr>
    <% }); } %>
  </tbody></table>
</div>

<!-- Coaching -->
<div class="card ta-section">
  <h3><i class="fas fa-people-arrows" aria-hidden="true"></i> <%= __('talentx:ta_coaching_heading') %> <span class="ta-count"><%= coaching.length %></span> <a class="ta-link" href="/coaching/plans"><%= __('talentx:ta_manage') %></a></h3>
  <table class="table"><thead><tr><th><%= __('talentx:employee') %></th><th><%= __('talentx:ta_type') %></th><th><%= __('talentx:ta_title_col') %></th><th><%= __('talentx:ta_context') %></th><th><%= __('talentx:state') %></th><th><%= __('talentx:ta_progress') %></th></tr></thead><tbody>
    <% if (!coaching.length) { %><tr><td colspan="6"><em><%= __('talentx:ta_no_coaching') %></em></td></tr><% } else { coaching.forEach(function(c){ %>
      <tr class="ta-row" data-emp="<%= ((c.firstName||'')+' '+(c.lastName||'')+' '+(c.employeeNumber||'')).toLowerCase() %>">
        <td><strong><%= (c.firstName||'')+' '+(c.lastName||'') %></strong><div class="ta-sub"><%= c.employeeNumber||'' %></div></td>
        <td><%= enumLabel(c.kind) %></td>
        <td><%= (c.title||'').slice(0,60) %></td>
        <td><% if (c.contextType) { %><span class="ta-ctx" data-c="<%= c.contextType %>"><%= enumLabel(c.contextType) %></span><% } else { %><span class="ta-sub">—</span><% } %></td>
        <td><span class="ta-badge" data-s="<%= c.state %>"><%= enumLabel(c.state) %></span></td>
        <td><div class="ta-bar"><div class="ta-fill" style="width:<%= Number(c.progress)||0 %>%"></div></div><span class="ta-sub"><%= Number(c.progress)||0 %>%</span></td>
      </tr>
    <% }); } %>
  </tbody></table>
</div>

<!-- Calibration & bias -->
<div class="card ta-section">
  <h3><i class="fas fa-scale-balanced" aria-hidden="true"></i> <%= __('talentx:ta_calibration') %> <a class="ta-link" href="/talent/nine-box"><%= __('talentx:ta_run_bias') %></a></h3>
  <% if (!bias.length) { %>
    <p class="text-muted" style="margin:.25rem 0"><%= __('talentx:ta_no_bias') %></p>
  <% } else { %>
    <table class="table"><thead><tr><th><%= __('talentx:ta_cycle') %></th><th><%= __('talentx:ta_dimension') %></th><th><%= __('talentx:ta_group') %></th><th><%= __('talentx:ta_zscore') %></th><th><%= __('talentx:state') %></th></tr></thead><tbody>
      <% bias.forEach(function(b){ %>
        <tr><td><%= b.cycleId||'—' %></td><td><%= __('talentx:ta_bias_dim_' + b.groupDim, { defaultValue: b.groupDim }) %></td><td><%= (b.groupValue === 'national' || b.groupValue === 'expatriate') ? __('talentx:ta_bias_val_' + b.groupValue) : b.groupValue %></td>
          <td><strong><%= b.zScore!=null ? Number(b.zScore).toFixed(2) : '—' %></strong></td>
          <td><span class="ta-badge" data-s="<%= b.state %>"><%= enumLabel(b.state) %></span></td></tr>
      <% }); %>
    </tbody></table>
  <% } %>
</div>

<style>
.ta-cards{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:14px}
.ta-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:14px 16px;text-align:center}
.ta-card.ta-warn{border-color:#fca5a5;background:#fff5f5}
.ta-n{font-size:1.9rem;font-weight:800;color:#1d4ed8;line-height:1}
.ta-of{font-size:.95rem;color:#94a3b8;font-weight:600;margin-left:2px}
.ta-l{color:var(--text-secondary);font-size:.78rem;text-transform:uppercase;letter-spacing:.03em;margin-top:6px}
.ta-attention{background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:10px 14px;margin-bottom:14px;font-size:.9rem;color:#92400e}
.ta-attention.ta-clear{background:#ecfdf5;border-color:#a7f3d0;color:#166534}
.ta-chip{display:inline-block;background:var(--amber-dim);border:1px solid var(--amber);color:var(--amber-text);border-radius:999px;padding:3px 10px;margin:3px 4px;font-size:.82rem;text-decoration:none}
.ta-chip:hover{background:var(--amber-dim)}
.ta-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.ta-section{padding:1rem;margin-bottom:1rem}
.ta-section h3{margin:.25rem 0 .75rem;font-size:1.05rem;display:flex;align-items:center;gap:8px}
.ta-count{background:#eef2ff;color:#3730a3;border-radius:999px;padding:1px 9px;font-size:.78rem;font-weight:700}
.ta-link{margin-left:auto;font-size:.82rem;color:#2563eb;text-decoration:none;font-weight:600}
.ta-sub{color:#94a3b8;font-size:.78rem}
.ta-badge{padding:2px 9px;border-radius:999px;color:#fff;font-size:.76rem;background:#64748b;text-transform:capitalize}
.ta-badge[data-s="active"]{background:#15803d}
.ta-badge[data-s="proposed"],.ta-badge[data-s="draft"]{background:#b45309}
.ta-badge[data-s="closed"],.ta-badge[data-s="completed"]{background:#475569}
.ta-badge[data-s="cancelled"],.ta-badge[data-s="rejected"]{background:#b91c1c}
.ta-badge[data-s="open"]{background:#b91c1c}
.ta-ctx{padding:2px 9px;border-radius:999px;font-size:.74rem;background:#eef2ff;color:#3730a3;text-transform:capitalize}
.ta-bar{display:inline-block;width:90px;height:8px;background:var(--bg-elevated);border-radius:999px;overflow:hidden;vertical-align:middle;margin-right:6px}
.ta-fill{height:100%;background:linear-gradient(90deg,#2563eb,#0ea5e9)}
@media(max-width:820px){.ta-cards{grid-template-columns:repeat(2,1fr)}}
</style>
<script nonce="<%= cspNonce %>">
(function(){
  var TA_T = {
    type: <%- JSON.stringify(__('talentx:ta_type')) %>,
    employee: <%- JSON.stringify(__('talentx:employee')) %>,
    number: <%- JSON.stringify(__('talentx:ta_number')) %>,
    statusState: <%- JSON.stringify(__('talentx:ta_status_state')) %>,
    detail: <%- JSON.stringify(__('talentx:ta_detail')) %>,
    manage: <%- JSON.stringify(__('talentx:ta_manage')) %>,
    exported: <%- JSON.stringify(__('talentx:ta_exported')) %>
  };
  var box=document.getElementById('ta-search');
  if(box){
    box.addEventListener('input',function(){
      var q=this.value.toLowerCase().trim();
      document.querySelectorAll('.ta-row').forEach(function(r){
        r.style.display=(!q||(r.dataset.emp||'').includes(q))?'':'none';
      });
    });
  }
  var btn=document.getElementById('ta-export');
  if(btn){
    btn.addEventListener('click',function(){
      var rows=[[TA_T.type,TA_T.employee,TA_T.number,TA_T.statusState,TA_T.detail]];
      function cells(tr){return Array.prototype.map.call(tr.children,function(td){return td.innerText.replace(/\s+/g,' ').trim();});}
      document.querySelectorAll('.ta-section').forEach(function(sec){
        var h=sec.querySelector('h3'); var type=h?h.innerText.replace(/\d+/g,'').replace(TA_T.manage,'').trim():'';
        sec.querySelectorAll('tbody tr.ta-row').forEach(function(tr){
          var c=cells(tr);
          rows.push([type, c[0]||'', '', c[1]||'', (c.slice(2).join(' | '))]);
        });
      });
      var csv=rows.map(function(r){return r.map(function(v){return '"'+String(v).replace(/"/g,'""')+'"';}).join(',');}).join('\n');
      var blob=new Blob([csv],{type:'text/csv'});
      var a=document.createElement('a');a.href=URL.createObjectURL(blob);
      a.download='talent-actions-'+new Date().toISOString().slice(0,10)+'.csv';
      document.body.appendChild(a);a.click();a.remove();
      if(window.toast)window.toast(TA_T.exported,'success');
    });
  }
})();
</script>
