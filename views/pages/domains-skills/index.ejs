                </div>
                <div class="form-group">
                    <label class="required" for="createSubDomainName"><%= __('framework:field_name') %></label>
                    <input type="text" id="createSubDomainName" name="name" required>
                </div>
                <div class="form-group">
                    <label for="createSubDomainDefinition"><%= __('framework:field_definition') %></label>
                    <textarea id="createSubDomainDefinition" name="definition" placeholder="<%= __('framework:definition_placeholder') %>"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary"><%= __('framework:btn_create') %></button>
                    <button type="button" class="btn btn-secondary" data-on-click="hideModal" data-args='["createSubDomainModal"]'><%= __('framework:btn_cancel') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="editSubDomainModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2><%= __('framework:modal_edit_subdomain') %></h2>
            <button class="close" type="button" aria-label="<%= __('common:close') %>" data-on-click="hideModal" data-args='["editSubDomainModal"]'>&times;</button>
        </div>
        <div class="modal-body">
            <form id="editSubDomainForm" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label class="required" for="editSubDomainDomainId"><%= __('framework:field_pillar') %></label>
                    <select name="domainId" id="editSubDomainDomainId" required>
                        <option value=""><%= __('framework:select_pillar') %></option>
                        <% _pillars.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label class="required" for="editSubDomainName"><%= __('framework:field_name') %></label>
                    <input type="text" name="name" id="editSubDomainName" required>
                </div>
                <div class="form-group">
                    <label for="editSubDomainDefinition"><%= __('framework:field_definition') %></label>
                    <textarea name="definition" id="editSubDomainDefinition"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary"><%= __('framework:btn_update') %></button>
                    <button type="button" class="btn btn-secondary" data-on-click="hideModal" data-args='["editSubDomainModal"]'><%= __('framework:btn_cancel') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Skill Modals -->
<div id="createSkillModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2><%= __('framework:modal_create_skill') %></h2>
            <button class="close" type="button" aria-label="<%= __('common:close') %>" data-on-click="hideModal" data-args='["createSkillModal"]'>&times;</button>
        </div>
        <div class="modal-body">
            <form action="/skills" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label class="required" for="createSkillSubDomainId"><%= __('framework:field_subdomain') %></label>
                    <select name="subDomainId" id="createSkillSubDomainId" required>
                        <option value=""><%= __('framework:select_subdomain') %></option>
                        <% var _byPillar = {}; (subDomains || []).forEach(function(sd){ (_byPillar[sd.domainName] = _byPillar[sd.domainName] || []).push(sd); }); %>
                        <% Object.keys(_byPillar).forEach(function(pillar){ %>
                            <optgroup label="<%= pillar %>">
                                <% _byPillar[pillar].forEach(function(sd){ %>
                                    <option value="<%= sd.id %>"><%= sd.name %></option>
                                <% }); %>
                            </optgroup>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label class="required" for="createSkillName"><%= __('framework:field_name') %></label>
                    <input type="text" id="createSkillName" name="name" required>
                </div>
                <div class="form-group">
                    <label class="required" for="createSkillCategory"><%= __('framework:field_category') %></label>
                    <select name="category" id="createSkillCategory" required>
                        <option value="Technical">Technical</option>
                        <option value="Behavioral">Behavioral</option>
                        <option value="Safety">Safety</option>
                        <option value="Compliance">Compliance</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="createSkillDescription"><%= __('framework:field_description') %></label>
                    <textarea id="createSkillDescription" name="description"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary"><%= __('framework:btn_create') %></button>
                    <button type="button" class="btn btn-secondary"
                        data-on-click="hideModal" data-args='["createSkillModal"]'><%= __('framework:btn_cancel') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="editSkillModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2><%= __('framework:modal_edit_skill') %></h2>
            <button class="close" type="button" aria-label="<%= __('common:close') %>" data-on-click="hideModal" data-args='["editSkillModal"]'>&times;</button>
        </div>
        <div class="modal-body">
            <form id="editSkillForm" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label class="required" for="editSkillSubDomainId"><%= __('framework:field_subdomain') %></label>
                    <select name="subDomainId" id="editSkillSubDomainId" required>
                        <option value=""><%= __('framework:select_subdomain') %></option>
                        <% var _byPillarE = {}; (subDomains || []).forEach(function(sd){ (_byPillarE[sd.domainName] = _byPillarE[sd.domainName] || []).push(sd); }); %>
                        <% Object.keys(_byPillarE).forEach(function(pillar){ %>
                            <optgroup label="<%= pillar %>">
                                <% _byPillarE[pillar].forEach(function(sd){ %>
                                    <option value="<%= sd.id %>"><%= sd.name %></option>
                                <% }); %>
                            </optgroup>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label class="required" for="editSkillName"><%= __('framework:field_name') %></label>
                    <input type="text" name="name" id="editSkillName" required>
                </div>
                <div class="form-group">
                    <label class="required" for="editSkillCategory"><%= __('framework:field_category') %></label>
                    <select name="category" id="editSkillCategory" required>
                        <option value="Technical">Technical</option>
                        <option value="Behavioral">Behavioral</option>
                        <option value="Safety">Safety</option>
                        <option value="Compliance">Compliance</option>
                    </select>
                </div>
                <%# 3.23.21: FR + EN description and the five level anchors, FR + EN.
                    `description` stays the FRENCH text; the self-assessment shows them. %>
                <div class="form-group">
                    <label for="editSkillDescription"><%= __('framework:field_description_fr') %></label>
                    <textarea name="description" id="editSkillDescription" maxlength="2000"></textarea>
                </div>
                <div class="form-group">
                    <label for="editSkillDescriptionEn"><%= __('framework:field_description_en') %></label>
                    <textarea name="descriptionEn" id="editSkillDescriptionEn" maxlength="2000"></textarea>
                </div>
                <fieldset class="form-group">
                    <legend><%= __('framework:field_levels_title') %></legend>
                    <p class="text-muted" style="font-size:.82rem"><%= __('framework:field_levels_hint') %></p>
                    <% [0, 1, 2, 3, 4].forEach(function (n) { %>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:6px">
                        <div><label for="editSkillFr<%= n %>"><%= __('framework:field_level_fr', { n: n }) %></label>
                            <textarea name="fr<%= n %>" id="editSkillFr<%= n %>" rows="2" maxlength="600"></textarea></div>
                        <div><label for="editSkillEn<%= n %>"><%= __('framework:field_level_en', { n: n }) %></label>
                            <textarea name="en<%= n %>" id="editSkillEn<%= n %>" rows="2" maxlength="600"></textarea></div>
                    </div>
                    <% }); %>
                </fieldset>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary"><%= __('framework:btn_update') %></button>
                    <button type="button" class="btn btn-secondary"
                        data-on-click="hideModal" data-args='["editSkillModal"]'><%= __('framework:btn_cancel') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script nonce="<%= cspNonce %>">
    // Tab switching
    // CSP: called from data-on-click with the tab BUTTON ("$el") — the
    // delegated event's target could be the inner <i> glyph.
    function showTab(btnOrEvent, tabName) {
        // Hide all tabs
        document.querySelectorAll('.tab-content').forEach(tab => {
            tab.classList.remove('active');
        });
        document.querySelectorAll('.tab').forEach(btn => {
            btn.classList.remove('active');
        });

        // Show selected tab
        document.getElementById(tabName + '-tab').classList.add('active');
        const btn = btnOrEvent && btnOrEvent.nodeType === 1
            ? btnOrEvent
            : document.querySelector('.tab[data-tab="' + tabName + '"]');
        if (btn) btn.classList.add('active');
    }

    // Domain edit function
    function editDomain(domain) {
        document.getElementById('editDomainName').value = domain.name || '';
        document.getElementById('editDomainDescription').value = domain.description || '';
        document.getElementById('editDomainForm').action = '/domains/' + domain.id;
        showModal('editDomainModal');
    }

    // Skill edit function
    function editSkill(skill) {
        document.getElementById('editSkillSubDomainId').value = skill.subDomainId || '';
        document.getElementById('editSkillName').value = skill.name || '';
        document.getElementById('editSkillCategory').value = skill.category || 'Technical';
        document.getElementById('editSkillDescription').value = skill.description || '';
        document.getElementById('editSkillDescriptionEn').value = skill.descriptionEn || '';
        var anchors = skill.anchors || {};
        [0, 1, 2, 3, 4].forEach(function (n) {
            var a = anchors[n] || {};
            document.getElementById('editSkillFr' + n).value = a.fr || '';
            document.getElementById('editSkillEn' + n).value = a.en || '';
        });
        document.getElementById('editSkillForm').action = '/skills/' + skill.id;
        showModal('editSkillModal');
    }

    // Sub-domain edit function
    function editSubDomain(sd) {
        document.getElementById('editSubDomainDomainId').value = sd.domainId || '';
        document.getElementById('editSubDomainName').value = sd.name || '';
        document.getElementById('editSubDomainDefinition').value = sd.definition || '';
        document.getElementById('editSubDomainForm').action = '/subdomains/' + sd.id;
        showModal('editSubDomainModal');
    }
</script>