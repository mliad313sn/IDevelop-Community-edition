<div class="page-header" style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;">
    <h1 style="margin:0;"><i class="fas fa-people-arrows" aria-hidden="true"></i> <%= role.name %></h1>
    <a href="/benchmark?roleName=<%= encodeURIComponent(role.name) %>" class="btn btn-sm btn-secondary"><i class="fas fa-table-cells" aria-hidden="true"></i> <%= __('dash:role_in_matrix') %></a>
    <a href="/benchmark" class="btn btn-sm btn-secondary"><%= __('dash:back_all_roles') %></a>
</div>

<!-- Summary -->
<div class="rb-summary">
    <div class="rb-stat"><span class="rb-n"><%= occupants.length %></span><span class="rb-l"><%= __('dash:occupants') %></span></div>
    <div class="rb-stat"><span class="rb-n"><%= summary && summary.benchmarkFit != null ? numFmt.pct(summary.benchmarkFit, 0) : '—' %></span><span class="rb-l"><%= __('dash:benchmark_fit') %></span></div>
    <div class="rb-stat"><span class="rb-n"><%= summary && summary.coverage != null ? numFmt.pct(summary.coverage, 0) : '—' %></span><span class="rb-l"><%= __('dash:assessment_coverage') %></span></div>
    <div class="rb-stat"><span class="rb-n"><%= summary && summary.criticalFit != null ? numFmt.pct(summary.criticalFit, 0) : '—' %></span><span class="rb-l"><%= __('dash:critical_fit') %></span></div>
    <%# A critical-gap count of 0 over occupants nobody assessed is an all-clear the
        data does not support — show a dash, like the fit figures beside it. %>
    <% const rbMeasured = summary && summary.measuredOccupants != null ? Number(summary.measuredOccupants) : null; %>
    <div class="rb-stat"><span class="rb-n <%= rbMeasured !== 0 && summary && summary.occupantsCriticalGap>0 ? 'rb-danger' : '' %>"><%= rbMeasured === 0 ? '—' : (summary ? summary.occupantsCriticalGap : 0) %></span><span class="rb-l"><%= __('dash:occupants_critical_gap') %></span></div>
</div>

<!-- Occupant × skill breakdown -->
<div class="section-divider" style="margin-top:20px;">
    <h2 class="section-title"><span class="section-icon"><i class="fas fa-users-viewfinder" aria-hidden="true"></i></span> <%= __('dash:who_has_which_gaps') %></h2>
    <p class="section-subtitle"><%= __('dash:who_gaps_sub') %></p>
</div>
<% if (!occupants.length) { %>
    <div class="empty-state" style="padding:28px;"><%= __('dash:no_occupants_role') %></div>
<% } else { %>
<div class="benchmark-scroll">
<div class="search-bar" style="margin:.6rem 0"><div class="search-input-wrapper"><input type="search" class="search-input" data-table-search="#role-matrix" placeholder="<%= __('common:filter_list') %>" aria-label="<%= __('common:filter_list') %>"></div></div>
    <table class="benchmark-matrix" id="role-matrix">
        <thead>
            <tr>
                <th class="sticky-col skill-col"><%= __('dash:skill') %></th>
                <th class="delta-col" title="<%= __('dash:req_title') %>"><%= __('dash:req') %></th>
                <% occupants.forEach(function(o){ %>
                    <th class="role-col" title="<%= o.fullName %> — <%= __('dash:fit_lc') %> <%= o.fit==null?'—':numFmt.pct(o.fit, 0) %> · <%= __('dash:click_view_profile') %>"><span><a href="/employees/<%= o.employeeId %>" class="rb-occlink"><%= o.fullName %></a></span><br><small class="rb-occfit <%= o.fit==null?'':(o.fit>=80?'fit-good':(o.fit>=50?'fit-mid':'fit-low')) %>"><%= o.fit==null?'—':numFmt.pct(o.fit, 0) %></small><% if (o.critGap>0) { %><br><a href="/employees/<%= o.employeeId %>/development" class="rb-occdev" title="<%= __('dash:plan_dev_title') %>"><%= __('dash:develop_arrow') %></a><% } %></th>
                <% }); %>
            </tr>
        </thead>
        <tbody>
            <% domains.forEach(function(d){ d.subs.forEach(function(sd){ %>
                <tr class="bm-group-row"><td class="sticky-col" colspan="<%= occupants.length + 2 %>"><%= d.name %> <span class="bm-group-sep">›</span> <strong><%= sd.name %></strong></td></tr>
                <% sd.skills.forEach(function(sk){ %>
                    <tr>
                        <td class="sticky-col skill-col"><%= sk.name %><% if (sk.isCritical) { %> <span class="bm-crit-tag" title="<%= __('dash:critical') %>"><%= __('dash:critical_lc') %></span><% } %></td>
                        <td class="delta-col vh-c" data-bin="seq-<%= Math.max(0, Math.min(4, Math.round(Number(sk.required) || 0))) %>"><%= sk.required %></td>
                        <% occupants.forEach(function(o){ var c = sk.cells[o.employeeId]; %>
                            <%# The actual level coloured by what is MISSING against the requirement (the heatmap scale: orange below, neutral when met). A requirement nobody assessed is hatched and says « Not assessed »: it is never level 0 and never a gap. %>
                            <% if (c && c.assessed) { var _bin = personGapBin(c.actual, sk.required, true); %><td class="bm-cell vh-c" data-bin="<%= _bin %>"<% if (!c.met) { %> data-below="1"<% } %> title="<%= o.fullName %>: <%= __('dash:actual_lc') %> <%= c.actual %> / <%= __('dash:required_lc') %> <%= sk.required %><%= c.met ? '' : ' — ' + __('dash:gap_upper') %>"><%= c.actual %><% if (!c.met) { %><span class="vh-mk" aria-hidden="true">▼</span><span class="viz-live"> — <%= __('dash:gap_upper') %></span><% } %></td><% } else if (c) { %><td class="bm-cell vh-c vh-c--unmeasured viz-hatch bm-unassessed" title="<%= o.fullName %>: <%= __('dash:required_lc') %> <%= sk.required %> <%= __('dash:not_assessed_paren') %>"><span class="bm-na"><%= __('dash:bm_not_assessed') %></span></td><% } else { %><td class="bm-cell bm-empty">·</td><% } %>
                        <% }); %>
                    </tr>
                <% }); %>
            <% }); }); %>
        </tbody>
    </table>
</div>
<p class="bm-legend" aria-hidden="true">
    <span><%= __('dash:bm_legend_actual') %></span>
    <span class="bm-legend-item"><span class="vh-sw" data-bin="at"></span> <%= __('viz:heat.bin_deficit_at') %></span>
    <span class="bm-legend-item"><span class="vh-sw" data-bin="below-1"></span> <%= __('viz:heat.bin_deficit_below_1') %></span>
    <span class="bm-legend-item"><span class="vh-sw" data-bin="below-2"></span> <%= __('viz:heat.bin_deficit_below_2') %></span>
    <span class="bm-legend-item"><span class="vh-sw" data-bin="below-3"></span> <%= __('viz:heat.bin_deficit_below_3') %></span>
    <span class="bm-legend-item">▼ <%= __('dash:gap_upper') %></span>
    <span class="bm-legend-item"><span class="vh-sw viz-hatch"></span> <%= __('dash:bm_not_assessed_legend') %></span>
</p>
<% } %>

<% if (profileAxes && profileAxes.length) { %>
<!-- Role profile: demonstrated against required, by sub-domain (assessed cells only) -->
<div class="section-divider" style="margin-top:22px;">
    <h2 class="section-title"><span class="section-icon"><i class="fas fa-chart-simple" aria-hidden="true"></i></span> <%= __('dash:bm_profile_title') %></h2>
    <p class="section-subtitle"><%= __('dash:bm_profile_sub') %></p>
</div>
<div class="rb-profile">
    <% if (profileAxes.length >= 3) { %>
    <%- include('../../partials/viz/radar', { radar: { id: 'rb-radar', title: __('dash:bm_profile_radar'), axes: profileAxes, max: 4 } }) %>
    <% } %>
    <%- include('../../partials/viz/dumbbell', { dumbbell: { id: 'rb-gaps', title: __('viz:dumbbell.title'), rows: profileAxes, max: 4 } }) %>
</div>
<% } %>

<!-- Succession candidates -->
<div class="section-divider" style="margin-top:22px;">
    <h2 class="section-title"><span class="section-icon"><i class="fas fa-arrow-trend-up" aria-hidden="true"></i></span> <%= __('dash:ready_to_move_up') %></h2>
    <p class="section-subtitle"><%= __('dash:rtm_sub_1') %> <em><%= __('dash:not_lc') %></em> <%= __('dash:rtm_sub_2') %></p>
</div>
<div class="table-wrapper">
<div class="search-bar" style="margin:.6rem 0"><div class="search-input-wrapper"><input type="search" class="search-input" data-table-search="#cand-table" placeholder="<%= __('common:filter_list') %>" aria-label="<%= __('common:filter_list') %>"></div></div>
    <table class="table" id="cand-table">
        <thead><tr><th><%= __('dash:candidate') %></th><th><%= __('dash:current_role') %></th><th style="min-width:150px;"><%= __('dash:fit_vs_role') %></th><th style="text-align:center;"><%= __('dash:skill_gaps') %></th><th style="text-align:center;"><%= __('dash:critical_gaps') %></th><th style="text-align:center;"><%= __('dash:act') %></th></tr></thead>
        <tbody>
            <% if (!candidates.length) { %>
                <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--text-muted);"><%= __('dash:no_candidates_in_scope') %></td></tr>
            <% } else { candidates.forEach(function(c){ var v = c.fit==null?null:Number(c.fit); var cAssessed = Number(c.assessedSkills||0), cReq = Number(c.reqSkills||0); %>
                <tr>
                    <td><strong><a href="/employees/<%= c.employeeId %>"><%= c.fullName %></a></strong><% if (c.employeeNumber) { %> <span class="rb-emp">#<%= c.employeeNumber %></span><% } %></td>
                    <td><%= c.currentRole || '—' %></td>
                    <%# Fit is NULL for a candidate nobody assessed: say "not measured", never a red 1 % bar. The coverage (assessed / department-designed requirements) always travels with the score. %>
                    <td><% if (v==null) { %><span class="bm-nodata" title="<%= __('dash:rd_not_measured_title') %>"><%= __('dash:rd_not_measured') %></span><% } else { %><div class="bm-fitbar"><div class="bm-fitbar-fill <%= v>=80?'fit-good':(v>=50?'fit-mid':'fit-low') %>" style="width:<%= v %>%;"></div><span class="bm-fitbar-label"><%= v %>%</span></div><% } %><small class="text-muted bm-cand-cov" title="<%= __('dash:rd_not_measured_title') %>"><%= cAssessed %> / <%= cReq %> <%= __('dash:bm_cand_coverage_suffix') %></small></td>
                    <td style="text-align:center;" title="<%= __('dash:bm_cand_gaps_measured_title') %>"><% if (cAssessed===0) { %>—<% } else { %><%= c.gapSkills %><% } %></td>
                    <td style="text-align:center;<%= c.critGapSkills>0 ? 'color:var(--viz-risk);font-weight:700;' : '' %>" title="<%= __('dash:bm_cand_gaps_measured_title') %>"><% if (cAssessed===0) { %>—<% } else { %><%= c.critGapSkills %><% } %></td>
                    <td style="text-align:center;"><% if (typeof appModules === 'undefined' || !appModules || appModules.development) { %><a href="/v2/idp/new?employeeId=<%= c.employeeId %>" class="btn btn-xs btn-secondary" title="<%= __('dash:start_idp_title') %>"><%= __('dash:develop') %></a><% } else { %>—<% } %></td>
                </tr>
            <% }); } %>
        </tbody>
    </table>
</div>

<style>
.rb-summary { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin:6px 0 4px; }
.rb-stat { background:var(--bg-subtle); border:1px solid var(--border-color); border-radius:12px; padding:14px 12px; text-align:center; }
.rb-n { display:block; font-size:1.5rem; font-weight:800; color:var(--brand-text, var(--brand)); font-variant-numeric:tabular-nums; }
.rb-n.rb-danger { color:var(--viz-risk); }
.rb-l { display:block; font-size:.75rem; letter-spacing:.03em; color:var(--text-secondary); margin-top:2px; }
.benchmark-scroll { overflow:auto; max-height:62vh; border:1px solid var(--border-color); border-radius:12px; }
.benchmark-matrix { border-collapse:separate; border-spacing:0; font-size:.8125rem; min-width:100%; }
.benchmark-matrix th, .benchmark-matrix td { padding:5px 8px; border-bottom:1px solid var(--border-color); white-space:nowrap; text-align:center; }
.benchmark-matrix thead th { position:sticky; top:0; z-index:3; background:var(--bg-elevated); color:var(--text-primary); }
.benchmark-matrix .role-col span { display:inline-block; max-width:120px; overflow:hidden; text-overflow:ellipsis; vertical-align:bottom; }
.rb-occfit { font-weight:700; } .rb-occfit.fit-good { color:var(--viz-good); } .rb-occfit.fit-mid { color:var(--viz-warn); } .rb-occfit.fit-low { color:var(--viz-risk); }
.bm-nodata { display:inline-block; padding:2px 10px; border-radius:6px; background:var(--bg-subtle); border:1px dashed var(--border-color); color:var(--text-muted); font-size:.78rem; }
.bm-cand-cov { display:block; font-size:.75rem; margin-top:2px; }
.benchmark-matrix .sticky-col { position:sticky; left:0; z-index:2; background:var(--bg-elevated); text-align:left; }
.benchmark-matrix thead .sticky-col { z-index:4; }
.benchmark-matrix .skill-col { min-width:230px; max-width:320px; white-space:normal; }
.delta-col { color:var(--text-secondary); font-variant-numeric:tabular-nums; }
.bm-group-row td { background:var(--bg-subtle); font-size:.82rem; color:var(--text-secondary); text-align:left; }
.bm-group-sep { color:var(--text-muted); }
.bm-crit-tag { font-size:.75rem; letter-spacing:.03em; color:var(--brand-text, var(--brand)); border:1px solid currentColor; border-radius:999px; padding:0 6px; }
.bm-cell { position:relative; font-variant-numeric:tabular-nums; }
/* the heatmap scale on the matrix cells (public/css/viz.css .vh-*): a compact cell */
.benchmark-matrix .vh-c { height:auto; border-radius:6px; padding:3px 6px; font-weight:600; }
.benchmark-matrix .bm-unassessed { white-space:normal; min-width:5.5rem; }
.bm-na { font-size:.75rem; font-weight:600; }
.bm-empty { color:var(--text-muted); }
.bm-legend { display:flex; flex-wrap:wrap; align-items:center; gap:8px 14px; font-size:.8125rem; color:var(--text-secondary); margin:10px 2px 0; }
.bm-legend-item { display:inline-flex; align-items:center; gap:6px; }
.bm-fitbar { position:relative; height:20px; background:var(--bg-subtle); border-radius:6px; overflow:hidden; min-width:140px; }
.bm-fitbar-fill { height:100%; background:var(--viz-good); } .bm-fitbar-fill.fit-good { background:var(--viz-good); } .bm-fitbar-fill.fit-mid { background:var(--viz-warn); } .bm-fitbar-fill.fit-low { background:var(--viz-risk); }
.bm-fitbar-label { position:absolute; top:0; left:8px; line-height:20px; font-size:.75rem; font-weight:600; color:var(--text-primary); }
.rb-emp { color:var(--text-muted); font-size:.78rem; }
.rb-occlink { color:var(--text-primary); text-decoration:none; border-bottom:1px dotted var(--text-muted); }
.rb-occlink:hover { color:var(--brand-text, var(--brand)); }
.rb-occdev { display:inline-block; margin-top:2px; font-size:.75rem; color:var(--brand-text, var(--brand)); text-decoration:none; }
.rb-occdev:hover { text-decoration:underline; }
.btn-xs { padding:2px 9px; font-size:.75rem; border-radius:6px; }
.rb-profile { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:16px; margin-top:12px; }
.rb-profile > section { background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-lg, 18px); padding:14px 16px; min-width:0; }
.rb-trend { margin-top:22px; }
.rb-trend-note { font-size:.8125rem; color:var(--text-muted); margin:6px 2px 0; }
@media (max-width:900px){ .rb-summary{grid-template-columns:repeat(2,1fr);} .rb-profile{grid-template-columns:minmax(0, 1fr);} }
@media print { .search-bar, .rb-occdev { display:none !important; } .benchmark-scroll { max-height:none; overflow:visible; } }
</style>

<!-- Fit trend: daily snapshots from benchmark_fit_history, drawn by the viz layer.
     A null day (nobody measured that day) is a gap, never bridged (spanGaps:false
     in public/js/viz.js); the axis fits the data (ChartAxisFit.fitRange, `fitAxis`). -->
<div class="rb-trend">
    <% if (!fitHistory || fitHistory.length < 2) { %>
    <div class="viz-chart">
        <h2 class="viz-title"><%= __('dash:fit_trend_title') %></h2>
        <p class="rb-trend-note"><%= __('dash:fit_trend_pending') %></p>
    </div>
    <% } else { %>
    <%- include('../../partials/viz/chart', { vizChart: {
        id: 'rb-fit-trend',
        title: __('dash:fit_trend_title'),
        height: 240,
        config: {
            kind: 'line',
            unit: 'pct',
            decimals: 0,
            fitAxis: true,
            labels: fitHistory.map(function (x) { return fmtDate(x.day); }),
            series: [
                { key: 'fit', label: __('dash:benchmark_fit_label'), data: fitHistory.map(function (x) { return x.fit === null || x.fit === undefined ? null : Number(x.fit); }) },
                { key: 'coverage', label: __('dash:coverage_label'), data: fitHistory.map(function (x) { return x.coverage === null || x.coverage === undefined ? null : Number(x.coverage); }) }
            ]
        }
    } }) %>
    <% } %>
</div>
<%- include('../../partials/viz/scripts', { viz: { chart: true, radar: profileAxes && profileAxes.length >= 3, dumbbell: true, axisFit: true } }) %>
