<%# the three counters are computed server-side. Defaults here so
    the template still renders when a caller (a test harness, a future partial)
    passes only the skill list — the numbers are then derived from that list, which
    is the same truth, never a hard-coded 0. %>
<% const _saList = skillsWithAssessments || [];
   const saTotal = (typeof locals.saTotal === 'number') ? locals.saTotal : _saList.length;
   const saRated = (typeof locals.saRated === 'number') ? locals.saRated : _saList.filter((x) => x.selfRatedLevel != null).length;
   const saRemaining = (typeof locals.saRemaining === 'number') ? locals.saRemaining : (saTotal - saRated);
   const saEstimateMin = (typeof locals.saEstimateMin === 'number') ? locals.saEstimateMin : Math.max(1, Math.round((saRemaining * 15) / 60));
   // An honest range: 15 to 20 seconds per skill still to rate (4.0.0 port, wave 5).
   const saEstimateLo = (typeof locals.saEstimateLo === 'number') ? locals.saEstimateLo : Math.max(1, Math.round((saRemaining * 15) / 60));
   const saEstimateHi = (typeof locals.saEstimateHi === 'number') ? locals.saEstimateHi : Math.max(saEstimateLo, Math.round((saRemaining * 20) / 60));
   // No open campaign and the person's latest campaign LOCKED: every save is
   // refused (409 cycle_locked), so the page is read-only.
   const _ro = locals.saReadOnly === true; %>
<style nonce="<%= cspNonce %>">
    /* A never-rated skill is visually distinct from a deliberate "0 — None": muted
       until the person makes a choice, so an unrated row doesn't masquerade as a 0. */
    .self-rating-select.sa-unanswered { opacity: .62; font-style: italic; border-style: dashed; }
</style>
<div class="page-header">
    <h1><%= __('employee:sa_title') %></h1>
    <p><%= __('employee:sa_subtitle') %> <strong><%= employee.roleName %></strong></p>
</div>

<% if (typeof cycle !== 'undefined' && cycle) { %>
<!-- Campaign deadline, ON the page where the work happens. -->
<div class="sa-deadline <%= cycle.daysLeft < 0 ? 'sa-deadline-over' : (cycle.daysLeft <= 3 ? 'sa-deadline-soon' : '') %>">
    <i class="fas fa-calendar-day" aria-hidden="true"></i>
    <span>
        <strong><%= cycle.label %></strong> —
        <% if (cycle.daysLeft < 0) { %>
            <%= __('employee:sa_deadline_over') %>
        <% } else if (cycle.daysLeft === 0) { %>
            <%= __('employee:sa_deadline_today') %>
        <% } else { %>
            <%= __('employee:sa_deadline_in') %> <strong><%= cycle.daysLeft %></strong> <%= __('employee:sa_deadline_days') %>
        <% } %>
        <%# was toISOString.slice(0,10) — an ISO date inside a French
            sentence. The controller formats the bound once (dd/MM/yyyy, UTC). %>
        (<%= cycle.closesAtText || '—' %>)
    </span>
</div>
<% } else if (skillsWithAssessments && skillsWithAssessments.length) { %>
<!-- NO open campaign. The form still works (ratings are filed outside any
     campaign, cycle_id NULL) but the person must be told BEFORE they save that
     nothing they enter now will move a campaign counter. -->
<%
   // TWO different situations used to share one sentence, and one of them was a
   // false promise:
   //   * enrolled in a LOCKED campaign -> the server now REFUSES the save
   //     (409 cycle_locked), so telling the person their notes will be "filed
   //     outside the campaign" was wrong;
   //   * enrolled in NO campaign at all -> the save really is accepted and
   //     filed with no campaign, which is what that sentence describes.
   var _locked = (typeof lockedCycle !== 'undefined' && lockedCycle) ? lockedCycle : null;
   // the date used to be built here with toISOString.slice(0,10) —
   // « clôturée le 2026-08-31 » in French prose. The controller now formats the
   // bound (dd/MM/yyyy, UTC-forced) so this notice and the 409 refusal agree.
   var _lcDate = _locked ? (_locked.closesAtText || '—') : '';
%>
<div class="alert alert-warning sa-no-campaign" role="status" data-campaign="<%= _locked ? 'locked' : 'none' %>">
    <i class="fas fa-circle-info" aria-hidden="true"></i>
    <span>
        <% if (_locked) { %>
        <%#  (b): this banner is about the CAMPAIGN, and it used to borrow the
            per-COMPETENCY lock sentence as its title — it named no competency and told
            the employee to ask their manager for a reopening, which A5 reserves to the
            SuperAdmin. Campaign-level title; the competency sentence stays on the rows. %>
        <strong><%= __('employee:sa_locked_campaign_title') %></strong> &mdash;
        <%= __('employee:sa_no_campaign_last', { label: _locked.label || _locked.code, date: _lcDate }) %>
        <%= __('employee:sa_locked_body') %>
        <% if (_ro) { %><br><span data-sa-readonly="1"><%= __('employee:sa_readonly_note') %></span><% } %>
        <% } else { %>
        <strong><%= __('employee:sa_no_campaign_title') %></strong> &mdash; <%= __('employee:sa_no_campaign_body') %>
        <% } %>
    </span>
</div>
<% } %>

<link rel="stylesheet" href="/css/sa-skill-help.css?v=<%= assetVersion %>">
<%# The page CSS lives in its own file, on the design tokens. %>
<link rel="stylesheet" href="/css/self-assessment.css?v=<%= assetVersion %>">
<div class="assessment-info">
    <%# 3.23.21: « Comment bien vous auto-évaluer » replaces the one-line
        instructions. Open the first time; sa-skill-help.js folds it once read. %>
    <details class="sa-intro" id="saIntro" open>
        <summary class="sa-intro-head"><%= __('employee:sa_intro_title') %></summary>
        <ul class="sa-intro-list">
            <li><%= __('employee:sa_intro_1') %></li>
            <li><%= __('employee:sa_intro_2') %></li>
            <li><%= __('employee:sa_intro_3') %></li>
            <li><%= __('employee:sa_intro_4') %></li>
            <li><%= __('employee:sa_intro_5') %></li>
        </ul>
    </details>
    <%# the scale is READ, not hovered — a visible list, no title= tooltip
        (unreachable by touch and by keyboard). %>
    <div class="sa-scale-ref">
        <strong id="saScaleLabel"><%= __('employee:sa_scale_label') %></strong>
        <dl class="sa-scale-dl" aria-labelledby="saScaleLabel">
            <% [0, 1, 2, 3, 4].forEach(function (n) { %>
            <div><dt><%= n %>&nbsp;<%= __('employee:scale_' + n + '_word') %></dt><dd><%= __('employee:scale_' + n + '_title') %></dd></div>
            <% }); %>
        </dl>
    </div>
    <p class="sa-scale-ref"><strong><%= __('employee:th_required_level') %></strong> <%= __('employee:sa_req_note_mid') %> <span class="sa-crit-key"><%= __('employee:critical_badge') %></span> <%= __('employee:sa_req_note_post') %></p>
    <%# The capability rule (src/utils/capability.js) in the employee's words:
        reaching the required level is « met »; a higher level never offsets a gap. %>
    <details class="sa-scale-ref sa-rule" id="saRule">
        <summary><%= __('employee:sa_rule_sum') %></summary>
        <p><%= __('employee:sa_rule_body') %></p>
    </details>
    <p class="sa-scale-ref sa-estimate">
        <i class="fas fa-clock" aria-hidden="true"></i>
        <%# rendered server-side, so the first paint already says
            "Environ 2 min" instead of an em dash that only JS could fill. %>
        <%# a range, and leave to split the work into several sittings %>
        <%= __('employee:sa_estimate_pre') %> <strong id="saEstimate" data-min="<%= saEstimateMin %>"><%= saEstimateLo === saEstimateHi ? saEstimateLo : __('employee:sa_estimate_range', { lo: saEstimateLo, hi: saEstimateHi }) %></strong> <%= __('employee:sa_minutes') %> <%= __('employee:sa_estimate_post') %> — <%= __('employee:sa_estimate_split') %>
    </p>
</div>

<% if (!skillsWithAssessments || !skillsWithAssessments.length) { %>
<div class="empty-state sa-empty-state">
    <div class="sa-empty-state-ico" aria-hidden="true"><i class="fas fa-clipboard-list"></i></div>
    <h2><%= __('employee:sa_no_skills_title') %></h2>
    <p class="text-muted"><%= __('employee:sa_no_skills_body') %></p>
</div>
<% } else { %>
<form id="selfAssessmentForm"<%= _ro ? ' data-readonly=1' : '' %>>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- STICKY action bar: progress + save/submit always reachable
         (previously the Submit button sat below ~5 phone-screens of table).
         ONLY the progress line, the autosave state and the two buttons stay
         sticky: with the filter chips and the tools inside, the bar covered
         about half of a phone screen. -->
    <div class="sa-bar" id="saBar">
        <div class="sa-bar-row">
            <div class="sa-progress-text">
                <strong id="saRatedCount"><%= saRated %></strong> <%= __('employee:sa_progress_of') %> <strong id="saTotalCount"><%= saTotal %></strong> <%= __('employee:sa_progress_rated') %>
                <span class="sa-progress-sub" id="saZeroNote"><%= saRemaining ? ' · ' + saRemaining + ' ' + __('employee:sa_still_zero') : ' · ' + __('employee:sa_all_rated') %></span>
            </div>
            <div class="sa-bar-actions">
                <%# the offline / sync status docks here (sync-indicator.js), never
                    floating over the content or the help button %>
                <span class="sa-sync-slot" id="saSyncSlot"></span>
                <% if (!_ro) { %>
                <span class="sa-autosave" id="saAutosave" aria-live="polite"></span>
                <button type="button" id="saveDraftBtn" class="btn btn-secondary btn-sm"><i class="fas fa-floppy-disk" aria-hidden="true"></i> <%= __('employee:sa_save_draft') %></button>
                <button type="button" id="submitBtn" class="btn btn-primary btn-sm"><i class="fas fa-file-export" aria-hidden="true"></i> <%= __('employee:sa_submit_review') %></button>
                <% } %>
            </div>
        </div>
        <div class="sa-progress-bar"><div class="sa-progress-fill" id="saProgressFill" style="width:<%= saTotal ? Math.round((saRated / saTotal) * 100) : 0 %>%"></div></div>
    </div>

    <!-- Filters and tools: NOT sticky. Open on a wide screen (script below), folded on a phone. -->
    <details class="sa-tools-wrap" id="saToolsWrap">
        <summary class="btn btn-secondary btn-sm"><i class="fas fa-sliders" aria-hidden="true"></i> <%= __('employee:sa_tools_summary') %></summary>
        <div class="sa-tools-body">
        <div class="sa-filters" role="group" aria-label="<%= __('employee:sa_filter_aria') %>">
            <button type="button" class="sa-chip is-active" data-filter="all"><%= __('employee:sa_filter_all') %></button>
            <button type="button" class="sa-chip" data-filter="unrated"><%= __('employee:sa_filter_unrated') %> <span class="sa-chip-n" id="chipUnrated">0</span></button>
            <button type="button" class="sa-chip" data-filter="critical"><%= __('employee:sa_filter_critical') %> <span class="sa-chip-n" id="chipCritical">0</span></button>
            <button type="button" class="sa-chip" data-filter="gap"><%= __('employee:sa_filter_gap') %> <span class="sa-chip-n" id="chipGap">0</span></button>
            <label class="sa-toggle">
                <input type="checkbox" id="saShowCurrent"> <span><%= __('employee:sa_show_current') %></span>
            </label>
        </div>
        <!-- Power tools: find a skill in a 161-item list, jump straight to the
             next unrated one, and collapse/expand the whole set. -->
        <div class="sa-tools">
            <input type="search" id="saSearch" class="form-control sa-search"
                   placeholder="<%= __('employee:sa_search_ph') %>" aria-label="<%= __('employee:sa_search_ph') %>">
            <button type="button" class="btn btn-secondary btn-sm" id="saNextUnrated">
                <i class="fas fa-forward" aria-hidden="true"></i> <%= __('employee:sa_next_unrated') %>
            </button>
            <button type="button" class="btn btn-secondary btn-sm" id="saToggleAll" data-state="open">
                <i class="fas fa-compress" aria-hidden="true"></i> <span id="saToggleAllLabel"><%= __('employee:sa_collapse_all') %></span>
            </button>
            <%# every « Qu'est-ce que c'est ? » at once — separate from the
                section collapse above; remembered per device by sa-skill-help.js. %>
            <button type="button" class="btn btn-secondary btn-sm" id="saHelpToggleAll" aria-pressed="false">
                <span aria-hidden="true">ⓘ</span> <span id="saHelpToggleAllLabel"><%= __('employee:sa_help_show_all') %></span>
            </button>
            <span class="sa-kbd-hint"><%= __('employee:sa_kbd_hint') %></span>
        </div>
        </div>
    </details>

    <!-- Inline submit confirmation (replaces browser confirm dialog) -->
    <% if (!_ro) { %>
    <div class="sa-confirm" id="saConfirm" role="alertdialog" aria-live="assertive" aria-describedby="saConfirmMsg" hidden>
        <span class="sa-confirm-msg" id="saConfirmMsg"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> <%= __('employee:sa_confirm_msg') %></span>
        <span class="sa-confirm-actions">
            <button type="button" id="saConfirmYes" class="btn btn-primary btn-sm"><%= __('employee:sa_confirm_yes') %></button>
            <button type="button" id="saConfirmNo" class="btn btn-secondary btn-sm"><%= __('employee:sa_cancel') %></button>
        </span>
    </div>
    <% } %>

    <%
    // Group requirements by pillar/domain — a 44-to-161-row flat table is the
    // main abandonment driver; sections make the work feel finite.
    const saGroups = {};
    skillsWithAssessments.forEach(function (s) {
        const key = s.domainName || '—';
        (saGroups[key] = saGroups[key] || []).push(s);
    });
    const saGroupNames = Object.keys(saGroups).sort();
    %>

    <% saGroupNames.forEach(function (groupName, gi) { %>
    <details class="sa-section" open data-section>
        <summary class="sa-section-head">
            <span class="sa-section-title"><%= groupName %></span>
            <span class="sa-section-meta">
                <span class="sa-section-count" data-section-progress>0/<%= saGroups[groupName].length %></span>
                <span class="sa-section-bar"><span class="sa-section-fill" data-section-fill></span></span>
            </span>
        </summary>

        <table class="table sa-table">
            <thead>
                <tr>
                    <th scope="col"><%= __('employee:th_skill') %></th>
                    <th scope="col"><%= __('employee:th_required_level') %></th>
                    <th scope="col" class="sa-col-current"><%= __('employee:th_current_level') %></th>
                    <th scope="col"><%= __('employee:th_self_rating') %></th>
                    <th scope="col"><%= __('employee:th_status') %></th>
                    <th scope="col"><%= __('employee:th_notes') %></th>
                </tr>
            </thead>
            <tbody>
                <% saGroups[groupName].forEach(function(skill) { %>
                <%
                   // 3.23.21: what the skill and its levels mean, resolved
                   // once per row by the SAME core the browser uses.
                   var _shLang = (typeof lang !== 'undefined' && lang === 'en') ? 'en' : 'fr';
                   var _shCore = (typeof skillHelpCore !== 'undefined' && skillHelpCore) ? skillHelpCore : null;
                   var _shRes = _shCore ? _shCore.resolve(skill.skillHelp || null, _shLang, _shCore.scaleLabels(__)) : null;
                   var _shSel = (skill.selfRatedLevel === null || skill.selfRatedLevel === undefined) ? null : Number(skill.selfRatedLevel);
                   var _shRated = _shSel !== null;
                   var _shLevelText = (_shRated && _shRes && _shRes.levels[_shSel]) ? _shRes.levels[_shSel].text
                       : (_shRated ? __('employee:scale_' + _shSel + '_title') : '');
                   var _shNudge = _shCore ? _shCore.nudgeFor(_shSel, skill.requiredLevel) : 'default';
                %>
                <tr data-skill-id="<%= skill.skillId %>"
                    data-critical="<%= skill.isCritical ? '1' : '0' %>"
                    data-required="<%= skill.requiredLevel %>">
                    <th scope="row" class="sa-skill-cell" data-label="<%= __('employee:th_skill') %>">
                        <%# The SEARCH reads .sa-skill-name only — never the description. %>
                        <span class="sa-skill-name" id="sk-name-<%= skill.skillId %>"><%= skill.skillName %></span>
                        <% if (skill.isCritical) { %> <span class="sa-crit-key"><%= __('employee:critical_badge') %><span class="sr-only"> — <%= __('employee:critical_title') %></span></span><% } %>
                        <%- include('../../partials/skill-help', { sh: { id: skill.skillId, raw: skill.skillHelp || null, resolved: _shRes, mode: 'self', selected: _shSel, required: skill.requiredLevel } }) %>
                    </th>
                    <%# D5 (PO): the required level is hidden until THIS row is rated, so it
                        cannot anchor the answer; the « Critique » badge stays visible. %>
                    <td data-label="<%= __('employee:th_required_level') %>" class="sa-req-cell" data-req-cell<%= _shRated ? ' data-revealed=1' : '' %>><% if (_shRated) { %><%= skill.requiredLevel %><% var _gap = _shCore ? _shCore.gapText(_shSel, skill.requiredLevel, { met: __('employee:sa_req_met'), gap: __('employee:sa_req_gap', { n: '%n%' }) }) : ''; if (_gap) { %><span class="sa-req-gap"> · <%= _gap %></span><% } %><% } else { %><span aria-hidden="true">—</span><span class="sr-only"><%= __('employee:sa_req_hidden_sr') %></span><% } %></td>
                    <%# never a « 0 » for a skill nobody has assessed %>
                    <td class="sa-col-current" data-label="<%= __('employee:th_current_level') %>"><%= (skill.currentSkillLevel === null || skill.currentSkillLevel === undefined) ? '—' : skill.currentSkillLevel %></td>
                    <%# An assessment that has left the employee's hands is read-only.
                        Two reasons this must show in the markup, not just on the server:
                        · `data-answered` drives collect(), and it was '1' for every
                          previously rated skill — approved ones included — so a single
                          "save draft" posted the whole approved set back as drafts.
                        · a control that looks editable and silently does nothing is
                          worse than one that is visibly locked.
                        The server refuses these regardless (SelfAssessmentService); this
                        makes the page honest about it. %>
                    <% const saLocked = ['submitted', 'reviewed', 'approved'].includes(skill.status);
                       // A locked campaign makes the whole page read-only.
                       const rowRO = saLocked || _ro; %>
                    <td class="sa-rate-cell" data-label="<%= __('employee:th_self_rating') %>">
                        <%# a real <label> for every rating select; its accessible name
                            is « Your rating for » + THIS row's skill name %>
                        <label class="sr-only" for="sa-rate-<%= skill.skillId %>" id="sk-rlbl-<%= skill.skillId %>"><%= __('employee:aria_self_rating_for') %></label>
                        <select name="assessments[<%= skill.skillId %>][selfRatedLevel]"
                                id="sa-rate-<%= skill.skillId %>"
                                class="self-rating-select<%= skill.selfRatedLevel == null ? ' sa-unanswered' : '' %><%= saLocked ? ' sa-locked' : '' %>"
                                data-skill-id="<%= skill.skillId %>"
                                data-answered="<%= (skill.selfRatedLevel != null && !rowRO) ? '1' : '0' %>"
                                <%# data-rated is "a level was saved", INDEPENDENT of the lock.
                                    data-answered means "editable AND rated" and drives collect(),
                                    so it is deliberately 0 on locked rows — but the PROGRESS
                                    counter also read it, so once everything was submitted the
                                    page reported "0 of 50 rated · 50 still at level 0" while
                                    /employee/assessment-status correctly said 3 of 49.
                                    Completion was structurally unreachable. %>
                                data-rated="<%= skill.selfRatedLevel != null ? '1' : '0' %>"
                                <%= rowRO ? 'disabled' : '' %>
                                aria-labelledby="sk-rlbl-<%= skill.skillId %> sk-name-<%= skill.skillId %><%= saLocked ? ' sk-lock-' + skill.skillId : '' %>"
                                aria-describedby="sk-desc-<%= skill.skillId %> sk-lvl-<%= skill.skillId %>"
                                required>
                            <%# A never-rated skill must NOT sit on "0 - Aucun": the control then
                                looks answered when it is not, and — worse — choosing 0 with the
                                mouse fires no `change` event (the value never changes), so an
                                honest "0 — None" was silently dropped by collect(). Keyboard
                                users could save it; mouse and touch users could not. %>
                            <% if (skill.selfRatedLevel == null) { %>
                            <option value="" selected disabled><%= __('employee:opt_pick') %></option>
                            <% } %>
                            <option value="0" <%= skill.selfRatedLevel === 0 ? 'selected' : '' %>><%= __('employee:opt_0') %></option>
                            <option value="1" <%= skill.selfRatedLevel === 1 ? 'selected' : '' %>><%= __('employee:opt_1') %></option>
                            <option value="2" <%= skill.selfRatedLevel === 2 ? 'selected' : '' %>><%= __('employee:opt_2') %></option>
                            <option value="3" <%= skill.selfRatedLevel === 3 ? 'selected' : '' %>><%= __('employee:opt_3') %></option>
                            <option value="4" <%= skill.selfRatedLevel === 4 ? 'selected' : '' %>><%= __('employee:opt_4') %></option>
                        </select>
                        <%# On a phone or a touch screen, five large 0-4 buttons: one tap
                            per skill. The <select> above stays the value holder, the
                            no-JS fallback and the keyboard model (0-4, J/K); the buttons
                            only drive it. Shown by the page script. %>
                        <div class="sa-seg" role="radiogroup" data-seg-for="<%= skill.skillId %>" aria-label="<%= __('employee:sa_seg_aria', { skill: skill.skillName }) %>" hidden>
                            <% [0, 1, 2, 3, 4].forEach(function (n) { var _on = skill.selfRatedLevel === n; %>
                            <button type="button" class="sa-seg-b" role="radio" data-v="<%= n %>" aria-checked="<%= _on ? 'true' : 'false' %>" tabindex="<%= (_on || (skill.selfRatedLevel == null && n === 0)) ? '0' : '-1' %>"<%= rowRO ? ' disabled' : '' %>><span class="sa-seg-n"><%= n %></span><span class="sa-seg-w"><%= __('employee:scale_' + n + '_word') %></span></button>
                            <% }); %>
                        </div>
                        <%#  (a): the badge said « Validé » on EVERY locked row —
                            submitted and reviewed rows included — two columns away from a
                            Statut column reading « Soumis », and « Validé » is the label of
                            no state at all (an approved row says « Approuvée »). The badge
                            states the LOCK; the Statut column keeps stating the state. %>
                        <%# the lock is explained in words (aria-describedby), not in a hover-only title=. %>
                        <% if (saLocked) { %><span class="sa-lock-badge"><i class="fas fa-lock" aria-hidden="true"></i> <%= __('employee:sa_rating_locked') %><span class="sr-only" id="sk-lock-<%= skill.skillId %>"> — <%= __('employee:sa_locked_title') %></span></span><% } %>
                        <%# the meaning of the chosen level, in plain words, announced politely. %>
                        <p class="sa-level-line" id="sk-lvl-<%= skill.skillId %>" aria-live="polite"><% if (_shRated) { %><%= __('employee:sa_level_line', { n: _shSel }) %> <%= _shLevelText %><% } %></p>
                        <input type="hidden" name="assessments[<%= skill.skillId %>][skillId]" value="<%= skill.skillId %>">
                    </td>
                    <td class="sa-status-cell" data-status="<%= skill.status || 'not_started' %>" data-label="<%= __('employee:th_status') %>">
                        <%# The shared status badge (icon and text, never colour alone). %>
                        <% const _stKey = skill.status === 'submitted' || skill.status === 'under_review' ? 'state_submitted'
                               : ['draft', 'reviewed', 'approved', 'changes_requested', 'rejected', 'arbitration'].includes(skill.status) ? 'state_' + skill.status
                               : 'sa_status_not_started';
                           const _stTone = skill.status === 'reviewed' ? 'ok' : (skill.status || 'not_started'); %>
                        <%- include('../../partials/status-badge', { state: _stTone, label: __('employee:' + _stKey) }) %>
                    </td>
                    <% var _hasNote = !!(skill.selfAssessment && skill.selfAssessment.notes); %>
                    <td class="sa-notes-cell<%= (!rowRO || _hasNote || saLocked) ? '' : ' sa-notes-empty' %>" data-label="<%= __('employee:th_notes') %>">
                        <%# The NOTE follows the LOCK of the row it belongs to.
                            It used to stay editable on a submitted/approved row while
                            `data-answered` was '0', so collect() never picked the row up:
                            the employee typed a justification, pressed "Enregistrer le
                            brouillon", was told « Brouillon enregistré », and the text was
                            never sent anywhere — a success message over a discarded write.
                            The server refuses these rows regardless (SelfAssessmentService
                            returns {skipped:true}); readonly makes the page honest about it
                            BEFORE the person spends effort on text nobody will read. %>
                        <%# on a phone the note folds behind « Add a note » (open when it holds text) %>
                        <% if (!rowRO) { %><button type="button" class="btn btn-secondary btn-sm sa-note-add" data-note-for="<%= skill.skillId %>" aria-expanded="false" hidden><i class="fas fa-plus" aria-hidden="true"></i> <%= __('employee:sa_add_note') %></button><% } %>
                        <textarea name="assessments[<%= skill.skillId %>][notes]"
                                  class="form-control<%= saLocked ? ' sa-locked' : '' %><%= _hasNote ? ' sa-note-has' : '' %>"
                                  rows="2"
                                  <%= rowRO ? 'readonly' : '' %>
                                  aria-label="<%= __('employee:aria_notes_for') %> <%= skill.skillName %><%= saLocked ? ' — ' + __('employee:sa_locked_aria') : '' %>"
                                  <% if (saLocked) { %>title="<%= __('employee:sa_notes_locked_title') %>"<% } %>
                                  data-default-ph="<%= saLocked ? __('employee:sa_notes_locked_ph') : __('employee:sa_notes_placeholder') %>"
                                  <%# an evidence nudge, never a requirement. %>
                                  placeholder="<%= saLocked ? __('employee:sa_notes_locked_ph') : (_shNudge === 'evidence' ? __('employee:sa_nudge_evidence') : (_shNudge === 'training' ? __('employee:sa_nudge_training') : __('employee:sa_notes_placeholder'))) %>"><%= skill.selfAssessment ? skill.selfAssessment.notes || '' : '' %></textarea>
                        <% if (saLocked) { %><span class="sa-lock-badge"><i class="fas fa-lock" aria-hidden="true"></i> <%= __('employee:sa_notes_locked') %></span><% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </details>
    <% }); %>

    <div class="sa-empty" id="saEmpty" hidden><%= __('employee:sa_filter_empty') %></div>
</form>
<% } %>


<%# The page CSS (deadline banner, sticky bar, chips, sections, card rows on a
    phone) is public/css/self-assessment.css. %>

<!-- Offline resilience: cache ratings locally (IndexedDB) and replay when back online. -->
<!--
  The replay POSTs under the CURRENT session, and the server writes to req.user.id.
  On a shared site tablet the store therefore has to know whose drafts these are:
  without it, drafts A saved offline were replayed into B's assessment after B
  signed in. `SA_USER_ID` below is script-scoped, so the owner is published here
  where the two library files can read it.
-->
<script nonce="<%= cspNonce %>">
    window.APP_DRAFT_OWNER = '<%= user && user.id ? user.id : "" %>';
</script>
<%# The sync status speaks the page language: labels from locales/*/employee.json
    in a JSON data block (never executed). `locked` keeps it quiet on a read-only
    page, where nothing can be saved. %>
<script type="application/json" id="syncI18n"><%- include('../../partials/json-script', { v: {
    locked: _ro,
    synced: __('employee:sync_synced'),
    online: __('employee:sync_online'),
    offline: __('employee:sync_offline'),
    offlineOne: __('employee:sync_offline_one', { n: '%n%' }),
    offlineOther: __('employee:sync_offline_other', { n: '%n%' }),
    syncingOne: __('employee:sync_syncing_one', { n: '%n%' }),
    syncingOther: __('employee:sync_syncing_other', { n: '%n%' }),
    failedOne: __('employee:sync_failed_one', { n: '%n%' }),
    failedOther: __('employee:sync_failed_other', { n: '%n%' })
} }) %></script>
<script src="/js/draft-store.js?v=<%= assetVersion %>"></script>
<script src="/js/sync-indicator.js?v=<%= assetVersion %>"></script>
<%# 3.23.21: the strings sa-skill-help.js needs — a JSON data
    block (never executed, so no nonce needed), escaped by json-script. %>
<script type="application/json" id="saHelpI18n"><%- include('../../partials/json-script', { v: {
    levelLine: __('employee:sa_level_line', { n: '%n%' }),
    met: __('employee:sa_req_met'),
    gap: __('employee:sa_req_gap', { n: '%n%' }),
    nudgeEvidence: __('employee:sa_nudge_evidence'),
    nudgeTraining: __('employee:sa_nudge_training'),
    showAll: __('employee:sa_help_show_all'),
    hideAll: __('employee:sa_help_hide_all')
} }) %></script>
<script src="/js/sa-skill-help.js?v=<%= assetVersion %>"></script>

<script nonce="<%= cspNonce %>">
(function () {
    const selects = Array.from(document.querySelectorAll('.self-rating-select'));
    const rows = selects.map((s) => s.closest('tr'));
    const SA_USER_ID = '<%= user && user.id ? user.id : "0" %>';
    // The REAL campaign id, so an offline draft can state which campaign it
    // belongs to and the server can refuse to re-file it into a later one.
    const SA_CYCLE_ID = <%- JSON.stringify(typeof cycle !== "undefined" && cycle && cycle.id != null ? String(cycle.id) : null) %>;
    // A read-only page (locked campaign): no autosave, no save, no submit.
    const SA_FORM = document.getElementById('selfAssessmentForm');
    const SA_RO = !!(SA_FORM && SA_FORM.dataset.readonly);
    const SA_I18N = {
        range: <%- JSON.stringify(__('employee:sa_estimate_range', { lo: '%lo%', hi: '%hi%' })) %>,
        stillZero: <%- JSON.stringify(__('employee:sa_still_zero')) %>,
        allRated: <%- JSON.stringify(__('employee:sa_all_rated')) %>,
        draftSaved: <%- JSON.stringify(__('employee:sa_toast_draft_saved')) %>,
        partialSkipped: <%- JSON.stringify(__('employee:sa_toast_partial_skipped')) %>,
        submitted: <%- JSON.stringify(__('employee:sa_toast_submitted')) %>,
        errPrefix: <%- JSON.stringify(__('employee:err_prefix')) %>,
        errNetwork: <%- JSON.stringify(__('employee:err_network')) %>,
        saving: <%- JSON.stringify(__('employee:sa_autosaving')) %>,
        saved: <%- JSON.stringify(__('employee:sa_autosaved')) %>,
        autosavePending: <%- JSON.stringify(__('employee:sa_autosave_pending')) %>,
        autosaveFailed: <%- JSON.stringify(__('employee:sa_autosave_failed')) %>,
        autosavePartial: <%- JSON.stringify(__('employee:sa_autosave_partial')) %>,
        autosaveRetry: <%- JSON.stringify(__('employee:sa_autosave_retry')) %>,
        minutes: <%- JSON.stringify(__('employee:sa_minutes')) %>,
        collapseAll: <%- JSON.stringify(__('employee:sa_collapse_all')) %>,
        expandAll: <%- JSON.stringify(__('employee:sa_expand_all')) %>,
        // Server returns a STABLE error code (never English prose); map it here.
        codes: {
            already_submitted: <%- JSON.stringify(__('employee:err_already_submitted')) %>,
            invalid_data: <%- JSON.stringify(__('employee:err_invalid_data')) %>,
            invalid_assessments: <%- JSON.stringify(__('employee:err_invalid_assessments')) %>,
            rate_at_least_one: <%- JSON.stringify(__('employee:err_rate_at_least_one')) %>,
            nothing_to_save: <%- JSON.stringify(__('employee:err_nothing_to_save')) %>,
            validation: <%- JSON.stringify(__('employee:err_validation')) %>,
            unexpected: <%- JSON.stringify(__('employee:err_unexpected')) %>,
            cycle_locked: <%- JSON.stringify(__('employee:err_cycle_locked')) %>,
            cycle_changed: <%- JSON.stringify(__('employee:err_cycle_changed')) %>,
            unknown: <%- JSON.stringify(__('employee:err_unknown')) %>,
        },
    };
    // Resolve a server error to a localized message. The server now sends a
    // localized `message` for the campaign refusals, and it is MORE specific
    // than anything this map can hold (it names the campaign and its closing
    // date), so prefer it; fall back to the code map, then to a generic line.
    function errMessage(result, status) {
        if (result && typeof result.message === 'string' && result.message.trim()) return result.message;
        const code = result && result.code;
        return (code && SA_I18N.codes[code]) || SA_I18N.codes.unknown;
    }
    const ratedEl = document.getElementById('saRatedCount');
    const totalEl = document.getElementById('saTotalCount');
    const fillEl = document.getElementById('saProgressFill');
    const zeroEl = document.getElementById('saZeroNote');
    const confirmBox = document.getElementById('saConfirm');
    const autosaveEl = document.getElementById('saAutosave');

    // The app-wide toast (public/js/ui-feedback.js): one component, an icon and
    // a spoken kind, an error that stays until it is dismissed.
    function toast(msg, type) {
        if (typeof window.toast === 'function') window.toast(msg, type || 'info');
    }
    // Filters and tools are folded on a phone, open on a wide screen.
    const toolsWrap = document.getElementById('saToolsWrap');
    if (toolsWrap && window.matchMedia && window.matchMedia('(min-width: 780px)').matches) toolsWrap.open = true;

    // "Answered" = the person made a deliberate choice, INCLUDING a considered "0 — None".
    // Seeded server-side from whether a level was ever saved (null = never rated), and set
    // on any interaction below. This stops the UI from nagging an honest 0 as "unrated"
    // (which made completion feel unreachable and penalised honesty).
    // PROGRESS reads data-rated ("a level exists"), which stays true once a row is
    // submitted/approved and locked. collect below reads data-answered ("editable
    // AND rated"), which must stay false on a locked row so saving a draft never
    // re-posts an approved rating. Two questions, two flags — conflating them made
    // the progress bar drop back to 0 the moment the person submitted.
    const isRated = (s) => s.dataset.rated === '1';
    function markAnswered(s) {
        if (!s) return;
        s.dataset.answered = '1';
        s.dataset.rated = '1';
        s.classList.remove('sa-unanswered');
    }

    function updateProgress() {
        const total = selects.length;
        const rated = selects.filter(isRated).length;
        const zeros = total - rated;
        ratedEl.textContent = rated;
        totalEl.textContent = total;
        fillEl.style.width = total ? Math.round((rated / total) * 100) + '%' : '0%';
        zeroEl.textContent = zeros ? ' · ' + zeros + ' ' + SA_I18N.stillZero : ' · ' + SA_I18N.allRated;

        // Time estimate: 15 to 20 s per remaining skill, floor of 1 minute.
        // The server rendered the same range; JS only keeps it live while rating.
        const lo = Math.max(1, Math.round((zeros * 15) / 60));
        const hi = Math.max(lo, Math.round((zeros * 20) / 60));
        document.getElementById('saEstimate').textContent =
            lo === hi ? String(lo) : SA_I18N.range.replace('%lo%', String(lo)).replace('%hi%', String(hi));

        // Per-section progress + completion state.
        document.querySelectorAll('[data-section]').forEach((sec) => {
            const secSelects = Array.from(sec.querySelectorAll('.self-rating-select'));
            const done = secSelects.filter(isRated).length;
            const cnt = sec.querySelector('[data-section-progress]');
            const bar = sec.querySelector('[data-section-fill]');
            if (cnt) cnt.textContent = done + '/' + secSelects.length;
            if (bar) bar.style.width = secSelects.length ? Math.round((done / secSelects.length) * 100) + '%' : '0%';
            sec.classList.toggle('is-complete', secSelects.length > 0 && done === secSelects.length);
        });

        // Filter chip counters.
        document.getElementById('chipUnrated').textContent = zeros;
        document.getElementById('chipCritical').textContent =
            rows.filter((r) => r.dataset.critical === '1').length;
        document.getElementById('chipGap').textContent = selects.filter((s) => {
            const req = parseInt(s.closest('tr').dataset.required, 10) || 0;
            return parseInt(s.value, 10) < req;
        }).length;
    }

    // ---- filters: let a person work through a long list in passes ----
    let activeFilter = 'all';
    let searchTerm = '';
    function applyFilter() {
        let visible = 0;
        rows.forEach((r, i) => {
            const s = selects[i];
            const req = parseInt(r.dataset.required, 10) || 0;
            let show = true;
            if (activeFilter === 'unrated') show = !isRated(s);
            else if (activeFilter === 'critical') show = r.dataset.critical === '1';
            else if (activeFilter === 'gap') show = parseInt(s.value, 10) < req;
            // Free-text skill search — essential when a role carries 100+ skills.
            if (show && searchTerm) {
                // The NAME only (3.23.21, D1): the cell now also holds the skill's
                // description and level texts, which must never match a search.
                const name = (r.querySelector('.sa-skill-name') || {}).textContent || '';
                show = name.toLowerCase().indexOf(searchTerm) >= 0;
            }
            r.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        // Hide sections that have no visible rows under the active filter.
        document.querySelectorAll('[data-section]').forEach((sec) => {
            const any = Array.from(sec.querySelectorAll('tbody tr')).some((r) => r.style.display !== 'none');
            sec.style.display = any ? '' : 'none';
            if (any && activeFilter !== 'all') sec.open = true;
        });
        document.getElementById('saEmpty').hidden = visible > 0;
    }
    document.querySelectorAll('.sa-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
            document.querySelectorAll('.sa-chip').forEach((c) => c.classList.remove('is-active'));
            chip.classList.add('is-active');
            activeFilter = chip.dataset.filter;
            applyFilter();
        });
    });

    // ---- power tools: search, jump-to-next-unrated, collapse/expand all ----
    const searchEl = document.getElementById('saSearch');
    let searchDebounce = null;
    searchEl.addEventListener('input', () => {
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(() => {
            searchTerm = searchEl.value.trim().toLowerCase();
            applyFilter();
        }, 150);
    });

    function focusRow(row) {
        rows.forEach((r) => r.classList.remove('sa-focus'));
        if (!row) return;
        row.classList.add('sa-focus');
        const sec = row.closest('[data-section]');
        if (sec && !sec.open) sec.open = true;
        // Where the five buttons replace the list, focus them.
        const seg = segActive() ? row.querySelector('.sa-seg') : null;
        const segBtn = seg && (seg.querySelector('.sa-seg-b[aria-checked="true"]') || seg.querySelector('.sa-seg-b'));
        const sel = row.querySelector('.self-rating-select');
        if (segBtn) segBtn.focus({ preventScroll: true });
        else if (sel) sel.focus({ preventScroll: true });
        // scrollIntoView({block:'center'}) centred the row in the VIEWPORT, and the
        // sticky #saBar (top: --topbar-height) covers its upper part: on a short or
        // narrow viewport the centred row — and the <select> that now holds the
        // focus — landed under the bar (measured: select 9 / 15 / 36 px masked at
        // 414x896, 1280x400, 375x812; scroll-margin-top is ignored on a <tr>). So
        // the target is computed: the row is centred where there is room (1280x800:
        // identical to before), otherwise it sits 8 px below the bar. One scroll,
        // no motion added; smooth only when the person has not asked for less.
        // On a phone the bar sits at the BOTTOM (thumb zone): it then covers the
        // bottom of the screen, not the top.
        const bar = document.getElementById('saBar');
        const barAtBottom = !!(bar && getComputedStyle(bar).position === 'fixed');
        const covered = bar && !barAtBottom ? (parseFloat(getComputedStyle(bar).top) || 0) + bar.offsetHeight : 0;
        const r = row.getBoundingClientRect();
        const room = window.innerHeight - (barAtBottom ? bar.offsetHeight : 0);
        const rowTop = barAtBottom
            ? Math.max(56, Math.min((room - r.height) / 2, room - r.height - 8))
            : Math.max((window.innerHeight - r.height) / 2, covered + 8);
        const reduce = !!(window.MOTION && window.MOTION.reduce);
        window.scrollTo({ top: Math.max(0, window.scrollY + r.top - rowTop), behavior: reduce ? 'auto' : 'smooth' });
    }
    document.getElementById('saNextUnrated').addEventListener('click', () => {
        // Next unrated AFTER the currently focused one, wrapping around.
        const cur = rows.findIndex((r) => r.classList.contains('sa-focus'));
        const order = rows.map((_, i) => (cur + 1 + i) % rows.length);
        const nextIdx = order.find((i) => !isRated(selects[i]));
        if (nextIdx === undefined) { toast(SA_I18N.allRated, 'success'); return; }
        focusRow(rows[nextIdx]);
    });

    const toggleAllBtn = document.getElementById('saToggleAll');
    toggleAllBtn.addEventListener('click', () => {
        const collapsing = toggleAllBtn.dataset.state === 'open';
        document.querySelectorAll('[data-section]').forEach((s) => { s.open = !collapsing; });
        toggleAllBtn.dataset.state = collapsing ? 'closed' : 'open';
        document.getElementById('saToggleAllLabel').textContent = collapsing ? SA_I18N.expandAll : SA_I18N.collapseAll;
        toggleAllBtn.querySelector('i').className = collapsing ? 'fas fa-expand' : 'fas fa-compress';
    });

    // Keyboard rating: 0-4 sets the level on the focused row and advances to
    // the next unrated one — a whole assessment can be done without the mouse.
    // UX-12 (3.23.17): the shortcuts used to fire wherever the focus was on the
    // page (the body, the sticky bar, the search box's neighbours), so a stray
    // "2" or "j" silently rated/moved a background row. They now act ONLY when
    // the keyboard focus is inside a rating row, and never while typing.
    document.addEventListener('keydown', (e) => {
        const tag = e.target && e.target.tagName;
        const inRatings = !!(e.target && e.target.nodeType === 1 && rows.some((r) => r.contains(e.target)));
        if (!inRatings) return;
        if (/^(INPUT|TEXTAREA)$/.test(tag) || (e.target && e.target.isContentEditable)) return;
        // Don't hijack keys while a button/link (toolbar, filter chip, "Next unrated")
        // is focused — a digit there must not silently rate a background row.
        // The five level buttons of a row ARE the rating control: 0-4 and J/K keep
        // working on them (the same keyboard model as the list).
        const onSeg = tag === 'BUTTON' && e.target.classList.contains('sa-seg-b');
        if ((tag === 'BUTTON' && !onSeg) || tag === 'A') return;
        if (onSeg && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
            // radiogroup arrows: move between the five levels of THIS row
            const btns = Array.from(e.target.parentElement.querySelectorAll('.sa-seg-b'));
            const i = btns.indexOf(e.target) + (e.key === 'ArrowRight' ? 1 : -1);
            if (btns[i]) { e.preventDefault(); btns[i].focus(); }
            return;
        }
        // A focused native <select> (rows auto-focus their rating select) must keep
        // its own keyboard behavior — Arrow/Home/End/Space change the rating for
        // keyboard & screen-reader users. Don't hijack those (WCAG 2.1.1). The j/k
        // row-nav and 0–4 quick-set shortcuts below still work while a select is focused.
        if (tag === 'SELECT' && (e.key === 'ArrowUp' || e.key === 'ArrowDown'
            || e.key === 'ArrowLeft' || e.key === 'ArrowRight'
            || e.key === 'Home' || e.key === 'End' || e.key === ' ' || e.key === 'Enter')) return;
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        const focused = rows.find((r) => r.contains(e.target)) || rows.find((r) => r.classList.contains('sa-focus'));
        if (/^[0-4]$/.test(e.key)) {
            // Rate the ACTUALLY-focused select if a keyboard/SR user is on one — never
            // redirect a digit to a different (mouse-highlighted) row, which silently
            // mis-rated the wrong skill.
            // The row that holds the focus — never a different, merely highlighted one.
            const ownRow = rows.find((r) => r.contains(e.target));
            const sel = (tag === 'SELECT' && e.target.classList.contains('self-rating-select'))
                ? e.target
                : (tag === 'SELECT' ? null : (ownRow && ownRow.querySelector('.self-rating-select')));
            if (!sel || sel.disabled) return; // a locked row / read-only page is never rated
            e.preventDefault();
            sel.value = e.key;
            sel.dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('saNextUnrated').click();
        } else if (e.key === 'j' || e.key === 'ArrowDown') {
            const visible = rows.filter((r) => r.style.display !== 'none');
            const i = visible.indexOf(focused);
            if (visible.length) { e.preventDefault(); focusRow(visible[Math.min(i + 1, visible.length - 1)] || visible[0]); }
        } else if (e.key === 'k' || e.key === 'ArrowUp') {
            const visible = rows.filter((r) => r.style.display !== 'none');
            const i = visible.indexOf(focused);
            if (visible.length) { e.preventDefault(); focusRow(visible[Math.max(i - 1, 0)] || visible[0]); }
        }
    });

    // ---- anti-anchoring: the validated level is hidden until asked for ----
    const showCurrent = document.getElementById('saShowCurrent');
    try {
        if (localStorage.getItem('saShowCurrent') === '1') { showCurrent.checked = true; document.body.classList.add('sa-show-current'); }
    } catch (_) { /* private mode */ }
    showCurrent.addEventListener('change', function () {
        document.body.classList.toggle('sa-show-current', this.checked);
        try { localStorage.setItem('saShowCurrent', this.checked ? '1' : '0'); } catch (_) { /* noop */ }
    });

    selects.forEach((s) => s.addEventListener('change', () => { markAnswered(s); updateProgress(); applyFilter(); syncSeg(s); }));

    // ---- five large 0-4 buttons on phones / touch screens ----
    // The <select> stays the single source of truth (collect(), autosave, the
    // keyboard 0-4 / J/K model): a tap sets it and fires the same `change`,
    // then moves on to the next unrated skill — one tap per skill.
    function syncSeg(s) {
        const seg = document.querySelector('.sa-seg[data-seg-for="' + s.dataset.skillId + '"]');
        if (!seg) return;
        seg.querySelectorAll('.sa-seg-b').forEach((b) => {
            const on = s.dataset.rated === '1' && b.dataset.v === s.value;
            b.setAttribute('aria-checked', on ? 'true' : 'false');
            b.tabIndex = on ? 0 : -1;
        });
        if (!seg.querySelector('.sa-seg-b[aria-checked="true"]')) {
            const first = seg.querySelector('.sa-seg-b');
            if (first) first.tabIndex = 0;
        }
    }
    document.body.classList.add('sa-seg-js');
    document.querySelectorAll('.sa-seg').forEach((seg) => { seg.hidden = false; });
    document.querySelectorAll('.sa-note-add').forEach((b) => { b.hidden = false; });
    function segActive() {
        const any = document.querySelector('.sa-seg');
        return !!(any && any.offsetParent !== null);
    }
    document.addEventListener('click', (e) => {
        const btn = e.target && e.target.closest ? e.target.closest('.sa-seg-b') : null;
        if (btn) {
            const sel = document.getElementById('sa-rate-' + btn.parentElement.dataset.segFor);
            if (!sel || sel.disabled || btn.disabled) return;
            sel.value = btn.dataset.v;
            sel.dispatchEvent(new Event('change', { bubbles: true }));
            // auto-advance (as with the keyboard): the next unrated skill
            const nextBtn = document.getElementById('saNextUnrated');
            if (nextBtn && selects.some((x) => !isRated(x))) nextBtn.click();
            return;
        }
        const add = e.target && e.target.closest ? e.target.closest('.sa-note-add') : null;
        if (add) {
            const row = add.closest('tr');
            const ta = row && row.querySelector('textarea');
            if (!ta) return;
            const open = !ta.classList.contains('sa-note-open');
            ta.classList.toggle('sa-note-open', open);
            add.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open) ta.focus();
        }
    });

    // Persist a rating to the local draft store so a network drop (common on
    // remote sites / mobile) never loses work; sync-indicator.js replays it.
    // ONLY work that could not reach the server is queued on the device — while
    // offline, after a failed save, or when the page is left with a save still
    // pending. A rating the server accepted leaves no local copy (IndexedDB is
    // readable by the next user of a shared device).
    const dirty = new Set();
    function cacheDraft(select) {
        if (!window.AppDraftStore) return;
        const row = select.closest('tr');
        const ta = row ? row.querySelector('textarea') : null;
        try {
            window.AppDraftStore.put({
                userId: SA_USER_ID, cycleId: SA_CYCLE_ID,
                skillId: select.dataset.skillId,
                level: select.value,
                justification: ta ? ta.value : '',
            });
        } catch (_) { /* best-effort; IndexedDB may be unavailable */ }
    }
    function queueDirty() {
        dirty.forEach((s) => cacheDraft(s));
    }
    function forgetSaved(sentSkillIds, skipped) {
        if (!window.AppDraftStore || !window.AppDraftStore.markSyncedFor) return;
        const refused = new Set((skipped || []).map((x) => String(x && x.skillId)));
        sentSkillIds.forEach((skillId) => {
            if (refused.has(String(skillId))) return;
            window.AppDraftStore.markSyncedFor({ userId: SA_USER_ID, cycleId: SA_CYCLE_ID, skillId })
                .catch(() => { /* store unavailable */ });
        });
        selects.forEach((s) => { if (!refused.has(String(s.dataset.skillId))) dirty.delete(s); });
    }
    // Leaving the page with a change not yet sent: keep it on the device.
    window.addEventListener('pagehide', () => { if (dirty.size) queueDirty(); });

    function collect() {
        // Only send skills the employee actually rated. A never-touched <select>
        // reports value "0" (no option is `selected`), so serializing every select
        // would silently persist ~every role skill as a real "0 — None", flooding the
        // manager's review queue and destroying the honest "unrated = null" model.
        return selects
            .filter((select) => select.dataset.answered === '1')
            .map((select) => {
                const row = select.closest('tr');
                return {
                    skillId: select.dataset.skillId,
                    selfRatedLevel: select.value,
                    notes: row.querySelector('textarea').value,
                };
            });
    }

    async function post(url, okMsg, opts) {
        const silent = opts && opts.silent;
        const sent = collect();
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ assessments: sent }),
            });
            const result = await res.json().catch(() => ({}));
            if (res.ok && result.success) {
                // The server holds these now: no copy stays on the device.
                forgetSaved(sent.map((a) => a.skillId), result.skipped);
                // A 200 with a non-empty `skipped` list is a PARTIAL save: the server
                // declined those rows (already submitted/approved, or a closed
                // campaign). Reporting a plain success over them is the same lie as
                // the discarded note this page used to accept — say what was refused.
                const skipped = Array.isArray(result.skipped) ? result.skipped : [];
                if (!silent) {
                    if (skipped.length) {
                        toast(SA_I18N.partialSkipped.replace('{{n}}', String(skipped.length)), 'error');
                    } else {
                        toast(okMsg, 'success');
                    }
                    setTimeout(() => location.reload(), skipped.length ? 2500 : 1000);
                }
                // A partial save is NOT a save. This returned a bare `true`, and
                // the autosave — which calls with silent:true and so never saw
                // the toast — printed "enregistré HH:MM:SS" over rows the server
                // had just declined. The caller gets the refusal count and
                // decides; nobody is told their work is safe when it is not.
                return { ok: true, skipped };
            }
            // A refusal (4xx) is not a network problem: replaying it would be
            // refused again. A server error is queued for the replay.
            if (res.status >= 500) queueDirty();
            if (!silent) toast(SA_I18N.errPrefix + errMessage(result, res.status), 'error');
            return { ok: false, skipped: [] };
        } catch (e) {
            queueDirty(); // the save did not reach the server: keep it on the device
            if (!silent) toast(SA_I18N.errNetwork, 'error');
            return { ok: false, skipped: [] };
        }
    }

    // ---- AUTOSAVE: a long form must never lose work to a closed tab ----
    //
    // Four states, and each one is true at the moment it is shown:
    //
    //   pending  the change is in the browser and NOTHING has been sent yet.
    //            This said "enregistrement en cours" for the whole 2.5 s
    //            debounce, i.e. it claimed a request was in flight while none
    //            was.
    //   saving   the request has actually departed.
    //   saved    a 200 with NOTHING skipped. A partial save no longer lands
    //            here; it lands in `failed`, because rows were refused.
    //   failed   the save did not happen (or not entirely). It used to blank
    //            the label, so work that never reached the server showed the
    //            reader exactly nothing. It now persists and offers a retry.
    let autosaveTimer = null;
    let autosaveInFlight = false;

    function renderAutosave(state, detail) {
        autosaveEl.textContent = '';
        autosaveEl.classList.toggle('sa-autosave-failed', state === 'failed');
        if (state === 'pending') { autosaveEl.textContent = SA_I18N.autosavePending; return; }
        if (state === 'saving') { autosaveEl.textContent = SA_I18N.saving; return; }
        if (state === 'saved') {
            autosaveEl.textContent = SA_I18N.saved + ' ' + FMT.time(new Date());
            return;
        }
        // failed — say so, and give a control that actually retries.
        autosaveEl.appendChild(document.createTextNode((detail || SA_I18N.autosaveFailed) + ' '));
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.className = 'btn-link sa-autosave-retry';
        retry.textContent = SA_I18N.autosaveRetry;
        retry.addEventListener('click', runAutosave);
        autosaveEl.appendChild(retry);
    }

    async function runAutosave() {
        if (autosaveInFlight) return; // one save at a time; a retry must not pile up
        autosaveInFlight = true;
        renderAutosave('saving');
        try {
            const r = await post('/employee/self-assessment/save-draft', null, { silent: true });
            if (r.ok && !r.skipped.length) renderAutosave('saved');
            else if (r.ok) {
                renderAutosave('failed', SA_I18N.autosavePartial.replace('{{n}}', String(r.skipped.length)));
            } else renderAutosave('failed');
        } finally {
            autosaveInFlight = false;
        }
    }

    function scheduleAutosave() {
        clearTimeout(autosaveTimer);
        renderAutosave('pending');
        autosaveTimer = setTimeout(runAutosave, 2500);
    }
    // A change is queued on the device only while offline; online, the
    // autosave sends it and a failure queues it (post() above).
    function noteChange(s) {
        dirty.add(s);
        if (!navigator.onLine) cacheDraft(s);
        scheduleAutosave();
    }
    // A read-only page never queues, autosaves or sends.
    if (!SA_RO) selects.forEach((s) => {
        s.addEventListener('change', () => noteChange(s));
        const row = s.closest('tr');
        const ta = row ? row.querySelector('textarea') : null;
        if (ta) ta.addEventListener('blur', () => noteChange(s));
    });

    if (!SA_RO) {
    document.getElementById('saveDraftBtn').addEventListener('click', function () {
        this.disabled = true;
        post('/employee/self-assessment/save-draft', SA_I18N.draftSaved).finally(() => { this.disabled = false; });
    });

    // Inline confirmation instead of window.confirm
    document.getElementById('submitBtn').addEventListener('click', function () {
        confirmBox.hidden = false;
        confirmBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        // Move focus into the revealed dialog so keyboard/SR users hear it (WCAG 4.1.3).
        var yesBtn = document.getElementById('saConfirmYes');
        if (yesBtn) yesBtn.focus();
    });
    function closeConfirm() { confirmBox.hidden = true; var s = document.getElementById('submitBtn'); if (s) s.focus(); }
    document.getElementById('saConfirmNo').addEventListener('click', closeConfirm);
    // Escape closes the confirm dialog and returns focus to the trigger (WCAG 2.1.2/2.4.3).
    confirmBox.addEventListener('keydown', function (e) { if (e.key === 'Escape') { e.preventDefault(); closeConfirm(); } });
    document.getElementById('saConfirmYes').addEventListener('click', async function () {
        this.disabled = true;
        // `post` reports { ok, skipped }; a partial submit must re-enable the
        // button too, so the reader can act on what was refused.
        const r = await post('/employee/self-assessment/submit', SA_I18N.submitted);
        if (!r.ok || r.skipped.length) { this.disabled = false; } else { confirmBox.hidden = true; }
    });
    } // !SA_RO

    updateProgress();
    applyFilter();
})();
</script>
