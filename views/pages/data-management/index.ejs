    // The snapshot name travels on a data- attribute and is read back through
    // dataset. It used to be spliced into an inline click handler restoreSnapshot(id,'NAME') via an
    // escaped EJS output tag: EJS turns ' into &#39;, the HTML parser decodes it back BEFORE the handler is
    // compiled, so a name like  x');alert(1);//  ran as script (and O'Brien broke).
    function restoreSnapshotBtn(btn) {
        return restoreSnapshot(Number(btn.dataset.snapshotId), btn.dataset.snapshotName || '');
    }

    async function restoreSnapshot(snapshotId, snapshotName) {
        if (!(await window.confirmDialog(`${I18N.restoreWarn1}${snapshotName}${I18N.restoreWarn2}`, { danger: true }))) {
            return;
        }

        if (!(await window.confirmDialog(I18N.confirmRestoreAbsolutely, { danger: true }))) {
            return;
        }

        showLoading(I18N.restoringSnapshot);

        fetch(`/data-management/snapshots/${snapshotId}/restore`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ snapshotId, _csrf: '<%= csrfToken %>' })
        })
            .then(res => res.json())
            .then(data => {
                hideLoading();
                if (data.success) {
                    alert(I18N.snapshotRestored);
                    location.reload();
                } else {
                    alert(I18N.errorPrefix + ' ' + (data.error || I18N.failedRestoreSnapshot));
                }
            })
            .catch(error => {
                hideLoading();
                console.error('Restore snapshot error:', error);
                alert(I18N.errorRestoringSnapshot);
            });
    }

    async function deleteSnapshot(snapshotId) {
        if (!(await window.confirmDialog(I18N.confirmDeleteSnapshot, { danger: true }))) {
            return;
        }

        showLoading(I18N.deletingSnapshot);

        fetch(`/data-management/snapshots/${snapshotId}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        })
            .then(res => res.json())
            .then(data => {
                hideLoading();
                if (data.success) {
                    location.reload();
                } else {
                    alert(I18N.errorPrefix + ' ' + (data.error || I18N.failedDeleteSnapshot));
                }
            })
            .catch(error => {
                hideLoading();
                console.error('Delete snapshot error:', error);
                alert(I18N.errorDeletingSnapshot);
            });
    }

    // Reset database functionality
    document.addEventListener('DOMContentLoaded', function () {
        const resetForm = document.getElementById('resetDatabaseForm');
        const resetConfirmation = document.getElementById('resetConfirmation');
        const resetAcknowledge = document.getElementById('resetAcknowledge');
        const resetSubmitBtn = document.getElementById('resetSubmitBtn');

        if (resetForm) {
            // Enable/disable submit button based on confirmation and checkbox
            function checkResetConditions() {
                const confirmationValid = resetConfirmation.value === 'RESET_ALL_DATA';
                const acknowledged = resetAcknowledge.checked;
                resetSubmitBtn.disabled = !(confirmationValid && acknowledged);
            }

            resetConfirmation.addEventListener('input', checkResetConditions);
            resetAcknowledge.addEventListener('change', checkResetConditions);

            resetForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                const confirmation = resetConfirmation.value;
                if (confirmation !== 'RESET_ALL_DATA') {
                    alert(I18N.typeResetExactly);
                    return;
                }

                if (!resetAcknowledge.checked) {
                    alert(I18N.pleaseAcknowledge);
                    return;
                }

                // Final confirmation (two styled dialogs, never a native box)
                if (!(await window.confirmDialog(I18N.finalWarning, { danger: true }))) {
                    return;
                }

                if (!(await window.confirmDialog(I18N.lastChance, { danger: true }))) {
                    return;
                }

                const formData = new FormData(this);
                const data = {
                    confirmation: formData.get('confirmation'),
                    _csrf: formData.get('_csrf')
                };

                showLoading(I18N.resettingDatabase);

                fetch('/data-management/reset', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                })
                    .then(res => {
                        // A redirect (session expired, or a password change still
                        // required on this account) comes back as an HTML page, and
                        // parsing it as JSON produced an opaque "Unexpected token <"
                        // alert. Say what actually happened instead.
                        if (res.redirected || !(res.headers.get('content-type') || '').includes('application/json')) {
                            throw new Error('the server redirected to ' + (res.url || '?') + ' — sign in again (or complete the required password change) and retry');
                        }
                        return res.json();
                    })
                    .then(result => {
                        hideLoading();
                        if (result.success) {
                            alert(I18N.resetSuccess);
                            // Redirect to login after reset
                            window.location.href = '/login';
                        } else {
                            alert(I18N.errorPrefix + ' ' + (result.error || I18N.failedReset));
                        }
                    })
                    .catch(error => {
                        hideLoading();
                        console.error('Reset database error:', error);
                        alert(I18N.errorResetting + ' ' + error.message);
                    });
            });
        }
    });
</script>
