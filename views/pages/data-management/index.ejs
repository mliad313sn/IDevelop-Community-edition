    // Dry-run preview for the Skill Matrix Workbook (no changes are written).
    function previewSkillMatrixWorkbook() {
        const fileInput = document.getElementById('skillMatrixWorkbookFile');
        const panel = document.getElementById('skillMatrixWorkbookPreview');
        if (!fileInput.files.length) { alert(I18N.chooseXlsxFirst); return; }
        const fd = new FormData();
        fd.append('file', fileInput.files[0]);
        panel.style.display = 'none';
        showLoading(I18N.analyzingWorkbook);
        fetch('/data-management/skill-matrix-workbook/preview', { method: 'POST', body: fd, headers: CSRF_HEADERS })
            .then(res => res.json())
            .then(data => {
                hideLoading();
                if (!data.success) {
                    panel.textContent = I18N.previewError + ' ' + (data.message || I18N.invalidFile);
                    panel.className = 'import-result error';
                    panel.style.display = 'block';
                    return;
                }
                const c = (data.preview && data.preview.counts) || {};
                const label = {
                    domains: I18N.labels.domains, skills: I18N.labels.skills, roles: I18N.labels.roles,
                    requirements: I18N.labels.roleRequirements, employees: I18N.labels.employees, assessments: I18N.labels.assessments
                };
                const lines = [];
                for (const [key, lab] of Object.entries(label)) {
                    const v = c[key];
                    if (!v || !v.inFile) continue;
                    if (v.new !== undefined) lines.push(`${lab}: ${v.inFile} ${I18N.inFile} — ${v.new} ${I18N.newWord}, ${v.existing} ${I18N.alreadyExist}`);
                    // Carry `note` through, as the JSON preview already does. It is
                    // where a section explains itself (e.g. rows the file cannot
                    // represent); dropping it here made the workbook preview quieter
                    // than the data warranted.
                    else lines.push(`${lab}: ${v.inFile} ${I18N.inFile}${v.note ? ' (' + v.note + ')' : ''}`);
                }
                const g = data.preview && data.preview.credentialsToGenerate;
                if (g && g.employees) {
                    lines.push(`${I18N.loginsToGenerate} ${g.employees} ${I18N.newEmployeesSuffix}`);
                }
                const errs = (data.preview && data.preview.errors) || [];
                if (errs.length) lines.push(`${I18N.warnings} ${errs.length} (${I18N.eg} ${errs[0]})`);
                panel.textContent = I18N.previewNoChanges + '\n' + (lines.length ? lines.join('\n') : I18N.nothingRecognized);
                panel.className = 'import-result success';
                panel.style.display = 'block';
            })
            .catch(err => {
                hideLoading();
                panel.textContent = I18N.previewError + ' ' + err.message;
                panel.className = 'import-result error';
                panel.style.display = 'block';
            });
    }

    function importData(form, url, resultId) {
        const formData = new FormData(form);
        const resultDiv = document.getElementById(resultId);
        resultDiv.style.display = 'none';
        resultDiv.className = 'import-result';

        showLoading(I18N.importingData);

        fetch(url, {
            method: 'POST',
            headers: CSRF_HEADERS,
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                hideLoading();
                if (data.success) {
                    let message = I18N.importCompleted;
                    if (data.results) {
                        // Per-entity lines. Counters come in two shapes: an
                        // object {created, skipped, errors} (section imports)
                        // or a plain number of applied rows (full JSON import).
                        const LABELS = {
                            sites: I18N.labels.sites, departments: I18N.labels.departments, services: I18N.labels.services,
                            regions: I18N.labels.regions, countries: I18N.labels.countries,
                            domains: I18N.labels.domains, skills: I18N.labels.skills, roles: I18N.labels.roles,
                            requirements: I18N.labels.requirements, employees: I18N.labels.employees,
                            assessments: I18N.labels.assessments, admins: I18N.labels.admins,
                            adminScopes: I18N.labels.adminScopes, appSettings: I18N.labels.settings
                        };
                        for (const [key, label] of Object.entries(LABELS)) {
                            const v = data.results[key];
                            if (v === undefined || v === null) continue;
                            if (typeof v === 'number') {
                                if (v > 0) message += `\n${label}: ${v} ${I18N.applied}`;
                            } else if (typeof v === 'object') {
                                message += `\n${label}: ${v.created ?? 0} ${I18N.created}`;
                                // Rewritten-existing rows (role requirements,
                                // assessments) are real work — reporting only
                                // `created` made a full re-import read "0".
                                if (v.updated) message += `, ${v.updated} ${I18N.updated}`;
                                // `unchanged` is the whole point of the importer fix:
                                // matched and NOT rewritten. Without it on screen, a
                                // re-import still reads as "0 created" and the operator
                                // cannot tell "did nothing" from "rewrote everything".
                                if (v.unchanged) message += `, ${v.unchanged} ${I18N.unchanged}`;
                                if (v.skipped) message += `, ${v.skipped} ${I18N.skipped}`;
                                // Blank scaffold rows — never a level 0.
                                if (v.notRated) message += `, ${v.notRated} ${I18N.notRated}`;
                                if (v.errors && v.errors.length > 0) message += `, ${v.errors.length} ${I18N.errors}`;
                            }
                        }
                        // Generic results
                        if (data.results.created !== undefined) {
                            message += `\n${data.results.created} ${I18N.itemsCreated}`;
                            if (data.results.skipped) message += `, ${data.results.skipped} ${I18N.skipped}`;
                            if (data.results.errors && data.results.errors.length > 0) {
                                message += `, ${data.results.errors.length} ${I18N.errors}`;
                            }
                        }
                    }
                    resultDiv.textContent = message;
                    resultDiv.className = 'import-result success';
                    resultDiv.style.display = 'block';
                    form.reset();

                    // Generated logins are shown ONCE — offer them as a CSV and
                    // do NOT auto-reload (reloading would lose the passwords).
                    const creds = data.results && data.results.credentials;
                    if (Array.isArray(creds) && creds.length > 0) {
                        window._lastImportCredentials = creds;
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-primary';
                        btn.style.marginTop = '10px';
                        btn.innerHTML = `<i class="fas fa-key" aria-hidden="true"></i> ${I18N.downloadCredentialsSheet} (${creds.length}) — CSV`;
                        btn.onclick = downloadCredentialsCsv;
                        const note = document.createElement('div');
                        note.style.cssText = 'margin-top:8px;font-size:0.8rem;';
                        note.textContent = I18N.credsNote;
                        resultDiv.appendChild(document.createElement('br'));
                        resultDiv.appendChild(btn);
                        resultDiv.appendChild(note);
                    } else {
                        // Reload page after 2 seconds to show updated data
                        setTimeout(() => location.reload(), 2000);
                    }
                } else {
                    resultDiv.textContent = I18N.errorPrefix + ' ' + (data.error || data.message || I18N.importFailed);
                    resultDiv.className = 'import-result error';
                    resultDiv.style.display = 'block';
                }
            })
            .catch(error => {
                hideLoading();
                console.error('Import error:', error);
                resultDiv.textContent = I18N.errorPrefix + ' ' + error.message;
                resultDiv.className = 'import-result error';
                resultDiv.style.display = 'block';
            });
    }

    // Build and download the generated-credentials sheet from the last import.
    function downloadCredentialsCsv() {
        const creds = window._lastImportCredentials || [];
        if (!creds.length) return;
        const esc = (v) => '"' + String(v ?? '').replace(/"/g, '""') + '"';
        const rows = [[I18N.csvType, I18N.csvEmployeeNumber, I18N.csvName, I18N.csvUsername, I18N.csvTempPassword]];
        creds.forEach(c => rows.push([c.type || '', c.employeeNumber || '', c.name || '', c.username || '', c.password || '']));
        const csv = '﻿' + rows.map(r => r.map(esc).join(',')).join('\r\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'generated-credentials-' + new Date().toISOString().slice(0, 10) + '.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(a.href);
    }

