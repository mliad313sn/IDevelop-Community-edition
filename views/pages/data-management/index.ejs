        const panel = document.getElementById('jsonPreviewResult');
        if (!fileInput.files.length) { alert(I18N.chooseJsonFirst); return; }
        const fd = new FormData();
        fd.append('jsonFile', fileInput.files[0]);
        panel.style.display = 'none';
        showLoading(I18N.analyzingFile);
        fetch('/admin/data/preview-json', { method: 'POST', body: fd, headers: CSRF_HEADERS })
            .then(res => res.json())
            .then(data => {
                hideLoading();
                if (!data.success) {
                    panel.textContent = I18N.previewError + ' ' + (data.message || I18N.invalidFile);
                    panel.className = 'import-result error';
                    panel.style.display = 'block';
                    return;
                }
                const c = data.preview.counts || {};
                const lines = [];
                const label = {
                    regions: I18N.labels.regions, countries: I18N.labels.countries, domains: I18N.labels.domains, skills: I18N.labels.skills,
                    sites: I18N.labels.sites, departments: I18N.labels.departments, services: I18N.labels.services, roles: I18N.labels.roles,
                    requirements: I18N.labels.roleRequirements, employees: I18N.labels.employees, assessments: I18N.labels.assessments,
                    admins: I18N.labels.admins, appSettings: I18N.labels.settings
                };
                for (const [key, lab] of Object.entries(label)) {
                    const v = c[key];
                    if (!v || !v.inFile) continue;
                    if (v.new !== undefined) lines.push(`${lab}: ${v.inFile} ${I18N.inFile} — ${v.new} ${I18N.newWord}, ${v.existing} ${I18N.alreadyExist}`);
                    else lines.push(`${lab}: ${v.inFile} ${I18N.inFile}${v.note ? ' (' + v.note + ')' : ''}`);
                }
                const g = data.preview.credentialsToGenerate || {};
                if (g.employees || g.admins) {
                    lines.push(I18N.loginsGenerateBoth.replace('{emp}', g.employees || 0).replace('{admins}', g.admins || 0));
                }
                panel.textContent = I18N.previewNoChanges + '\n' + (lines.length ? lines.join('\n') : I18N.nothingRecognized);
                panel.className = 'import-result success';
                panel.style.display = 'block';
            })
            .catch(err => {
                hideLoading();
                panel.textContent = I18N.previewError + ' ' + err.message;
                panel.className = 'import-result error';
                panel.style.display = 'block';
            });
    }

    function createSnapshot(form) {
