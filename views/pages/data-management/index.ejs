<% if (user && user.role === 'superadmin') { %>
<!-- Snapshots Section (super-admin only) -->
<div class="dashboard-section">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <div>
            <h2><i class="fas fa-camera" aria-hidden="true"></i> <%= __('datamgmt:snapshots_title') %></h2>
            <p><%= __('datamgmt:snapshots_desc') %></p>
        </div>
        <button class="btn btn-primary" data-on-click="showModal" data-args='["createSnapshotModal"]'><i class="fas fa-plus" aria-hidden="true"></i> <%= __('datamgmt:btn_create_snapshot') %></button>
    </div>

    <% if (snapshots && snapshots.length> 0) { %>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th><%= __('datamgmt:th_name') %></th>
                        <th><%= __('datamgmt:th_description') %></th>
                        <th><%= __('datamgmt:th_created_by') %></th>
                        <th><%= __('datamgmt:th_created_at') %></th>
                        <%# d: size + captured counts, so an empty capture is visible. %>
                        <th><%= __('datamgmt:th_size') %></th>
                        <th><%= __('datamgmt:th_actions') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% snapshots.forEach(function(snapshot) { %>
                        <tr>
                            <td><strong>
                                    <%= snapshot.name %>
                                </strong></td>
                            <td>
                                <%= snapshot.description || '-' %>
                            </td>
                            <td>
                                <%= snapshot.createdByUsername || __('datamgmt:unknown_user') %>
                            </td>
                            <td>
                                <%= fmtDateTime(snapshot.createdAt) %>
                            </td>
                            <td>
                                <% if (snapshot.sizeBytes == null) { %>—<% } else { %>
                                  <%= (snapshot.sizeBytes / 1024).toFixed(0) %> Ko
                                  <% const c = snapshot.entityCounts || {}; const keys = Object.keys(c).filter(function(k){ return c[k]; }).sort(); %>
                                  <% if (keys.length) { %>
                                    <div class="snap-counts"><%= keys.map(function(k){ return c[k] + ' ' + k; }).join(' · ') %></div>
                                  <% } %>
                                <% } %>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn btn-sm" data-on-click="viewSnapshotStats" data-args="<%= JSON.stringify([snapshot.id]) %>"
                                        title="<%= __('datamgmt:title_view_details') %>"><i class="fas fa-eye" aria-hidden="true"></i> <%= __('datamgmt:btn_view') %></button>
                                    <button class="btn btn-sm btn-warning"
                                        data-snapshot-id="<%= snapshot.id %>" data-snapshot-name="<%= snapshot.name %>"
                                        data-on-click="restoreSnapshotBtn" data-args='["$el"]'
                                        title="<%= __('datamgmt:title_restore_snapshot') %>"><i class="fas fa-arrows-rotate" aria-hidden="true"></i> <%= __('datamgmt:btn_restore') %></button>
                                    <button class="btn btn-sm btn-danger" data-on-click="deleteSnapshot" data-args="<%= JSON.stringify([snapshot.id]) %>"
                                        title="<%= __('datamgmt:title_delete_snapshot') %>"><i class="fas fa-trash-can" aria-hidden="true"></i> <%= __('datamgmt:btn_delete') %></button>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-camera" aria-hidden="true"></i></div>
                <h3><%= __('datamgmt:snapshots_empty_title') %></h3>
                <p><%= __('datamgmt:snapshots_empty_desc') %></p>
                <button class="btn btn-primary" data-on-click="showModal" data-args='["createSnapshotModal"]'><%= __('datamgmt:btn_create_first_snapshot') %></button>
            </div>
            <% } %>
</div>
<% } %>

