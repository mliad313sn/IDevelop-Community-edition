.sl-fg input, .sl-fg select { padding:5px 8px; background:var(--bg-elevated); color:var(--text-primary); border:1px solid var(--border-light); border-radius:var(--radius-sm); font-size:.85rem; }
.sl-chk { flex-direction:row; align-items:center; gap:6px; font-size:.85rem; color:var(--text-primary); text-transform:none; }
.sl-fg-err input, .sl-fg-err select { border-color:#ef4444; }
.sl-err { font-size:.72rem; color:#f87171; text-transform:none; letter-spacing:0; max-width:220px; }
.sl-sev { display:inline-block; padding:1px 7px; border-radius:6px; font-size:.74rem; font-weight:600; }
.sl-sev-info { background:rgba(59,130,246,.15); color:#60a5fa; } .sl-sev-warn { background:rgba(245,158,11,.18); color:#fbbf24; }
.sl-sev-error, .sl-sev-critical { background:rgba(239,68,68,.20); color:#f87171; }
/* Status code chips */
.sl-sc { display:inline-block; padding:1px 7px; border-radius:6px; font-size:.76rem; font-weight:700; font-variant-numeric:tabular-nums; }
.sl-sc-2 { background:rgba(16,185,129,.18); color:#34d399; } .sl-sc-3 { background:rgba(59,130,246,.18); color:#60a5fa; }
.sl-sc-4 { background:rgba(245,158,11,.18); color:#fbbf24; } .sl-sc-5 { background:rgba(239,68,68,.20); color:#f87171; }
