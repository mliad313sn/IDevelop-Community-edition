<script nonce="<%= cspNonce %>">
(function () {
    var T = {
        extend: <%- JSON.stringify(__('admin:adm_bulk_confirm_extend')) %>,
        profile: <%- JSON.stringify(__('admin:adm_bulk_confirm_profile')) %>,
        deactivate: <%- JSON.stringify(__('admin:adm_bulk_confirm_deactivate')) %>,
        title: <%- JSON.stringify(__('admin:adm_bulk_title')) %>
    };
    var form = document.getElementById('tri-bulk-form');
    var bar = document.getElementById('tri-bulk-bar');
    var count = document.getElementById('tri-bulk-count');
    var action = document.getElementById('tri-bulk-action');
    var profile = document.getElementById('tri-bulk-profile');
    var all = document.getElementById('tri-check-all');
    if (!form || !bar) return;
    var checks = function () { return Array.prototype.slice.call(document.querySelectorAll('.tri-row-check')); };
    function refresh() {
        var n = checks().filter(function (c) { return c.checked; }).length;
        count.textContent = String(n);
        bar.hidden = n === 0;
    }
    document.addEventListener('change', function (e) {
        if (e.target === all) { checks().forEach(function (c) { c.checked = all.checked; }); refresh(); }
        else if (e.target && e.target.classList && e.target.classList.contains('tri-row-check')) refresh();
    });
    // The confirmation (with a mandatory reason for a deactivation) is the shared
    // data-confirm handler; only the attributes change with the chosen action.
    function syncAction() {
        var a = action.value;
        profile.hidden = a !== 'profile';
        form.setAttribute('data-confirm', T[a] || T.extend);
        form.setAttribute('data-confirm-title', T.title);
        if (a === 'deactivate') { form.setAttribute('data-confirm-reason', 'reason'); form.setAttribute('data-confirm-danger', ''); }
        else { form.removeAttribute('data-confirm-reason'); form.removeAttribute('data-confirm-danger'); }
    }
    action.addEventListener('change', syncAction);
    syncAction();
    refresh();
})();
</script>
