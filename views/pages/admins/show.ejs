<script nonce="<%= cspNonce %>">
    // Per-admin authentication policy (SuperAdmin only; JSON POST).
    (function () {
        var btn = document.getElementById('admin-auth-policy-save');
        if (!btn) return;
        btn.addEventListener('click', async function () {
            var msg = document.getElementById('admin-auth-policy-msg');
            btn.disabled = true; msg.style.color = '#64748b'; msg.textContent = '…';
            try {
                var r = await fetch('/admins/<%= admin.id %>/auth-policy', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ policy: document.getElementById('admin-auth-policy').value })
                });
                var j = await r.json().catch(function () { return {}; });
                if (r.ok && j.success) { msg.style.color = '#15803d'; msg.textContent = <%- JSON.stringify(__('admin:access_identity_saved')) %>; }
                else { msg.style.color = '#b91c1c'; msg.textContent = j.error || ('HTTP ' + r.status); }
            } catch (e) { msg.style.color = '#b91c1c'; msg.textContent = <%- JSON.stringify(__('admin:access_identity_network_error')) %>; }
            finally { btn.disabled = false; }
        });
    })();

    // ---- One-time password: copy to clipboard ------------------------------
    (function () {
        var b = document.getElementById('admCopyPw'); var i = document.getElementById('admGeneratedPw');
        if (!b || !i) return;
        b.addEventListener('click', function () {
            i.select();
            var done = function () { (window.toast || function () {})(<%- JSON.stringify(__('admin:adm_copied')) %>, 'success'); };
            if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(i.value).then(done, function () { document.execCommand('copy'); done(); });
            else { document.execCommand('copy'); done(); }
        });
    })();

    // ---- "Actif" box: a state change needs a reason (same path as the buttons)
    (function () {
        var box = document.getElementById('adm-active-box'); var wrap = document.getElementById('adm-state-reason');
        if (!box || !wrap) return;
        var initial = box.checked;
        var ta = document.getElementById('adm-state-reason-input');
        function sync() { var changed = box.checked !== initial; wrap.hidden = !changed; if (ta) ta.required = changed; }
        box.addEventListener('change', sync);
        sync();
    })();

    // ---- Access profile: the primary granting control ----------------------
    // Picking a profile ticks its bundle into the checkbox grid below; that
    // SNAPSHOT is what posts through permissions[]. The profile itself stores
    // nothing, so an edited account keeps exactly the grants shown on screen.
    (function accessProfileControl() {
        const sel = document.getElementById('accessProfile');
        if (!sel) return;
        const appliedFlag = document.getElementById('apProfileApplied');
        const appliedNote = document.getElementById('apProfileAppliedNote');
        const noneNote = document.getElementById('apProfileNoneNote');
        const advanced = document.getElementById('apAdvancedPermissions');
        const boxes = function () {
            return document.querySelectorAll('#permissions-section input[name="permissions[]"]');
        };

        function showSummary(key) {
            document.querySelectorAll('.ap-profile-summary').forEach(function (el) {
                el.hidden = (el.getAttribute('data-profile') !== key);
            });
        }

        function setDuration(days) {
            const until = document.getElementById('apDurationUntil');
            const input = document.getElementById('accessExpiresAt');
            if (!until || !input || !days) return;
            const d = new Date();
            d.setDate(d.getDate() + Number(days));
            const p = function (n) { return String(n).padStart(2, '0'); };
            input.value = d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate())
                + 'T' + p(d.getHours()) + ':' + p(d.getMinutes());
            until.checked = true;
            input.disabled = false;
        }

        function applyProfile(opt) {
            const slugs = (opt.getAttribute('data-slugs') || '').split(' ').filter(Boolean);
            const wanted = {};
            slugs.forEach(function (s) { wanted[s] = true; });

            // The profile decides the account type too — a read-only bundle on a
            // localadmin (or a write bundle on a viewer) would be half-applied.
            const roleSel = document.getElementById('role-selector');
            const role = opt.getAttribute('data-role');
            if (roleSel && role && roleSel.value !== role) {
                roleSel.value = role;
                onRoleChange(role);
            }
            boxes().forEach(function (cb) { cb.checked = !!wanted[cb.value] && !cb.disabled; });
            setDuration(opt.getAttribute('data-days'));
            if (appliedFlag) appliedFlag.value = '1';
            if (appliedNote) appliedNote.hidden = false;
            if (noneNote) noneNote.hidden = true;
        }

        sel.addEventListener('change', function () {
            const key = sel.value;
            showSummary(key);
            if (key && key !== 'custom') { applyProfile(sel.options[sel.selectedIndex]); return; }
            if (appliedFlag) appliedFlag.value = '';
            if (appliedNote) appliedNote.hidden = true;
            if (noneNote) noneNote.hidden = false;
            if (advanced && key === 'custom') advanced.open = true;
        });

        // Hand-editing a checkbox means the grant is no longer that profile.
        document.addEventListener('change', function (e) {
            const t = e.target;
            if (!t || t.name !== 'permissions[]') return;
            if (sel.value && sel.value !== 'custom') {
                sel.value = 'custom';
                showSummary('custom');
                if (appliedFlag) appliedFlag.value = '';
                if (appliedNote) appliedNote.hidden = true;
                if (noneNote) noneNote.hidden = false;
            }
        });
    })();

    // ---- Access duration ---------------------------------------------------
    (function accessDurationControl() {
        const until = document.getElementById('apDurationUntil');
        const perm = document.getElementById('apDurationPermanent');
        const input = document.getElementById('accessExpiresAt');
        if (!until || !perm || !input) return;
        // Disabled inputs are not posted, so "permanent" reaches the server as an
        // absent date PLUS an explicit mode — never as an ambiguous blank.
        function sync() { input.disabled = perm.checked; }
        until.addEventListener('change', sync);
        perm.addEventListener('change', sync);
        input.addEventListener('input', function () { until.checked = true; sync(); });
        sync();
    })();

    function onRoleChange(role) {
        const scoped = (role === 'localadmin' || role === 'viewer');
        const scopesSection = document.getElementById('scopes-section');
        const permsSection = document.getElementById('permissions-section');
        const profileSection = document.getElementById('access-profile-section');
        if (profileSection) profileSection.style.display = scoped ? 'block' : 'none';
        if (scopesSection) scopesSection.style.display = scoped ? 'block' : 'none';
        if (permsSection) permsSection.style.display = scoped ? 'block' : 'none';
        const note = document.getElementById('viewer-perm-note');
        const isViewer = role === 'viewer';
        document.querySelectorAll('#permissions-section input[name="permissions[]"]').forEach(function (cb) {
            if (cb.getAttribute('data-write') === '1') {
                cb.disabled = isViewer;
                if (isViewer) cb.checked = false;
            }
        });
        if (note) note.style.display = isViewer ? 'block' : 'none';
    }

    function togglePasswordFields() {
        const passwordFields = document.getElementById('password-fields');
        const checkbox = document.getElementById('change-password-toggle');
        const newPasswordInput = document.getElementById('newPassword');
        const newPasswordConfirmInput = document.getElementById('newPasswordConfirm');

        if (checkbox.checked) {
            passwordFields.style.display = 'block';
            newPasswordInput.required = true;
            newPasswordConfirmInput.required = true;
        } else {
            passwordFields.style.display = 'none';
            newPasswordInput.required = false;
            newPasswordConfirmInput.required = false;
            newPasswordInput.value = '';
            newPasswordConfirmInput.value = '';
        }
    }

    function togglePasswordVisibility(inputId) {
        const input = document.getElementById(inputId);
        if (input.type === 'password') {
            input.type = 'text';
        } else {
            input.type = 'password';
        }
    }

    // Validate password confirmation on form submit
    document.querySelector('form').addEventListener('submit', function (e) {
        const changePasswordCheckbox = document.getElementById('change-password-toggle');

        if (changePasswordCheckbox && changePasswordCheckbox.checked) {
            const newPassword = document.getElementById('newPassword').value;
            const newPasswordConfirm = document.getElementById('newPasswordConfirm').value;

            if (newPassword !== newPasswordConfirm) {
                e.preventDefault();
                alert(<%- JSON.stringify(__('admin:passwords_no_match')) %>);
                return false;
            }
        }
    });

    function addScope() {
        const container = document.getElementById('scopes-container');
        if (!container) return;
        const index = new Date().getTime(); // Unique index for grouping
        const div = document.createElement('div');
        div.className = 'scope-item';
        div.innerHTML = `
        <select name="scopes[${index}][type]" onchange="updateScopeOptions(this)" aria-label="${<%- JSON.stringify(__('admin:a11y_scope_type')) %>}">
            <% if (_regions.length) { %><option value="region">${<%- JSON.stringify(__('admin:adm_region_widest')) %>}</option><% } %>
            <% if (countries && countries.length) { %><option value="country">${<%- JSON.stringify(__('admin:country_widest')) %>}</option><% } %>
            <option value="site">${<%- JSON.stringify(__('admin:site')) %>}</option>
            <option value="department">${<%- JSON.stringify(__('admin:department')) %>}</option>
            <option value="service">${<%- JSON.stringify(__('admin:service')) %>}</option>
        </select>
        <select name="scopes[${index}][value]" aria-label="${<%- JSON.stringify(__('admin:a11y_scope_value')) %>}"></select>
        <button type="button" class="btn btn-sm btn-danger" onclick="this.parentElement.remove()">${<%- JSON.stringify(__('admin:remove')) %>}</button>
    `;
        container.appendChild(div);
        updateScopeOptions(div.querySelector('select[name*="[type]"]'));
    }

    function updateScopeOptions(select) {
        const type = select.value;
        const valueSelect = select.parentElement.querySelector('select[name*="[value]"]');
        const initialValue = valueSelect.getAttribute('data-initial-value');
        const scopeValue = select.getAttribute('data-scope-value');
        const currentValue = initialValue || scopeValue;

        valueSelect.innerHTML = '<option value="">' + <%- JSON.stringify(__('admin:select_label')) %> + '</option>';

    <% if (_regions.length > 0) { %>
    if (type === 'region') {
        <% _regions.forEach(function (r) { %>
        var selected = currentValue && parseInt(currentValue) === <%= r.id %> ? 'selected' : '';
            valueSelect.innerHTML += '<option value="<%= r.id %>" ' + selected + '><%= r.name %></option>';
        <% }); %>
    }
    <% } %>

    <% if (countries && countries.length > 0) { %>
    if (type === 'country') {
        <% countries.forEach(function (c) { %>
        var selected = currentValue && parseInt(currentValue) === <%= c.id %> ? 'selected' : '';
            valueSelect.innerHTML += '<option value="<%= c.id %>" ' + selected + '><%= c.name %></option>';
        <% }); %>
    }
    <% } %>

    <% if (sites && sites.length > 0) { %>
    if (type === 'site') {
        <%# A deactivated site that is already assigned stays offered, flagged. %>
        <% sites.forEach(function (site) { %>
        var selected = currentValue && parseInt(currentValue) === <%= site.id %> ? 'selected' : '';
            valueSelect.innerHTML += '<option value="<%= site.id %>" ' + selected + '><%= site.name %><%= site.isActive === false ? ' ' + __('admin:adm_site_inactive_suffix') : '' %></option>';
        <% }); %>
    }
    <% } %>

    <% if (departments && departments.length > 0) { %>
    if (type === 'department') {
        <% departments.forEach(function (dept) { %>
        var selected = currentValue && parseInt(currentValue) === <%= dept.id %> ? 'selected' : '';
                valueSelect.innerHTML += '<option value="<%= dept.id %>" ' + selected + '><%= dept.siteName %> - <%= dept.name %></option>';
        <% }); %>
    }
    <% } %>

    <% if (services && services.length > 0) { %>
    if (type === 'service') {
        <% services.forEach(function (service) { %>
        var selected = currentValue && parseInt(currentValue) === <%= service.id %> ? 'selected' : '';
                    valueSelect.innerHTML += '<option value="<%= service.id %>" ' + selected + '><%= service.siteName %> - <%= service.departmentName %> - <%= service.name %></option>';
        <% }); %>
    }
    <% } %>

    // Clear the data attributes after first use
    if (initialValue) {
            valueSelect.removeAttribute('data-initial-value');
        }
        if (scopeValue) {
            select.removeAttribute('data-scope-value');
        }
    }

    // Initialize existing scopes on page load
    document.addEventListener('DOMContentLoaded', function () {
        const roleSel = document.getElementById('role-selector');
        if (roleSel) onRoleChange(roleSel.value);
        const scopeItems = document.querySelectorAll('.scope-item');
        scopeItems.forEach(function (item) {
            const typeSelect = item.querySelector('select[name*="[type]"]');
            if (typeSelect) {
                updateScopeOptions(typeSelect);
            }
        });
    });

    // ---- Restore a kept draft ------------------------------------
    // Runs after the initialiser above: the JS-built parts (scopes, duration,
    // profile, permission grid) come back exactly as POSTED.
    document.addEventListener('DOMContentLoaded', function () {
        const D = <%- include('../../partials/json-script', { v: d }) %>;
        if (!D.__from) return;
        const roleSel = document.getElementById('role-selector');
        if (roleSel && roleSel.value) onRoleChange(roleSel.value);
        if (D.scopes && typeof D.scopes === 'object' && document.getElementById('scopes-container')) {
            document.getElementById('scopes-container').innerHTML = '';
            Object.values(D.scopes).forEach(function (s) {
                if (!s || !s.type) return;
                addScope();
                const items = document.querySelectorAll('#scopes-container .scope-item');
                const item = items[items.length - 1];
                const t = item.querySelector('select[name*="[type]"]');
                t.value = s.type; updateScopeOptions(t);
                if (s.value) item.querySelector('select[name*="[value]"]').value = String(s.value);
            });
        }
        if (D.accessDurationMode) {
            const r = document.querySelector('input[name="accessDurationMode"][value="' + D.accessDurationMode + '"]');
            if (r) { r.checked = true; r.dispatchEvent(new Event('change')); }
        }
        if (D.accessExpiresAt) { const i = document.getElementById('accessExpiresAt'); if (i) i.value = D.accessExpiresAt; }
        const prof = document.getElementById('accessProfile');
        if (prof && D.accessProfile != null) {
            prof.value = D.accessProfile;
            document.querySelectorAll('.ap-profile-summary').forEach(function (el) { el.hidden = el.getAttribute('data-profile') !== D.accessProfile; });
        }
        const perms = [].concat(D.permissions || []);
        document.querySelectorAll('input[name="permissions[]"]').forEach(function (cb) { cb.checked = perms.indexOf(cb.value) !== -1 && !cb.disabled; });
        const flag = document.getElementById('apProfileApplied'); if (flag) flag.value = D.apProfileApplied || '';
        // (A password change is never part of a draft — it must be retyped.)
    });
</script>
