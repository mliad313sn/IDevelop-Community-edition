<%
    // a refused update comes back with its safe body in `draft`
    // (never the passwords); a field shows the draft value when there is one.
    const d = (typeof draft !== 'undefined' && draft) || {};
    const v = function (k, cur) { return d[k] != null ? String(d[k]) : (cur == null ? '' : String(cur)); };
    // a self-edit is limited to contact fields; access controls are
    // not rendered for one's own account, the note below says why.
    const self = (typeof isSelf !== 'undefined' && isSelf);
    const scoped = (admin.role === 'localadmin' || admin.role === 'viewer');
    const active = admin.isActive !== false && admin.isActive !== 0;
    const _regions = (typeof regions !== 'undefined' && regions) || [];
    const _lock = (typeof lock !== 'undefined' && lock) || { locked: false };
    const _mfa = (typeof mfa !== 'undefined' && mfa) || { enrolled: false, confirmed: false, backupCodesLeft: 0 };
    const _sessions = (typeof sessions !== 'undefined' && sessions) || [];
    const _history = (typeof history !== 'undefined' && history) || [];
    const scopeValueOf = function (scope) {
        return scope.scopeType === 'site' ? scope.siteId : scope.scopeType === 'department' ? scope.departmentId
            : scope.scopeType === 'country' ? scope.countryId : scope.scopeType === 'region' ? scope.regionId : scope.serviceId;
    };
    const scopeTypeLabel = function (t) {
        if (t === 'site') return __('admin:tri_scope_site');
        if (t === 'department') return __('admin:tri_scope_department');
        if (t === 'service') return __('admin:tri_scope_service');
        if (t === 'country') return __('admin:tri_scope_country');
        if (t === 'region') return __('admin:tri_scope_region');
        return t;
    };
%>
<div class="page-header">
    <div>
        <h1><%= __('admin:admin_label') %>: <%= admin.username %>
            <span class="adm-chip <%= active ? 'adm-chip-ok' : 'adm-chip-muted' %>"><%= active ? __('admin:active') : __('admin:inactive') %></span>
            <% if (_lock.locked) { %><span class="adm-chip adm-chip-danger"><i class="fas fa-lock" aria-hidden="true"></i> <%= __('admin:adm_chip_locked') %></span><% } %>
        </h1>
        <% if (!active && admin.deactivatedAt) { %>
            <p class="text-muted" style="margin:.25rem 0 0"><%= __('admin:adm_deactivated_on', { date: fmtDateTime(admin.deactivatedAt) }) %><%= admin.deactivationReason ? ' — ' + __('admin:adm_deactivation_reason', { reason: admin.deactivationReason }) : '' %></p>
        <% } %>
    </div>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap">
        <a href="/admins" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left" aria-hidden="true"></i> <%= __('admin:admin_management') %></a>
    </div>
</div>
<% if (d.__from) { %>
<p class="text-muted" style="margin:-.5rem 0 1rem;"><i class="fas fa-rotate-left" aria-hidden="true"></i> <%= __('validation:draft_kept') %></p>
<% } %>

<% if (typeof generatedPassword !== 'undefined' && generatedPassword) { %>
<%# One-time password from "Réinitialiser": a copyable field, shown once. %>
<div class="card adm-otp" role="status">
    <label for="admGeneratedPw"><strong><%= __('admin:adm_generated_pw_label') %></strong></label>
    <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
        <input type="text" id="admGeneratedPw" readonly value="<%= generatedPassword %>" style="font-family:var(--font-data);min-width:260px">
        <button type="button" class="btn btn-sm btn-secondary" id="admCopyPw"><i class="fas fa-copy" aria-hidden="true"></i> <%= __('admin:adm_copy') %></button>
    </div>
    <small class="text-muted"><%= __('admin:adm_generated_pw_hint') %></small>
</div>
<% } %>

<% if (self) { %>
<div class="card adm-note" role="note"><i class="fas fa-circle-info" aria-hidden="true"></i> <%= __('admin:adm_self_edit_note') %></div>
<% } %>

<form action="/admins/<%= admin.id %>" method="POST">
    <% if (!csrfToken) { %>
        <div style="color: red; padding: 10px; background: #ffe6e6; margin-bottom: 10px; border-radius: 4px;">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i> <%= __('admin:csrf_warning') %>
        </div>
        <% } %>
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">

            <div class="form-group">
                <label for="admUsername"><%= __('admin:username') %> *</label>
                <input type="text" name="username" id="admUsername" value="<%= v('username', admin.username) %>" required>
            </div>

            <div class="form-group">
                <label for="admEmail"><%= __('admin:email') %></label>
                <% const emailNow = v('email', admin.email); %>
                <%# the installer seeds `admin@localhost` on this very account. The
                    form ACCEPTS it now (validators.js: a bare host is a valid address on a
                    closed network) and says in one sentence what it costs — rendered by the
                    server, so it is there with JavaScript off. %>
                <% const emailNoDomain = typeof emailHasNoPublicDomain === 'function' && emailHasNoPublicDomain(emailNow); %>
                <input type="email" name="email" id="admEmail" value="<%= emailNow %>" data-email-check data-exclude-admin="<%= admin.id %>" aria-describedby="emailSharedNote<%= emailNoDomain ? ' admEmailNoDomain' : '' %>">
                <% if (emailNoDomain) { %>
                <small id="admEmailNoDomain" class="text-muted" style="display:block;margin-top:.35rem"><i class="fas fa-circle-info" aria-hidden="true"></i> <%= __('admin:adm_email_no_domain_note') %></small>
                <% } %>
                <%# A shared address is allowed (a person may hold several accounts): this note only advises. %>
                <small id="emailSharedNote" class="email-shared-note text-muted" hidden></small>
                <script src="/js/email-shared-check.js" nonce="<%= cspNonce %>" defer></script>
            </div>

            <% if (self) { %>
                <%# Role is read-only on one's own account (the validator still needs it posted). %>
                <input type="hidden" name="role" value="<%= admin.role %>">
                <div class="form-group">
                    <label><%= __('admin:role_account') %></label>
                    <div><span class="adm-chip"><%= enumLabel('admin_role', admin.role) %></span></div>
                </div>
            <% } else { %>
            <div class="form-group">
                <label for="role-selector"><%= __('admin:role_account') %> *</label>
                <select name="role" id="role-selector" required onchange="onRoleChange(this.value)">
                    <% const roleNow = v('role', admin.role); %>
                    <% if ((typeof granterIsSuper === 'undefined' || granterIsSuper) || admin.role==='superadmin') { %>
                        <option value="superadmin" <%=roleNow==='superadmin' ? 'selected' : '' %>><%= __('admin:superadmin_label') %></option>
                    <% } %>
                    <option value="localadmin" <%=roleNow==='localadmin' ? 'selected' : '' %>><%= __('admin:localadmin_label') %></option>
                    <option value="viewer" <%=roleNow==='viewer' ? 'selected' : '' %>><%= __('admin:viewer_label') %></option>
                </select>
            </div>
            <% if ((typeof granterIsSuper === 'undefined' || granterIsSuper) && admin.role !== 'superadmin') { %>
            <%# ASVS 3.7.1: promoting to SuperAdmin needs a recent sign-in or the granter's own password. %>
            <div class="form-group">
                <label for="grantCurrentPassword"><%= __('admin:reauth_current_password') %></label>
                <input type="password" name="currentPassword" id="grantCurrentPassword" autocomplete="current-password" maxlength="200" aria-describedby="grantReauthHint">
                <small id="grantReauthHint" style="color:#888; display:block; margin-top:4px;"><%= __('admin:reauth_superadmin_hint', { minutes: 15 }) %></small>
            </div>
            <% } %>

            <div class="form-group">
                <label>
                    <input type="checkbox" name="isActive" id="adm-active-box" <%=(d.__from ? d.isActive === 'on' : admin.isActive) ? 'checked' : '' %>> <%= __('admin:active') %>
                </label>
                <%# Ticking or unticking "Actif" is a state change: it needs a reason and runs the same deactivate/reactivate path as the buttons. %>
                <div id="adm-state-reason" hidden style="margin-top:.4rem">
                    <label for="adm-state-reason-input" style="font-size:.85rem"><%= __('admin:adm_state_reason_label') %></label>
                    <textarea name="reason" id="adm-state-reason-input" rows="2" maxlength="1000" style="width:100%;max-width:520px" placeholder="<%= __('admin:adm_reason_ph') %>"><%= v('reason', '') %></textarea>
                </div>
            </div>
            <% } %>

            <div class="form-group">
                <label>
                    <input type="checkbox" id="change-password-toggle" onchange="togglePasswordFields()"> <%= __('admin:change_password') %>
                </label>
                <% if (!self) { %><small class="text-muted" style="display:block"><%= __('admin:adm_password_by_other_hint') %></small><% } %>
            </div>

            <div id="password-fields" style="display: none;">
                <div class="form-group">
                    <label for="newPassword"><%= __('admin:new_password') %></label>
                    <div style="position: relative; display: flex; align-items: center;">
                        <input type="password" name="newPassword" id="newPassword" minlength="12"
                            autocomplete="new-password" style="flex: 1; padding-right: 35px;">
                        <button type="button" onclick="togglePasswordVisibility('newPassword')"
                            style="position: absolute; right: 8px; background: none; border: none; cursor: pointer; font-size: 16px; padding: 4px 8px;"
                            title="<%= __('admin:toggle_visibility') %>"><i class="fas fa-eye" aria-hidden="true"></i></button>
                    </div>
                    <small style="color: #666; font-size: 0.85em; display: block; margin-top: 4px;">
                        <%= __('admin:password_requirements') %>
                    </small>
                </div>

                <div class="form-group">
                    <label for="newPasswordConfirm"><%= __('admin:confirm_new_password') %></label>
                    <div style="position: relative; display: flex; align-items: center;">
                        <input type="password" name="newPasswordConfirm" id="newPasswordConfirm" minlength="12"
                            autocomplete="new-password" style="flex: 1; padding-right: 35px;">
                        <button type="button" onclick="togglePasswordVisibility('newPasswordConfirm')"
                            style="position: absolute; right: 8px; background: none; border: none; cursor: pointer; font-size: 16px; padding: 4px 8px;"
                            title="<%= __('admin:toggle_visibility') %>"><i class="fas fa-eye" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>

            <% if (!self) { %>
            <div id="scopes-section" class="form-group"
                style="display: <%= scoped ? 'block' : 'none' %>;">
                <label><%= __('admin:scopes') %></label>
                <%# Every scope row is shown: an EXPIRED row stays
                    editable and flagged (a re-save keeps it; "Prolonger" renews it),
                    a REVOKED row (account deactivated) is listed read-only, a row on a
                    deactivated unit is flagged so the operator re-scopes on purpose. %>
                <div id="scopes-container">
                    <% if (admin.scopes && admin.scopes.length> 0) { %>
                        <% admin.scopes.forEach(function(scope, i) { const scopeValue = scopeValueOf(scope); const index = i; %>
                            <% if (scope.revoked) { %>
                                <div class="scope-item adm-scope-revoked">
                                    <span class="adm-chip adm-chip-muted"><%= scopeTypeLabel(scope.scopeType) %><%= colon %> <%= scope.scopeName || ('#' + scopeValue) %></span>
                                    <span class="adm-chip adm-chip-muted" title="<%= scope.revokeReason || '' %>"><%= __('admin:adm_scope_revoked') %></span>
                                </div>
                            <% } else { %>
                            <div class="scope-item">
                                <%# A scope row repeats: a visible label per row would be noise,
                                    so each select carries its own name for a screen reader. %>
                                <select name="scopes[<%= index %>][type]" onchange="updateScopeOptions(this)"
                                    aria-label="<%= __('admin:a11y_scope_type') %>"
                                    data-scope-value="<%= scopeValue %>">
                                    <% if (_regions.length) { %><option value="region" <%=scope.scopeType==='region' ? 'selected' : '' %>><%= __('admin:adm_region') %></option><% } %>
                                    <% if (countries && countries.length) { %><option value="country" <%=scope.scopeType==='country' ? 'selected' : '' %>><%= __('admin:country') %></option><% } %>
                                    <option value="site" <%=scope.scopeType==='site' ? 'selected' : '' %>><%= __('admin:site') %></option>
                                    <option value="department" <%=scope.scopeType==='department' ? 'selected' : '' %>
                                        ><%= __('admin:department') %></option>
                                    <option value="service" <%=scope.scopeType==='service' ? 'selected' : '' %>><%= __('admin:service') %>
                                    </option>
                                </select>
                                <select name="scopes[<%= index %>][value]" aria-label="<%= __('admin:a11y_scope_value') %>" data-initial-value="<%= scopeValue %>">
                                    <!-- Options will be populated by JavaScript -->
                                </select>
                                <% if (scope.expired) { %><span class="adm-chip adm-chip-warn" title="<%= __('admin:adm_scope_expired_title') %>"><%= __('admin:adm_scope_expired', { date: fmtDate(scope.expiresAt) }) %></span><% } %>
                                <% if (scope.unitInactive) { %><span class="adm-chip adm-chip-warn" title="<%= __('admin:adm_chip_site_inactive_title') %>"><%= __('admin:adm_scope_unit_inactive') %></span><% } %>
                                <button type="button" class="btn btn-sm btn-danger"
                                    onclick="this.parentElement.remove()"><%= __('admin:remove') %></button>
                            </div>
                            <% } %>
                            <% }); %>
                                <% } %>
                </div>
                <button type="button" class="btn btn-sm" onclick="addScope()"><%= __('admin:add_scope') %></button>
            </div>

            <%# ---- Durée de l'accès ---------------------------------------------
                Always visible (not folded into the scopes block), and explicit:
                "permanent" is now a deliberate radio, not the silent meaning of an
                empty or unreadable field. An EXPIRED delegation shows its past
                date and says so — the server refuses a past date, so a plain
                re-save can never silently turn "expired" into "permanent". %>
            <%
                const _pad = function (n) { return String(n).padStart(2, '0'); };
                const _dtLocal = function (dt) {
                    return dt.getFullYear() + '-' + _pad(dt.getMonth() + 1) + '-' + _pad(dt.getDate())
                        + 'T' + _pad(dt.getHours()) + ':' + _pad(dt.getMinutes());
                };
                const _hasExp = (typeof accessExpiresAt !== 'undefined' && accessExpiresAt);
                const _expired = (typeof accessExpired !== 'undefined' && accessExpired);
                const _fallbackUntil = new Date(); _fallbackUntil.setMonth(_fallbackUntil.getMonth() + 12);
                const _expValue = _dtLocal(_hasExp ? new Date(accessExpiresAt) : _fallbackUntil);
            %>
            <fieldset class="form-group" id="access-duration-group"
                style="border:1px solid var(--border,#ddd); border-radius:8px; padding:10px 14px; margin:8px 0;">
                <legend style="font-size:0.85rem; font-weight:700; padding:0 6px;"><%= __('admin:ap_duration_title') %></legend>
                <small style="color:#888; display:block; margin-bottom:8px;"><%= __('admin:ap_duration_hint') %></small>
                <% if (_expired) { %>
                    <p class="adm-expired-note"><i class="fas fa-hourglass-end" aria-hidden="true"></i> <%= __('admin:adm_access_expired_note', { date: fmtDate(accessExpiresAt) }) %></p>
                <% } %>
                <label style="display:flex; align-items:center; gap:8px; padding:4px 0; flex-wrap:wrap;">
                    <input type="radio" name="accessDurationMode" value="until" id="apDurationUntil" <%= _hasExp ? 'checked' : '' %>>
                    <span><%= __('admin:ap_duration_until') %></span>
                    <input type="datetime-local" id="accessExpiresAt" name="accessExpiresAt"
                        aria-label="<%= __('admin:ap_duration_until_aria') %>"
                        value="<%= _expValue %>" style="max-width:260px;">
                </label>
                <label style="display:flex; align-items:flex-start; gap:8px; padding:4px 0;">
                    <input type="radio" name="accessDurationMode" value="permanent" id="apDurationPermanent" style="margin-top:4px;" <%= _hasExp ? '' : 'checked' %>>
                    <span><%= __('admin:ap_duration_permanent') %>
                        <br><small style="color:#888;"><%= __('admin:ap_duration_permanent_hint') %></small></span>
                </label>
                <small style="color:#888; display:block; margin-top:6px;"><%= __('admin:ap_duration_default_note') %></small>
            </fieldset>

            <% const granted = (admin.permissions || []); %>
            <%# ---- Profil d'accès (contrôle principal) --------------------------
                Pre-selected when the stored grant set is exactly one profile's
                bundle, so a provisioned account is recognisable at a glance. %>
            <% const _apProfiles = (typeof accessProfileList !== 'undefined' ? accessProfileList : []); %>
            <% const _permLabel = {}; (typeof permissionGroups !== 'undefined' ? permissionGroups : []).forEach(function (g) { g.items.forEach(function (i) { _permLabel[i.slug] = i.label; }); }); %>
            <% const _scopeLabel = { site: __('admin:ap_scope_site'), department: __('admin:ap_scope_department'), service: __('admin:ap_scope_service'), country: __('admin:ap_scope_country'), region: __('admin:adm_region') }; %>
            <% const _roleLabel = { localadmin: __('admin:ap_role_localadmin'), viewer: __('admin:ap_role_viewer') }; %>
            <%
                const _sortedGranted = [...granted].sort().join('|');
                let _currentProfile = '';
                _apProfiles.forEach(function (p) {
                    if (!_currentProfile && p.slugs.length && [...p.slugs].sort().join('|') === _sortedGranted) _currentProfile = p.key;
                });
            %>
            <div id="access-profile-section"
                style="display: <%= scoped ? 'block' : 'none' %>;">
                <div class="form-group">
                    <label for="accessProfile"><strong><%= __('admin:ap_profile_group_label') %></strong>
                        <small style="color:#888;">— <%= __('admin:ap_profile_hint') %></small></label>
                    <select id="accessProfile" name="accessProfile" style="max-width:520px;">
                        <option value=""><%= __('admin:ap_profile_placeholder') %></option>
                        <% _apProfiles.forEach(function (p) { %>
                            <option value="<%= p.key %>" data-role="<%= p.role %>" data-days="<%= p.defaultDays %>"
                                data-slugs="<%= p.slugs.join(' ') %>" <%= p.unavailable ? 'disabled' : '' %>
                                <%= _currentProfile === p.key ? 'selected' : '' %>>
                                <%= p.label %><%= p.unavailable ? ' ' + __('admin:ap_profile_unavailable_suffix') : '' %>
                            </option>
                        <% }); %>
                        <option value="custom" <%= (!_currentProfile && granted.length) ? 'selected' : '' %>><%= __('admin:ap_profile_custom') %></option>
                    </select>
                    <input type="hidden" name="apProfileApplied" id="apProfileApplied" value="<%= _currentProfile ? '1' : '' %>">

                    <% _apProfiles.forEach(function (p) { %>
                        <div class="ap-profile-summary" data-profile="<%= p.key %>" <%= _currentProfile === p.key ? '' : 'hidden' %>
                            style="border-left:3px solid var(--accent,#6656f0); background:rgba(127,127,127,.06); border-radius:6px; padding:10px 12px; margin-top:10px;">
                            <p style="margin:0 0 6px;"><%= p.description %></p>
                            <p style="margin:0 0 6px; font-size:.85rem; color:#888;">
                                <%= __('admin:ap_profile_summary_scope', { scope: _scopeLabel[p.defaultScopeType] || p.defaultScopeType }) %>
                                · <%= __('admin:ap_profile_summary_duration', { days: p.defaultDays }) %>
                                · <%= __('admin:ap_profile_summary_role', { role: _roleLabel[p.role] || p.role }) %>
                            </p>
                            <% if (p.partial && !p.unavailable) { %>
                                <p style="margin:0 0 6px; color:#b45309; font-size:.85rem;">
                                    <%= __('admin:ap_profile_partial', { granted: p.slugs.length, total: p.total }) %>
                                </p>
                            <% } %>
                            <strong style="font-size:.85rem;"><%= __('admin:ap_profile_summary_heading') %> —
                                <%= __('admin:ap_profile_summary_rights', { n: p.slugs.length }) %></strong>
                            <ul style="margin:6px 0 0; padding-left:18px; font-size:.85rem;">
                                <% p.slugs.forEach(function (s) { %><li><%= _permLabel[s] || s %></li><% }); %>
                            </ul>
                        </div>
                    <% }); %>
                    <small id="apProfileAppliedNote" hidden style="display:block; margin-top:8px; color:#15803d;"><%= __('admin:ap_profile_applied_note') %></small>
                    <small id="apProfileNoneNote" <%= _currentProfile ? 'hidden' : '' %> style="display:block; margin-top:8px; color:#888;"><%= __('admin:ap_profile_none_note') %></small>
                </div>
            </div>

            <div id="permissions-section"
                style="display: <%= scoped ? 'block' : 'none' %>;">
                <details id="apAdvancedPermissions" class="form-group" style="border:1px solid var(--border,#ddd); border-radius:8px; padding:8px 12px;">
                <summary style="cursor:pointer; font-weight:600;"><%= __('admin:ap_advanced_summary') %></summary>
                <div class="form-group" style="margin-top:8px;">
                    <small style="color:#888; display:block; margin-bottom:6px;"><%= __('admin:ap_advanced_hint') %></small>
                    <label><%= __('admin:permissions') %> <small style="color:#888;">— <%= __('admin:permissions_hint') %></small></label>
                    <% (typeof permissionGroups !== 'undefined' ? permissionGroups : []).forEach(function(grp) { %>
                        <fieldset class="perm-group" style="border:1px solid var(--border,#ddd); border-radius:8px; padding:10px 12px; margin:8px 0;">
                            <legend style="font-size:0.8rem; font-weight:700; padding:0 6px;"><%= grp.group %></legend>
                            <% grp.items.forEach(function(p) { %>
                                <% if (p.assignable) { %>
                                    <label class="perm-option" style="display:flex; align-items:flex-start; gap:8px; padding:5px 0;">
                                        <input type="checkbox" name="permissions[]" value="<%= p.slug %>"
                                            data-write="<%= p.write ? '1' : '0' %>" style="margin-top:3px;"
                                            <%= granted.indexOf(p.slug) !== -1 ? 'checked' : '' %>>
                                        <span>
                                            <strong><%= p.label %></strong>
                                            <% if (p.write) { %><span class="badge badge-warning" style="font-size:0.65rem;"><%= __('admin:write_badge') %></span><% } %>
                                            <br><small style="color:#888;"><%= p.description %></small>
                                        </span>
                                    </label>
                                <% } %>
                            <% }); %>
                        </fieldset>
                    <% }); %>
                    <small id="viewer-perm-note" style="display:none; color:#b8860b;">
                        <%= __('admin:viewer_perm_note') %>
                    </small>
                </div>
                </details>
            </div>
            <% } %>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><%= __('admin:update_admin') %></button>
                <a href="/admins" class="btn btn-secondary"><%= __('admin:cancel') %></a>
            </div>
</form>

<%# The action forms below are SEPARATE forms and MUST NOT be nested inside the
    edit form above. Nested form elements are invalid HTML: the browser drops the
    inner one, merging its fields into the outer form, so the page ends up posting
    two _csrf inputs -> Express parses _csrf as an array -> csurf rejects it with
    "Invalid CSRF token". Kept as siblings, styled to sit on their own action row. %>
<% if (!self) { %>
    <div class="form-actions" style="display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-top:.5rem;">
        <%# Styled confirmation (ui-feedback data-confirm) — never the native confirm. %>
        <form action="/admins/<%= admin.id %>/reset-password" method="POST"
            style="display:inline-flex; align-items:center; gap:6px;"
            data-confirm="<%= __('admin:reset_password_confirm') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <%# Inline action row — no room for a visible label, so the name is sr-only. %>
            <label for="admNewPassword" class="sr-only"><%= __('admin:new_password_placeholder') %></label>
            <input type="password" id="admNewPassword" name="newPassword" autocomplete="new-password"
                placeholder="<%= __('admin:new_password_placeholder') %>" style="padding:6px 8px; min-width:230px;">
            <button type="button" class="btn btn-secondary" onclick="togglePasswordVisibility('admNewPassword', this)"
                aria-pressed="false" title="<%= __('admin:toggle_visibility') %>"><i class="fas fa-eye" aria-hidden="true"></i></button>
            <button type="submit" class="btn btn-warning"><i class="fas fa-key" aria-hidden="true"></i> <%= __('admin:set_reset_password') %></button>
        </form>
        <form action="/admins/<%= admin.id %>/force-password-change" method="POST"
            style="display:inline;"
            data-confirm="<%= __('admin:force_password_change_confirm') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-secondary"><i class="fas fa-user-clock" aria-hidden="true"></i> <%= __('admin:force_password_change') %></button>
        </form>
        <% if (active) { %>
        <%# "Désactiver" = state + mandatory reason, grants kept. %>
        <form action="/admins/<%= admin.id %>/deactivate" method="POST" style="display:inline;"
            data-confirm="<%= __('admin:adm_deactivate_confirm', { username: admin.username }) %>" data-confirm-title="<%= __('admin:adm_deactivate_title') %>"
            data-confirm-yes="<%= __('admin:adm_deactivate') %>" data-confirm-danger data-confirm-reason="reason">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger"><i class="fas fa-user-slash" aria-hidden="true"></i> <%= __('admin:adm_deactivate') %></button>
        </form>
        <% } else { %>
        <form action="/admins/<%= admin.id %>/reactivate" method="POST" style="display:inline;"
            data-confirm="<%= __('admin:adm_reactivate_confirm', { username: admin.username }) %>" data-confirm-title="<%= __('admin:adm_reactivate_title') %>"
            data-confirm-yes="<%= __('admin:adm_reactivate') %>" data-confirm-reason="reason">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-primary"><i class="fas fa-user-check" aria-hidden="true"></i> <%= __('admin:adm_reactivate') %></button>
        </form>
        <% } %>
    </div>

    <%# ---- Verrouillage ---------------------------------------- %>
    <div class="card" style="padding:14px 16px; margin-top:1rem;">
        <h3 style="margin-top:0;"><i class="fas fa-lock" aria-hidden="true"></i> <%= __('admin:adm_lock_title') %></h3>
        <% if (_lock.locked) { %>
            <p class="help-text adm-expired-note" style="margin-bottom:.75rem;">
                <%= _lock.until ? __('admin:adm_lock_locked_until', { time: fmtDateTime(_lock.until), n: _lock.attempts }) : __('admin:adm_lock_locked', { n: _lock.attempts }) %>
            </p>
            <form action="/admins/<%= admin.id %>/unlock" method="POST" style="display:inline;" data-confirm="<%= __('admin:unlock_account_confirm') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-secondary"><i class="fas fa-lock-open" aria-hidden="true"></i> <%= __('admin:unlock_account') %></button>
            </form>
        <% } else { %>
            <p class="help-text" style="margin-bottom:0;"><%= __('admin:adm_lock_not_locked', { n: _lock.policy ? _lock.policy.maxAttempts : '', minutes: _lock.policy ? _lock.policy.lockoutMinutes : '' }) %></p>
        <% } %>
    </div>

    <%# ---- Re-certification -------------------------------------------------
        One click renews the whole delegation instead of re-submitting the edit
        form (role, scopes, 29 checkboxes) just to move a date — the friction
        that pushes operators into granting permanent access. Its own <form>, a
        SIBLING of the edit form: nesting forms silently merges the fields and
        posts two _csrf values, which csurf then rejects (see note above).
        Hidden for one's own account: the controller refuses self-renewal. %>
    <% if (scoped) { %>
        <div class="card" style="padding:14px 16px; margin-top:1rem;">
            <h3 style="margin-top:0;"><i class="fas fa-hourglass-half" aria-hidden="true"></i> <%= __('admin:ap_extend_section_title') %></h3>
            <p class="help-text" style="margin-bottom:.75rem;">
                <% if (typeof accessExpired !== 'undefined' && accessExpired) { %>
                    <span class="adm-expired-note"><%= __('admin:adm_expired_on', { date: fmtDate(accessExpiresAt) }) %></span>
                <% } else if (typeof accessExpiresAt !== 'undefined' && accessExpiresAt) { %>
                    <%= __('admin:ap_extend_current', { date: fmtDate(accessExpiresAt) }) %>
                <% } else { %>
                    <%= __('admin:ap_extend_current_permanent') %>
                <% } %>
            </p>
            <form action="/admins/<%= admin.id %>/extend-access" method="POST" style="display:inline;" data-confirm="<%= __('admin:ap_extend_confirm', { username: admin.username }) %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-secondary" title="<%= __('admin:ap_extend_title') %>">
                    <i class="fas fa-calendar-plus" aria-hidden="true"></i> <%= __('admin:ap_extend_btn') %>
                </button>
            </form>
        </div>
    <% } %>
<% } %>

<%# ---- MFA ------------------------------------------------------------- %>
<div class="card" style="padding:14px 16px; margin-top:1rem;">
