<%#
    3.23.20 (Amendment C3g) — « Imprimer les notices SSO »: one A5 page per
    person whose account was migrated to SSO and who has no e-mail address in
    the app. No secret on it: what changed, how to sign in (the company login
    when known), whom to contact. Standalone page (layout:false), print-ready.
%>
<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' && lang) || 'fr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style nonce="<%= cspNonce %>">
        @page { size: A5; margin: 12mm; }
        body { font-family: "Segoe UI", Arial, sans-serif; color: #111827; margin: 0; background: #f3f4f6; }
        .toolbar { padding: 12px 16px; background: #fff; border-bottom: 1px solid #e5e7eb; }
        .notice { background: #fff; width: 148mm; min-height: 190mm; margin: 12px auto; padding: 12mm; box-sizing: border-box; page-break-after: always; }
        .notice h1 { font-size: 15px; margin: 0 0 6px; }
        .notice .for { font-size: 12px; color: #6b7280; margin-bottom: 10px; }
        .notice pre { white-space: pre-wrap; font-family: inherit; font-size: 11.5px; line-height: 1.45; margin: 0; }
        @media print { body { background: #fff; } .toolbar { display: none; } .notice { margin: 0; width: auto; min-height: 0; } }
    </style>
</head>
<body>
    <div class="toolbar">
        <strong><%= title %></strong> — <%= notices.length %>
        <button type="button" id="sso-notices-print"><%= __('admin:acc_sso_notices_print') %></button>
    </div>
    <script nonce="<%= cspNonce %>">
        document.getElementById('sso-notices-print').addEventListener('click', function () { window.print(); });
    </script>
    <% if (!notices.length) { %>
        <p style="padding:16px;"><%= __('admin:acc_sso_notices_none') %></p>
    <% } %>
    <% notices.forEach(function (n) { %>
        <section class="notice">
            <h1><%= n.subject %></h1>
            <div class="for"><%= __('auth:ssoinv_notice_for', { name: n.name }) %><% if (n.employeeNumber) { %> · <%= n.employeeNumber %><% } %></div>
            <pre><%= n.text %></pre>
        </section>
    <% }); %>
</body>
</html>
