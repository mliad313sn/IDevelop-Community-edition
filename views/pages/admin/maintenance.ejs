<script nonce="<%= cspNonce %>">
(function(){
  var CSRF = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
  var T = {
    needReason: <%- JSON.stringify(__('admin:maint_err_maintenance_reason_required')) %>,
    pickEmp: <%- JSON.stringify(__('admin:maint_err_pick_employee')) %>,
    err: <%- JSON.stringify(__('admin:maint_generic_err')) %>,
    done: <%- JSON.stringify(__('admin:maint_dsr_done')) %>
  };
  var dlg = document.getElementById('mntDsrDlg');
  function picked(){
    var raw = (document.getElementById('mntDsrEmp').value || '').trim();
    var id = parseInt(raw, 10);
    if (!id) { (window.toast || alert)(T.pickEmp, 'error'); return null; }
    var label = '#' + id;
    var opts = document.getElementById('mntEmpList').options;
    for (var i = 0; i < opts.length; i++) {
      if (String(opts[i].value) === String(id)) { label = (opts[i].textContent || opts[i].label || '').trim() + ' (#' + id + ')'; break; }
    }
    return { id: id, label: label };
  }
  document.getElementById('mntDsrExport').addEventListener('click', function(){
    var p = picked(); if (!p) return;
    window.location.href = '/admin/maintenance/dsr/' + p.id + '/export.json';
  });
  document.getElementById('mntDsrErase').addEventListener('click', function(){
    var p = picked(); if (!p) return;
    dlg.dataset.id = p.id;
    document.getElementById('mntDsrWhat').textContent = p.label;
    document.getElementById('mntDsrReason').value = '';
    document.getElementById('mntDsrConfirm').value = '';
    var e = document.getElementById('mntDsrErr'); e.hidden = true; e.textContent = '';
    dlg.showModal();
    document.getElementById('mntDsrReason').focus();
  });
  document.getElementById('mntDsrCancel').addEventListener('click', function(){ dlg.close(); });
  document.getElementById('mntDsrOk').addEventListener('click', function(){
    var reason = (document.getElementById('mntDsrReason').value || '').trim();
    var confirmNumber = (document.getElementById('mntDsrConfirm').value || '').trim();
    var errEl = document.getElementById('mntDsrErr');
    if (!reason) { errEl.textContent = T.needReason; errEl.hidden = false; return; }
    var btn = this; btn.disabled = true;
    fetch('/admin/maintenance/dsr-erase', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': CSRF },
      body: JSON.stringify({ employeeId: Number(dlg.dataset.id), reason: reason, confirmNumber: confirmNumber })
    }).then(function(r){ return r.json().catch(function(){ return {}; }); })
      .then(function(j){
        btn.disabled = false;
        if (j && j.ok) { dlg.close(); if (window.toast) window.toast(T.done, 'success'); setTimeout(function(){ window.location.reload(); }, 800); }
        else { errEl.textContent = (j && j.error) || T.err; errEl.hidden = false; }
      })
      .catch(function(){ btn.disabled = false; errEl.textContent = T.err; errEl.hidden = false; });
  });
})();
</script>
