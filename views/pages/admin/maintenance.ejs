<dialog id="mntRetDlg" class="mnt-dlg" aria-labelledby="mntRetDlgTitle">
  <form method="dialog">
    <h3 id="mntRetDlgTitle" style="margin:0 0 .3rem;font-size:1.05rem"></h3>
    <p id="mntRetDlgWhat" class="text-muted" style="margin:0 0 .8rem;font-size:.85rem"></p>
    <label for="mntRetDlgReason" style="display:block;font-weight:600;margin-bottom:.3rem"><%= __('admin:maint_reason_label') %></label>
    <textarea id="mntRetDlgReason" rows="3" class="form-control" style="width:100%" placeholder="<%= __('admin:maint_reason_ph') %>"></textarea>
    <p id="mntRetDlgErr" class="mnt-err" hidden></p>
    <div style="display:flex;gap:.5rem;justify-content:flex-end;margin-top:.9rem">
      <button type="button" class="btn" id="mntRetDlgCancel"><%= __('admin:maint_dlg_cancel') %></button>
      <button type="button" class="btn btn-danger" id="mntRetDlgOk"></button>
    </div>
  </form>
</dialog>

<script nonce="<%= cspNonce %>">
(function(){
  var CSRF = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
  var T = <%- JSON.stringify({
    colon: colon,
    report: __('admin:ret_mode_report'), apply: __('admin:ret_mode_apply'),
    toApply: __('admin:ret_mode_switch_apply'), toReport: __('admin:ret_mode_switch_report'),
    confirmApply: __('admin:ret_confirm_apply'), needReason: __('admin:ret_err_reason_required'),
    err: __('admin:ret_err_generic'), notMeasured: __('admin:ret_not_measured'),
    colCountry: __('admin:ret_col_country'), colDays: __('admin:ret_col_days'),
    colEmployee: __('admin:ret_col_employee'), colDue: __('admin:ret_col_due'), colHold: __('admin:ret_col_hold'),
    dueNone: __('admin:ret_due_none'), pending: __('admin:ret_pending'), unscheduled: __('admin:ret_unscheduled'),
    lastNone: __('admin:ret_last_run_none'), lastLine: __('admin:ret_last_run_line'),
    tomb: __('admin:ret_tombstones'), held: __('admin:ret_held'),
    holdSet: __('admin:ret_hold_set'), holdRelease: __('admin:ret_hold_release'),
    runDone: __('admin:ret_run_done'), reapplyDone: __('admin:ret_reapply_done'),
    periodsNone: __('admin:ret_periods_none'),
    runNow: __('admin:ret_run_now'), confirmRunApply: __('admin:ret_confirm_run_apply'),
    preHoldTitle: __('admin:ret_prehold_title'), preHoldBadId: __('admin:ret_prehold_bad_id'),
    actions: {
      would_erase: __('admin:ret_action_would_erase'), erased: __('admin:ret_action_erased'),
      skipped_legal_hold: __('admin:ret_action_skipped_legal_hold'), skipped_active: __('admin:ret_action_skipped_active'),
      already_erased: __('admin:ret_action_already_erased'), failed: __('admin:ret_action_failed'),
      skipped_claimed: __('admin:ret_action_skipped_claimed'), skipped_missing: __('admin:ret_action_skipped_missing')
    }
  }) %>;
  var box = document.getElementById('mntRet');
  var errEl = document.getElementById('mntRetErr');
  var modeNow = null;
  function fill(tpl, vars){ return String(tpl).replace(/\{\{(\w+)\}\}/g, function(_, k){ return vars[k] == null ? '' : String(vars[k]); }); }
  function num(v){ return v == null ? T.notMeasured : String(v); }
  function day(d){ if (!d) return '—'; try { return new Date(d).toLocaleDateString(document.documentElement.lang || 'fr'); } catch (e) { return String(d); } }
  function el(tag, text, cls){ var e = document.createElement(tag); if (text != null) e.textContent = text; if (cls) e.className = cls; return e; }
  function showErr(msg){ errEl.textContent = msg || T.err; errEl.hidden = false; }
  function post(url, body){
    errEl.hidden = true;
    return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': CSRF }, body: JSON.stringify(body || {}) })
      .then(function(r){ return r.json().catch(function(){ return {}; }); });
  }
  function table(head, rows){
    var t = el('table', null, 'table table-sm'); var tr = el('tr');
    head.forEach(function(h){ tr.appendChild(el('th', h)); });
    var th = el('thead'); th.appendChild(tr); t.appendChild(th);
    var tb = el('tbody'); rows.forEach(function(r){ tb.appendChild(r); }); t.appendChild(tb);
    return t;
  }
  function render(s){
    modeNow = s.mode;
    var m = document.getElementById('mntRetMode');
    m.textContent = s.mode === 'apply' ? T.apply : T.report;
    m.className = 'badge ' + (s.mode === 'apply' ? 'badge-danger' : 'badge-secondary');
    var btn = document.getElementById('mntRetModeBtn');
    btn.textContent = s.mode === 'apply' ? T.toReport : T.toApply;
    btn.className = 'btn ' + (s.mode === 'apply' ? 'btn-secondary' : 'btn-danger');
    btn.hidden = false;

    var per = document.getElementById('mntRetPeriods'); per.textContent = '';
    if (s.periods == null) per.textContent = T.notMeasured;
    else if (!s.periods.length) per.textContent = T.periodsNone;
    else per.appendChild(table([T.colCountry, T.colDays], s.periods.map(function(p){
      var tr = el('tr'); tr.appendChild(el('td', (p.name || '') + ' (' + (p.code || '') + ')')); tr.appendChild(el('td', String(p.dsrSlaDays))); return tr;
    })));

    var due = document.getElementById('mntRetDue'); due.textContent = '';
    if (s.due == null) due.textContent = T.notMeasured;
    else if (!s.due.length) due.appendChild(el('p', T.dueNone, 'text-muted'));
    else due.appendChild(table([T.colEmployee, T.colCountry, T.colDue, T.colHold], s.due.map(function(d){
      var tr = el('tr');
      var name = [d.firstName, d.lastName].filter(Boolean).join(' ');
      tr.appendChild(el('td', (name ? name + ' ' : '') + '(#' + d.employeeId + ')'));
      tr.appendChild(el('td', d.countryCode || '—'));
      tr.appendChild(el('td', day(d.dueAt)));
      var td = el('td');
      if (d.legalHoldAt) { td.appendChild(el('span', T.held + (d.legalHoldReason ? ' — ' + d.legalHoldReason : ''), 'badge badge-warning')); td.appendChild(document.createTextNode(' ')); }
      var hb = el('button', d.legalHoldAt ? T.holdRelease : T.holdSet, 'btn btn-sm');
      hb.type = 'button';
      hb.addEventListener('click', function(){
        ask(d.legalHoldAt ? T.holdRelease : T.holdSet, (name ? name + ' ' : '') + '(#' + d.employeeId + ')',
          d.legalHoldAt ? T.holdRelease : T.holdSet, function(why){
            return post('/v2/cap/dsr/' + encodeURIComponent(d.employeeId) + '/legal-hold', { hold: !d.legalHoldAt, reason: why });
          });
      });
      td.appendChild(hb); tr.appendChild(td);
      return tr;
    })));
    document.getElementById('mntRetCounts').textContent =
      fill(T.pending, { n: num(s.pendingNotDue) }) + ' · ' + fill(T.unscheduled, { n: num(s.unscheduledLeavers) });

    var last = document.getElementById('mntRetLast');
    if (!s.lastRun) last.textContent = T.lastNone;
    else {
      var parts = Object.keys(s.lastRun.counts || {}).map(function(k){ return (T.actions[k] || k) + T.colon + ' ' + s.lastRun.counts[k]; });
      last.textContent = fill(T.lastLine, { at: s.lastRun.at ? new Date(s.lastRun.at).toLocaleString(document.documentElement.lang || 'fr') : '—',
        mode: s.lastRun.mode === 'apply' ? T.apply : T.report }) + (parts.length ? ' — ' + parts.join(', ') : '');
    }
    document.getElementById('mntRetTomb').textContent = fill(T.tomb, { n: num(s.tombstones) });
    box.setAttribute('aria-busy', 'false');
  }
  function load(){
    fetch('/v2/cap/dsr/retention/status', { headers: { 'Accept': 'application/json' } })
      .then(function(r){ return r.json(); })
      .then(function(j){ if (j && j.ok) render(j); else showErr(j && j.error); })
      .catch(function(){ showErr(); });
  }
  // One dialog for every reasoned action on this block (mode switch, legal hold):
  // a mandatory reason, then `send(reason)` → promise of the JSON answer.
  var dlg = document.getElementById('mntRetDlg');
  var dlgSend = null;
  function ask(title, what, okLabel, send){
    document.getElementById('mntRetDlgTitle').textContent = title;
    document.getElementById('mntRetDlgWhat').textContent = what || '';
    document.getElementById('mntRetDlgOk').textContent = okLabel;
    document.getElementById('mntRetDlgReason').value = '';
    var e = document.getElementById('mntRetDlgErr'); e.hidden = true; e.textContent = '';
    dlgSend = send;
    dlg.showModal();
    document.getElementById('mntRetDlgReason').focus();
  }
  document.getElementById('mntRetDlgCancel').addEventListener('click', function(){ dlg.close(); });
  document.getElementById('mntRetDlgOk').addEventListener('click', function(){
    var reason = (document.getElementById('mntRetDlgReason').value || '').trim();
    var e = document.getElementById('mntRetDlgErr');
    if (!reason) { e.textContent = T.needReason; e.hidden = false; return; }
    var b = this; b.disabled = true;
    dlgSend(reason)
      .then(function(j){ b.disabled = false; if (j && j.ok) { dlg.close(); load(); } else { e.textContent = (j && j.error) || T.err; e.hidden = false; } })
      .catch(function(){ b.disabled = false; e.textContent = T.err; e.hidden = false; });
  });
  document.getElementById('mntRetModeBtn').addEventListener('click', function(){
    var target = modeNow === 'apply' ? 'report' : 'apply';
    ask(target === 'apply' ? T.toApply : T.toReport, target === 'apply' ? T.confirmApply : '',
      target === 'apply' ? T.toApply : T.toReport, function(reason){
        return post('/v2/cap/dsr/retention/mode', { mode: target, reason: reason });
      });
  });
  document.getElementById('mntRetRun').addEventListener('click', function(){
    var b = this;
    // UX-5 (3.23.21): in APPLY mode a run erases people — the reasoned
    // confirmation dialog comes first. In report mode it only lists.
    if (modeNow === 'apply') {
      ask(T.runNow, T.confirmRunApply, T.runNow, function(reason){
        return post('/v2/cap/dsr/retention/run', { reason: reason }).then(function(j){
          if (j && j.ok && window.toast) window.toast(T.runDone, 'success');
          return j;
        });
      });
      return;
    }
    b.disabled = true;
    post('/v2/cap/dsr/retention/run', {})
      .then(function(j){ b.disabled = false; if (j && j.ok) { if (window.toast) window.toast(T.runDone, 'success'); load(); } else showErr(j && j.error); })
      .catch(function(){ b.disabled = false; showErr(); });
  });
  // F11 (3.23.21): legal hold BEFORE departure — on the employee record, carried
  // into the retention job when the departure schedules it.
  document.getElementById('mntRetPreHoldBtn').addEventListener('click', function(){
    var input = document.getElementById('mntRetPreHoldId');
    var id = parseInt(input.value, 10);
    if (!(id > 0)) { showErr(T.preHoldBadId); input.focus(); return; }
    ask(T.preHoldTitle, '#' + id, T.holdSet, function(why){
      return post('/v2/cap/dsr/' + encodeURIComponent(id) + '/legal-hold', { hold: true, reason: why, beforeDeparture: true });
    });
  });
  document.getElementById('mntRetReapply').addEventListener('click', function(){
    var b = this; b.disabled = true;
    post('/v2/cap/dsr/retention/reapply-erasures', {})
      .then(function(j){ b.disabled = false; if (j && j.ok) { if (window.toast) window.toast(fill(T.reapplyDone, { n: (j.reapplied || []).length }), 'success'); load(); } else showErr(j && j.error); })
      .catch(function(){ b.disabled = false; showErr(); });
  });
  load();
})();
</script>
<!-- ══ end retention ══ -->
