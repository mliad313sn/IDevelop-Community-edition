<div class="dashboard-container">

    <% if (typeof setupPending !== 'undefined' && setupPending) { %>
    <!-- First-run setup banner (SuperAdmin, until complete or dismissed) -->
    <div class="card" style="display:flex;align-items:center;gap:14px;padding:14px 18px;margin-bottom:14px;border-left:3px solid var(--brand,#7C6CFF);">
        <i class="fas fa-list-check" aria-hidden="true" style="color:var(--brand,#7C6CFF);font-size:1.2rem;"></i>
        <div style="flex:1;">
            <strong><%= __('admin:setup_banner_title', { brand: (typeof brandName!=='undefined' && brandName) ? brandName : 'IDevelop' }) %></strong>
            <div style="font-size:.85rem;color:var(--text-secondary);"><%= __('admin:setup_banner_sub') %></div>
        </div>
        <a href="/setup" class="btn btn-primary btn-sm"><%= __('admin:setup_banner_cta') %></a>
    </div>
    <% } %>

    <!-- Header & Title -->
    <div class="dashboard-header">
        <h1><%= __('dash:workforce_capability_dashboard') %></h1>
        <div class="last-updated">
            <%= __('dash:data_real_time') %>
        </div>
    </div>

    <!-- Global Filters -->
    <div class="dashboard-filters">
        <div class="filter-group">
            <label for="filter-site"><%= __('dash:site') %></label>
            <select id="filter-site">
                <%# a scope with exactly one site never offers the misleading "all sites" option. %>
                <% if (filterOptions.sites.length !== 1) { %><option value=""><%= __('dash:all_sites') %></option><% } %>
                <% filterOptions.sites.forEach(site=> { %>
                    <option value="<%= site.name %>">
                        <%= site.name %>
                    </option>
                    <% }); %>
            </select>
        </div>
        <div class="filter-group">
            <label for="filter-department"><%= __('dash:department') %></label>
            <select id="filter-department">
                <option value=""><%= __('dash:all_departments') %></option>
                <% filterOptions.departments.forEach(dept=> { %>
                    <option value="<%= dept.name %>">
                        <%= dept.name %>
                    </option>
                    <% }); %>
            </select>
        </div>
        <div class="filter-group">
            <label for="filter-service"><%= __('dash:service') %></label>
            <select id="filter-service">
                <option value=""><%= __('dash:all_services') %></option>
                <% filterOptions.services.forEach(svc=> { %>
                    <option value="<%= svc.name %>">
                        <%= svc.name %>
                    </option>
                    <% }); %>
            </select>
        </div>
        <div class="filter-actions">
            <button id="btn-apply-filters" class="btn btn-primary"><%= __('dash:apply') %></button>
            <button id="btn-reset-filters" class="btn btn-secondary"><%= __('dash:reset') %></button>
            <a href="/reports/dept-analytics" class="btn btn-secondary" title="<%= __('chrome:nav_dept_analytics_title') %>"><i class="fas fa-chart-line" aria-hidden="true"></i> <%= __('chrome:nav_dept_analytics') %></a>
        </div>
    </div>

    <!-- Tabs Navigation -->
    <div class="dashboard-tabs">
        <% const _ws = (typeof wsVisible === 'function') ? wsVisible : function(){ return true; }; %>
        <% if (_ws('tab:executive')) { %><button class="tab-btn active" data-tab="executive"><%= __('dash:executive_overview') %></button><% } %>
        <% if (_ws('tab:training')) { %><button class="tab-btn" data-tab="training"><%= __('dash:training_priorities') %></button><% } %>
        <% if (_ws('tab:talentdev')) { %><button class="tab-btn" data-tab="talentdev"><%= __('dash:talent_development') %></button><% } %>
        <% if (_ws('tab:team')) { %><button class="tab-btn" data-tab="team" style="display: none !important;"><%= __('dash:team_development') %></button><% } %>
        <% if (_ws('tab:capability')) { %><button class="tab-btn" data-tab="capability"><%= __('dash:capability_map') %></button><% } %>
        <% if (_ws('tab:comparator')) { %><button class="tab-btn" data-tab="comparator"><%= __('dash:comparator') %></button><% } %>
    </div>

    <!-- TAB 1: EXECUTIVE OVERVIEW -->
    <div id="tab-executive" class="tab-panel active">
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 1: HEADLINE — scope + health index + decision KPIs      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <%# M-12 (résiduel) : le bandeau écrit le périmètre RÉEL du lecteur.
            Il rendait « Tous les sites · Tous les départements · Tous les services »
            pour TOUT LE MONDE (libellé de la première option des listes), y compris
            pour un lecteur borné dont la tuile du même onglet imprimait 1 site /
            1 département / 1 service. Le serveur résout ici le périmètre RBAC avec
            le prédicat de la tuile ; `dashboard.js` ne remplace un segment que
            lorsqu'un filtre est réellement appliqué. Rendu côté serveur pour que la
            page dise vrai même sans JavaScript. %>
        <% const _rs = (typeof readerScope !== 'undefined' && readerScope) ? readerScope : { restricted: false };
           const _scopeParts = _rs.restricted && _rs.empty
               ? [_rs.emptyLabel]
               : [_rs.site || __('dash:all_sites'), _rs.department || __('dash:all_departments'), _rs.service || __('dash:all_services')]; %>
        <div class="exec-scope<%= _rs.restricted ? ' is-scoped' : '' %>" id="exec-scope-bar" data-scoped="<%= _rs.restricted ? '1' : '0' %>">
            <i class="fas fa-filter" aria-hidden="true"></i>
            <span class="exec-scope-label"><%= __('dash:exec_scope_label') %></span>
            <span class="exec-scope-value" id="exec-scope-value"><%= _scopeParts.join(' · ') %></span>
            <span class="exec-scope-own" id="exec-scope-own" <%= _rs.restricted ? '' : 'hidden' %>><%= _rs.limitedLabel || __('dash:scope_limited') %></span>
            <%# M-12 (arbitrage 4b) : la garantie ne porte plus que sur ce qu'elle tient
                réellement. Le seul bloc de l'onglet qui ne suit pas le périmètre est le
                RÉFÉRENTIEL de compétences (cartes marquées « référentiel »), exclu ici
                nommément plutôt que démenti par ses propres chiffres. %>
            <span class="exec-scope-hint"><%= __('dash:exec_scope_hint') %></span>
        </div>

        <div class="section-divider first-section">
            <h2 class="section-title"><span class="section-icon"><i class="fas fa-bullseye" aria-hidden="true"></i></span> <%= __('dash:strategic_health') %></h2>
            <p class="section-subtitle"><%= __('dash:strategic_health_sub') %></p>
        </div>

        <div class="exec-hero">
            <div class="chart-box risk-gauge-box">
                <h3><%= __('dash:workforce_health_score') %></h3>
                <p class="chart-caption" style="margin:-4px 0 8px;color:var(--text-muted);font-size:.8rem"><%= __('dash:workforce_health_hint') %></p>
                <div id="risk-gauge-container" class="risk-gauge-wrapper">
                    <div class="chart-loading"><%= __('dash:loading') %></div>
                </div>
                <p class="exec-trend-caption" id="exec-trend-caption" aria-live="polite"></p>
                <div id="risk-breakdown-container" class="risk-breakdown"></div>
            </div>
            <div class="chart-box exec-hero-kpis">
                <h3><%= __('dash:decision_kpis') %></h3>
                <!-- KPI Grid -->
                <div class="kpi-grid" id="executive-kpis">
                    <!-- Populated by JS -->
                </div>
                <!-- Provenance strip: says how much of the workforce the KPIs above
                     are actually based on, so "never assessed" can never be read as
                     an honest zero. Populated by JS. -->
                <p class="exec-provenance" id="exec-provenance" aria-live="polite"></p>
            </div>
        </div>

        <!-- Trend Chart -->
        <div class="chart-box wide">
            <h3><%= __('dash:workforce_trend_6m') %></h3>
            <div class="chart-container-inner" style="height: 300px;">
                <canvas id="chart-trend"></canvas>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 2: OPERATIONAL OVERVIEW                                -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="section-divider">
            <h2 class="section-title"><span class="section-icon"><i class="fas fa-chart-column" aria-hidden="true"></i></span> <%= __('dash:operational_overview') %></h2>
            <p class="section-subtitle"><%= __('dash:operational_overview_sub') %></p>
        </div>

        <div class="chart-row">
            <div class="chart-box org-health-box" style="flex: 2;">
                <h3><%= __('dash:org_health_scorecard') %></h3>
                <div id="org-health-grid" class="org-health-grid">
                    <div class="chart-loading"><%= __('dash:loading') %></div>
                </div>
            </div>
            <div class="chart-box" style="flex: 1;">
                <h3><%= __('dash:readiness_distribution') %></h3>
                <div class="chart-container-inner">
                    <canvas id="chart-readiness-dist"></canvas>
                </div>
            </div>
            <div class="chart-box" style="flex: 1; display: none !important;">
                <div class="box-header">
                    <h3><i class="fas fa-chart-column" aria-hidden="true"></i> <%= __('dash:domain_proficiency_summary') %></h3>
                </div>
                <div class="table-container" id="org-radar-summary-table">
                    <!-- Populated by JS -->
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 2b: WORKFORCE & TALENT MEASURES (collapsed by default)  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <details class="exec-disclosure" id="dsc-measures">
            <summary>
                <span class="section-icon"><i class="fas fa-gauge-high" aria-hidden="true"></i></span>
                <span class="exec-disclosure-title"><%= __('dash:workforce_talent_measures') %></span>
                <span class="exec-disclosure-count" id="measures-count" hidden></span>
                <i class="fas fa-chevron-down exec-disclosure-chev" aria-hidden="true"></i>
                <span class="exec-disclosure-sub"><%= __('dash:workforce_talent_measures_sub') %></span>
            </summary>
            <div class="exec-disclosure-body">
                <div id="measures-grid" class="measures-grid"><div class="chart-loading"><%= __('dash:loading_measures') %></div></div>
            </div>
        </details>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 3: RISK & FOCUS AREAS                                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="section-divider">
            <h2 class="section-title"><span class="section-icon"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i></span> <%= __('dash:risk_focus_areas') %></h2>
            <p class="section-subtitle"><%= __('dash:risk_focus_areas_sub') %></p>
        </div>

        <!-- Critical Roles + Impact Gaps -->
        <div class="chart-row strategic-row">
            <div class="chart-box" style="flex: 1;">
                <div class="box-header">
                    <h3><i class="fas fa-triangle-exclamation" aria-hidden="true"></i><%= __('dash:critical_roles_at_risk') %></h3>
                    <span class="badge badge-count" id="critical-roles-count">0</span>
                </div>
                <div class="table-container" id="critical-roles-container">
                    <div class="chart-loading"><%= __('dash:loading') %></div>
                </div>
            </div>
            <div class="chart-box" style="flex: 1;">
                <h3><i class="fas fa-fire" aria-hidden="true"></i> <%= __('dash:top5_skill_gaps_by_impact') %></h3>
                <div id="impact-gaps-container" class="impact-gaps-container">
                    <div class="chart-loading"><%= __('dash:loading') %></div>
                </div>
            </div>
        </div>

        <!-- Compliance & Campaign strip (migrations 56/57): certification expiry
             pressure, coverage breaches, current-campaign completion. -->
        <div class="chart-box wide" id="compliance-strip-box">
            <div class="box-header">
                <h3><i class="fas fa-clipboard-check" aria-hidden="true"></i> <%= __('dash:compliance_campaign_title') %></h3>
                <span>
                    <a href="/compliance" class="btn btn-sm btn-secondary"><%= __('dash:cc_open_compliance') %></a>
                    <a href="/reports/dept-analytics" class="btn btn-sm btn-secondary"><%= __('dash:cc_open_analytics') %></a>
                </span>
            </div>
            <p class="section-subtitle" style="margin:.15rem 0 .7rem;"><%= __('dash:compliance_campaign_sub') %></p>
            <div id="compliance-strip" style="display:flex;flex-wrap:wrap;gap:12px;">
                <div class="chart-loading"><%= __('dash:loading') %></div>
            </div>
        </div>
        <script nonce="<%= cspNonce %>">
        (function () {
            'use strict';
            var T = <%- include('../partials/json-script', { v: {
                expiring: __('dash:cc_certs_expiring'), expired: __('dash:cc_certs_expired'),
                lapsed: __('dash:cc_lapsed_levels'), breaches: __('dash:cc_coverage_breaches'),
                campaign: __('dash:cc_campaign_completion'), noCampaign: __('dash:cc_no_campaign'),
                daysLeft: __('dash:cc_days_left'), overdue: __('dash:cc_overdue'),
                criticalSuffix: __('dash:cc_critical_suffix'),
                notLaunched: __('dash:cmp_not_launched'), noRoster: __('dash:cmp_no_roster'),
                rosterUnavailable: __('dash:cmp_roster_unavailable'),
                funnel: __('dash:cmp_funnel'),
            } }) %>;
            function card(label, value, color, sub, href) {
                var a = document.createElement(href ? 'a' : 'div');
                if (href) { a.href = href; a.style.textDecoration = 'none'; }
                a.style.cssText += ';flex:1;min-width:150px;padding:.7rem .9rem;border:1px solid var(--border-color,#e5e7eb);border-radius:10px;background:var(--bg-primary,transparent);color:inherit;';
                var h = document.createElement('div');
                h.style.cssText = 'font-size:.72rem;text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted,#6b7280);';
                h.textContent = label;
                var v = document.createElement('div');
                v.style.cssText = 'font-size:1.45rem;font-weight:700;color:' + color + ';';
                v.textContent = value;
                a.appendChild(h); a.appendChild(v);
                if (sub) {
                    var s = document.createElement('div');
                    s.style.cssText = 'font-size:.75rem;color:var(--text-muted,#6b7280);';
                    s.textContent = sub;
                    a.appendChild(s);
                }
                return a;
            }
            fetch('/api/dashboard/compliance-summary', { headers: { Accept: 'application/json' } })
                .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                .then(function (d) {
                    var el = document.getElementById('compliance-strip');
                    el.innerHTML = '';
                    var c = d.certifications, cov = d.coverage, cp = d.campaign;
                    el.appendChild(card(T.expiring, c.expiring, c.expiring ? '#e67e22' : '#27ae60', null, '/compliance'));
                    el.appendChild(card(T.expired, c.expired, c.expired ? '#c0392b' : '#27ae60', null, '/compliance'));
                    el.appendChild(card(T.lapsed, c.lapsed, c.lapsed ? '#c0392b' : '#27ae60', null, '/compliance'));
                    el.appendChild(card(T.breaches, cov.breached + ' / ' + cov.rules,
                        cov.breached ? '#c0392b' : '#27ae60',
                        cov.critical ? (cov.critical + ' ' + T.criticalSuffix) : null, '/compliance'));
                    if (cp && cp.launched) {
                        // Denominator = the ENROLLED ROSTER (migration 70), so the
                        // people who never opened the campaign are counted. The
                        // sub-line states the funnel: submitted / asked, and how
                        // many have not started at all.
                        var funnel = T.funnel
                            .replace('{submitted}', cp.submitted)
                            .replace('{total}', cp.enrolled)
                            .replace('{notStarted}', cp.notStarted);
                        var when = cp.daysLeft == null ? null
                            : (cp.daysLeft >= 0 ? (cp.daysLeft + ' ' + T.daysLeft) : T.overdue);
                        el.appendChild(card(T.campaign + ' — ' + cp.code,
                            cp.completionPct + '%',
                            cp.completionPct >= 80 ? '#27ae60' : (cp.completionPct >= 50 ? '#e67e22' : '#c0392b'),
                            funnel + (when ? ' · ' + when : ''),
                            '/cycles'));
                    } else if (cp) {
                        // Open cycle, but nobody enrolled in this scope (or the
                        // roster is unavailable): "non lancée" — NEVER 100 %.
                        el.appendChild(card(T.campaign + ' — ' + cp.code, '—',
                            'var(--text-muted,#6b7280)',
                            cp.rosterAvailable === false ? T.rosterUnavailable
                                : (T.notLaunched + ' · ' + T.noRoster),
                            '/cycles'));
                    } else {
                        el.appendChild(card(T.campaign, '—', 'var(--text-muted,#6b7280)', T.noCampaign));
                    }
                })
                .catch(function () {
                    var el = document.getElementById('compliance-strip');
                    if (el) el.innerHTML = '';
                    var box = document.getElementById('compliance-strip-box');
                    if (box) box.style.display = 'none'; // fail closed & quiet — never break the exec tab
                });
        })();
        </script>

        <div class="chart-row" style="display: none !important;">
            <div class="chart-box wide">
                <h3><%= __('dash:staffing_risks_spof') %></h3>
                <div class="table-container" id="staffing-risk-container">
                    <!-- HTML Table -->
                </div>
            </div>
        </div>

        <!-- ═══ Capability Radar (Domain & Sub-Domain) — collapsed by default ═══ -->
        <details class="exec-disclosure" id="dsc-radar">
            <summary>
                <span class="section-icon"><i class="fas fa-diagram-project" aria-hidden="true"></i></span>
                <span class="exec-disclosure-title"><%= __('dash:capability_radar') %></span>
                <span class="exec-disclosure-count" id="radar-count" hidden></span>
                <i class="fas fa-chevron-down exec-disclosure-chev" aria-hidden="true"></i>
                <span class="exec-disclosure-sub"><%= __('dash:capability_radar_sub') %></span>
            </summary>
            <div class="exec-disclosure-body">

        <!-- Top/Worst Domains -->
        <div class="chart-row">
            <div class="chart-box" style="flex: 1; min-width: 320px;">
                <div class="box-header">
                    <h3><i class="fas fa-trophy" aria-hidden="true"></i> <%= __('dash:top10_domains') %></h3>
                    <span class="chart-subtitle"><%= __('dash:highest_actual_proficiency') %></span>
                </div>
                <div class="chart-container-inner" style="height: 370px;">
                    <canvas id="chart-org-radar-top"></canvas>
                </div>
                <div class="radar-legend-inline">
                    <span class="radar-legend-item"><span class="radar-dot actual"></span> <%= __('dash:actual_avg') %></span>
                    <span class="radar-legend-item"><span class="radar-dot required"></span> <%= __('dash:required_avg') %></span>
                </div>
            </div>
            <div class="chart-box" style="flex: 1; min-width: 320px;">
                <div class="box-header">
                    <h3><i class="fas fa-triangle-exclamation" aria-hidden="true"></i><%= __('dash:worst10_domains') %></h3>
                    <span class="chart-subtitle"><%= __('dash:largest_proficiency_gaps') %></span>
                </div>
                <div class="chart-container-inner" style="height: 370px;">
                    <canvas id="chart-org-radar-worst"></canvas>
                </div>
                <div class="radar-legend-inline">
                    <span class="radar-legend-item"><span class="radar-dot actual"></span> <%= __('dash:actual_avg') %></span>
                    <span class="radar-legend-item"><span class="radar-dot required"></span> <%= __('dash:required_avg') %></span>
                </div>
            </div>
        </div>

        <!-- Sub-Domain Capability Radar (V3 — domain → sub-domain axis) -->
        <div class="chart-row">
            <div class="chart-box" style="flex: 1; min-width: 320px;">
                <div class="box-header">
                    <h3><i class="fas fa-diagram-project" aria-hidden="true"></i> <%= __('dash:subdomain_capability') %></h3>
                    <span class="chart-subtitle"><%= __('dash:subdomain_capability_sub') %></span>
                    <select id="subdomain-radar-pillar" class="filter-select" style="margin-left:auto; max-width: 260px;" aria-label="<%= __('dash:pillar_domain') %>">
                        <option value=""><%= __('dash:all_pillars') %></option>
                    </select>
                </div>
                <div class="chart-container-inner" style="height: 420px;">
                    <canvas id="chart-org-subdomain-radar"></canvas>
                </div>
                <p id="subdomain-radar-caption" class="chart-caption" aria-live="polite"></p>
                <div class="radar-legend-inline">
                    <span class="radar-legend-item"><span class="radar-dot actual"></span> <%= __('dash:actual_avg') %></span>
                    <span class="radar-legend-item"><span class="radar-dot required"></span> <%= __('dash:required_avg') %></span>
                </div>
            </div>
        </div>
            </div>
        </details>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 4: ORGANIZATIONAL BREAKDOWN (collapsed by default)     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <details class="exec-disclosure" id="dsc-orgdist">
            <summary>
                <span class="section-icon"><i class="fas fa-building" aria-hidden="true"></i></span>
                <span class="exec-disclosure-title"><%= __('dash:organizational_breakdown') %></span>
                <span class="exec-disclosure-count" id="orgdist-count" hidden></span>
                <i class="fas fa-chevron-down exec-disclosure-chev" aria-hidden="true"></i>
                <span class="exec-disclosure-sub"><%= __('dash:organizational_breakdown_sub') %></span>
            </summary>
            <div class="exec-disclosure-body">

        <div class="chart-row">
            <div class="chart-box">
                <h3><%= __('dash:readiness_by_site') %></h3>
                <div class="chart-container-inner">
                    <canvas id="chart-readiness-site"></canvas>
                </div>
            </div>
            <div class="chart-box">
                <h3><%= __('dash:readiness_by_department') %></h3>
                <div class="chart-container-inner">
                    <canvas id="chart-readiness-department"></canvas>
                </div>
            </div>
            <div class="chart-box">
                <h3><%= __('dash:readiness_by_service') %></h3>
                <div class="chart-container-inner">
                    <canvas id="chart-readiness-service"></canvas>
                </div>
            </div>
        </div>

        <div class="chart-row strategic-row">
            <div class="chart-box wide">
                <h3><i class="fas fa-chart-line" aria-hidden="true"></i> <%= __('dash:dept_performance_ranking') %></h3>
                <div class="chart-container-inner" style="height: 300px;">
                    <canvas id="chart-dept-ranking"></canvas>
                </div>
            </div>
        </div>
            </div>
        </details>

        <!-- ═══ Benchmark Fit — how current occupants meet each role's required benchmark ═══ -->
        <details class="exec-disclosure" id="dsc-benchmark">
            <summary>
                <span class="section-icon"><i class="fas fa-people-arrows" aria-hidden="true"></i></span>
                <span class="exec-disclosure-title"><%= __('dash:benchmark_fit_by_role') %></span>
                <span class="exec-disclosure-count" id="benchmark-fit-count" hidden></span>
                <i class="fas fa-chevron-down exec-disclosure-chev" aria-hidden="true"></i>
                <span class="exec-disclosure-sub"><%= __('dash:benchmark_fit_by_role_sub') %></span>
            </summary>
            <div class="exec-disclosure-body">
                <p class="section-subtitle" style="margin:0 0 .6rem;"><a href="/benchmark"><%= __('dash:open_full_benchmark_matrix') %></a></p>
                <div class="chart-row strategic-row">
                    <div class="chart-box wide">
                        <div class="table-container" id="benchmark-fit-container"><!-- populated by loadBenchmarkFit() --></div>
                    </div>
                </div>
            </div>
        </details>
        <style>
        #benchmark-fit-container .bm-fitbar { position:relative; height:20px; background:var(--bg-subtle); border-radius:6px; overflow:hidden; min-width:150px; }
        #benchmark-fit-container .bm-fitbar-fill { height:100%; background:#4CAF50; }
