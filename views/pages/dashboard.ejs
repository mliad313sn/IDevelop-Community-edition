<!-- Additional workforce & talent measures (non-security) -->
<style>
/* Mirrors the proven .org-health-grid pattern on this same dashboard: plain
   repeat(4,1fr) with VERTICALLY-stacked, centered cards. Stacked content keeps each
   card's min-content small so 1fr tracks never blow out the page; overflow:hidden is
   a hard backstop and overflow-wrap breaks long labels. Columns step down by width. */
.measures-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin:4px 0 8px; overflow:hidden; }
@media (max-width:1200px){ .measures-grid{grid-template-columns:repeat(3,1fr);} }
@media (max-width:820px){ .measures-grid{grid-template-columns:repeat(2,1fr);} }
@media (max-width:480px){ .measures-grid{grid-template-columns:1fr;} }
.measure-card { min-width:0; background:var(--bg-subtle); border:1px solid var(--border-light,#2a3148); border-radius:12px; padding:16px 12px; display:flex; flex-direction:column; align-items:center; text-align:center; gap:7px; }
.measure-ic { width:40px; height:40px; border-radius:10px; flex:none; display:flex; align-items:center; justify-content:center; font-size:1.05rem; background:var(--brand-dim,rgba(124, 108, 255,.15)); color:var(--brand,#7C6CFF); }
.measure-body { min-width:0; max-width:100%; display:flex; flex-direction:column; align-items:center; }
.measure-val { font-size:1.5rem; font-weight:800; color:var(--text-primary); line-height:1.1; font-variant-numeric:tabular-nums; }
.measure-lbl { font-size:.78rem; color:var(--text-secondary); overflow-wrap:anywhere; }
.measure-sub { font-size:.7rem; color:var(--text-muted); overflow-wrap:anywhere; }
/* M-12 : marque les cartes que le périmètre NE borne PAS (le référentiel). */
.measure-chip { margin-top:.3rem; font-size:.63rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase;
    padding:.08rem .4rem; border-radius:999px; border:1px dashed var(--border-light,rgba(255,255,255,.22));
    color:var(--text-muted,#8a93a6); cursor:help; }

/* ═══ Executive information architecture ═══════════════════════════════════
   Progressive disclosure for the exec tab: an always-visible scope line, a
   headline band (health index + decision KPIs) above the fold, collapsible
   low-frequency sections, and folded previews for long inline tables.
   Selectors are exec-scoped so nothing else on the dashboard shifts. */
.exec-scope { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; margin:0 0 1rem;
    padding:.55rem .85rem; border:1px solid var(--border-light,rgba(255,255,255,.12));
    border-left:3px solid var(--text-tertiary,#8a93a6); border-radius:10px;
    background:var(--bg-subtle,rgba(255,255,255,.04)); font-size:.85rem; }
.exec-scope.is-filtered { border-left-color:var(--brand,#7C6CFF); }
.exec-scope > i { color:var(--text-muted,#8a93a6); }
.exec-scope-label { text-transform:uppercase; letter-spacing:.06em; font-size:.7rem; font-weight:700; color:var(--text-muted,#8a93a6); }
.exec-scope-value { font-weight:700; color:var(--text-primary); overflow-wrap:anywhere; }
.exec-scope-hint { margin-left:auto; font-size:.75rem; color:var(--text-muted,#8a93a6); }
/* M-12 (résiduel) : marque un périmètre IMPOSÉ (RBAC), que le lecteur ne choisit
   pas dans les listes — à ne pas confondre avec un filtre appliqué. */
.exec-scope-own { font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
    padding:.1rem .4rem; border-radius:999px; color:var(--text-muted,#8a93a6);
    border:1px solid var(--border-color,rgba(255,255,255,.12)); }
@media (max-width:700px){ .exec-scope-hint { margin-left:0; flex:1 1 100%; } }

.exec-hero { display:grid; grid-template-columns:minmax(240px,320px) minmax(0,1fr); gap:1rem; align-items:stretch; margin-bottom:1rem; }
@media (max-width:900px){ .exec-hero { grid-template-columns:1fr; } }
.exec-hero .risk-gauge-box { max-width:none; min-width:0; }
.exec-hero-kpis { min-width:0; display:flex; flex-direction:column; }
.exec-hero-kpis .kpi-grid { margin-bottom:0; grid-template-columns:repeat(auto-fit,minmax(165px,1fr)); }
/* Assessment provenance — "never assessed" must never read as an honest zero. */
.exec-provenance { margin:.7rem 0 0; padding:.6rem .75rem; font-size:.8rem; line-height:1.45;
    color:var(--text-secondary); border-left:3px solid var(--text-tertiary,#8a93a6); border-radius:8px;
    background:var(--bg-subtle,rgba(255,255,255,.04)); }
.exec-provenance:empty { display:none; }
.exec-provenance.is-blind { border-left-color:var(--warn,#b45309); }
.exec-provenance .prov-label { text-transform:uppercase; letter-spacing:.06em; font-size:.7rem;
    font-weight:700; color:var(--text-muted,#8a93a6); margin-right:.4rem; }
.exec-provenance strong { color:var(--text-primary); }

.prov-badge { display:inline-flex; align-items:center; gap:.25rem; font-size:.68rem; font-weight:700;
    padding:.1rem .4rem; border-radius:999px; border:1px solid var(--border-light,rgba(255,255,255,.18));
    color:var(--text-secondary); white-space:nowrap; }
.prov-badge.never { border-color:var(--warn,#b45309); color:var(--warn,#b45309); }
.prov-badge.self { border-color:var(--info,#4a90d9); color:var(--info,#4a90d9); }
.prov-badge.validated { border-color:var(--success,#2DD4A0); color:var(--success,#2DD4A0); }

/* A required skill nobody has ever rated: dashed frame + em-dash, never a "0". */
.skill-card.prov-never { border-style:dashed !important; opacity:.85; }
.skill-card.prov-never .actual { color:var(--warn,#b45309); font-weight:700; }
.skill-card .prov-mark { font-size:.66rem; font-weight:700; letter-spacing:.04em;
    display:block; margin-top:.15rem; color:var(--text-muted,#8a93a6); }
.skill-card.prov-never .prov-mark { color:var(--warn,#b45309); }
.skill-card.prov-self .prov-mark { color:var(--info,#4a90d9); }
/* A lapsed certificate: the effective level is 0 but it is a caution, not a
   scored 0 — dashed frame and amber mark so it never reads as a passed skill. */
.skill-card.prov-lapsed { border-style:dashed !important; }
.skill-card.prov-lapsed .actual { color:var(--warn,#b45309); font-weight:700; }
.skill-card.prov-lapsed .prov-mark { color:var(--warn,#b45309); }
.detail-stats .prov-stat { color:var(--text-secondary); }
.detail-stats .prov-stat.is-blind { color:var(--warn,#b45309); font-weight:700; }

.exec-trend-caption { margin:.55rem 0 0; font-size:.8rem; color:var(--text-secondary); text-align:center; }
.exec-trend-caption:empty { display:none; }
.exec-trend-caption .delta-up { color:var(--success,#2DD4A0); font-weight:700; }
.exec-trend-caption .delta-down { color:var(--danger,#F06060); font-weight:700; }

/* KPI-card movement chip. Rendered ONLY when a real prior snapshot exists —
   there is deliberately no "0" state for "no history". */
.kpi-delta { display:inline-block; margin-left:.4rem; font-size:.6em; font-weight:700;
    vertical-align:middle; padding:.1rem .4rem; border-radius:999px;
    background:var(--bg-subtle,rgba(255,255,255,.06)); }
.kpi-delta.delta-up { color:var(--success,#2DD4A0); }
.kpi-delta.delta-down { color:var(--danger,#F06060); }
.kpi-delta.delta-flat { color:var(--text-muted,#8a93a6); }
/* J8 — a visible caveat that the delta compared a different measured population. */
.kpi-delta-note { margin-left:.3rem; font-size:.62em; font-weight:600; vertical-align:middle;
    color:var(--text-muted,#8a93a6); cursor:help; }

.exec-disclosure { margin:1.5rem 0; border-top:2px solid rgba(255,255,255,.08); }
.exec-disclosure > summary { list-style:none; cursor:pointer; display:flex; align-items:center; flex-wrap:wrap; gap:.55rem; padding:1rem 0 .55rem; }
.exec-disclosure > summary::-webkit-details-marker { display:none; }
.exec-disclosure > summary:focus-visible { outline:2px solid var(--brand,#7C6CFF); outline-offset:3px; border-radius:6px; }
.exec-disclosure-title { font-size:1.3rem; font-weight:700; color:var(--text-primary,#e0e0e0); }
.exec-disclosure-count { font-size:.75rem; font-weight:700; padding:.14rem .55rem; border-radius:999px;
    background:var(--bg-subtle,rgba(255,255,255,.06)); border:1px solid var(--border-light,rgba(255,255,255,.12)); color:var(--text-secondary); }
.exec-disclosure-chev { margin-left:auto; color:var(--text-muted,#8a93a6); transition:transform .18s ease; }
.exec-disclosure[open] > summary .exec-disclosure-chev { transform:rotate(180deg); }
.exec-disclosure-sub { flex:1 1 100%; margin:0; font-size:.85rem; color:var(--text-muted,#8a93a6); }
.exec-disclosure-body { padding-top:.25rem; min-width:0; }

/* Folded table previews (top-N inline, rest one click away) */
.rowfold-hidden { display:none !important; }
.rowfold-bar { display:flex; align-items:center; flex-wrap:wrap; gap:.6rem; margin:.6rem 0 .1rem; }
.rowfold-note { font-size:.76rem; color:var(--text-muted,#8a93a6); }
.rowfold-toggle { display:inline-flex; align-items:center; gap:.4rem; background:transparent;
    border:1px solid var(--border-light,rgba(255,255,255,.14)); color:var(--text-secondary);
    border-radius:8px; padding:.35rem .7rem; font-size:.8rem; font-weight:600; cursor:pointer; }
.rowfold-toggle:hover { border-color:var(--brand,#7C6CFF); color:var(--text-primary); }
.rowfold-toggle:focus-visible { outline:2px solid var(--brand,#7C6CFF); outline-offset:2px; }
#critical-roles-container, #benchmark-fit-container { overflow-x:auto; }
</style>
<script nonce="<%= cspNonce %>">
(function(){
  var ICON={people:'fa-users',sites:'fa-location-dot',depts:'fa-diagram-project',services:'fa-people-group',roles:'fa-id-badge',
    span:'fa-sitemap',managers:'fa-user-tie',layers:'fa-layer-group',ninebox:'fa-table-cells',coaching:'fa-people-arrows',
    idp:'fa-seedling',pip:'fa-clipboard-check',goals:'fa-bullseye',checkins:'fa-calendar-check',skills:'fa-screwdriver-wrench',domains:'fa-folder-tree'};
  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
  function card(m,chip,hint){
    // M-12 (arbitrage 4b) : une carte qui ne suit PAS le périmètre le porte
    // écrit. Le référentiel de compétences est conçu par les départements et
    // reste celui de toute l'organisation — il n'est jamais réduit.
    var mark = m.framework ? '<span class="measure-chip" title="'+esc(hint)+'">'+esc(chip)+'</span>' : '';
    return '<div class="measure-card"><span class="measure-ic"><i class="fas '+(ICON[m.key]||'fa-gauge')+'" aria-hidden="true"></i></span>'+
      '<span class="measure-body"><span class="measure-val">'+(m.value==null?'—':m.value)+'</span>'+
      '<span class="measure-lbl">'+m.label+'</span>'+(m.sub?'<span class="measure-sub">'+m.sub+'</span>':'')+mark+'</span></div>';
  }
  // M-12 (arbitrage 4a) : la tuile interroge le serveur AVEC le filtre appliqué,
  // comme tous les autres blocs de l'onglet. Elle lisait `/api/dashboard/measures`
  // sans aucun paramètre : la charge était identique octet pour octet avec et sans
  // filtre pendant que le KPI voisin passait de 76 à 17.
  function activeQuery(){
    var q=[]; var ids=[['filter-site','siteName'],['filter-department','departmentName'],['filter-service','serviceName']];
    for(var i=0;i<ids.length;i++){
      var el=document.getElementById(ids[i][0]);
      var v=el&&el.value?String(el.value).trim():'';
      if(v) q.push(encodeURIComponent(ids[i][1])+'='+encodeURIComponent(v));
    }
    return q.length?('?'+q.join('&')):'';
  }
  function load(){
    var box=document.getElementById('measures-grid'); if(!box) return;
    fetch('/api/dashboard/measures'+activeQuery(),{headers:{'Accept':'application/json'}})
      .then(function(r){return r.json();})
      .then(function(d){
        var m=(d&&d.measures)||[];
        var chip=(d&&d.frameworkChip)||'', hint=(d&&d.frameworkHint)||'';
        // M-12 (résiduel) : `scoped` était renvoyé « pour que la vue puisse
        // l'écrire au lieu de l'affirmer » et n'était lu NULLE PART. Il l'est :
        // le bandeau « Périmètre » suit ce que la charge vient de mesurer.
        if (window.Dashboard && typeof window.Dashboard.setMeasuresScoped === 'function') {
          window.Dashboard.setMeasuresScoped(!!(d && d.scoped));
        }
        // Empty state, not the loading class: that one draws a spinning ring, and a
        // ring that turns next to « Aucune mesure disponible. » says the opposite of
        // the text. Same for the error state below (role="alert" so it is announced).
        box.innerHTML = m.length? m.map(function(x){return card(x,chip,hint);}).join('') : '<p class="empty-state">'+<%- JSON.stringify(__('dash:no_measures_available')) %>+'</p>';
        var badge=document.getElementById('measures-count');
        if(badge && m.length){ badge.textContent = m.length; badge.hidden = false; }
      })
      .catch(function(){ box.innerHTML='<p class="empty-state" role="alert">'+<%- JSON.stringify(__('dash:could_not_load_measures')) %>+'</p>'; });
  }
  function bind(){
    load();
    // Les deux boutons sont déjà câblés par dashboard.js ; `addEventListener` est
    // additif. Le rechargement est différé d'une macro-tâche pour que « Réinitialiser »
    // ait FINI de vider les listes déroulantes avant qu'on les relise.
    ['btn-apply-filters','btn-reset-filters'].forEach(function(id){
      var b=document.getElementById(id);
      if(b) b.addEventListener('click', function(){ setTimeout(load,0); });
    });
  }
  if(document.readyState!=='loading') bind(); else document.addEventListener('DOMContentLoaded', bind);
})();
</script>