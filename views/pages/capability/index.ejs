<%# UNE SEULE discipline de reseau pour toute l application :
    public/js/sa-console-net.js. Une reponse REDIRIGEE, non-JSON, 401/440 est
    un ECHEC -- jamais un succes -- et le refus est ecrit dans la langue de la
    page. Charge AVANT le script de la page (non differe) pour que SAConsoleNet
    existe au premier appel. %>
<script src="/js/sa-console-net.js?v=<%= assetVersion %>"></script>
<script nonce="<%= cspNonce %>">
SAConsoleNet.configure(<%- include('../../partials/json-script', { v: {
  err_session: __('talentx:sar_err_session'),
  err_forbidden: __('talentx:sar_err_forbidden'),
  err_notfound: __('talentx:sar_err_notfound'),
  err_server: __('talentx:sar_err_server'),
  err_http: __('talentx:sar_err_http'),
  err_ref: __('talentx:sar_err_ref'),
  err_network: __('talentx:sar_err_network'),
  err_format: __('talentx:sar_err_format'),
  // Titre de la carte de refus : neutre, car ces ecrans ne sont pas la console de
  // revue (sans cela ils affichaient « La file de revue n a pas pu etre chargee »).
  load_failed: __('dash:unable_to_load'),
  pending_failed: __('dash:unable_to_load'),
  retry: __('talentx:sar_retry'),
  relogin: __('talentx:sar_relogin')
} }) %>);
const CAP_T = <%- include('../../partials/json-script', { v: {
  colon: colon,
  thinking: __('talentx:cap_thinking'), aiUnavail: __('talentx:cap_ai_unavail'),
  aiLlm: __('talentx:cap_ai_llm'), aiBuiltin: __('talentx:cap_ai_builtin'),
  aiDisclaimer: __('talentx:cap_ai_disclaimer'),
  basedOn: __('talentx:cap_based_on'), person: __('talentx:cap_person'), people: __('talentx:cap_people'),
  inScope: __('talentx:cap_in_scope'), askError: __('talentx:cap_ask_error'),
  needTitle: __('talentx:cap_need_title'), topMatches: __('talentx:cap_top_matches'),
  noMatch: __('talentx:cap_no_match'), surveyPrompt: __('talentx:cap_survey_title_prompt'),
  surveyDefault: __('talentx:cap_survey_default'), needRec: __('talentx:cap_need_rec'),
  suppressed: __('talentx:cap_suppressed'), responses: __('talentx:cap_responses'),
  noDemo: __('talentx:cap_no_demo'), http: 'HTTP', representation: __('talentx:cap_representation'),
  nineboxGroup: __('talentx:cap_ninebox_group'), pipRate: __('talentx:cap_pip_rate_group'),
  noApplicants: __('talentx:cap_no_applicants'), colName: __('talentx:cap_col_name'), colFit: __('talentx:cap_col_fit'),
  colAppliedOn: __('talentx:cap_col_applied_on'), colStatus: __('talentx:status'), colNote: __('talentx:cap_col_note'),
  accept: __('talentx:cap_accept'), decline: __('talentx:cap_decline'), fitUnmeasured: __('talentx:cap_fit_unmeasured'),
  declineReason: __('talentx:cap_decline_reason_prompt'), acceptNote: __('talentx:cap_accept_note_prompt'),
  closeReason: __('talentx:cap_close_reason_prompt'), fillReason: __('talentx:cap_fill_reason_prompt'),
  reasonRequired: __('talentx:cap_reason_required'),
  appSt: { applied: __('talentx:cap_app_st_applied'), accepted: __('talentx:cap_app_st_accepted'), declined: __('talentx:cap_app_st_declined') },
  qtypes: { scale: __('talentx:cap_qtype_scale'), nps: __('talentx:cap_qtype_nps'), text: __('talentx:cap_qtype_text') },
  qTextPh: __('talentx:cap_q_text_ph'), removeQ: __('talentx:cap_remove_question'), needQuestion: __('talentx:cap_need_question'),
  defaultQs: [
    { text: __('talentx:cap_default_q1'), qtype: 'scale' },
    { text: __('talentx:cap_default_q2'), qtype: 'scale' },
    { text: __('talentx:cap_default_q3'), qtype: 'nps' }
  ],
  templates: (typeof surveyTemplates !== 'undefined' ? surveyTemplates : []),
  templateHint: __('talentx:cap_svy_template_hint'),
  openConfirm: __('talentx:cap_open_survey_confirm'), closeConfirm: __('talentx:cap_close_survey_confirm'),
  invited: __('talentx:cap_survey_invited'), avg: __('talentx:cap_avg'), textAnswers: __('talentx:cap_text_answers')
} }) %>;
// Every value that comes from the server is escaped before it touches innerHTML
// (DEI group labels and survey question texts were written raw: stored XSS).
function capEsc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
const CAP = {
  // L assistant reseau ne se recopie plus ici : il vit dans
  // public/js/sa-console-net.js (SAConsoleNet.call). L ancien corps avalait
  // `r.json` en `{}` ; sur une session expiree le serveur repondait
  // `302 -> /login`, le fetch de navigateur SUIVAIT la redirection, la page de
  // connexion arrivait en `200 text/html`, `r.ok` valait donc true et `j`
  // valait `{}` : le test `if(!r.ok||j.ok===false)` ne voyait rien.
  async api(m,p,b){ try { return await SAConsoleNet.call(p, m, b); } catch(e){ alert(e.message); throw e; } },
  async ask(){ const q=document.getElementById('cop-q').value.trim(); if(!q)return; const out=document.getElementById('cop-a'); out.textContent=CAP_T.thinking; try{
      // SAConsoleNet.call directement (pas this.api) : un echec rend le message
      // en place, sans l alert de l assistant partage.
      // Meme defaut, meme correction que l assistant ci-dessus : le copilote
      // passait par un fetch nu dont le `{}` franchissait `if(!r.ok||j.ok===false)`,
      // et `esc(j.answer)` affichait alors « undefined » comme une reponse.
      // Mesure du 16/09/2026 sur une base de developpement.
      const j=await SAConsoleNet.call('/v2/cap/copilot/ask','POST',{question:q});
      // Show the answer plainly; put provenance in a subtle muted line (no raw error, no dev "[scope N]").
      const esc=s=>String(s==null?'':s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
      const src = j.mode==='fallback' ? CAP_T.aiUnavail : j.mode==='llm' ? CAP_T.aiLlm : CAP_T.aiBuiltin;
      const note = CAP_T.basedOn+' '+(j.scope||0)+' '+((j.scope===1)?CAP_T.person:CAP_T.people)+' '+CAP_T.inScope+' · '+src;
      // EU AI Act transparency: every answer is labelled as AI-generated decision support.
      const label = j.disclaimer || CAP_T.aiDisclaimer;
      out.innerHTML = '<div class="cop-ai-label" role="note" style="font-size:.75em;font-weight:600;margin-bottom:.3rem"><i class="fas fa-robot" aria-hidden="true"></i> '+esc(label)+'</div><div>'+esc(j.answer)+'</div><div class="text-muted" style="font-size:.72em;margin-top:.4rem">'+esc(note)+'</div>';
    // Le refus du catalogue dit POURQUOI (session, perimetre, reseau) et il est
    // dans la langue de la page ; CAP_T.askError ne reste que pour une erreur
    // sans code stable.
    }catch(e){ out.textContent=(e&&e.code&&e.message)?e.message:CAP_T.askError; } },
  quickAsk(q){ document.getElementById('cop-q').value=q; this.ask(); },
  async newCalibration(){ await this.api('POST','/v2/cap/calibration',{scopeType:'org'}); location.reload(); },
  async newObjective(){ const t=document.getElementById('obj-title').value.trim(); if(!t){alert(CAP_T.needTitle);return;} await this.api('POST','/v2/cap/objective',{level:document.getElementById('obj-level').value,title:t,period:document.getElementById('obj-period').value||null}); location.reload(); },
  async newOpportunity(){ const t=document.getElementById('opp-title').value.trim(); if(!t){alert(CAP_T.needTitle);return;} await this.api('POST','/v2/cap/opportunity',{kind:document.getElementById('opp-kind').value,title:t,skillsSought:[],closesOn:document.getElementById('opp-closes').value||null}); location.reload(); },
  async match(id){ const j=await this.api('GET','/v2/cap/opportunity/'+id+'/match'); document.getElementById('opp-match').textContent=j.candidates.length?(CAP_T.topMatches+' '+j.candidates.slice(0,5).map(c=>'#'+c.employeeId+' '+c.matchPct+'%').join(', ')):CAP_T.noMatch; },
  // Applicants of one posting: name, fit, date, status, and the decision.
  async applicants(id){
    const box=document.getElementById('opp-applicants');
    const j=await this.api('GET','/v2/cap/opportunity/'+id+'/applicants');
    const list=j.applicants||[];
    if(!list.length){ box.innerHTML='<em class="text-muted">'+capEsc(CAP_T.noApplicants)+'</em>'; return; }
    const lang=document.documentElement.lang||'fr';
    const d=s=>{ if(!s) return '—'; const x=new Date(s); return isNaN(x.getTime())?'—':x.toLocaleDateString(lang); };
    box.innerHTML='<table class="table"><thead><tr><th>'+capEsc(CAP_T.colName)+'</th><th>'+capEsc(CAP_T.colFit)+'</th><th>'+capEsc(CAP_T.colAppliedOn)+'</th><th>'+capEsc(CAP_T.colStatus)+'</th><th>'+capEsc(CAP_T.colNote)+'</th><th></th></tr></thead><tbody>'
      + list.map(a=>'<tr><td>'+capEsc(a.name)+'</td>'
        // Fit is null — not 0 — when it cannot be measured.
        + '<td>'+(a.fitPct==null?'<span class="text-muted">'+capEsc(CAP_T.fitUnmeasured)+'</span>':capEsc(a.fitPct)+'%')+'</td>'
        + '<td>'+capEsc(d(a.appliedAt))+'</td>'
        + '<td><span class="badge">'+capEsc((CAP_T.appSt||{})[a.status]||a.status)+'</span>'+(a.decisionNote?'<div class="text-muted" style="font-size:.8em">'+capEsc(a.decisionNote)+'</div>':'')+'</td>'
        + '<td style="max-width:260px;font-size:.85em">'+capEsc(a.note||'')+'</td>'
        + '<td style="white-space:nowrap">'+(a.status==='applied'
            ? '<button class="btn btn-sm btn-success" data-app="'+Number(a.id)+'" data-dec="accepted" data-opp="'+Number(id)+'">'+capEsc(CAP_T.accept)+'</button> '
            + '<button class="btn btn-sm btn-secondary" data-app="'+Number(a.id)+'" data-dec="declined" data-opp="'+Number(id)+'">'+capEsc(CAP_T.decline)+'</button>'
            : '')+'</td></tr>').join('')
      + '</tbody></table>';
    box.querySelectorAll('button[data-app]').forEach(b=>{ b.onclick=()=>CAP.decide(Number(b.dataset.app), b.dataset.dec, Number(b.dataset.opp)); });
  },
  async decide(appId, decision, oppId){
    const note=await window.promptDialog(decision==='declined'?CAP_T.declineReason:CAP_T.acceptNote,'');
    if(note===null) return;
    if(decision==='declined' && !String(note).trim()){ alert(CAP_T.reasonRequired); return; }
    const j=await this.api('POST','/v2/cap/opportunity/application/'+appId+'/decide',{decision:decision,note:String(note||'').trim()||null});
    if(j && j.ok===false && j.reason){ alert(j.reason); }
    await this.applicants(oppId);
  },
  async oppState(id, state){
    const reason=await window.promptDialog(state==='filled'?CAP_T.fillReason:CAP_T.closeReason,'');
    if(reason===null) return;
    if(!String(reason).trim()){ alert(CAP_T.reasonRequired); return; }
    await this.api('POST','/v2/cap/opportunity/'+id+'/state',{state:state,reason:String(reason).trim()});
    location.reload();
  },
  // --- Survey builder (FR-first default questions come from the locale) ---
  newSurvey(){
    const b=document.getElementById('svy-builder');
    document.getElementById('svy-title').value=CAP_T.surveyDefault||'';
    const qs=document.getElementById('svy-questions'); qs.textContent='';
    (CAP_T.defaultQs||[]).forEach(q=>this.addQuestion(q));
    const sel=document.getElementById('svy-template'); if(sel) sel.value='';
    const d=document.getElementById('svy-template-desc'); if(d) d.textContent=CAP_T.templateHint||'';
    b.hidden=false; document.getElementById('svy-title').focus();
  },
  // "Start from a template": fills title, type and questions (all still editable).
  applyTemplate(id){
    const t=(CAP_T.templates||[]).find(x=>x.id===id);
    const d=document.getElementById('svy-template-desc');
    const qs=document.getElementById('svy-questions'); qs.textContent='';
    if(!t){ document.getElementById('svy-title').value=CAP_T.surveyDefault||''; (CAP_T.defaultQs||[]).forEach(q=>this.addQuestion(q)); if(d) d.textContent=CAP_T.templateHint||''; return; }
    document.getElementById('svy-title').value=t.title||'';
    const k=document.getElementById('svy-kind'); if(k) k.value=t.kind;
    (t.questions||[]).forEach(q=>this.addQuestion(q));
    if(d) d.textContent=t.description||'';
  },
  addQuestion(q){
    q=q||{text:'',qtype:'scale'};
    const row=document.createElement('div'); row.className='svy-q'; if(q.category) row.dataset.category=q.category; row.style.cssText='display:flex;gap:.4rem;margin:.3rem 0;flex-wrap:wrap';
    const t=document.createElement('input'); t.className='form-control svy-q-text'; t.maxLength=500; t.placeholder=CAP_T.qTextPh; t.value=q.text||''; t.style.cssText='flex:1;min-width:220px'; t.setAttribute('aria-label',CAP_T.qTextPh);
    const s=document.createElement('select'); s.className='form-control svy-q-type'; s.style.width='auto';
    ['scale','nps','text'].forEach(k=>{ const o=document.createElement('option'); o.value=k; o.textContent=(CAP_T.qtypes||{})[k]||k; if(k===q.qtype) o.selected=true; s.appendChild(o); });
    const rm=document.createElement('button'); rm.type='button'; rm.className='btn btn-sm btn-link'; rm.textContent=CAP_T.removeQ; rm.onclick=()=>row.remove();
    row.append(t,s,rm); document.getElementById('svy-questions').appendChild(row);
  },
  async createSurvey(){
    const title=document.getElementById('svy-title').value.trim(); if(!title){ alert(CAP_T.needTitle); return; }
    const questions=[...document.querySelectorAll('#svy-questions .svy-q')].map(r=>({text:r.querySelector('.svy-q-text').value.trim(),qtype:r.querySelector('.svy-q-type').value,category:r.dataset.category||null})).filter(q=>q.text);
    if(!questions.length){ alert(CAP_T.needQuestion); return; }
    const min=Math.max(5,parseInt(document.getElementById('svy-min').value,10)||5);
    await this.api('POST','/v2/cap/survey',{kind:document.getElementById('svy-kind').value,title:title,anonymous:document.getElementById('svy-anon').checked,minResponses:min,questions:questions});
    location.reload();
  },
  async surveyOpen(id){ if(window.confirmDialog && !(await window.confirmDialog(CAP_T.openConfirm))) return; const j=await this.api('POST','/v2/cap/survey/'+id+'/open'); if(j && j.invited!=null) alert(String(CAP_T.invited).replace('{{n}}', j.invited)); location.reload(); },
  async surveyClose(id){ if(window.confirmDialog && !(await window.confirmDialog(CAP_T.closeConfirm))) return; await this.api('POST','/v2/cap/survey/'+id+'/close'); location.reload(); },
  async surveyResults(id){
    const j=await this.api('GET','/v2/cap/survey/'+id+'/results');
    document.getElementById('survey-results').innerHTML=(j.results||[]).map(r=>{
      if(r.suppressed) return capEsc(r.text)+CAP_T.colon+' '+capEsc(CAP_T.suppressed)+' ('+capEsc(r.responses)+' '+capEsc(CAP_T.responses)+')';
      if(r.qtype==='text') return '<strong>'+capEsc(r.text)+'</strong> — '+capEsc(CAP_T.textAnswers)+' ('+capEsc(r.responses)+')<ul style="margin:.2rem 0 .4rem">'+(r.answers||[]).map(a=>'<li>'+capEsc(a)+'</li>').join('')+'</ul>';
      return capEsc(r.text)+CAP_T.colon+' '+capEsc(CAP_T.avg)+' '+capEsc(r.avgScore==null?'—':r.avgScore)+(r.enps!=null?(' · eNPS '+capEsc(r.enps)):'');
    }).join('<br>');
  },
  async give(){ const to=Number(document.getElementById('rec-to').value); const msg=document.getElementById('rec-msg').value.trim(); if(!to||!msg){alert(CAP_T.needRec);return;} await this.api('POST','/v2/cap/recognition',{toEmployeeId:to,valueTag:document.getElementById('rec-tag').value||null,message:msg}); location.reload(); },
  async dei(){ const j=await this.api('GET','/v2/cap/dei/representation?dim='+encodeURIComponent(document.getElementById('dei-dim').value)); document.getElementById('dei-out').innerHTML='<strong>'+capEsc(CAP_T.representation)+':</strong> '+j.data.map(d=>d.suppressed?(capEsc(d.grp)+': '+capEsc(CAP_T.suppressed)):(capEsc(d.grp)+': '+capEsc(d.n))).join(' · '); },
  async deiNineBox(){ const j=await this.api('GET','/v2/cap/dei/ninebox?dim='+encodeURIComponent(document.getElementById('dei-dim').value)); document.getElementById('dei-out').innerHTML='<strong>'+capEsc(CAP_T.nineboxGroup)+':</strong> '+(j.data.length?j.data.map(d=>d.suppressed?(capEsc(d.grp)+'/'+capEsc(d.box)+': '+capEsc(CAP_T.suppressed)):(capEsc(d.grp)+'/'+capEsc(d.box)+': '+capEsc(d.n))).join(' · '):capEsc(CAP_T.noDemo)); },
  async deiPip(){ const j=await this.api('GET','/v2/cap/dei/piprate?dim='+encodeURIComponent(document.getElementById('dei-dim').value)); document.getElementById('dei-out').innerHTML='<strong>'+capEsc(CAP_T.pipRate)+':</strong> '+(j.data.length?j.data.map(d=>d.suppressed?(capEsc(d.grp)+': '+capEsc(CAP_T.suppressed)):(capEsc(d.grp)+': '+capEsc(d.pipRatePct)+'%')).join(' · '):capEsc(CAP_T.noDemo)); }
};
</script>
