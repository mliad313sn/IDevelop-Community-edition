<!-- ===================== DEI ===================== -->
<% if (_cm('talent')) { %>
<div class="card" style="padding:1rem">
  <h3 style="margin-top:0"><%= __('talentx:cap_dei') %> <span class="text-muted" style="font-size:.7em"><%= __('talentx:cap_dei_suppressed') %></span></h3>
  <div style="display:flex;gap:.5rem;align-items:flex-end">
    <div><label for="dei-dim"><%= __('talentx:cap_dimension') %></label><br><select id="dei-dim" class="form-control"><option value="gender"><%= __('talentx:cap_dim_gender') %></option><option value="ethnicity"><%= __('talentx:cap_dim_ethnicity') %></option><option value="age_band"><%= __('talentx:cap_dim_age_band') %></option><option value="nationality"><%= __('talentx:cap_dim_nationality') %></option></select></div>
