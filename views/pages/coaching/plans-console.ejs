<div class="page-header">
  <h1><i class="fas fa-people-arrows" aria-hidden="true"></i> <%= __('coaching:cm_title') %></h1>
  <p class="text-muted"><%= __('coaching:cm_intro') %></p>
</div>

<%# The console on IDevelop's tokens: no inline style; each table sits in a
    .table-wrapper and becomes labelled cards on a phone (the card's
    overflow:hidden clipped it at 390 px); the « Start a plan » dialog is a
    native <dialog> (Escape, focus kept inside, focus back to the opener), every
    label points at its control and the required marker is drawn by the design
    system; validating a plan asks first, with a verb on the button. %>
<div class="cp-tabs" role="tablist" aria-label="<%= __('coaching:cm_title') %>">
  <button type="button" class="btn btn-primary" id="cp-tab-roster" role="tab" aria-selected="true" aria-controls="cp-roster-panel" data-on-click="CP.show" data-args='["roster"]'><%= __('coaching:tab_my_people') %></button>
  <button type="button" class="btn btn-secondary" id="cp-tab-plans" role="tab" aria-selected="false" aria-controls="cp-plans-panel" data-on-click="CP.show" data-args='["plans"]'><%= __('coaching:tab_plans') %></button>
</div>

<!-- ROSTER -->
<section id="cp-roster-panel" class="card cp-panel" role="tabpanel" aria-labelledby="cp-tab-roster">
  <div class="cp-panel-head">
    <h2 class="cp-panel-title"><%= __('coaching:roster_heading') %></h2>
    <label class="sr-only" for="cp-search"><%= __('coaching:filter_label') %></label>
    <input id="cp-search" type="search" class="form-control cp-search" placeholder="<%= __('coaching:search_placeholder') %>" data-on-input="CP.renderRoster" data-args='[]'>
  </div>
  <div class="table-wrapper">
    <table class="table table-cards" id="cp-roster">
      <thead><tr>
        <th scope="col"><%= __('common:employee') %></th>
        <th scope="col"><%= __('coaching:th_role') %></th>
        <th scope="col"><%= __('coaching:th_service_site') %></th>
        <th scope="col"><%= __('coaching:th_active_plans') %></th>
        <th scope="col" class="col-actions"><%= __('coaching:th_action') %></th>
      </tr></thead>
      <tbody id="cp-roster-body"><tr><td colspan="5"><%- include('../../partials/skeleton', { rows: 3, cols: 4, table: true }) %></td></tr></tbody>
    </table>
  </div>
  <p class="cp-count text-muted" id="cp-roster-count" aria-live="polite"></p>
</section>

<!-- PLANS -->
<section id="cp-plans-panel" role="tabpanel" aria-labelledby="cp-tab-plans" hidden>
  <div class="card cp-panel cp-monitor" id="cp-monitor"><h2 class="cp-panel-title"><%= __('coaching:monitor') %></h2> <span id="cp-monitor-body"><%- include('../../partials/skeleton', { rows: 1, compact: true }) %></span></div>
  <div class="card cp-panel">
    <div class="table-wrapper">
      <table class="table table-cards" id="cp-table">
        <thead><tr>
          <th scope="col"><%= __('common:employee') %></th>
          <th scope="col"><%= __('coaching:kind') %></th>
          <th scope="col"><%= __('common:title') %></th>
          <th scope="col"><%= __('coaching:th_context') %></th>
          <th scope="col"><%= __('coaching:th_target') %></th>
          <th scope="col"><%= __('coaching:th_state') %></th>
          <th scope="col"><%= __('coaching:th_progress') %></th>
          <th scope="col" class="col-actions"><%= __('common:actions') %></th>
        </tr></thead>
        <tbody><tr><td colspan="8"><%- include('../../partials/skeleton', { rows: 3, cols: 5, table: true }) %></td></tr></tbody>
      </table>
    </div>
  </div>
</section>

<!-- CREATE PLAN DIALOG -->
<dialog id="cp-modal" class="cp-dialog" aria-labelledby="cp-modal-title">
  <form method="dialog" class="cp-dialog-body" id="cp-form" novalidate>
    <div class="cp-dialog-head">
      <h2 id="cp-modal-title"><%= __('coaching:modal_title_prefix') %> <span id="cp-modal-name"></span></h2>
      <button type="button" class="btn btn-secondary cp-dialog-close" data-on-click="CP.closeModal" data-args='[]' aria-label="<%= __('coaching:modal_close') %>"><i class="fas fa-xmark" aria-hidden="true"></i></button>
    </div>
    <input type="hidden" id="cp-emp">
    <%- include('../../partials/form-legend') %>
    <div class="form-field">
      <label class="form-field-label" for="cp-kind"><%= __('coaching:type') %></label>
      <select id="cp-kind" class="form-control" aria-describedby="cp-kind-hint">
        <option value="coaching"><%= __('coaching:kind_coaching') %></option>
        <option value="mentoring"><%= __('coaching:kind_mentoring') %></option>
      </select>
      <p class="form-field-hint" id="cp-kind-hint"><%= __('coaching:kind_hint') %></p>
    </div>
    <div class="form-field">
      <label class="form-field-label is-required" for="cp-context"><%= __('coaching:context_label') %></label>
      <select id="cp-context" class="form-control" required aria-describedby="cp-context-hint cp-error"><option value=""><%= __('coaching:context_loading') %></option></select>
      <p id="cp-context-hint" class="form-field-hint"><%= __('coaching:context_help_small') %> <%= __('coaching:context_hint') %></p>
    </div>
    <p id="cp-error" class="form-field-error" role="alert" hidden></p>
    <div class="form-field"><label class="form-field-label is-required" for="cp-title"><%= __('coaching:title_label') %></label><input id="cp-title" class="form-control" required maxlength="200" placeholder="<%= __('coaching:title_ph') %>" aria-describedby="cp-error"></div>
    <div class="form-field"><label class="form-field-label" for="cp-obj"><%= __('coaching:objective_label') %></label><input id="cp-obj" class="form-control" placeholder="<%= __('coaching:objective_ph') %>"></div>
    <div class="form-field"><label class="form-field-label" for="cp-out"><%= __('coaching:outcome_label') %></label><input id="cp-out" class="form-control" placeholder="<%= __('coaching:outcome_ph') %>"></div>
    <div class="form-field"><label class="form-field-label" for="cp-target"><%= __('coaching:target_date_label') %></label><input id="cp-target" class="form-control" type="date"></div>
    <div class="cp-dialog-foot">
      <button type="button" class="btn btn-secondary" data-on-click="CP.closeModal" data-args='[]'><%= __('coaching:cancel_dialog') %></button>
      <button type="button" class="btn btn-primary" data-on-click="CP.create" data-args='[]'><%= __('coaching:create_plan') %></button>
    </div>
  </form>
</dialog>

<style nonce="<%= cspNonce %>">
.cp-tabs{display:flex;flex-wrap:wrap;gap:var(--space-2);margin-bottom:var(--space-4)}
.cp-tabs .btn{min-height:44px}
.cp-panel{padding:0}
.cp-panel-head{display:flex;flex-wrap:wrap;gap:var(--space-3);justify-content:space-between;align-items:center;padding:var(--space-3) var(--space-4);border-bottom:1px solid var(--border)}
.cp-panel-title{margin:0;font-size:1rem}
.cp-search{max-width:280px;min-height:44px}
.cp-count{margin:0;padding:var(--space-2) var(--space-4);font-size:.8rem}
.cp-monitor{padding:var(--space-4);margin-bottom:var(--space-4);display:flex;flex-wrap:wrap;gap:var(--space-2);align-items:center}
.cp-monitor .cp-panel-title{margin-right:var(--space-2)}
.cp-sub{display:block;color:var(--text-muted);font-size:.78rem}
.cp-empty{padding:var(--space-4)}
#cp-roster .col-actions .btn,#cp-table .col-actions .btn{min-height:44px}
.cp-dialog{border:1px solid var(--border);border-radius:var(--radius-lg);padding:0;width:min(480px,calc(100vw - 2 * var(--space-4)));max-height:calc(100vh - 2 * var(--space-4));background:var(--bg-card);color:var(--text-primary);box-shadow:var(--shadow-lg)}
.cp-dialog::backdrop{background:rgba(0,0,0,.55)}
.cp-dialog-body{padding:var(--space-5)}
.cp-dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-3);margin-bottom:var(--space-3)}
.cp-dialog-head h2{margin:0;font-size:1.1rem}
.cp-dialog-close{min-width:44px;min-height:44px;justify-content:center}
.cp-dialog-foot{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:var(--space-2);margin-top:var(--space-4)}
.cp-dialog-foot .btn{min-height:44px}
@media (max-width:767.98px){
  .cp-search{max-width:none;width:100%}
  .cp-dialog-foot .btn{flex:1 1 auto;justify-content:center}
}
</style>

<%# UNE SEULE discipline de reseau pour toute l application :
    public/js/sa-console-net.js. Une reponse REDIRIGEE, non-JSON, 401/440 est
    un ECHEC -- jamais un succes -- et le refus est ecrit dans la langue de la
    page. Charge AVANT le script de la page (non differe) pour que SAConsoleNet
    existe au premier appel. %>
<script src="/js/sa-console-net.js?v=<%= assetVersion %>"></script>
<script nonce="<%= cspNonce %>">
SAConsoleNet.configure(<%- include('../../partials/json-script', { v: {
  err_session: __('talentx:sar_err_session'),
  err_forbidden: __('talentx:sar_err_forbidden'),
  err_notfound: __('talentx:sar_err_notfound'),
  err_server: __('talentx:sar_err_server'),
  err_http: __('talentx:sar_err_http'),
  err_ref: __('talentx:sar_err_ref'),
  err_network: __('talentx:sar_err_network'),
  err_format: __('talentx:sar_err_format'),
  // Titre de la carte de refus : neutre, car ces ecrans ne sont pas la console de
  // revue (sans cela ils affichaient « La file de revue n a pas pu etre chargee »).
  load_failed: __('dash:unable_to_load'),
  pending_failed: __('dash:unable_to_load'),
  retry: __('talentx:sar_retry'),
  relogin: __('talentx:sar_relogin')
} }) %>);
const CP_T = {
  loading: <%- JSON.stringify(__('coaching:context_loading')) %>,
  noEmployees: <%- JSON.stringify(__('coaching:no_employees')) %>,
  activeSuffix: <%- JSON.stringify(__('coaching:active_suffix')) %>,
  none: <%- JSON.stringify(__('coaching:none')) %>,
  startPlan: <%- JSON.stringify(__('coaching:start_plan')) %>,
  rosterCount: <%- JSON.stringify(__('coaching:roster_count')) %>,
  ctxSelect: <%- JSON.stringify(__('coaching:ctx_select')) %>,
  ctxGaps: <%- JSON.stringify(__('coaching:ctx_gaps')) %>,
  ctxLevel: <%- JSON.stringify(__('coaching:ctx_level')) %>,
  ctxCritical: <%- JSON.stringify(__('coaching:ctx_critical')) %>,
  ctxIdps: <%- JSON.stringify(__('coaching:ctx_idps')) %>,
  ctxPips: <%- JSON.stringify(__('coaching:ctx_pips')) %>,
  ctxNone: <%- JSON.stringify(__('coaching:ctx_none')) %>,
  ctxFailed: <%- JSON.stringify(__('coaching:ctx_failed')) %>,
  errPickContext: <%- JSON.stringify(__('coaching:err_pick_context')) %>,
  errTitleRequired: <%- JSON.stringify(__('coaching:err_title_required')) %>,
  toastCreated: <%- JSON.stringify(__('coaching:toast_created')) %>,
  noPlans: <%- JSON.stringify(__('coaching:no_plans')) %>,
  promptSessionNote: <%- JSON.stringify(__('coaching:prompt_session_note')) %>,
  btnNote: <%- JSON.stringify(__('coaching:btn_note')) %>,
  confirmValidate: <%- include('../../partials/json-script', { v: { title: __('coaching:confirm_validate_title'), body: __('coaching:confirm_validate_body'), yes: __('coaching:confirm_validate_yes'), no: __('common:cancel') } }) %>,
  th: <%- include('../../partials/json-script', { v: { employee: __('common:employee'), role: __('coaching:th_role'), serviceSite: __('coaching:th_service_site'), activePlans: __('coaching:th_active_plans'), kind: __('coaching:kind'), title: __('common:title'), context: __('coaching:th_context'), target: __('coaching:th_target'), state: __('coaching:th_state'), progress: __('coaching:th_progress'), actions: __('common:actions') } }) %>,
  btnValidate: <%- JSON.stringify(__('coaching:btn_validate')) %>,
  btnCancel: <%- JSON.stringify(__('coaching:btn_cancel')) %>,
  monitorOverdue: <%- JSON.stringify(__('coaching:monitor_overdue')) %>,
  st: <%- include('../../partials/json-script', { v: { draft: __('coaching:st_draft'), active: __('coaching:st_active'), completed: __('coaching:st_completed'), cancelled: __('coaching:st_cancelled') } }) %>,
  kind: <%- include('../../partials/json-script', { v: { coaching: __('coaching:kind_coaching'), mentoring: __('coaching:kind_mentoring') } }) %>,
  promptCancelReason: <%- JSON.stringify(__('coaching:prompt_cancel_reason')) %>,
  cancelRequested: <%- JSON.stringify(__('coaching:cancel_requested')) %>
};
const CP = {
  roster:[],
  lbl(map,v){ return (map && map[v]) || v || ''; },
  // L assistant reseau ne se recopie plus ici : il vit dans
  // public/js/sa-console-net.js (SAConsoleNet.call). L ancien corps avalait
  // `r.json` en `{}` ; sur une session expiree le serveur repondait
  // `302 -> /login`, le fetch de navigateur SUIVAIT la redirection, la page de
  // connexion arrivait en `200 text/html`, `r.ok` valait donc true et `j`
  // valait `{}` : le test `if(!r.ok||j.ok===false)` ne voyait rien.
  // Mesure du 16/09/2026 : create enchainait sur un toast VERT « Plan de coaching cree » pendant que coaching_plans restait a 0 avant / 0 apres.
  async api(p,m,b){ try { return await SAConsoleNet.call(p,m,b); } catch(e){ this.toast(e.message,'error'); throw e; } },

  // The ONE toast of the product (public/js/ui-feedback.js).
  toast(msg,type){ if (typeof window.toast === 'function') window.toast(msg, type || 'info'); },
  fieldError(msg,focusId){const e=document.getElementById('cp-error');e.textContent=msg;e.hidden=false;if(focusId){const f=document.getElementById(focusId);if(f){f.setAttribute('aria-invalid','true');f.focus();f.addEventListener('change',()=>f.removeAttribute('aria-invalid'),{once:true});}}},
  clearError(){const e=document.getElementById('cp-error');e.hidden=true;e.textContent='';['cp-context','cp-title'].forEach(id=>{const f=document.getElementById(id);if(f)f.removeAttribute('aria-invalid');});},

  show(which){
    const roster = which==='roster';
    document.getElementById('cp-roster-panel').hidden = !roster;
    document.getElementById('cp-plans-panel').hidden  = roster;
    const tr=document.getElementById('cp-tab-roster'), tp=document.getElementById('cp-tab-plans');
    tr.className='btn '+(roster?'btn-primary':'btn-secondary'); tr.setAttribute('aria-selected', roster?'true':'false');
    tp.className='btn '+(roster?'btn-secondary':'btn-primary'); tp.setAttribute('aria-selected', roster?'false':'true');
    if(!roster) this.load();
  },

  // roster
  async loadRoster(){ const j=await this.api('/api/coaching/roster'); this.roster=j.employees||[]; this.renderRoster(); },
  renderRoster(){
    const q=(document.getElementById('cp-search').value||'').toLowerCase();
    const rows=this.roster.filter(e=>!q||((e.firstName+' '+e.lastName+' '+(e.roleName||'')+' '+(e.serviceName||'')+' '+(e.employeeNumber||'')).toLowerCase().includes(q)));
    const body=document.getElementById('cp-roster-body');
    const T=CP_T.th;
    if(!rows.length){ body.innerHTML='<tr><td class="text-muted cp-empty" colspan="5">'+esc(CP_T.noEmployees)+'</td></tr>'; document.getElementById('cp-roster-count').textContent=''; return; }
    body.innerHTML=rows.map(e=>'<tr>'+
      '<td data-label="'+esc(T.employee)+'"><strong>'+esc(e.firstName+" "+e.lastName)+'</strong><span class="cp-sub">'+esc(e.employeeNumber||'')+'</span></td>'+
      '<td data-label="'+esc(T.role)+'">'+esc(e.roleName||'—')+'</td>'+
      '<td data-label="'+esc(T.serviceSite)+'" class="text-muted">'+esc((e.serviceName||'—')+' · '+(e.siteName||'—'))+'</td>'+
      '<td data-label="'+esc(T.activePlans)+'">'+(e.planCount?cpBadge('info', CP_T.activeSuffix, e.planCount):'<span class="text-muted">'+esc(CP_T.none)+'</span>')+'</td>'+
      '<td class="col-actions" data-label="'+esc(T.actions)+'">'+
        '<button class="btn btn-sm btn-primary" data-emp="'+esc(e.employeeId)+'" data-name="'+esc(e.firstName+" "+e.lastName)+'"'+cpOn('click','CP.startBtn',['$el'])+'><i class="fas fa-people-arrows" aria-hidden="true"></i> '+esc(CP_T.startPlan)+'</button>'+
      '</td></tr>').join('');
    document.getElementById('cp-roster-count').textContent=CP_T.rosterCount.replace('{{shown}}',rows.length).replace('{{total}}',this.roster.length);
  },

  // The employee travels on data- attributes and is read back through dataset.
  // It used to be spliced into an inline click handler CP.start(id,'coaching','NAME') behind
  // esc(name).replace(/'/g,...) - a no-op, because esc() had already turned the
  // quote into &#39;, which the HTML parser decodes back BEFORE the handler is
  // compiled: a first name  x');alert(1);//  ran for every manager opening this
  // page, and O'Brien threw a SyntaxError. Never put a value in a JS string
  // inside an HTML attribute.
  startBtn(btn){ this._opener = btn; this.start(Number(btn.dataset.emp),'coaching',btn.dataset.name||''); },

  // dialog: a native <dialog>; showModal() keeps the focus inside, Escape
  // closes it (the `cancel` event), the focus goes back to the opener.
  start(empId,kind,name){
    document.getElementById('cp-emp').value=empId;
    document.getElementById('cp-kind').value=kind||'coaching';
    document.getElementById('cp-modal-name').textContent=name;
    ['cp-title','cp-obj','cp-out','cp-target'].forEach(id=>document.getElementById(id).value='');
    this.clearError();
    this.loadContext(empId);
    const dlg=document.getElementById('cp-modal');
    if(typeof dlg.showModal==='function'){ if(!dlg.open) dlg.showModal(); } else { dlg.setAttribute('open',''); }
    const first=document.getElementById('cp-kind'); if(first) first.focus();
  },
  async loadContext(empId){
    const sel=document.getElementById('cp-context');
    sel.innerHTML='<option value="">'+esc(CP_T.loading)+'</option>';
    try{
      const {options}=await this.api('/api/coaching/context/'+empId);
      const g=options.gaps||[], idps=options.idps||[], pips=options.pips||[];
      let html='<option value="">'+esc(CP_T.ctxSelect)+'</option>';
      if(g.length) html+='<optgroup label="'+esc(CP_T.ctxGaps)+'">'+g.map(x=>'<option value="skill_gap:'+x.skillId+'">'+esc(x.skillName)+' ('+esc(CP_T.ctxLevel)+' '+x.current+'→'+x.required+(x.isCritical?', '+esc(CP_T.ctxCritical):'')+')</option>').join('')+'</optgroup>';
      if(idps.length) html+='<optgroup label="'+esc(CP_T.ctxIdps)+'">'+idps.map(p=>'<option value="idp:'+p.id+'">IDP #'+p.id+' — '+esc(p.status)+' ('+esc(p.priority)+')</option>').join('')+'</optgroup>';
      if(pips.length) html+='<optgroup label="'+esc(CP_T.ctxPips)+'">'+pips.map(p=>'<option value="pip:'+p.id+'">PIP #'+p.id+' — '+esc(p.state)+'</option>').join('')+'</optgroup>';
      if(!(g.length||idps.length||pips.length)) html='<option value="">'+esc(CP_T.ctxNone)+'</option>';
      sel.innerHTML=html;
    }catch(e){ sel.innerHTML='<option value="">'+esc(CP_T.ctxFailed)+'</option>'; }
  },
  closeModal(){ this.clearError(); const dlg=document.getElementById('cp-modal'); if(dlg.open && typeof dlg.close==='function') dlg.close(); else dlg.removeAttribute('open'); },
  async create(){
    this.clearError();
    const ctxRaw=document.getElementById('cp-context').value;
    if(!ctxRaw){this.fieldError(CP_T.errPickContext,'cp-context');return;}
    const body={employeeId:Number(document.getElementById('cp-emp').value),kind:document.getElementById('cp-kind').value,title:document.getElementById('cp-title').value,objective:document.getElementById('cp-obj').value,expectedOutcome:document.getElementById('cp-out').value,targetDate:document.getElementById('cp-target').value||null};
    if(!body.title.trim()){this.fieldError(CP_T.errTitleRequired,'cp-title');return;}
    const sep=ctxRaw.indexOf(':');const contextType=ctxRaw.slice(0,sep);const ctxId=Number(ctxRaw.slice(sep+1));
    body.contextType=contextType;
    if(contextType==='idp')body.idpId=ctxId; else if(contextType==='pip')body.pipId=ctxId; else if(contextType==='skill_gap')body.skillId=ctxId;
    const created=await this.api('/api/coaching','POST',body);
    // « Cree » seulement sur la PREUVE renvoyee par le serveur (le plan), jamais
    // sur la seule absence d erreur : `{}` n est pas une preuve.
    if(!SAConsoleNet.confirmed(created,'plan')){ this.toast(SAConsoleNet.t('err_format'),'error'); return; }
    this.toast(CP_T.toastCreated,'success');
    this.closeModal();
    await this.loadRoster();
  },

  // Cancel button: the plan kind travels on data-kind, read back here (was
  // CP.act(id,'cancel',this.dataset.kind) inline).
  cancelBtn(btn,id){ return this.act(id,'cancel',btn.dataset.kind); },
  async act(id,action,kind){
    const ask=window.promptDialog;
    if(action==='session'){const n=await ask(CP_T.promptSessionNote);if(n!==null&&n.trim())await this.api('/api/coaching/'+id+'/session','POST',{note:n});}
    if(action==='validate'){
      // A validation closes the plan: it is confirmed first, with a verb on the button.
      const C=CP_T.confirmValidate;
      const ok=typeof window.confirmDialog==='function'
        ? await window.confirmDialog({ title:C.title, body:C.body, confirmLabel:C.yes, cancelLabel:C.no })
        : false;
      if(!ok) return;
      await this.api('/api/coaching/'+id+'/validate','POST',{});
    }
    if(action==='cancel'){
      // Cancellation is a governed action (two-person rule): request it, a local
      // admin approves it in the Cancellations queue. Reason is mandatory.
      const reason=await ask(CP_T.promptCancelReason);
      if(!reason||!reason.trim())return;
      const et=(kind==='mentor'||kind==='mentoring')?'mentoring':'coaching';
      const r=await this.api('/cancellations','POST',{entityType:et,entityId:id,reason:reason.trim()});
      // `if(r)` etait vrai pour `{}` : l ecran annoncait « Annulation demandee »
      // sur une regle des DEUX PERSONNES ou cancellation_requests restait a 0.
      // La preuve, ici, c est le `ok:true` du controleur.
      if(!SAConsoleNet.confirmed(r,'ok')){ this.toast(SAConsoleNet.t('err_format'),'error'); return; }
      this.toast(CP_T.cancelRequested,'success');
    }
    await this.load(); await this.loadRoster();
  },
  // The shared status badge: an icon and a text, never colour alone.
  badge(s,n){ return cpBadge(s, this.lbl(CP_T.st,s), n==null?null:n); },
  async load(){
    const [q,m]=await Promise.all([this.api('/api/coaching/queue'),this.api('/api/coaching/monitor')]);
    const tb=document.querySelector('#cp-table tbody');
    const T=CP_T.th;
    tb.innerHTML=q.items.length?q.items.map(p=>'<tr><td data-label="'+esc(T.employee)+'">'+esc((p.firstName||'')+' '+(p.lastName||''))+'</td><td data-label="'+esc(T.kind)+'">'+esc(this.lbl(CP_T.kind,p.kind))+'</td><td data-label="'+esc(T.title)+'">'+esc(p.title)+'</td><td data-label="'+esc(T.context)+'">'+(p.contextLabel?cpBadge('info', p.contextLabel, null, {text:true}):'<span class="text-muted">—</span>')+'</td><td data-label="'+esc(T.target)+'">'+(p.targetDate?esc(String(p.targetDate).slice(0,10)):'—')+'</td><td data-label="'+esc(T.state)+'">'+this.badge(p.state)+'</td><td data-label="'+esc(T.progress)+'">'+Number(p.progress)+' %</td><td class="col-actions" data-label="'+esc(T.actions)+'">'+
      '<button class="btn btn-sm btn-secondary"'+cpOn('click','CP.act',[p.id,'session'])+'>'+esc(CP_T.btnNote)+'</button> '+
      (p.state==='active'?'<button class="btn btn-sm btn-success"'+cpOn('click','CP.act',[p.id,'validate'])+'>'+esc(CP_T.btnValidate)+'</button> <button class="btn btn-sm btn-danger" data-kind="'+((p.kind==='mentoring'||p.kind==='mentor')?'mentoring':'coaching')+'"'+cpOn('click','CP.cancelBtn',['$el',Number(p.id)])+'>'+esc(CP_T.btnCancel)+'</button>':'')+
      '</td></tr>').join(''):'<tr><td colspan="8"><em>'+esc(CP_T.noPlans)+'</em></td></tr>';
    document.getElementById('cp-monitor-body').innerHTML=(m.monitor.byState||[]).map(s=>this.badge(s.state, Number(s.n))).join(' ')+' <span aria-hidden="true">|</span> '+esc(CP_T.monitorOverdue)+': '+Number(m.monitor.overdue.length);
  }
};
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
// The shared status badge (public/js/status-badge.js, every value escaped); a
// plain escaped chip if the script did not load.
function cpBadge(tone,label,n,opts){
  if(window.StatusBadge && typeof window.StatusBadge.html==='function') return window.StatusBadge.html(tone,label,n,opts);
  return '<span class="badge">'+esc(label)+(n!=null?' '+esc(n):'')+'</span>';
}
// CSP: no inline handlers — built controls are wired by public/js/csp-actions.js.
function cpOn(type,fn,args){ return ' data-on-'+type+'="'+fn+'" data-args="'+esc(JSON.stringify(args||[]))+'"'; }
// csp-actions.js resolves handlers on window and calls them with `this` = the
// element; CP is a top-level const (not on window) and its methods use `this`.
Object.keys(CP).forEach(function(k){ const d=Object.getOwnPropertyDescriptor(CP,k); if(d && typeof d.value==='function') CP[k]=d.value.bind(CP); });
window.CP = CP;
// A click on the backdrop (the dialog element itself, outside its form)
// closes it; on close the focus goes back to the button that opened it.
(function(){ const dlg=document.getElementById('cp-modal'); if(!dlg) return;
  dlg.addEventListener('click', function(ev){ if(ev.target===dlg) CP.closeModal(); });
  dlg.addEventListener('close', function(){ CP.clearError(); if(CP._opener && typeof CP._opener.focus==='function') CP._opener.focus(); });
})();
CP.loadRoster();
</script>
