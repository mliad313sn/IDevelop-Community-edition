<%# public/js/sa-console-net.js porte la discipline de réseau : une redirection ou
    une réponse non-JSON est un ÉCHEC, jamais un succès, et tout refus est écrit
    DANS la zone concernée. Chargé avant le script de la page (non différé) pour
    que SAConsoleNet existe au premier appel. %>
<script src="/js/sa-console-net.js?v=<%= assetVersion %>"></script>
<link rel="stylesheet" href="/css/sa-skill-help.css?v=<%= assetVersion %>">
<script src="/js/sa-skill-help.js?v=<%= assetVersion %>"></script>
<script nonce="<%= cspNonce %>">
// The person's current goals, shown as CONTEXT beside their ratings (read-only;
// the review logic does not read them). Engagement module only.
const SA_GOALS = {
  on: <%- JSON.stringify(typeof appModules !== 'undefined' && !!appModules && appModules.engagement === true) %>,
  title: <%- JSON.stringify(__('talentx:rvx_goals_title')) %>,
  none: <%- JSON.stringify(__('talentx:rvx_goals_none')) %>,
  failed: <%- JSON.stringify(__('talentx:rvx_goals_failed')) %>,
  progress: <%- JSON.stringify(__('talentx:rvx_goals_progress', { cur: '{cur}', target: '{target}' })) %>,
  loaded: {},
  load(empId){
    if (!this.on || this.loaded[empId]) return;
    const box = document.getElementById('sa-goals-' + empId);
    if (!box) return;
    this.loaded[empId] = true;
    fetch('/api/v1/employees/' + Number(empId) + '/goals', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(r => r.ok ? r.json() : Promise.reject(r.status))
      .then(j => {
        const goals = ((j && j.data) || []).filter(g => g.status === 'active' || g.status === 'at_risk');
        const objectives = goals.filter(g => g.kind === 'objective');
        const krs = goals.filter(g => g.kind === 'key_result');
        let html = '<strong>' + escapeHtml(this.title) + '</strong>';
        if (!objectives.length) { box.innerHTML = html + ' <span class="text-muted">' + escapeHtml(this.none) + '</span>'; return; }
        html += '<ul class="sa-goals-list">' + objectives.map(o => {
          const kids = krs.filter(k => Number(k.parentId) === Number(o.id));
          return '<li>' + escapeHtml(o.title) + (kids.length ? '<ul>' + kids.map(k => {
            const tgt = Number(k.targetValue);
            const txt = tgt > 0 ? String(this.progress).replace('{cur}', Number(k.currentValue) || 0).replace('{target}', tgt) : String(Number(k.currentValue) || 0);
            return '<li>' + escapeHtml(k.title) + ' <span class="text-muted">' + escapeHtml(txt + (k.metricUnit ? ' ' + k.metricUnit : '')) + '</span></li>';
          }).join('') + '</ul>' : '') + '</li>';
        }).join('') + '</ul>';
        box.innerHTML = html;
      })
      .catch(() => { box.innerHTML = '<span class="text-muted">' + escapeHtml(this.failed) + '</span>'; });
  }
};
