<div class="page-header">
  <h1><i class="fas fa-clipboard-check" aria-hidden="true"></i> <%= __('talentx:sar_title') %></h1>
  <p class="text-muted"><%= __('talentx:sar_intro_grouped') %> <strong><%= __('talentx:sar_intro_per_employee') %></strong>. <%= __('talentx:sar_intro_supervisor') %> <em><%= __('talentx:sar_intro_or') %></em> <%= __('talentx:sar_intro_rest') %></p>
  <p class="text-muted" style="font-size:.85em"><%= __('talentx:sar_gap_hint_pre') %> <a href="/supervisor/gap-analysis"><%= __('talentx:sar_gap_analysis') %></a>.</p>
</div>

<div id="sa-analytics" class="card" style="margin-bottom:1rem;padding:.85rem 1rem;">
  <strong><%= __('talentx:sar_pipeline') %></strong> <span id="sa-analytics-body"><%= __('talentx:sar_loading') %></span>
</div>

<!-- Campaign filter + the two halves of the funnel (
     "submitted work to review" (the queue) and "waiting for the employee"
     (roster non-starters / in progress, chaseable from here). -->
<div class="card" style="margin-bottom:1rem;padding:.7rem 1rem;display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;">
  <label for="sa-cycle" style="font-weight:600;font-size:.9rem;margin:0;"><%= __('admin:cyc_rv_cycle_label') %></label>
  <select id="sa-cycle" class="form-control" style="width:auto;min-width:230px;">
    <option value=""><%= __('admin:cyc_rv_all_cycles') %></option>
  </select>
  <a id="sa-cycle-console" class="btn btn-sm btn-secondary" href="/cycles" hidden><i class="fas fa-gauge-high" aria-hidden="true"></i> <%= __('admin:cyc_rv_open_console') %></a>
  <span class="sa-tabs" role="tablist" style="margin-left:auto;display:inline-flex;gap:.25rem">
    <button type="button" class="sa-tab on" role="tab" aria-selected="true" data-sa-tab="queue"><%= __('admin:cyc_rv_tab_queue') %></button>
    <button type="button" class="sa-tab" role="tab" aria-selected="false" data-sa-tab="pending"><%= __('admin:cyc_rv_tab_pending') %> <span id="sa-pending-n" class="sa-badge" style="background:#c8514b" hidden>0</span></button>
  </span>
</div>

<div id="sa-pending" class="card" style="display:none;margin-bottom:1rem;padding:.85rem 1rem" role="tabpanel">
  <p class="text-muted" style="font-size:.85rem;margin:0 0 .6rem"><%= __('admin:cyc_rv_pending_intro') %></p>
  <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin-bottom:.6rem">
    <button type="button" class="btn btn-sm btn-primary" id="sa-nudge-all" hidden><i class="fas fa-bell" aria-hidden="true"></i> <%= __('admin:cyc_nudge_all_mine') %></button>
    <span id="sa-pending-hint" class="text-muted" style="font-size:.85rem"></span>
  </div>
  <div class="table-wrapper"><table class="table" id="sa-pending-table"><thead><tr>
    <th><%= __('admin:cyc_th_person') %></th><th><%= __('admin:cyc_th_state') %></th><th><%= __('admin:cyc_th_skills') %></th><th><%= __('admin:cyc_th_last_nudge') %></th><th></th>
  </tr></thead><tbody><tr><td colspan="5"><em><%= __('admin:cyc_rv_pending_pick') %></em></td></tr></tbody></table></div>
</div>

<!-- Sort / bring-forward controls. These reorder the VIEW only: every submitted
     skill always stays in the queue (no subsetting, no hiding). -->
<div class="card" style="margin-bottom:1rem;padding:.7rem 1rem;display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;">
  <label for="sa-sort" style="font-weight:600;font-size:.9rem;margin:0;"><%= __('talentx:rvx_sort_label') %></label>
  <select id="sa-sort" class="form-control" style="width:auto;min-width:230px;">
    <option value="all"><%= __('talentx:rvx_sort_all') %></option>
    <option value="gap"><%= __('talentx:rvx_sort_gap') %></option>
    <option value="critical"><%= __('talentx:rvx_sort_critical') %></option>
    <option value="nojust"><%= __('talentx:rvx_sort_nojust') %></option>
  </select>
  <span class="text-muted" style="font-size:.82rem"><i class="fas fa-circle-info" aria-hidden="true"></i> <%= __('talentx:rvx_sort_hint') %></span>
</div>

<%# « Approuver les notes concordantes de mon équipe » — one click for the
    ratings nobody needs to discuss. The rule is stated on the card and again
    in the confirmation; the server (isAgreedRating) is what decides, and
    everything it declines stays in the queue below. %>
<div class="card sa-team-card">
  <div class="sa-team-text">
    <strong><%= __('talentx:sar_team_title') %></strong>
    <p class="text-muted sa-team-rule"><%= __('talentx:sar_team_rule') %></p>
  </div>
  <button type="button" class="btn btn-success btn-sm" id="sa-team-approve"><i class="fas fa-check-double" aria-hidden="true"></i> <%= __('talentx:sar_team_btn') %></button>
</div>

<%
// RENDU SERVEUR DE LA FILE (constat « la console du superviseur ne rend rien côté
// serveur »). La zone ne contenait que « Chargement… » : sans JS — navigateur
// ancien d'un poste de site, extension bloquante, script qui n'arrive pas — le
// réviseur n'avait AUCUN contenu, et c'est aussi ce qui rendait tous les refus
// invisibles. On suit le précédent déjà appliqué à l'écran de l'employé
// (SelfAssessmentWorkflowController.myStatusPage) : le serveur rend les lignes,
// le JS les re-rend à l'identique. `employees` absent = ancien chemin JS seul.
var saRows = (typeof employees !== 'undefined' && Array.isArray(employees)) ? employees : null;
function saCell(v) { return (v === null || v === undefined || v === '') ? '—' : String(v); }
%>
<div id="sa-people">
<% if (saRows && saRows.length) { %>
  <p class="text-muted" style="font-size:.82rem;margin:.2rem 0 .6rem"><i class="fas fa-circle-info" aria-hidden="true"></i> <%= __('talentx:sar_server_rendered') %></p>
  <% saRows.forEach(function (e) { %>
  <div class="sa-emp">
    <div class="sa-emp-head">
      <div>
        <div class="sa-emp-name"><%= (e.firstName || '') + ' ' + (e.lastName || '') %></div>
        <div class="sa-emp-sub"><%= __('talentx:sar_skills_pending').replace('{total}', e.total).replace('{pending}', e.pending) %></div>
      </div>
      <div class="sa-emp-counts">
        <% Object.keys(e.counts || {}).forEach(function (s) { %>
          <span class="sa-badge" style="background:#5f6570"><%= __('talentx:sar_st_' + s) %> <%= e.counts[s] %></span>
        <% }); %>
      </div>
    </div>
    <div class="sa-detail open"><div class="table-wrapper"><table><thead><tr>
      <th><%= __('talentx:skill') %></th>
      <th class="sa-num"><%= __('talentx:rvx_required') %></th>
      <th class="sa-num"><%= __('talentx:rvx_self') %></th>
      <th class="sa-num"><%= __('talentx:rvx_last_validated') %></th>
      <th><%= __('talentx:rvx_justification') %></th>
      <th><%= __('talentx:state') %></th>
    </tr></thead><tbody>
      <% (e.items || []).forEach(function (it) { %>
      <tr class="sa-row">
        <td><%= it.skillName || ('#' + it.skillId) %><% if (it.skillId != null) { %><%- include('../../partials/skill-help', { sh: { id: 'r' + it.id + '-' + it.skillId, raw: it.skillHelp || null, mode: 'review', selected: it.selfRatedLevel, required: it.requiredLevel } }) %><% } %></td>
        <td class="sa-num"><%= saCell(it.requiredLevel) %></td>
        <td class="sa-num"><%= saCell(it.selfRatedLevel) %></td>
        <td class="sa-num"><%= saCell(it.validatedLevel) %></td>
        <td class="sa-just"><%= (it.employeeNotes == null || String(it.employeeNotes).trim() === '') ? __('talentx:rvx_no_justification') : String(it.employeeNotes) %></td>
        <td><%= __('talentx:sar_st_' + it.workflowState) %></td>
      </tr>
      <% }); %>
    </tbody></table></div></div>
  </div>
  <% }); %>
<% } else if (saRows) { %>
  <div class="card" style="padding:1rem"><em><%= __('talentx:sar_nothing_awaiting') %></em></div>
<% } else { %>
  <div class="card" style="padding:1rem"><%= __('talentx:loading') %></div>
<% } %>
</div>

<!-- Thread drawer -->
<div id="sa-thread" class="card" style="display:none;margin-top:1rem;padding:1rem;">
  <h3><%= __('talentx:sar_discussion') %> <button class="btn btn-sm" onclick="document.getElementById('sa-thread').style.display='none'"><%= __('talentx:sar_close') %></button></h3>
  <div id="sa-thread-body"></div>
  <div style="margin-top:.5rem;display:flex;gap:.5rem;">
    <input id="sa-thread-input" class="form-control" placeholder="<%= __('talentx:sar_add_comment_ph') %>" style="flex:1;">
    <button class="btn btn-secondary" onclick="SA.comment()"><%= __('talentx:sar_comment') %></button>
  </div>
</div>

<style>
