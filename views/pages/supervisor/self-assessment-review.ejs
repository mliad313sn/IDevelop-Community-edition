  sortMode: 'all',
  ACT_STATES: ['submitted','under_review','reviewed','arbitration'],
  STATES: { draft:'#5f6570', submitted:'#1b56b8', under_review:'#a15400', changes_requested:'#c62828', reviewed:'#1b7e3a', arbitration:'#7a3cc4', approved:'#0f8a3c', rejected:'#b00020' },
  // UNE REDIRECTION EST UN ÉCHEC. L'ancien helper envoyait Content-Type seul, donc
  // une session expirée recevait `302 → /login?expired=1`, fetch la SUIVAIT, la page
  // HTML arrivait en 200, `r.ok` valait true et `r.json` était avalé en `{}` :
  // l'écran annonçait « Terminé » sur une décision jamais enregistrée. Toute la
  // discipline est dans public/js/sa-console-net.js (testée unitairement).
  async api(path, method, body) {
    try {
      return await SAConsoleNet.api(path, method, body);
    } catch (err) {
      (window.toast||alert)(err.message, 'error');
      if (err.code === 'session') SAConsoleNet.navigate('/login?expired=1');
      err.__saReported = true; // déjà dit à l'utilisateur : pas deux fois (voir plus bas)
      throw err;
    }
  },
  badge(s, n){ return '<span class="sa-badge" style="background:'+(this.STATES[s]||'#555')+'">'+escapeHtml((SA_T.SL&&SA_T.SL[s])||s)+(n!=null?(' '+n):'')+'</span>'; },
  rateSelect(it){
    // The reviewer's OWN rating (0–4), pre-filled with the self-rating. On approve
    // this is what becomes the official skill level — no more silent rubber-stamp.
    const cur = (it.selfRatedLevel!=null ? String(it.selfRatedLevel) : '');
    let opts = '';
    for (let i=0;i<=4;i++){ opts += '<option value="'+i+'"'+(String(i)===cur?' selected':'')+'>'+i+'</option>'; }
    // data-self carries the employee's own rating so act can tell an OVERRIDE
    // from an agreement and demand a short reason for the former.
    return '<span class="sa-rate" title="'+escapeHtml(SA_T.rateTitle)+'">'+escapeHtml(SA_T.rateLbl)+' <select id="sa-rate-'+it.id+'" class="sa-rate-sel" data-self="'+escapeHtml(cur)+'" aria-label="'+escapeHtml(SA_T.rateTitle)+'">'+opts+'</select></span>';
  },
  // ---- decision context (per skill) -----------------------------------
  lvl(v){ return (v===null||v===undefined||v==='') ? null : Number(v); },
  /** Required level cell + the « Critique » marker is rendered next to the skill. */
  requiredCell(it){
    const req = this.lvl(it.requiredLevel);
    if (req===null) return '<span class="sa-lvl-none" title="'+escapeHtml(SA_T.rvxNoRequirement)+'">—</span>';
    return String(req);
  },
  /** Self level + the gap against the requirement (context, not a filter). */
  selfCell(it){
    const req = this.lvl(it.requiredLevel), self = this.lvl(it.selfRatedLevel);
    let out = (self===null? '—' : String(self));
    if (req!==null && self!==null) {
      const d = self - req;
      out += d < 0
        ? ' <span class="sa-gap" title="'+escapeHtml(SA_T.rvxGapTitle)+'">'+d+'</span>'
        : ' <span class="sa-gap sa-gap-ok" title="'+escapeHtml(SA_T.rvxMetTitle)+'">✓</span>';
    }
    return out;
  },
  /** The level the organisation last officially validated for this skill. */
  validatedCell(it){
    const v = this.lvl(it.validatedLevel);
    if (v===null) return '<span class="sa-lvl-none">'+escapeHtml(SA_T.rvxNeverValidated)+'</span>';
    let title = '';
    if (it.validatedAt) { try { title = SA_T.rvxValidatedOn.replace('{date}', new Date(it.validatedAt).toLocaleDateString(SA_T.lang)); } catch(_) { title=''; } }
    return '<span'+(title?' title="'+escapeHtml(title)+'"':'')+'>'+v+'</span>';
  },
  /** The employee's own justification, expandable in place. */
  justificationCell(it){
    const txt = (it.employeeNotes==null? '' : String(it.employeeNotes)).trim();
    if (!txt) return '<span class="sa-nojust">'+escapeHtml(SA_T.rvxNoJustification)+'</span>';
    const short = txt.length > 46 ? txt.slice(0,46)+'…' : txt;
    return '<details class="sa-just"><summary title="'+escapeHtml(SA_T.rvxSeeJustification)+'">'+escapeHtml(short)+'</summary><div>'+escapeHtml(txt)+'</div></details>';
  },
  /** 3.23.21: the same « Qu'est-ce que c'est ? » the employee saw, built by
   *  the shared helper (public/js/sa-skill-help.js) — every text escaped there. */
  helpPanel(it){
    if (it.skillId==null || !window.SkillHelp) return '';
    const H = window.SkillHelp;
    return H.panelHtml({
      id: 'r'+it.id+'-'+it.skillId,
      help: H.resolve(it.skillHelp||null, SA_T.lang==='en'?'en':'fr', SA_T.HELP.labels),
      selected: it.selfRatedLevel, required: it.requiredLevel, mode: 'review', t: SA_T.HELP.t
    });
  },
  /** One queue row. `idx` preserves the server order for the « Tout » sort. */
  row(it, idx){
    const crit = it.isCritical===true || it.isCritical===1 || it.isCritical==='t';
    const req = this.lvl(it.requiredLevel), self = this.lvl(it.selfRatedLevel);
    // Gap magnitude used only for ORDERING; -999 keeps rows without a requirement
    // at the end of the gap sort — still present, never removed.
    const gap = (req!==null && self!==null) ? (req - self) : -999;
    const hasJust = !!((it.employeeNotes==null? '' : String(it.employeeNotes)).trim());
    return '<tr class="sa-row" data-idx="'+idx+'" data-gap="'+gap+'" data-crit="'+(crit?1:0)+'" data-just="'+(hasJust?1:0)+'">'+
      '<td>'+escapeHtml(it.skillName||('#'+it.skillId))+(crit?'<span class="sa-chip-crit" title="'+escapeHtml(SA_T.rvxCriticalTitle)+'">'+escapeHtml(SA_T.rvxCritical)+'</span>':'')+this.helpPanel(it)+'</td>'+
      '<td class="sa-num">'+this.requiredCell(it)+'</td>'+
      '<td class="sa-num">'+this.selfCell(it)+'</td>'+
      '<td class="sa-num">'+this.validatedCell(it)+'</td>'+
      '<td>'+this.justificationCell(it)+'</td>'+
      '<td>'+this.badge(it.workflowState)+'</td>'+
      '<td>'+this.rowActions(it)+'</td></tr>';
  },
  /**
   * Reorder the already-loaded rows. This ONLY moves rows (and marks the ones the
   * chosen criterion brings forward): no row is ever hidden or dropped — the
   * number of skills a reviewer must decide on is unchanged by design.
   */
  applySort(){
    const mode = this.sortMode || 'all';
    document.querySelectorAll('.sa-detail tbody').forEach(function(tb){
      const rows = Array.prototype.slice.call(tb.querySelectorAll('tr.sa-row'));
      const n = function(el, a){ return Number(el.getAttribute(a)); };
      rows.sort(function(a,b){
        if (mode==='gap')      return (n(b,'data-gap') - n(a,'data-gap')) || (n(a,'data-idx') - n(b,'data-idx'));
        if (mode==='critical') return (n(b,'data-crit') - n(a,'data-crit')) || (n(b,'data-gap') - n(a,'data-gap')) || (n(a,'data-idx') - n(b,'data-idx'));
        if (mode==='nojust')   return (n(a,'data-just') - n(b,'data-just')) || (n(a,'data-idx') - n(b,'data-idx'));
        return n(a,'data-idx') - n(b,'data-idx');
      });
      rows.forEach(function(r){
        r.classList.remove('sa-hit');
        if (mode==='gap' && n(r,'data-gap') > 0) r.classList.add('sa-hit');
        if (mode==='critical' && n(r,'data-crit') === 1) r.classList.add('sa-hit');
        if (mode==='nojust' && n(r,'data-just') === 0) r.classList.add('sa-hit');
        tb.appendChild(r); // move, never remove
      });
    });
  },
  rowActions(it){
    const id = it.id, st = it.workflowState, A = [];
    if (this.ACT_STATES.includes(st)) { A.push(this.rateSelect(it)); A.push(b(id,SA_T.approve,'approve','btn-success')); A.push(b(id,SA_T.requestChanges,'request-changes','btn-warning')); A.push(b(id,SA_T.reject,'reject','btn-danger')); }
    A.push('<button class="btn btn-sm" onclick="SA.openThread('+id+')">'+SA_T.discuss+' ('+(it.commentCount||0)+')</button>');
    return A.join(' ');
    function b(id,label,action,cls){ return '<button class="btn btn-sm '+cls+'" data-action="'+action+'" onclick="SA.act('+id+',this.dataset.action)">'+label+'</button>'; }
  },
  async act(id, action){
    let body = {};
    // Treat an empty box the same as cancel — the server now requires a reason, so
    // sending '' would just bounce back an error. Loop until we have text or a cancel.
    if (action==='request-changes') { const c = await askChanges(); if (c===null || !String(c).trim()) return; body.comment = c.trim(); }
    if (action==='reject') { const c = await ask(SA_T.askRejectReason); if (c===null || !String(c).trim()) return; body.reason = c.trim(); }
    // On approve, promote the reviewer's rating (defaults to the pre-filled self-rating).
    // When that rating DIFFERS from the employee's own, the supervisor must say why:
    // the reason is stored on supervisor_reviews.gap_reason. Cancel/empty aborts the
    // whole decision — nothing is sent, the assessment stays where it is.
    if (action==='approve') {
      const sel = document.getElementById('sa-rate-'+id);
      if (sel && sel.value !== '') {
        body.supervisorLevel = sel.value;
        const self0 = sel.getAttribute('data-self') || '';
        if (self0 !== '' && String(sel.value) !== String(self0)) {
          const why = await ask(SA_T.rvxAskOverride.replace('{self}', self0).replace('{mine}', sel.value));
          if (why===null || !String(why).trim()) return;
          body.recommendation = { gapReason: String(why).trim() };
        }
      }
    }
    // On n'annonce JAMAIS un acte avant d'en avoir la preuve : le serveur renvoie
    // l'évaluation mise à jour. Une réponse sans `assessment` n'est pas un succès.
    const j = await this.api('/api/self-assessment/'+id+'/'+action, 'POST', body);
    if (!SAConsoleNet.confirmed(j, 'assessment')) {
      (window.toast||function(){})(SA_T.notConfirmed, 'error');
      await this.load();
      return;
    }
    (window.toast||function(){})(SA_T.done, 'success');
    await this.load();
  },
  async approveAll(empId, n){
    const ok = await window.confirmDialog(SA_T.approveAllConfirm.replace('{n}', n), { okText: SA_T.approveAll });
    if (!ok) return;
    const j = await this.api('/api/self-assessment/employee/'+empId+'/approve-all', 'POST', {});
    const r = j.result || {};
    const skipped = (r.failed && r.failed.length) ? r.failed.length : 0;
    if (skipped) {
      (window.toast||function(){})(SA_T.approvedN.replace('{n}', r.approved) + ' — ' + skipped + ' skipped (' + r.failed.map(function(f){return '#'+f.id;}).join(', ') + ')', 'warning');
    } else {
      (window.toast||function(){})(SA_T.approvedN.replace('{n}', (r.approved!=null?r.approved:n)), 'success');
    }
    await this.load();
  },
  /** Team-wide: agreed ratings only. Never announced before the server's proof. */
  async approveTeam(){
    const ok = await window.confirmDialog(SA_T.teamConfirm, { title: SA_T.teamTitle, confirmText: SA_T.teamOk });
    if (!ok) return;
    const j = await this.api('/api/self-assessment/team/approve-all', 'POST', {});
    const r = j && j.result;
    if (!r || r.approved === undefined) {
      (window.toast||function(){})(SA_T.notConfirmed, 'error');
      await this.load();
      return;
    }
    let msg = this.fmt(SA_T.teamDone, { approved: r.approved, held: r.held || 0 });
    if (r.failed) msg += ' ' + this.fmt(SA_T.teamFailedN, { n: r.failed });
    (window.toast||function(){})(msg, r.failed ? 'warning' : 'success');
    await this.load();
  },
  async openThread(id){
    this.current = id;
    const j = await this.api('/api/self-assessment/'+id+'/thread');
    document.getElementById('sa-thread').style.display='block';
    document.getElementById('sa-thread-body').innerHTML = j.comments.length
      ? j.comments.map(c=>'<div style="padding:.4rem 0;border-bottom:1px solid #eee;"><strong>'+escapeHtml((SA_T.AUTH&&SA_T.AUTH[c.authorType])||c.authorType)+'</strong>: '+escapeHtml(c.body)+' <span class="text-muted" style="font-size:.8em">'+escapeHtml(new Date(c.createdAt).toLocaleString(SA_T.lang))+'</span></div>').join('')
      : '<em>'+SA_T.noComments+'</em>';
    document.getElementById('sa-thread').scrollIntoView({behavior:'smooth'});
  },
  async comment(){
    const v = document.getElementById('sa-thread-input').value.trim();
    if (!v || !this.current) return;
    await this.api('/api/self-assessment/'+this.current+'/comment','POST',{ comment: v }).catch(()=>{});
    document.getElementById('sa-thread-input').value='';
    await this.openThread(this.current); await this.load();
  },
  toggle(empId){ const d=document.getElementById('sa-detail-'+empId); if(!d) return; const open=d.classList.toggle('open'); const b=document.getElementById('sa-toggle-'+empId); if(b) b.setAttribute('aria-expanded', open?'true':'false'); if (open) SA_GOALS.load(empId); },
  // ---- campaign filter + "waiting for the employee" tab ------------
  cycleId: '',
  cycles: [],
  fmt(tpl, vars){ return String(tpl).replace(/%(\w+)%/g, function (m, k) { return Object.prototype.hasOwnProperty.call(vars, k) ? String(vars[k]) : m; }); },
  cycleChip(c){ return '<span class="sa-cycle-chip">'+escapeHtml(c && c.code ? this.fmt(SA_T.cycleChip, { code: c.code }) : SA_T.noCycleChip)+'</span>'; },
  async loadCycles(){
    try {
      const j = await this.api('/cycles/running.json');
      this.cycles = j.cycles || [];
      const sel = document.getElementById('sa-cycle');
      this.cycles.forEach(c => { const o = document.createElement('option'); o.value = String(c.id); o.textContent = c.code + (c.label && c.label !== c.code ? ' — ' + c.label : '') + ' (' + (SA_T.cycStatus[c.status] || c.status) + ')'; sel.appendChild(o); });
      // AUCUNE pré-sélection subie : la première campagne « en cours » — y compris
      // VERROUILLÉE et échue — était imposée comme filtre et masquait toutes les
      // lignes hors campagne, pendant que le bandeau du haut, lui, les comptait.
      // Le filtre reste offert ; il n'est plus appliqué sans qu'on l'ait demandé.
      const want = SAConsoleNet.preselectedCycle(location.search, this.cycles);
      if (want && Array.prototype.some.call(sel.options, o => o.value === want)) { sel.value = want; this.cycleId = want; }
      const link = document.getElementById('sa-cycle-console');
      if (link) { link.hidden = !this.cycleId; link.href = '/cycles/' + this.cycleId; }
    } catch (_) { /* the queue works without the picker */ }
  },
  showTab(name){
    document.querySelectorAll('[data-sa-tab]').forEach(b => { const on = b.getAttribute('data-sa-tab') === name; b.classList.toggle('on', on); b.setAttribute('aria-selected', on ? 'true' : 'false'); });
    document.getElementById('sa-pending').style.display = name === 'pending' ? '' : 'none';
    document.getElementById('sa-people').style.display = name === 'pending' ? 'none' : '';
    if (name === 'pending') this.loadPending();
  },
  async loadPending(){
    const tb = document.querySelector('#sa-pending-table tbody');
    const hint = document.getElementById('sa-pending-hint');
    const all = document.getElementById('sa-nudge-all');
    const badge = document.getElementById('sa-pending-n');
    if (!this.cycleId) { tb.innerHTML = '<tr><td colspan="5"><em>'+SA_T.pendingPick+'</em></td></tr>'; all.hidden = true; badge.hidden = true; return; }
    tb.innerHTML = '<tr><td colspan="5"><em>'+SA_T.loading+'</em></td></tr>';
    // Un refus laissait « Chargement… » dans ce tableau pour toujours.
    let j;
    try {
      j = await this.api('/cycles/'+this.cycleId+'/roster.json?states=not_started,in_progress');
    } catch (err) {
      tb.innerHTML = SAConsoleNet.failureRow(err, 'pending', 5, 'pending_failed');
      all.hidden = true; badge.hidden = true;
      return;
    }
    const cyc = j.cycle || {};
    const open = cyc.status === 'open';
    hint.textContent = (cyc.overdueDays ? this.fmt(SA_T.overdue, { days: cyc.overdueDays }) + ' · ' : '') + (open ? '' : SA_T.nudgeLocked);
    all.hidden = !(open && j.rows.length);
    badge.hidden = !j.rows.length; badge.textContent = String(j.rows.length);
    if (!j.rows.length) { tb.innerHTML = '<tr><td colspan="5"><em>'+SA_T.pendingNone+'</em></td></tr>'; return; }
    tb.innerHTML = j.rows.map(p => '<tr>'+
      '<td><a href="/employees/'+p.employeeId+'">'+escapeHtml(p.fullName)+'</a>'+(p.serviceName?' <span class="sa-emp-sub">'+escapeHtml(p.serviceName)+'</span>':'')+'</td>'+
      '<td>'+this.badge(p.state)+'</td>'+
      '<td>'+escapeHtml(this.fmt(SA_T.progressOf, { done: p.approvedSkills, total: p.expectedSkills }))+'</td>'+
      '<td>'+(p.lastNudgeAt ? escapeHtml(new Date(p.lastNudgeAt).toLocaleDateString(SA_T.lang)) : '—')+'</td>'+
      '<td>'+(open ? '<button type="button" class="btn btn-sm btn-primary" data-sa-nudge="'+p.employeeId+'"><i class="fas fa-bell" aria-hidden="true"></i> '+SA_T.nudge+'</button>' : '')+'</td></tr>').join('');
  },
  async nudge(body, ask){
    const ok = await window.confirmDialog(ask);
    if (!ok) return;
    const j = await this.api('/cycles/'+this.cycleId+'/nudge', 'POST', body);
    (window.toast||function(){})(this.fmt(SA_T.nudgeDone, { sent: j.sent, managers: j.reviewersNotified, today: j.alreadyToday, locked: j.lockedSkipped }), j.sent ? 'success' : 'warning');
    await this.loadPending();
  },
  async load(){
    const cq = this.cycleId ? '?cycleId=' + encodeURIComponent(this.cycleId) : '';
    // L'ORNEMENT N'EMPORTE PLUS L'ESSENTIEL. Les deux appels étaient dans le même
    // Promise.all : un refus sur le petit compteur du haut rejetait l'ensemble et
    // la file — qui avait pourtant répondu — restait sur « Chargement… ».
    // Le compteur passe par SAConsoleNet directement : son échec se lit DANS le
    // bandeau (renderStats), il n'a pas besoin d'un toast de plus.
    const [qr, ar] = SAConsoleNet.settled(await Promise.allSettled([
      this.api('/api/self-assessment/queue-by-employee' + cq),
      SAConsoleNet.api('/api/self-assessment/analytics')
    ]));
    this.renderQueue(qr);
    this.renderStats(ar);
  },
  /** La file. Un refus s'écrit DANS la zone, avec de quoi réessayer. */
  renderQueue(res){
    const wrap = document.getElementById('sa-people');
    if (res.error) { wrap.innerHTML = SAConsoleNet.failureCard(res.error, 'queue', 'load_failed'); return; }
    const q = res.value || {};
    const list = q.employees || [];
    if (!list.length) { wrap.innerHTML = this.emptyQueueCard(); }
    else {
      wrap.innerHTML = list.map(e=>{
        const counts = (e.cycles || []).map(c => this.cycleChip(c)).join(' ') + ' ' + Object.keys(e.counts).map(s=>this.badge(s, e.counts[s])).join(' ');
        const rows = e.items.map((it, i)=>this.row(it, i)).join('');
        const approveBtn = e.pending>0 ? '<button class="btn btn-success btn-sm" onclick="SA.approveAll('+e.employeeId+','+e.pending+')"><i class="fas fa-check-double" aria-hidden="true"></i> '+SA_T.approveAll+' ('+e.pending+')</button>' : '<span class="sa-badge" style="background:#0f8a3c">'+SA_T.allDone+'</span>';
        return '<div class="sa-emp"><div class="sa-emp-head">'+
          '<div><div class="sa-emp-name">'+escapeHtml(e.firstName+' '+e.lastName)+'</div><div class="sa-emp-sub">'+SA_T.skillsPending.replace('{total}', e.total).replace('{pending}', e.pending)+'</div></div>'+
          '<div class="sa-emp-counts">'+counts+'</div>'+
          '<div class="sa-emp-actions"><button class="sa-toggle" id="sa-toggle-'+e.employeeId+'" aria-expanded="false" aria-controls="sa-detail-'+e.employeeId+'" onclick="SA.toggle('+e.employeeId+')">'+SA_T.details+'</button>'+approveBtn+'</div></div>'+
          '<div class="sa-detail" id="sa-detail-'+e.employeeId+'">'+(SA_GOALS.on ? '<div class="sa-goals" id="sa-goals-'+e.employeeId+'"></div>' : '')+'<div class="table-wrapper"><table><thead><tr>'+
            '<th>'+SA_T.skill+'</th>'+
            '<th class="sa-num">'+SA_T.rvxRequired+'</th>'+
            '<th class="sa-num">'+SA_T.rvxSelf+'</th>'+
            '<th class="sa-num">'+SA_T.rvxValidated+'</th>'+
            '<th>'+SA_T.rvxJustification+'</th>'+
            '<th>'+SA_T.state+'</th>'+
            '<th style="min-width:300px">'+SA_T.actions+'</th>'+
          '</tr></thead><tbody>'+rows+'</tbody></table></div></div></div>';
      }).join('');
      this.applySort();
    }
  },
  /**
   * File vide : dire LAQUELLE. « Rien en attente de votre revue » était faux dès
   * qu'un filtre de campagne était actif — il y avait du travail, ailleurs.
   */
  emptyQueueCard(){
    if (!this.cycleId) return '<div class="card" style="padding:1rem"><em>'+escapeHtml(SA_T.nothingAwaiting)+'</em></div>';
    const c = (this.cycles || []).find(x => String(x.id) === String(this.cycleId));
    const code = c ? (c.code || c.id) : this.cycleId;
    return '<div class="card" style="padding:1rem"><em>'+escapeHtml(String(SA_T.nothingAwaitingCycle).replace('{code}', code))+'</em> '+
      '<button type="button" class="btn btn-sm" data-sa-clear-cycle="1">'+escapeHtml(SA_T.seeAllCycles)+'</button></div>';
  },
  /**
   * Le bandeau. Il compte TOUTES les campagnes (completionStats n'accepte pas de
   * filtre) : quand la file est filtrée on l'écrit, au lieu de laisser deux
   * chiffres se contredire sur une seule hauteur d'écran. Son échec ne coûte que
   * lui-même.
   */
  renderStats(res){
    const el = document.getElementById('sa-analytics-body');
    if (!el) return;
    if (res.error) {
      el.innerHTML = '<span class="text-muted" title="'+escapeHtml(res.error.message)+'">'+escapeHtml(SA_T.statsUnavailable)+'</span>';
      return;
    }
    const stats = (res.value && res.value.stats) || {};
    const body = (stats.byState||[]).map(s=>this.badge(s.state, s.n)).join(' ') || '<em>'+escapeHtml(SA_T.none)+'</em>';
    el.innerHTML = body + (this.cycleId ? ' <span class="text-muted" style="font-size:.8rem">('+escapeHtml(SA_T.statsAllCycles)+')</span>' : '');
  }
};
function escapeHtml(s){ return String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function ask(msg){ return window.promptDialog(msg); }
// « Demander des modifications » : four ready-made reasons plus free text.
function askChanges(){ return window.promptDialog(SA_T.askComment, '', { title: SA_T.rcTitle, multiline: true, required: true, choices: SA_T.rcReasons, choicePlaceholder: SA_T.rcPick, placeholder: SA_T.rcFreePh }); }
// Les boutons appellent SA.act/SA.approveAll par onclick : l'erreur déjà
// montrée à l'utilisateur ressortait ensuite en « Uncaught (in promise) ». Un
// refus se dit UNE fois, dans l'interface, pas deux fois dont une dans la console.
window.addEventListener('unhandledrejection', function(ev){
  if (ev.reason && ev.reason.__saReported) ev.preventDefault();
});
(function(){
  const team = document.getElementById('sa-team-approve');
  if (team) team.addEventListener('click', function(){ SA.approveTeam().catch(function(){ /* already shown */ }); });
  const sel = document.getElementById('sa-sort');
  if (sel) sel.addEventListener('change', function(){ SA.sortMode = sel.value; SA.applySort(); });
  const cyc = document.getElementById('sa-cycle');
  if (cyc) cyc.addEventListener('change', function(){
    SA.cycleId = cyc.value;
    const link = document.getElementById('sa-cycle-console');
    if (link) { link.hidden = !SA.cycleId; link.href = '/cycles/' + SA.cycleId; }
    SA.load(); if (document.getElementById('sa-pending').style.display !== 'none') SA.loadPending();
  });
  document.querySelectorAll('[data-sa-tab]').forEach(function(b){ b.addEventListener('click', function(){ SA.showTab(b.getAttribute('data-sa-tab')); }); });
  const all = document.getElementById('sa-nudge-all');
  if (all) all.addEventListener('click', function(){ SA.nudge({ all: true, states: ['not_started', 'in_progress'] }, SA_T.nudgeAllAsk); });
  document.addEventListener('click', function(ev){
    const b = ev.target.closest && ev.target.closest('[data-sa-nudge]');
    if (b) SA.nudge({ employeeIds: [Number(b.getAttribute('data-sa-nudge'))] }, SA.fmt(SA_T.nudgeAsk, { n: 1 }));
    // « Réessayer » posé par la carte d'échec, et « voir toutes les campagnes »
    // posé par la file vide filtrée : deux sorties de secours, pas un toast.
    const r = ev.target.closest && ev.target.closest('[data-sa-retry]');
    if (r) { const z = r.getAttribute('data-sa-retry'); if (z === 'pending') SA.loadPending(); else SA.load(); }
    const c = ev.target.closest && ev.target.closest('[data-sa-clear-cycle]');
    if (c) {
      const sel = document.getElementById('sa-cycle');
      if (sel) sel.value = '';
      SA.cycleId = '';
      const link = document.getElementById('sa-cycle-console');
      if (link) link.hidden = true;
      SA.load();
    }
  });
})();
// Aucune de ces trois promesses n'avait de .catch : un rejet ne pouvait RIEN
// écrire à l'écran et la zone gardait « Chargement… » pour toujours. Chacune
// écrit désormais son échec dans SA ZONE, et aucune n'emporte les autres.
SA.loadCycles()
  .catch(function(){ /* le sélecteur de campagne est un confort, pas la file */ })
  .then(function(){
    SA.load().catch(function(err){
      const wrap = document.getElementById('sa-people');
      if (wrap) wrap.innerHTML = SAConsoleNet.failureCard(err, 'queue', 'load_failed');
    });
    SA.loadPending().catch(function(err){
      const tb = document.querySelector('#sa-pending-table tbody');
      if (tb) tb.innerHTML = SAConsoleNet.failureRow(err, 'pending', 5, 'pending_failed');
    });
  });
</script>
