<div class="page-header">
  <h1><i class="fas fa-gavel" aria-hidden="true"></i> <%= __('talentx:dsp_title') %></h1>
  <p class="text-muted"><%= __('talentx:dsp_intro') %></p>
</div>

<div class="card" style="padding:0">
<div class="search-bar" style="margin:.6rem 0"><div class="search-input-wrapper"><input type="search" class="search-input" data-table-search="#dsp-table" placeholder="<%= __('common:filter_list') %>" aria-label="<%= __('common:filter_list') %>"></div></div>
  <table class="table" id="dsp-table">
    <% var showActions = canResolve || canArbitrate; %>
    <thead><tr><th><%= __('talentx:employee') %></th><th><%= __('talentx:skill') %></th><th><%= __('talentx:dsp_self') %></th><th><%= __('talentx:dsp_supervisor') %></th><th><%= __('talentx:dsp_level') %></th><th><%= __('talentx:state') %></th><th><%= __('talentx:dsp_reason') %></th><th><%= __('talentx:dsp_opened') %></th><% if (showActions) { %><th><%= __('talentx:dsp_resolve') %></th><% } %></tr></thead>
    <tbody>
      <% if (!disputes || !disputes.length) { %>
        <tr><td colspan="<%= showActions ? 9 : 8 %>"><em><%= __('talentx:dsp_no_disputes') %></em></td></tr>
      <% } else { disputes.forEach(function(d){ %>
        <tr>
          <td><%= (d.firstName||'') + ' ' + (d.lastName||'') %><div style="color:#94a3b8;font-size:.78rem"><%= d.employeeNumber||'' %></div></td>
          <td><%= d.skillName || '' %></td>
          <td><%= d.selfRatedLevel %></td>
          <td><%= d.supervisorRatedLevel %></td>
          <td><span class="dsp-level" data-l="<%= d.level %>"><%= enumLabel(d.level) %><% if (d.level === 'L2') { %> · <%= __('talentx:dsp_hr') %><% } %></span></td>
          <td><span class="dsp-state" data-s="<%= d.state %>"><%= enumLabel(d.state) %></span><% if (d.level === 'L0' && d.state === 'open' && d.proposedAt) { %><div class="text-muted dsp-sub" data-dsp-proposal="<%= d.id %>"><%= __('talentx:dsp_proposal_waiting', { n: d.proposedRating, date: fmtDate(d.proposedAt) }) %></div><% } else if (d.employeeResponse === 'refused') { %><div class="text-muted dsp-sub"><%= __('talentx:dsp_proposal_refused', { n: d.proposedRating }) %></div><% } %></td>
          <td style="max-width:280px"><%= d.reason || '' %></td>
          <%# a `timestamp` column stringified by String(...) prints
              « Tue Sep 15 2026 00:00:00 GMT… » and slice(0,10) leaves the English
              head. fmtDate is the product's one date rendering. %>
          <td><%= fmtDate(d.openedAt) %></td>
          <% if (showActions) { %>
          <td style="white-space:nowrap">
            <%# Level 0 PROPOSES (migration 194): once a proposal waits for the
                person's answer there is nothing more to do here. Never a button on
                one's own dispute (the route refuses it too). %>
            <% var _args = function (path) { return JSON.stringify([d.id, path, d.selfRatedLevel, d.supervisorRatedLevel, d.reason || '']); }; %>
            <% if (canResolve && !d.ownRecord && d.level === 'L0' && d.state === 'open' && !d.proposedAt) { %><button class="btn btn-sm btn-success" data-on-click="DSP.resolve" data-args="<%= _args('resolve-l0') %>"><%= __('talentx:dsp_propose_l0') %></button><% } %>
            <% if (canResolve && !d.ownRecord && d.level === 'L1' && d.state === 'escalated') { %><button class="btn btn-sm btn-primary" data-on-click="DSP.resolve" data-args="<%= _args('resolve-l1') %>"><%= __('talentx:dsp_resolve_l1') %></button><% } %>
            <% if (canArbitrate && d.level === 'L2' && (d.state === 'escalated' || d.state === 'open')) { %><button class="btn btn-sm btn-warning" data-on-click="DSP.resolve" data-args="<%= _args('resolve-l2') %>"><i class="fas fa-user-shield" aria-hidden="true"></i> <%= __('talentx:dsp_resolve_l2') %></button><% } %>
          </td>
          <% } %>
        </tr>
      <% }); } %>
    </tbody>
  </table>
</div>

<style>
  .dsp-state{padding:2px 8px;border-radius:10px;color:#fff;font-size:.8em;background:#64748b}
  .dsp-state[data-s="open"]{background:#d97706}
  .dsp-state[data-s="escalated"]{background:#b00020}
  .dsp-state[data-s="resolved"]{background:#16a34a}
  .dsp-state[data-s="auto_finalized"]{background:#0891b2}
  .dsp-level{padding:2px 8px;border-radius:10px;font-size:.8em;background:var(--bg-subtle,#334155);color:var(--text-primary,#e2e8f0)}
  .dsp-level[data-l="L2"]{background:#7c3aed;color:#fff}
  .dsp-sub{font-size:.8rem;margin-top:.25rem}
</style>
<%# Même discipline que la console de revue : une réponse REDIRIGÉE ou non-JSON est
    un ÉCHEC. Mesuré ici sur une session expirée : l'ancien code recevait
    `302 → /login` suivi en 200 HTML, ne voyait ni `r.ok` faux ni `j.ok === false`,
    n'affichait AUCUN refus et appelait location.reload() — la décision d'arbitrage
    n'était jamais enregistrée et rien ne le disait. %>
<script src="/js/sa-console-net.js?v=<%= assetVersion %>"></script>
<script nonce="<%= cspNonce %>">
SAConsoleNet.configure(<%- include('../../partials/json-script', { v: {
  err_session: __('talentx:sar_err_session'),
  err_forbidden: __('talentx:sar_err_forbidden'),
  err_notfound: __('talentx:sar_err_notfound'),
  err_server: __('talentx:sar_err_server'),
  err_http: __('talentx:sar_err_http'),
  err_ref: __('talentx:sar_err_ref'),
  err_network: __('talentx:sar_err_network'),
  err_format: __('talentx:sar_err_format'),
  retry: __('talentx:sar_retry'),
  relogin: __('talentx:sar_relogin')
} }) %>);
const DSP_T = <%- include('../../partials/json-script', { v: {
  titleL0: __('talentx:dsp_dlg_title_l0'), titleL: __('talentx:dsp_dlg_title'),
  bodyL0: __('talentx:dsp_dlg_body_l0'), bodyL: __('talentx:dsp_dlg_body'),
  self: __('talentx:dsp_self'), sup: __('talentx:dsp_supervisor'), none: __('talentx:dsp_dlg_none'),
  quote: __('talentx:dsp_dlg_quote'), levels: __('talentx:dsp_dlg_levels'),
  reason: __('talentx:dsp_dlg_reason'), reasonHint: __('talentx:dsp_note_required'),
  pick: __('talentx:dsp_dlg_pick'), confirmL0: __('talentx:dsp_dlg_confirm_l0'), confirm: __('talentx:dsp_dlg_confirm')
} }) %>;
const DSP = {
  // One dialog for every level: both ratings and the person's words recalled,
  // five level buttons (never a typed digit), a mandatory reason kept if the
  // server refuses. Level 0 proposes between the contested rating and the
  // person's own rating; levels 1 and 2 decide between the two.
  _kept: new Map(),
  async resolve(id, path, self, sup, why){
    const notify = window.toast || ((m)=>alert(m));
    const T = DSP_T;
    const isL0 = path === 'resolve-l0';
    const has = (v) => v !== null && v !== undefined && v !== '';
    const s = has(self) ? Number(self) : null, u = has(sup) ? Number(sup) : null;
    let min = 0, max = 4;
    if (isL0) { min = u === null ? 0 : u; max = s === null ? 4 : Math.max(min, s); }
    else if (s !== null && u !== null) { min = Math.min(s, u); max = Math.max(s, u); }
    const marks = {};
    if (s !== null) marks[s] = T.self;
    if (u !== null) marks[u] = (marks[u] ? marks[u] + ' · ' : '') + T.sup;
    const out = await window.ratingDialog({
      title: isL0 ? T.titleL0 : T.titleL, body: isL0 ? T.bodyL0 : T.bodyL,
      context: [{ label: T.self, value: s === null ? T.none : s }, { label: T.sup, value: u === null ? T.none : u }],
      quote: why || '', quoteLabel: T.quote, levelsLabel: T.levels, min, max, marks,
      reasonLabel: T.reason, reasonHint: T.reasonHint, pickHint: T.pick,
      confirmTpl: isL0 ? T.confirmL0 : T.confirm, reason: DSP._kept.get(Number(id)) || ''
    });
    if (!out) return;
    const decidedRating = out.rating, reason = out.reason;
    DSP._kept.set(Number(id), reason);
    let j;
    try {
      j = await SAConsoleNet.api('/v2/slf/disputes/'+Number(id)+'/'+path, 'POST', {decidedRating, reason});
    } catch (err) {
      notify(err.message, 'error');
      if (err.code === 'session') SAConsoleNet.navigate('/login?expired=1');
      return;
    }
    if (!j || j.ok === false) { notify((j && j.error) || <%- JSON.stringify(__('talentx:sar_not_confirmed')) %>, 'error'); return; }
    DSP._kept.delete(Number(id));
    location.reload();
  }
};
// CSP: the buttons are wired by csp-actions.js (data-on-click: DSP.resolve).
window.DSP = DSP;
</script>
