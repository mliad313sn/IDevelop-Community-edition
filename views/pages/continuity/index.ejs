<div class="page-header">
  <h1><i class="fas fa-sitemap" aria-hidden="true"></i> <%= __('talentx:ct_title') %></h1>
  <p class="text-muted"><%= __('talentx:ct_intro_1') %> <em><%= __('talentx:ct_ready_now') %></em> <%= __('talentx:ct_intro_2') %></p>
<div class="search-bar" style="margin:.6rem 0"><div class="search-input-wrapper"><input type="search" class="search-input" data-table-search="#cov-table, #plan-table, #ho-table, #ret-table" placeholder="<%= __('common:filter_list') %>" aria-label="<%= __('common:filter_list') %>"></div></div>
</div>

<!-- ============================ COMMENCER ============================ -->
<%
  // « Commencer » — succession stays dormant unless the page tells a leader what
  // to do next. Three ordered prompts, each row actionable.
  var SH = (typeof startHere !== 'undefined' && startHere) ? startHere : null;
  var SH_NEED = (SH && SH.needCriticality) || [];
  var SH_GAP  = (SH && SH.noSuccessor) || [];
  var SH_DUE  = (SH && SH.dueForReview) || [];
  var SH_MONTHS = (SH && SH.reviewIntervalMonths) || 6;
  // The unscored-roles list is capped; the counter must state the real total.
  var SH_NEED_TOTAL = (SH && SH.needCriticalityTotal != null) ? Number(SH.needCriticalityTotal) : SH_NEED.length;
  var SH_TOTAL = SH_NEED_TOTAL + SH_GAP.length + SH_DUE.length;
  var _sLang = (typeof lang !== 'undefined' ? lang : 'fr');
  // the server-side twin of ctDate below. This used to be
  // `new Date(String(v).slice(0,10) + 'T00:00:00Z').toLocaleDateString(lang)`,
  // which has TWO faults of the same family: a `date` column arrives as a Date
  // object, so String(v).slice(0,10) is « Tue Sep 15 », the reconstructed date
  // is invalid and the catch prints that English head verbatim; and when it did
  // parse, toLocaleDateString('en') wrote « 9/15/2026 » on a product whose ONE
  // date rendering is dd/MM/yyyy in both languages (src/utils/dateFormat).
  // Forced to UTC: a review date is a calendar day, not an instant.
  function sDate(v) {
    if (!v) return '—';
    var x = new Date(typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v) ? v + 'T00:00:00Z' : v);
    if (isNaN(x.getTime())) return '—';
    var p = function (n) { return String(n).padStart(2, '0'); };
    return p(x.getUTCDate()) + '/' + p(x.getUTCMonth() + 1) + '/' + x.getUTCFullYear();
  }
%>
<div class="card start-card" style="padding:0;margin-bottom:1rem">
  <div style="padding:.75rem 1rem;border-bottom:1px solid rgba(148,163,184,.2);display:flex;justify-content:space-between;align-items:center;gap:.75rem;flex-wrap:wrap">
    <h3 style="margin:0"><i class="fas fa-flag-checkered" aria-hidden="true"></i> <%= __('talentx:succ_start_heading') %></h3>
    <% if (SH_TOTAL) { %><span class="badge badge-danger"><%= __('talentx:succ_start_count').replace('{n}', SH_TOTAL) %></span><% } %>
  </div>
  <div style="padding:.75rem 1rem">
    <p class="text-muted" style="margin:0 0 .75rem"><%= __('talentx:succ_start_intro') %></p>
    <% if (!SH_TOTAL) { %>
      <p style="margin:0"><span class="badge badge-success"><i class="fas fa-check" aria-hidden="true"></i></span> <%= __('talentx:succ_all_clear') %></p>
    <% } %>

    <!-- 1) Roles nobody has scored ------------------------------------------->
    <h4 style="margin:.5rem 0 .25rem"><%= __('talentx:succ_step1_title') %> <span class="text-muted">(<%= SH_NEED_TOTAL %>)</span></h4>
    <p class="text-muted" style="margin:0 0 .35rem;font-size:.85em"><%= __('talentx:succ_step1_hint') %><% if (SH_NEED_TOTAL > SH_NEED.length) { %> <%= __('talentx:succ_showing_first').replace('{n}', SH_NEED.length) %><% } %></p>
    <% if (!SH_NEED.length) { %>
      <p class="text-muted" style="margin:0 0 .75rem"><em><%= __('talentx:succ_no_unscored') %></em></p>
    <% } else { %>
      <table class="table start-table" id="succ-need-table">
        <thead><tr><th><%= __('talentx:succ_role') %></th><th><%= __('talentx:succ_occupants') %></th><th><%= __('talentx:succ_actions') %></th></tr></thead>
        <tbody>
          <% SH_NEED.forEach(function(r){ %>
            <tr>
              <td><%= r.roleName %></td>
              <td><%= r.occupantCount || 0 %></td>
              <td><button type="button" class="btn btn-sm btn-primary" data-on-click="CONT.scoreRole" data-args="<%= JSON.stringify([r.roleId]) %>"><%= __('talentx:succ_score_now') %></button></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <!-- 2) Critical roles with an empty bench --------------------------------->
    <h4 style="margin:.9rem 0 .25rem"><%= __('talentx:succ_step2_title') %> <span class="text-muted">(<%= SH_GAP.length %>)</span></h4>
    <p class="text-muted" style="margin:0 0 .35rem;font-size:.85em"><%= __('talentx:succ_step2_hint') %></p>
    <% if (!SH_GAP.length) { %>
      <p class="text-muted" style="margin:0 0 .75rem"><em><%= __('talentx:succ_no_gap') %></em></p>
    <% } else { %>
      <table class="table start-table" id="succ-gap-table">
        <thead><tr><th><%= __('talentx:succ_role') %></th><th><%= __('talentx:succ_criticality') %></th><th><%= __('talentx:succ_incumbent') %></th><th><%= __('talentx:succ_bench') %></th><th><%= __('talentx:succ_actions') %></th></tr></thead>
        <tbody>
          <% SH_GAP.forEach(function(g){ %>
            <tr>
              <td><%= g.roleName %></td>
              <td><span class="crit crit-<%= g.criticalityScore %>"><%= g.criticalityScore %>/5</span> <span class="risk risk-<%= g.vacancyRisk %>"><%= enumLabel(g.vacancyRisk) %></span></td>
              <td><% if (g.incumbentFirst || g.incumbentLast) { %><%= (g.incumbentFirst||'') + ' ' + (g.incumbentLast||'') %><% } else { %><span class="text-muted"><%= __('talentx:succ_no_incumbent') %></span><% } %></td>
              <td><% if (!g.planId) { %><span class="badge badge-danger"><%= __('talentx:succ_no_plan_badge') %></span><% } else { %><span class="badge badge-danger"><%= __('talentx:succ_bench_empty_badge') %></span><% } %></td>
              <td style="white-space:nowrap">
                <% if (!g.planId) { %>
                  <button type="button" class="btn btn-sm btn-primary" data-on-click="CONT.openPlanFor" data-args="<%= JSON.stringify([g.roleId]) %>"><%= __('talentx:succ_open_plan') %></button>
                <% } else { %>
                  <button type="button" class="btn btn-sm btn-secondary" data-on-click="CONT.jumpToPlan" data-args="<%= JSON.stringify([g.planId]) %>"><%= __('talentx:succ_open_plan') %></button>
                  <button type="button" class="btn btn-sm btn-success" data-on-click="CONT.seed" data-args="<%= JSON.stringify([g.planId]) %>"><%= __('talentx:succ_build_bench') %></button>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <!-- 3) Plans past their review date ---------------------------------------->
    <h4 style="margin:.9rem 0 .25rem"><%= __('talentx:succ_step3_title') %> <span class="text-muted">(<%= SH_DUE.length %>)</span></h4>
    <p class="text-muted" style="margin:0 0 .35rem;font-size:.85em"><%= __('talentx:succ_step3_hint').replace('{n}', SH_MONTHS) %></p>
    <% if (!SH_DUE.length) { %>
      <p class="text-muted" style="margin:0"><em><%= __('talentx:succ_none_due') %></em></p>
    <% } else { %>
      <table class="table start-table" id="succ-due-table">
        <thead><tr><th><%= __('talentx:succ_role') %></th><th><%= __('talentx:succ_incumbent') %></th><th><%= __('talentx:succ_bench') %></th><th><%= __('talentx:succ_review_due') %></th><th><%= __('talentx:succ_last_reviewed') %></th><th><%= __('talentx:succ_actions') %></th></tr></thead>
        <tbody>
          <% SH_DUE.forEach(function(p){ %>
            <tr>
              <td><%= p.roleName %></td>
              <td><% if (p.incumbentFirst || p.incumbentLast) { %><%= (p.incumbentFirst||'') + ' ' + (p.incumbentLast||'') %><% } else { %><span class="text-muted"><%= __('talentx:succ_no_incumbent') %></span><% } %></td>
              <td><%= p.benchDepth || 0 %> · <%= __('talentx:ct_ready_now_col') %> <%= p.readyNowCount || 0 %></td>
              <td>
                <%= sDate(p.reviewDueYmd) %><br>
                <% if (Number(p.daysOverdue) > 0) { %>
                  <span class="badge badge-danger"><%= __('talentx:succ_overdue_days').replace('{n}', Number(p.daysOverdue)) %></span>
                <% } else { %>
                  <span class="badge"><%= __('talentx:succ_due_today') %></span>
                <% } %>
              </td>
              <td><% if (p.lastReviewedYmd) { %><%= sDate(p.lastReviewedYmd) %><% } else { %><span class="text-muted"><%= __('talentx:succ_never_reviewed') %></span><% } %></td>
              <td style="white-space:nowrap">
                <button type="button" class="btn btn-sm btn-secondary" data-on-click="CONT.jumpToPlan" data-args="<%= JSON.stringify([p.id]) %>"><%= __('talentx:succ_open_plan') %></button>
                <button type="button" class="btn btn-sm btn-primary" data-on-click="CONT.review" data-args="<%= JSON.stringify([p.id]) %>"><%= __('talentx:succ_review_now') %></button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<!-- ============================ COVERAGE ============================ -->
<div class="card" style="padding:0;margin-bottom:1rem">
  <div style="padding:.75rem 1rem;border-bottom:1px solid rgba(148,163,184,.2)"><h3 style="margin:0"><%= __('talentx:ct_coverage') %></h3></div>
  <table class="table" id="cov-table">
    <thead><tr><th><%= __('talentx:role') %></th><th><%= __('talentx:ct_criticality') %></th><th><%= __('talentx:ct_vacancy_risk') %></th><th><%= __('talentx:ct_business_impact') %></th><th><%= __('talentx:ct_bench') %></th><th><%= __('talentx:ct_ready_now_col') %></th><th><%= __('talentx:ct_coverage_col') %></th><th><%= __('talentx:ct_incumbent_risk') %></th></tr></thead>
    <tbody>
      <% if (!coverage || !coverage.length) { %>
        <tr><td colspan="8"><em><%= __('talentx:ct_no_critical') %></em></td></tr>
      <% } else { coverage.forEach(function(c){ %>
        <tr>
          <td><%= c.roleName %></td>
          <td><span class="crit crit-<%= c.criticalityScore %>"><%= c.criticalityScore %>/5</span></td>
          <td><span class="risk risk-<%= c.vacancyRisk %>"><%= c.vacancyRisk %></span></td>
          <td><% if (c.businessImpact) { %><%= c.businessImpact %><% } else { %><span class="text-muted">—</span><% } %></td>
          <td><%= c.benchDepth || 0 %></td>
          <td><%= c.readyNowCount || 0 %></td>
          <td><% if (c.hasCoverageGap) { %><span class="badge badge-danger"><%= __('talentx:ct_gap_badge') %></span><% } else { %><span class="badge badge-success"><%= __('talentx:ct_covered') %></span><% } %></td>
          <td><% if (c.incumbentFlightRisk) { %><span class="risk risk-<%= c.incumbentFlightRisk %>"><%= __('talentx:ct_flight') %> <%= c.incumbentFlightRisk %></span><% } else { %><span class="text-muted">—</span><% } %></td>
        </tr>
      <% }); } %>
    </tbody>
  </table>
</div>

<!-- ====================== DESIGNATE CRITICAL ROLE ====================== -->
<div class="card" style="padding:1rem;margin-bottom:1rem">
  <h3 style="margin-top:0" id="designate-heading"><%= __('talentx:ct_designate_heading') %></h3>
  <p id="crit-hint" class="text-muted" role="status" style="display:none;margin:.15rem 0 .6rem"><%= __('talentx:succ_role_preselected') %></p>
  <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:flex-end">
    <div><label for="crit-role"><%= __('talentx:role') %> *</label><br>
      <select id="crit-role" class="form-control" data-searchable>
        <option value=""><%= __('talentx:cp_select') %></option>
        <% (roles||[]).forEach(function(r){ %><option value="<%= r.id %>"><%= r.name %></option><% }); %>
      </select>
    </div>
    <div><label for="crit-score"><%= __('talentx:ct_criticality_1_5') %></label><br>
      <select id="crit-score" class="form-control"><% for (var i=1;i<=5;i++){ %><option value="<%= i %>" <%= i===3?'selected':'' %>><%= i %></option><% } %></select>
    </div>
    <div><label for="crit-vac"><%= __('talentx:ct_vacancy_risk') %></label><br>
      <select id="crit-vac" class="form-control"><option>low</option><option selected>medium</option><option>high</option></select>
    </div>
    <div><label for="crit-ttf"><%= __('talentx:ct_ttf') %></label><br><input id="crit-ttf" type="number" min="0" class="form-control" style="width:120px"></div>
    <div style="flex:1;min-width:200px"><label for="crit-impact"><%= __('talentx:ct_business_impact') %></label><br><input id="crit-impact" class="form-control" placeholder="<%= __('talentx:ct_business_impact_ph') %>"></div>
    <div style="flex:1;min-width:200px"><label for="crit-rationale"><%= __('talentx:ct_rationale') %></label><br><input id="crit-rationale" class="form-control" placeholder="<%= __('talentx:ct_rationale_ph') %>"></div>
    <button class="btn btn-primary" data-on-click="CONT.designate" data-args='[]'><%= __('talentx:ct_designate') %></button>
  </div>
</div>

<!-- ============================ PLANS ============================ -->
<div class="card" style="padding:1rem;margin-bottom:1rem">
  <h3 style="margin-top:0"><%= __('talentx:ct_open_plan_heading') %></h3>
  <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:flex-end">
    <div><label for="plan-role"><%= __('talentx:role') %> *</label><br>
      <select id="plan-role" class="form-control" data-searchable>
        <option value=""><%= __('talentx:cp_select') %></option>
        <% (roles||[]).forEach(function(r){ %><option value="<%= r.id %>"><%= r.name %></option><% }); %>
      </select>
    </div>
    <div><label for="plan-incumbent"><%= __('talentx:ct_incumbent_opt') %></label><br>
      <select id="plan-incumbent" class="form-control">
        <option value=""><%= __('talentx:ct_none') %></option>
        <% (employees||[]).forEach(function(e){ %><option value="<%= e.id %>"><%= e.name %></option><% }); %>
      </select>
    </div>
    <button class="btn btn-primary" data-on-click="CONT.openPlan" data-args='[]'><%= __('talentx:ct_open_plan') %></button>
  </div>
</div>

<div class="card" style="padding:0;margin-bottom:1rem">
  <div style="padding:.75rem 1rem;border-bottom:1px solid rgba(148,163,184,.2)"><h3 style="margin:0"><%= __('talentx:ct_plans') %></h3></div>
  <table class="table" id="plan-table">
    <thead><tr><th><%= __('talentx:role') %></th><th><%= __('talentx:ct_incumbent') %></th><th><%= __('talentx:status') %></th><th><%= __('talentx:ct_bench') %></th><th><%= __('talentx:succ_next_review') %></th><th><%= __('talentx:actions') %></th></tr></thead>
    <tbody>
      <% if (!plans || !plans.length) { %>
        <tr><td colspan="6"><em><%= __('talentx:ct_no_plans') %></em></td></tr>
      <% } else { plans.forEach(function(p){ %>
        <tr data-plan="<%= p.id %>">
          <td><%= p.roleName %></td>
          <td><%= (p.incumbentFirst||'') + ' ' + (p.incumbentLast||'') %></td>
          <td><span class="badge"><%= enumLabel(p.status) %></span></td>
          <td><%= p.benchDepth || 0 %></td>
          <td style="white-space:nowrap">
            <% if (p.reviewDueYmd) { %>
              <%= sDate(p.reviewDueYmd) %>
              <% if (Number(p.daysOverdue) >= 0) { %> <span class="badge badge-danger"><%= Number(p.daysOverdue) > 0 ? __('talentx:succ_overdue_days').replace('{n}', Number(p.daysOverdue)) : __('talentx:succ_due_today') %></span><% } %>
            <% } else { %><span class="text-muted">—</span><% } %>
          </td>
          <td style="white-space:nowrap">
            <button class="btn btn-sm btn-secondary" data-on-click="CONT.toggle" data-args="<%= JSON.stringify([p.id]) %>"><%= __('talentx:open') %></button>
            <button class="btn btn-sm btn-success" data-on-click="CONT.seed" data-args="<%= JSON.stringify([p.id]) %>" title="<%= __('talentx:ct_seed_title') %>"><%= __('talentx:ct_seed_bench') %></button>
            <button class="btn btn-sm btn-primary" data-on-click="CONT.review" data-args="<%= JSON.stringify([p.id]) %>"><%= __('talentx:succ_review_now') %></button>
            <button class="btn btn-sm btn-danger" data-on-click="CONT.archive" data-args="<%= JSON.stringify([p.id]) %>"><%= __('talentx:nb_archive') %></button>
          </td>
        </tr>
        <tr class="plan-detail" id="detail-<%= p.id %>" style="display:none"><td colspan="6"><div class="detail-body"><em><%= __('talentx:loading') %></em></div></td></tr>
      <% }); } %>
    </tbody>
  </table>
</div>

<!-- ============================ HANDOVER ============================ -->
<div class="card" style="padding:0;margin-bottom:1rem">
  <div style="padding:.75rem 1rem;border-bottom:1px solid rgba(148,163,184,.2);display:flex;justify-content:space-between;align-items:center">
    <h3 style="margin:0"><%= __('talentx:ct_handover') %></h3>
    <button class="btn btn-sm btn-secondary" data-on-click="CONT.loadHandover" data-args='[]'><%= __('talentx:refresh') %></button>
  </div>
  <div style="padding:.75rem 1rem;display:flex;gap:.5rem;flex-wrap:wrap;align-items:flex-end;border-bottom:1px solid rgba(148,163,184,.15)">
    <div><label for="ho-out"><%= __('talentx:ct_outgoing') %> *</label><br>
      <select id="ho-out" class="form-control"><option value=""><%= __('talentx:cp_select') %></option>
        <% (employees||[]).forEach(function(e){ %><option value="<%= e.id %>"><%= e.name %></option><% }); %>
      </select></div>
    <div><label for="ho-in"><%= __('talentx:ct_incoming_opt') %></label><br>
      <select id="ho-in" class="form-control"><option value=""><%= __('talentx:ct_none') %></option>
        <% (employees||[]).forEach(function(e){ %><option value="<%= e.id %>"><%= e.name %></option><% }); %>
      </select></div>
    <div><label for="ho-due"><%= __('talentx:ct_due') %></label><br><input id="ho-due" type="date" class="form-control"></div>
    <button class="btn btn-primary" data-on-click="CONT.createHandover" data-args='[]'><%= __('talentx:ct_start_handover') %></button>
    <span class="text-muted" style="font-size:.82em"><%= __('talentx:ct_auto_create') %></span>
  </div>
  <table class="table" id="ho-table">
    <thead><tr><th><%= __('talentx:ct_outgoing') %></th><th><%= __('talentx:ct_incoming') %></th><th><%= __('talentx:status') %></th><th><%= __('talentx:ta_progress') %></th><th><%= __('talentx:ct_due') %></th><th></th></tr></thead>
    <tbody><tr><td colspan="6"><em><%= __('talentx:ct_click_refresh_ho') %></em></td></tr></tbody>
  </table>
</div>

<!-- ============================ RETENTION ============================ -->
<div class="card" style="padding:0">
  <div style="padding:.75rem 1rem;border-bottom:1px solid rgba(148,163,184,.2);display:flex;justify-content:space-between;align-items:center">
    <h3 style="margin:0"><%= __('talentx:ct_risk_of_loss') %></h3>
    <button class="btn btn-sm btn-secondary" data-on-click="CONT.loadRetention" data-args='[]'><%= __('talentx:refresh') %></button>
  </div>
  <table class="table" id="ret-table">
    <thead><tr><th><%= __('talentx:employee') %></th><th><%= __('talentx:ct_flight_risk') %></th><th><%= __('talentx:ct_impact') %></th><th><%= __('talentx:ct_score') %></th><th><%= __('talentx:ct_source') %></th><th><%= __('talentx:actions') %></th></tr></thead>
    <tbody><tr><td colspan="6"><em><%= __('talentx:ct_click_refresh_ret') %></em></td></tr></tbody>
  </table>
</div>

<style>
  .crit{padding:2px 8px;border-radius:10px;color:#fff;font-size:.8em;background:#64748b}
  .crit-4,.crit-5{background:#b00020}.crit-3{background:#d97706}.crit-1,.crit-2{background:#0f8a3c}
  .risk{padding:2px 8px;border-radius:10px;color:#fff;font-size:.8em;background:#64748b}
  .risk-high{background:#b00020}.risk-medium{background:#d97706}.risk-low{background:#0f8a3c}
  /* Not one of the three verdicts: nobody has judged this person yet. Muted and
     transparent on purpose — an unmeasured cell must not read as a green pass. */
  .risk-unknown{background:transparent;color:#94a3b8;border:1px dashed rgba(148,163,184,.5)}
  .badge{padding:2px 8px;border-radius:10px;font-size:.8em;background:#334155;color:#e2e8f0}
  .badge-danger{background:#b00020;color:#fff}.badge-success{background:#0f8a3c;color:#fff}
  #ret-table td,#cov-table td,#plan-table td{vertical-align:middle}
  .start-card{border-left:4px solid #d97706}
  .start-card h4{font-size:1rem}
  .start-table{margin:0 0 .35rem}
  .start-table td,.start-table th{vertical-align:middle;font-size:.9em}
</style>

<%# UNE SEULE discipline de reseau pour toute l application :
    public/js/sa-console-net.js. Une reponse REDIRIGEE, non-JSON, 401/440 est
    un ECHEC -- jamais un succes -- et le refus est ecrit dans la langue de la
    page. Charge AVANT le script de la page (non differe) pour que SAConsoleNet
    existe au premier appel. %>
<script src="/js/sa-console-net.js?v=<%= assetVersion %>"></script>
<script nonce="<%= cspNonce %>">
SAConsoleNet.configure(<%- include('../../partials/json-script', { v: {
  err_session: __('talentx:sar_err_session'),
  err_forbidden: __('talentx:sar_err_forbidden'),
  err_notfound: __('talentx:sar_err_notfound'),
  err_server: __('talentx:sar_err_server'),
  err_http: __('talentx:sar_err_http'),
  err_ref: __('talentx:sar_err_ref'),
  err_network: __('talentx:sar_err_network'),
  err_format: __('talentx:sar_err_format'),
  // Titre de la carte de refus : neutre, car ces ecrans ne sont pas la console de
  // revue (sans cela ils affichaient « La file de revue n a pas pu etre chargee »).
  load_failed: __('dash:unable_to_load'),
  pending_failed: __('dash:unable_to_load'),
  retry: __('talentx:sar_retry'),
  relogin: __('talentx:sar_relogin')
} }) %>);
// Everything this page builds goes through innerHTML, and much of it is text
// a person typed: employee names, and the title/detail of a handover item.
// Escape before injecting, exactly as public/js/dashboard.js does.
const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g,
  (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
// CSP: no inline handlers — rows built below wire their controls through
// public/js/csp-actions.js (data-on-click / data-on-change + a JSON data-args list).
const ctOn = (type, fn, args) => ' data-on-' + type + '="' + fn + '" data-args="' + esc(JSON.stringify(args || [])) + '"';
// An unmeasured verdict prints as a dash, never as the word "null" and never
// as a band class (`risk-null`) that quietly styles it like a real rating.
const band = (v) => v == null
  ? '<span class="risk risk-unknown" title="' + esc(CT_T.notMeasuredTitle) + '">—</span>'
  : '<span class="risk risk-' + esc(v) + '">' + esc(v) + '</span>';
const CT_T = {
