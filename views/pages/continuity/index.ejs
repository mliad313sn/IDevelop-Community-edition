  addItem: <%- JSON.stringify(__('talentx:ct_add_item')) %>,
  itemPh: <%- JSON.stringify(__('talentx:ct_item_ph')) %>,
  enterItem: <%- JSON.stringify(__('talentx:ct_enter_item')) %>,
  promptFlight: <%- JSON.stringify(__('talentx:ct_prompt_flight')) %>,
  promptImpact: <%- JSON.stringify(__('talentx:ct_prompt_impact')) %>,
  reviewConfirm: <%- JSON.stringify(__('talentx:succ_review_confirm')) %>,
  reviewTitle: <%- JSON.stringify(__('talentx:succ_review_title')) %>,
  reviewed: <%- JSON.stringify(__('talentx:succ_reviewed')) %>,
