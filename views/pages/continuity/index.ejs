  reviewMonths: <%- include('../../partials/json-script', { v: String(SH_MONTHS) }) %>,
  lang: <%- include('../../partials/json-script', { v: _sLang }) %>
};
/* the client-rendered twin of the server defect. A handover row
   printed String(h.dueDate).slice(0,10), i.e. the raw head of whatever the API
   sent (ISO over JSON, an English weekday head the day a route hands over a
   Date object rather than a string). The
   product has ONE date rendering — dd/MM/yyyy in both languages, src/utils/
   dateFormat.fmtDate — and an absent value is « — », never a blank cell.
   Forced to UTC: a due date is a calendar day, not an instant. */
function ctDate(v){
  if(!v) return '—';
  const d=new Date(typeof v==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(v)?v+'T00:00:00Z':v);
  if(isNaN(d.getTime())) return '—';
  const p=(n)=>String(n).padStart(2,'0');
  return p(d.getUTCDate())+'/'+p(d.getUTCMonth()+1)+'/'+d.getUTCFullYear();
}
const CONT = {
  // L assistant reseau ne se recopie plus ici : il vit dans
  // public/js/sa-console-net.js (SAConsoleNet.call). L ancien corps avalait
  // `r.json` en `{}` ; sur une session expiree le serveur repondait
  // `302 -> /login`, le fetch de navigateur SUIVAIT la redirection, la page de
  // connexion arrivait en `200 text/html`, `r.ok` valait donc true et `j`
  // valait `{}` : le test `if(!r.ok||j.ok===false)` ne voyait rien.
  // Les deux assistants — POST et GET — portaient le meme defaut.
  async api(p,b){ try { return await SAConsoleNet.call(p,'POST',b||{}); } catch(e){ alert(e.message); throw e; } },
  async get(p){ try { return await SAConsoleNet.call(p,'GET'); } catch(e){ alert(e.message); throw e; } },

  async designate(){
    const roleId=Number(document.getElementById('crit-role').value);
    if(!roleId){alert(CT_T.selectRole);return;}
    // businessImpact was a dead column: the route accepted it and the service
    // wrote it, but the form never sent it and nothing ever displayed it.
    await this.api('/v2/continuity/criticality',{roleId,score:document.getElementById('crit-score').value,businessImpact:document.getElementById('crit-impact').value||null,vacancyRisk:document.getElementById('crit-vac').value,timeToFillDays:document.getElementById('crit-ttf').value||null,rationale:document.getElementById('crit-rationale').value||null});
    location.reload();
  },
  async openPlan(){
    const roleId=Number(document.getElementById('plan-role').value);
    if(!roleId){alert(CT_T.selectRole);return;}
    await this.api('/v2/continuity/plan',{roleId,incumbentEmployeeId:document.getElementById('plan-incumbent').value||null});
    location.reload();
  },
  async seed(id){ const j=await this.api('/v2/continuity/plan/'+id+'/seed',{}); this.say(CT_T.seeded.replace('{n}', j.added),'success'); location.reload(); },

  // ---- « Commencer » actions ------------------------------------------------
  say(msg,type){ if(typeof window.toast==='function'){window.toast(msg,type||'info');} else {alert(msg);} },
  /** Pre-select an unscored role in the designate form and take the user there. */
  scoreRole(roleId){
    const sel=document.getElementById('crit-role');
    if(sel){ sel.value=String(roleId); sel.dispatchEvent(new Event('change',{bubbles:true})); }
    const hint=document.getElementById('crit-hint'); if(hint) hint.style.display='';
    const head=document.getElementById('designate-heading');
    if(head&&head.scrollIntoView) head.scrollIntoView({behavior:'smooth',block:'center'});
    const score=document.getElementById('crit-score'); if(score) score.focus();
  },
  /** Open the (missing) plan for a critical role, straight from the queue. */
  async openPlanFor(roleId){
    await this.api('/v2/continuity/plan',{roleId});
    this.say(CT_T.planOpened,'success');
    location.reload();
  },
  /** Scroll to an existing plan row and expand its bench. */
  jumpToPlan(planId){
    const row=document.querySelector('tr[data-plan="'+planId+'"]');
    if(!row) return;
    if(row.scrollIntoView) row.scrollIntoView({behavior:'smooth',block:'center'});
    const detail=document.getElementById('detail-'+planId);
    if(detail&&detail.style.display==='none') this.toggle(planId);
  },
  /** Mark a plan reviewed — stamps who/when and pushes review_due forward. */
  async review(planId){
    // one confirmation component; ui-feedback.js is on every page.
    const ask=window.confirmDialog(CT_T.reviewConfirm.replace('{n}',CT_T.reviewMonths),{title:CT_T.reviewTitle,okText:CT_T.reviewNow});
    if(!(await ask)) return;
    const j=await this.api('/v2/continuity/plan/'+planId+'/review',{});
    let due=j.reviewDue||'';
    try { if(due) due=new Date(due+'T00:00:00Z').toLocaleDateString(CT_T.lang); } catch(e){ /* keep ISO */ }
    this.say(CT_T.reviewed.replace('{date}',due),'success');
    location.reload();
  },

  async archive(id){ if(!(await window.confirmDialog(CT_T.archiveConfirm,{danger:true})))return; await this.api('/v2/continuity/plan/'+id+'/archive',{}); location.reload(); },

  async toggle(id){
    const row=document.getElementById('detail-'+id);
    if(row.style.display!=='none'){row.style.display='none';return;}
    row.style.display='';
    const j=await this.get('/v2/continuity/plan/'+id);
    row.querySelector('.detail-body').innerHTML=this.renderDetail(j.plan);
  },
  renderDetail(plan){
    const bands={ready_now:CT_T.bandNow,ready_1_2y:CT_T.band12,ready_3y:CT_T.band3,emergency:CT_T.bandEmergency};
    let h='<div style="padding:.75rem 0"><strong>'+CT_T.bench+'</strong>';
    if(!plan.successors||!plan.successors.length){h+=' <em>'+CT_T.benchEmpty+'</em>';}
    h+='<table class="table" style="margin:.5rem 0"><thead><tr><th>'+CT_T.candidate+'</th><th>'+CT_T.readiness+'</th><th>'+CT_T.source+'</th><th>'+CT_T.gaps+'</th><th></th></tr></thead><tbody>';
    (plan.successors||[]).forEach(function(s){
      // scoreRows deliberately keeps every never-assessed requirement in the
      // gap list — the department-designed set is never hidden — and marks it
      // `current: null`. Flattening the list to skill names threw that marker
      // away, so "8 measured shortfalls + 12 nobody has looked at" was shown
      // as one undifferentiated list of 20 under a header reading "Gaps".
      // A shortfall is evidence; an unmeasured requirement is a question.
      const _gs=(s.gapSummary||[]);
      const _short=_gs.filter(function(g){return g.current!=null;});
      const _unmeas=_gs.length-_short.length;
      const gaps=(_short.length?_short.map(function(g){return g.skillName;}).join(', '):'—');
      const gapsNote=_unmeas?CT_T.gapsUnmeasured.replace('{n}',_unmeas):'';
      h+='<tr><td>'+esc(s.firstName||'')+' '+esc(s.lastName||'')+'</td>'
        +'<td><select class="form-control"'+ctOn('change','CONT.band',[s.id,'$value'])+'>'
        +Object.keys(bands).map(function(b){return '<option value="'+b+'"'+(s.readinessBand===b?' selected':'')+'>'+bands[b]+'</option>';}).join('')
        +'</select></td><td>'+esc(s.source)+'</td><td style="max-width:240px;font-size:.85em">'+esc(gaps)
        +(gapsNote?'<div style="color:#94a3b8;font-size:.92em;margin-top:.15rem" title="'+esc(CT_T.notMeasuredTitle)+'">'+esc(gapsNote)+'</div>':'')+'</td>'
        +'<td><button class="btn btn-sm btn-danger"'+ctOn('click','CONT.removeSucc',[s.id])+'>'+CT_T.remove+'</button></td></tr>';
    });
    h+='</tbody></table>';
    h+='<div style="display:flex;gap:.5rem;align-items:flex-end;flex-wrap:wrap"><div><label for="add-succ-'+plan.id+'">'+CT_T.addSuccessor+'</label><br><select id="add-succ-'+plan.id+'" class="form-control"><option value="">'+CT_T.select+'</option>'
      +(window.__contEmployees||[]).map(function(e){return '<option value="'+esc(e.id)+'">'+esc(e.name)+'</option>';}).join('')
      +'</select></div><button class="btn btn-sm btn-primary"'+ctOn('click','CONT.addSucc',[plan.id])+'>'+CT_T.add+'</button>'
      +'<button class="btn btn-sm btn-secondary"'+ctOn('click','CONT.cover',[plan.id])+'>'+CT_T.setCover+'</button></div></div>';
    return h;
  },
  async band(id,band){ await this.api('/v2/continuity/successor/'+id+'/band',{band}); },
  async removeSucc(id){ if(!(await window.confirmDialog(CT_T.removeConfirm,{danger:true})))return; await this.api('/v2/continuity/successor/'+id+'/remove',{}); location.reload(); },
  async addSucc(planId){ const sel=document.getElementById('add-succ-'+planId); const employeeId=Number(sel.value); if(!employeeId){alert(CT_T.selectEmployee);return;} await this.api('/v2/continuity/plan/'+planId+'/successor',{employeeId}); this.toggle(planId); this.toggle(planId); location.reload(); },
  async cover(planId){ const sel=document.getElementById('add-succ-'+planId); const employeeId=Number(sel.value); if(!employeeId){alert(CT_T.pickCover);return;} const note=(await window.promptDialog(CT_T.coverNote,''))||''; await this.api('/v2/continuity/plan/'+planId+'/emergency-cover',{employeeId,note}); alert(CT_T.coverSet); },

  async loadRetention(){
    const j=await this.get('/v2/continuity/retention');
    const tb=document.querySelector('#ret-table tbody');
    if(!j.list||!j.list.length){tb.innerHTML='<tr><td colspan="6"><em>'+CT_T.noRisk+'</em></td></tr>';}
    else{tb.innerHTML=j.list.map(function(r){
      return '<tr><td>'+esc(r.firstName||'')+' '+esc(r.lastName||'')+'<div style="color:#94a3b8;font-size:.78rem">'+esc(r.employeeNumber||'')+'</div></td>'
        +'<td>'+band(r.flightRisk)+'</td>'
        +'<td>'+band(r.impactOfLoss)+'</td>'
        +'<td>'+(r.computedScore!=null?r.computedScore:'—')+'</td>'
        +'<td>'+(r.manualOverride?CT_T.manual:CT_T.computed)+'</td>'
        +'<td style="white-space:nowrap"><button class="btn btn-sm btn-secondary"'+ctOn('click','CONT.recompute',[r.employeeId])+'>'+CT_T.recompute+'</button> '
        +'<button class="btn btn-sm btn-primary"'+ctOn('click','CONT.override',[r.employeeId])+'>'+CT_T.override+'</button></td></tr>';
    }).join('');}
  },
  async createHandover(){
    const outgoingEmployeeId=Number(document.getElementById('ho-out').value);
    if(!outgoingEmployeeId){alert(CT_T.selectOutgoing);return;}
    await this.api('/v2/continuity/handover',{outgoingEmployeeId,incomingEmployeeId:document.getElementById('ho-in').value||null,dueDate:document.getElementById('ho-due').value||null});
    this.loadHandover();
  },
  async loadHandover(){
    const j=await this.get('/v2/continuity/handover');
    const tb=document.querySelector('#ho-table tbody');
    if(!j.list||!j.list.length){tb.innerHTML='<tr><td colspan="6"><em>'+CT_T.noHandovers+'</em></td></tr>';return;}
    tb.innerHTML=j.list.map(function(h){
      const prog=(h.itemCount?Math.round((h.doneCount/h.itemCount)*100):0);
      return '<tr><td>'+esc(h.outFirst||'')+' '+esc(h.outLast||'')+'</td>'
        +'<td>'+((h.inFirst||h.inLast)?(esc(h.inFirst||'')+' '+esc(h.inLast||'')):'<span class="text-muted">—</span>')+'</td>'
        +'<td><span class="badge">'+esc(h.status)+'</span></td>'
        +'<td>'+h.doneCount+'/'+h.itemCount+' ('+prog+'%)</td>'
        +'<td>'+ctDate(h.dueDate)+'</td>'
        +'<td><button class="btn btn-sm btn-secondary"'+ctOn('click','CONT.openHandover',[h.id])+'>'+CT_T.open+'</button></td></tr>'
        +'<tr id="ho-detail-'+h.id+'" style="display:none"><td colspan="6"><div class="ho-body"><em>'+CT_T.loading+'</em></div></td></tr>';
    }).join('');
  },
  async openHandover(id){
    const row=document.getElementById('ho-detail-'+id);
    if(row.style.display!=='none'){row.style.display='none';return;}
    row.style.display='';
    const j=await this.get('/v2/continuity/handover/'+id);
    const p=j.plan;
    let h='<table class="table" style="margin:.5rem 0"><thead><tr><th>'+CT_T.item+'</th><th>'+CT_T.kind+'</th><th>'+CT_T.status+'</th></tr></thead><tbody>';
    const stLabels={open:CT_T.stOpen,in_progress:CT_T.stInProgress,completed:CT_T.stCompleted};
    (p.items||[]).forEach(function(it){
      h+='<tr><td><strong>'+esc(it.title)+'</strong>'+(it.detail?'<div style="color:#94a3b8;font-size:.82em">'+esc(it.detail)+'</div>':'')+'</td><td>'+esc(it.kind)+'</td>'
        +'<td><select class="form-control"'+ctOn('change','CONT.itemStatus',[it.id,'$value'])+'>'
        +['open','in_progress','completed'].map(function(s){return '<option value="'+s+'"'+(it.status===s?' selected':'')+'>'+(stLabels[s]||s)+'</option>';}).join('')
        +'</select></td></tr>';
    });
    h+='</tbody></table><div style="display:flex;gap:.5rem;align-items:flex-end;flex-wrap:wrap"><div><label for="ho-it-'+id+'">'+CT_T.addItem+'</label><br><input id="ho-it-'+id+'" class="form-control" placeholder="'+CT_T.itemPh+'"></div><button class="btn btn-sm btn-primary"'+ctOn('click','CONT.addHandoverItem',[id])+'>'+CT_T.add+'</button></div>';
    row.querySelector('.ho-body').innerHTML=h;
  },
  async itemStatus(itemId,status){ await this.api('/v2/continuity/handover/item/'+itemId+'/status',{status}); this.loadHandover(); },
  async addHandoverItem(id){ const inp=document.getElementById('ho-it-'+id); const title=inp.value.trim(); if(!title){alert(CT_T.enterItem);return;} await this.api('/v2/continuity/handover/'+id+'/item',{title}); this.openHandover(id); this.openHandover(id); },
  async recompute(empId){ await this.api('/v2/continuity/retention/'+empId+'/recompute',{}); this.loadRetention(); },
  async override(empId){ const fr=await window.promptDialog(CT_T.promptFlight,''); if(!fr)return; const il=(await window.promptDialog(CT_T.promptImpact,''))||undefined; await this.api('/v2/continuity/retention/'+empId+'/override',{flightRisk:fr,impactOfLoss:il}); this.loadRetention(); }
};
// csp-actions.js resolves handlers on window and calls them with `this` = the
// clicked element; a top-level const is not a window property, and the methods
// above rely on `this` being CONT — so publish a bound copy of each.
Object.keys(CONT).forEach(function(k){ if(typeof CONT[k]==='function') CONT[k]=CONT[k].bind(CONT); });
window.CONT = CONT;
window.__contEmployees = <%- include('../../partials/json-script', { v: (employees||[]).map(function(e){return {id:e.id,name:e.name};}) }) %>;
// Auto-load the flight-risk + handover tables so leaders see them without a hidden
// click; the Refresh buttons remain for a manual re-fetch.
document.addEventListener('DOMContentLoaded', function(){ try { CONT.loadRetention(); CONT.loadHandover(); } catch (e) { /* optional */ } });
</script>
