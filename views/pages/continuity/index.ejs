  readiness: <%- JSON.stringify(__('talentx:ct_readiness')) %>,
  source: <%- JSON.stringify(__('talentx:ct_source')) %>,
  gaps: <%- JSON.stringify(__('talentx:ct_gaps_col')) %>,
  gapsUnmeasured: <%- JSON.stringify(__('talentx:ct_gaps_unmeasured')) %>,
  remove: <%- JSON.stringify(__('talentx:remove')) %>,
  addSuccessor: <%- JSON.stringify(__('talentx:ct_add_successor')) %>,
  select: <%- JSON.stringify(__('talentx:cp_select')) %>,
  add: <%- JSON.stringify(__('talentx:add')) %>,
  setCover: <%- JSON.stringify(__('talentx:ct_set_cover')) %>,
  removeConfirm: <%- JSON.stringify(__('talentx:ct_remove_confirm')) %>,
