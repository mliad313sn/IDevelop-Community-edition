            rbp_readiness_by_site: <%- JSON.stringify(__('admin:rbp_readiness_by_site')) %>,
            rbp_coverage_by_department: <%- JSON.stringify(__('admin:rbp_coverage_by_department')) %>,
            rbp_critical_skill_gap_analysis: <%- JSON.stringify(__('admin:rbp_critical_skill_gap_analysis')) %>,
            rbp_kpi_strip_gap_table_h_bar_by_domain: <%- JSON.stringify(__('admin:rbp_kpi_strip_gap_table_h_bar_by_domain')) %>,
            rbp_gap_overview: <%- JSON.stringify(__('admin:rbp_gap_overview')) %>,
            rbp_top_gaps_by_domain: <%- JSON.stringify(__('admin:rbp_top_gaps_by_domain')) %>,
            rbp_gap_details: <%- JSON.stringify(__('admin:rbp_gap_details')) %>,
            rbp_site_x_domain_capability: <%- JSON.stringify(__('admin:rbp_site_x_domain_capability')) %>,
            rbp_heatmap_radar_comparisons: <%- JSON.stringify(__('admin:rbp_heatmap_radar_comparisons')) %>,
            rbp_capability_heatmap: <%- JSON.stringify(__('admin:rbp_capability_heatmap')) %>,
            rbp_site_radar: <%- JSON.stringify(__('admin:rbp_site_radar')) %>,
            rbp_department_radar: <%- JSON.stringify(__('admin:rbp_department_radar')) %>,
