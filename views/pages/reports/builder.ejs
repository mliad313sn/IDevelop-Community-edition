            rbp_qualification_status_by_role: <%- JSON.stringify(__('admin:rbp_qualification_status_by_role')) %>,
            rbp_9_box_talent_grid: <%- JSON.stringify(__('admin:rbp_9_box_talent_grid')) %>,
            rbp_assessment_coverage: <%- JSON.stringify(__('admin:rbp_assessment_coverage')) %>,
            rbp_kpi_progress_line_trend: <%- JSON.stringify(__('admin:rbp_kpi_progress_line_trend')) %>,
            rbp_coverage_kpis: <%- JSON.stringify(__('admin:rbp_coverage_kpis')) %>,
            rbp_coverage_by_site: <%- JSON.stringify(__('admin:rbp_coverage_by_site')) %>,
            rbp_assessment_trend: <%- JSON.stringify(__('admin:rbp_assessment_trend')) %>,
            rbp_department_comparison: <%- JSON.stringify(__('admin:rbp_department_comparison')) %>,
            rbp_stacked_bar_radar_overlay: <%- JSON.stringify(__('admin:rbp_stacked_bar_radar_overlay')) %>,
            rbp_department_x_domain: <%- JSON.stringify(__('admin:rbp_department_x_domain')) %>,
            rbp_department_radar_overlay: <%- JSON.stringify(__('admin:rbp_department_radar_overlay')) %>,
            rbp_training_needs_priority: <%- JSON.stringify(__('admin:rbp_training_needs_priority')) %>,
            rbp_h_bar_table_with_cf: <%- JSON.stringify(__('admin:rbp_h_bar_table_with_cf')) %>,
            rbp_gaps_by_skill: <%- JSON.stringify(__('admin:rbp_gaps_by_skill')) %>,
            rbp_priority_list: <%- JSON.stringify(__('admin:rbp_priority_list')) %>,
            rbp_skills_distribution: <%- JSON.stringify(__('admin:rbp_skills_distribution')) %>,
            rbp_doughnut_area_progress: <%- JSON.stringify(__('admin:rbp_doughnut_area_progress')) %>,
            rbp_skills_by_domain: <%- JSON.stringify(__('admin:rbp_skills_by_domain')) %>,
            rbp_level_trend: <%- JSON.stringify(__('admin:rbp_level_trend')) %>,
