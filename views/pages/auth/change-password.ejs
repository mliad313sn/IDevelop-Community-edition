<div class="page-header">
    <h1><%= __('chrome:change_password_title') %></h1>
</div>

<form action="/change-password" method="POST" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
        <label for="currentPassword"><%= __('chrome:current_password_label') %></label>
        <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
    </div>

    <div class="form-group">
        <label for="newPassword"><%= __('chrome:new_password_label') %></label>
        <input type="password" id="newPassword" name="newPassword" required minlength="12" maxlength="128" autocomplete="new-password" data-pw-strength="pwStrengthNew">
        <small style="color: #666; font-size: 0.85em; display: block; margin-top: 4px;">
            <%= __('chrome:password_requirements') %>
        </small>
        <div id="pwStrengthNew" class="pw-strength" aria-live="polite" data-l-empty="<%= __('auth:pw_strength_empty') %>" data-l-weak="<%= __('auth:pw_strength_weak') %>" data-l-fair="<%= __('auth:pw_strength_fair') %>" data-l-good="<%= __('auth:pw_strength_good') %>" data-l-strong="<%= __('auth:pw_strength_strong') %>" style="display:flex;align-items:center;gap:8px;margin-top:6px;font-size:.85em;">
            <span><%= __('auth:pw_strength_label') %></span>
            <meter min="0" max="100" low="40" high="60" optimum="100" value="0" aria-hidden="true" style="flex:1;max-width:220px;"></meter>
            <span data-pw-strength-text></span>
        </div>
        <small style="color: #666; font-size: 0.85em; display: block; margin-top: 4px;"><%= __('auth:pw_strength_hint') %></small>
    </div>

    <div class="form-group">
        <label for="confirmPassword"><%= __('chrome:confirm_password_label') %></label>
        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="12" maxlength="128" autocomplete="new-password">
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= __('chrome:btn_change_password') %></button>
        <a href="/dashboard" class="btn btn-secondary"><%= __('chrome:btn_cancel') %></a>
    </div>
</form>
<script src="/js/password-strength.js" nonce="<%= cspNonce %>" defer></script>
