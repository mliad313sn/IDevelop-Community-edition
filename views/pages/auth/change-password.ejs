<div class="page-header">
    <h1><%= __('chrome:change_password_title') %></h1>
</div>

<form action="/change-password" method="POST" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
        <label for="currentPassword"><%= __('chrome:current_password_label') %></label>
        <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
    </div>

    <div class="form-group">
        <label for="newPassword"><%= __('chrome:new_password_label') %></label>
        <input type="password" id="newPassword" name="newPassword" required minlength="12" autocomplete="new-password">
        <small style="color: #666; font-size: 0.85em; display: block; margin-top: 4px;">
            <%= __('chrome:password_requirements') %>
        </small>
    </div>

    <div class="form-group">
        <label for="confirmPassword"><%= __('chrome:confirm_password_label') %></label>
        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="12" autocomplete="new-password">
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= __('chrome:btn_change_password') %></button>
        <a href="/dashboard" class="btn btn-secondary"><%= __('chrome:btn_cancel') %></a>
    </div>
</form>
