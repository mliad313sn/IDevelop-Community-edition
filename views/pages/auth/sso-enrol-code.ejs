<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' && lang) ? lang : 'fr' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% const _brand = (typeof branding !== 'undefined' && branding) ? branding : { appName: 'IDevelop', faviconUrl: null, accentCss: '' }; %>
    <title><%= __('auth:sso_enrol_title') %> · <%= (typeof brandName!=='undefined' && brandName) ? brandName : _brand.appName %></title>
    <% if (_brand.faviconUrl) { %>
    <link rel="icon" href="<%= _brand.faviconUrl %>">
    <% } %>
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=6.4.0">
    <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/login.css?v=<%= assetVersion %>">
    <% if (_brand.accentCss) { %>
    <style nonce="<%= cspNonce %>"><%- _brand.accentCss %></style>
    <% } %>
    <!-- Prevent theme flash: apply saved theme before paint -->
    <script nonce="<%= cspNonce %>">
        (function () { var t = localStorage.getItem('theme'); if (t === 'light') document.documentElement.setAttribute('data-theme', 'light'); })();
    </script>
    <%- include('../../partials/pwa-head') %>
</head>

<body class="login-page">
    <%#
        3.23.19 (security review): an administrator with no second factor
        may sign in by SSO only with the ONE-TIME code a super administrator
        issued for them (24 h, single use, 5 tries). The session then opens held
        on TOTP enrolment. Works with no JavaScript.
    %>
    <main class="login-container">
        <h1><%= _brand.appName %></h1>
        <h2><i class="fas fa-key" aria-hidden="true"></i> <%= __('auth:sso_enrol_title') %></h2>

        <%- include('../../partials/flash') %>

        <p class="login-help-text"><%= __('auth:sso_enrol_intro') %></p>

        <form action="/auth/sso/enrol-code" method="POST" class="login-form">
            <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <div class="form-group">
                <label for="code"><%= __('auth:sso_enrol_label') %></label>
                <input type="text" id="code" name="code" required autofocus autocomplete="one-time-code"
                    maxlength="20" class="form-control" style="text-align:center; letter-spacing:0.2em; font-size:1.1rem;">
            </div>
            <button type="submit" class="btn btn-primary btn-block"><%= __('chrome:btn_verify') %></button>
        </form>

        <p style="text-align:center; margin-top: 16px;">
            <a href="/login" style="font-size: 0.85rem;">← <%= __('chrome:mfa_back_to_sign_in') %></a>
        </p>
    </main>
</body>

</html>
