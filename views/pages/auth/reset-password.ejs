<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' && lang) ? lang : 'fr' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= __('auth:reset_title') %> - IDevelop</title>
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=6.4.0">
    <% if (typeof externalFonts !== 'undefined' && externalFonts === true) { %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
        rel="stylesheet" media="print" data-async-css>
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    </noscript>
    <% } %>
    <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/login.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/horizon.css?v=<%= assetVersion %>">
    <script nonce="<%= cspNonce %>">
        (function(){var d=document.documentElement,t=null,p=null;try{t=localStorage.getItem('theme');p=localStorage.getItem('palette');}catch(e){}var dk=t==='dark'||(t!=='light'&&window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches);if(!dk)d.setAttribute('data-theme','light');if(p&&p!=='iris')d.setAttribute('data-palette',p);})();
    </script>
    <%- include('../../partials/pwa-head') %>
    <script src="/js/csp-actions.js?v=<%= assetVersion %>" defer></script>
</head>

<body class="login-page">
    <div class="login-container">
        <img src="/brand/idevelop-mark.svg" alt="" class="login-mark" width="56" height="56">
        <h1>IDevelop</h1>
        <h2><%= __('auth:reset_title') %></h2>

        <%- include('../../partials/flash') %>

        <p style="color:var(--text-secondary,#94a3b8);font-size:.9rem;margin:0 0 16px;">
            <%= __('auth:reset_intro') %>
        </p>

        <form action="/reset-password" method="POST" class="login-form" id="reset-form">
            <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <input type="hidden" name="token" value="<%= token %>">
            <div class="form-group">
                <label for="password"><%= __('auth:reset_new_label') %></label>
                <div style="position:relative;display:flex;align-items:center;">
                    <input type="password" id="password" name="password" required minlength="12" maxlength="128"
                        autocomplete="new-password" data-pw-strength="pwStrengthNew" class="form-control" style="flex:1;padding-right:38px;">
                    <button type="button" data-on-click="pwToggle" data-args='["password", "$el"]' aria-pressed="false"
                        title="<%= __('admin:toggle_visibility') %>"
                        style="position:absolute;right:8px;background:none;border:none;cursor:pointer;color:inherit;font-size:15px;padding:4px 8px;">
                        <i class="fas fa-eye" aria-hidden="true"></i></button>
                </div>
                <small style="color:var(--text-muted,#888);font-size:.82rem;display:block;margin-top:4px;">
                    <%= __('auth:reset_policy_hint') %></small>
                <div id="pwStrengthNew" class="pw-strength" aria-live="polite" data-l-empty="<%= __('auth:pw_strength_empty') %>" data-l-weak="<%= __('auth:pw_strength_weak') %>" data-l-fair="<%= __('auth:pw_strength_fair') %>" data-l-good="<%= __('auth:pw_strength_good') %>" data-l-strong="<%= __('auth:pw_strength_strong') %>" style="display:flex;align-items:center;gap:8px;margin-top:6px;font-size:.82rem;">
                    <span><%= __('auth:pw_strength_label') %></span>
                    <meter min="0" max="100" low="40" high="60" optimum="100" value="0" aria-hidden="true" style="flex:1;max-width:200px;"></meter>
                    <span data-pw-strength-text></span>
                </div>
                <small style="color:var(--text-muted,#888);font-size:.82rem;display:block;margin-top:4px;"><%= __('auth:pw_strength_hint') %></small>
            </div>
            <div class="form-group">
                <label for="passwordConfirm"><%= __('auth:reset_confirm_label') %></label>
                <div style="position:relative;display:flex;align-items:center;">
                    <input type="password" id="passwordConfirm" name="passwordConfirm" required minlength="12"
                        autocomplete="new-password" class="form-control" style="flex:1;padding-right:38px;">
                    <button type="button" data-on-click="pwToggle" data-args='["passwordConfirm", "$el"]' aria-pressed="false"
                        title="<%= __('admin:toggle_visibility') %>"
                        style="position:absolute;right:8px;background:none;border:none;cursor:pointer;color:inherit;font-size:15px;padding:4px 8px;">
                        <i class="fas fa-eye" aria-hidden="true"></i></button>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block"><%= __('auth:reset_submit') %></button>
        </form>

        <p class="login-help-text" style="margin-top:14px;text-align:center;">
            <a href="/login"><i class="fas fa-arrow-left" aria-hidden="true"></i> <%= __('auth:back_to_login') %></a>
        </p>
    </div>

    <script src="/js/password-strength.js" nonce="<%= cspNonce %>" defer></script>
    <script nonce="<%= cspNonce %>">
        // Standalone page (no app bundle): local show/hide toggle + confirm-match guard.
        function pwToggle(id, btn) {
            var el = document.getElementById(id); if (!el) return;
            var reveal = el.type === 'password'; el.type = reveal ? 'text' : 'password';
            var i = btn && btn.querySelector('.fa-eye, .fa-eye-slash');
            if (i) { i.classList.toggle('fa-eye', !reveal); i.classList.toggle('fa-eye-slash', reveal); }
            btn.setAttribute('aria-pressed', String(reveal));
        }
        document.getElementById('reset-form').addEventListener('submit', function (e) {
            var p = document.getElementById('password').value;
            var c = document.getElementById('passwordConfirm').value;
            if (p !== c) { e.preventDefault(); alert(<%- JSON.stringify(__('flash:reset_mismatch')) %>); }
        });
    </script>
</body>

</html>
