<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' && lang) ? lang : 'fr' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= __('auth:forgot_title') %> - IDevelop</title>
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=6.4.0">
    <% if (typeof externalFonts !== 'undefined' && externalFonts === true) { %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
        rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    </noscript>
    <% } %>
    <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/login.css?v=<%= assetVersion %>">
    <script nonce="<%= cspNonce %>">
        (function () { var t = localStorage.getItem('theme'); if (t === 'light') document.documentElement.setAttribute('data-theme', 'light'); })();
    </script>
    <%- include('../../partials/pwa-head') %>
</head>

<body class="login-page">
    <div class="login-container">
        <img src="/brand/idevelop-mark.svg" alt="" class="login-mark" width="56" height="56">
        <h1>IDevelop</h1>
        <h2><%= __('auth:forgot_title') %></h2>

        <%- include('../../partials/flash') %>

        <p style="color:var(--text-secondary,#94a3b8);font-size:.9rem;margin:0 0 16px;">
            <%= __('auth:forgot_intro') %>
        </p>

        <% if (typeof emailEnabled !== 'undefined' && !emailEnabled) { %>
            <div class="login-notice" role="status" style="display:flex;align-items:center;gap:8px;margin:0 0 14px;padding:10px 14px;font-size:.85rem;border-radius:10px;background:rgba(124, 108, 255,.10);border:1px solid rgba(124, 108, 255,.35);color:var(--text-secondary,#94a3b8);">
                <i class="fas fa-circle-info" aria-hidden="true" style="color:var(--brand,#7C6CFF);"></i>
                <%= __('auth:forgot_email_off_hint') %>
            </div>
        <% } %>

        <form action="/forgot-password" method="POST" class="login-form">
            <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <div class="form-group">
                <label for="identifier"><%= __('auth:forgot_identifier_label') %></label>
                <input type="text" id="identifier" name="identifier" required autofocus
                    autocomplete="username" class="form-control"
                    placeholder="<%= __('auth:forgot_identifier_placeholder') %>">
            </div>
            <button type="submit" class="btn btn-primary btn-block"><%= __('auth:forgot_submit') %></button>
        </form>

        <p class="login-help-text" style="margin-top:14px;text-align:center;">
            <a href="/login"><i class="fas fa-arrow-left" aria-hidden="true"></i> <%= __('auth:back_to_login') %></a>
        </p>
    </div>
</body>

</html>
